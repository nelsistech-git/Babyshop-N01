<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record id="ssp_review_default" model="ssp.review">
            <field name="name">Management Review</field>
            <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
            <field name="next_run_date" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d')"/>
        </record>
        
        <record id="ssp_review_dashboard_daily" model="ssp.review.dashboard">
            <field name="name">Management Review Dashboard Daily</field>
            <field name="periodicity">daily</field>
        </record>

        <!-- <function id="ssp_review_refresh_automatic_action" model="ssp.review.dashboard" name="generate_summary_data"/> -->
    </data>
</odoo>
