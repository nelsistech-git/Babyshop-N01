GraphWidget.template = "operation_overview.GraphWidget";
GraphWidget.displayName = _lt("Graph Widget");
GraphWidget.supportedTypes = ["float", "integer", "monetary"];

GraphWidget.props = {
        record: { type: Object, required: true },
        graph_type: { type: String, optional: true, default: 'line' },
        xlabel: { type: String, optional: true },
        ylabel: { type: String, optional: true },
    
        // Additional props based on the error messages
        update: { type: Function, optional: true },
        value: { type: String, optional: true },
        decorations: { type: Object, optional: true }, 
        readonly: { type: Boolean, optional: true },
        id: { type: String, optional: true },   
        name: { type: String, optional: true },
        type: { type: String, optional: true },
        setDirty: { type: Function, optional: true },
    };

GraphWidget.isEmpty = () => false;

registry.category("fields").add("graph_widget", GraphWidget);

