<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_real_estate" model="ir.module.category">
            <field name="name">Real Estate</field>
            <field name="description">Real Estate Project &amp; Property Management</field>
            <field name="sequence">20</field>
        </record>

        <!-- Base access: any real-estate staff member -->
        <record id="group_real_estate_user" model="res.groups">
            <field name="name">User / Read Only</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="comment">Basic read access to Real Estate records.</field>
        </record>

        <record id="group_real_estate_land_manager" model="res.groups">
            <field name="name">Land Manager</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>

        <record id="group_real_estate_project_manager" model="res.groups">
            <field name="name">Project Manager</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>

        <record id="group_real_estate_sales_manager" model="res.groups">
            <field name="name">Sales Manager</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>

        <record id="group_real_estate_salesperson" model="res.groups">
            <field name="name">Salesperson</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>

        <record id="group_real_estate_accounts_manager" model="res.groups">
            <field name="name">Accounts Manager</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>

        <record id="group_real_estate_site_engineer" model="res.groups">
            <field name="name">Site Engineer</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>

        <record id="group_real_estate_qc_officer" model="res.groups">
            <field name="name">QC Officer</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>

        <record id="group_real_estate_procurement_officer" model="res.groups">
            <field name="name">Procurement Officer</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>

        <record id="group_real_estate_store_manager" model="res.groups">
            <field name="name">Store Manager</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>

        <record id="group_real_estate_director" model="res.groups">
            <field name="name">Director</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_land_manager')),
                                              (4, ref('group_real_estate_project_manager')),
                                              (4, ref('group_real_estate_sales_manager')),
                                              (4, ref('group_real_estate_accounts_manager'))]"/>
        </record>

        <record id="group_real_estate_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_director')),
                                              (4, ref('group_real_estate_site_engineer')),
                                              (4, ref('group_real_estate_qc_officer')),
                                              (4, ref('group_real_estate_procurement_officer')),
                                              (4, ref('group_real_estate_store_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Customer Portal group (for future phases - portal access) -->
        <record id="group_real_estate_customer_portal" model="res.groups">
            <field name="name">Customer Portal</field>
            <field name="category_id" ref="module_category_real_estate"/>
        </record>

    </data>
</odoo>
