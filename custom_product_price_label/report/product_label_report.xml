<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_custom_product_price_label" model="ir.actions.report">
        <field name="name">Custom Product Label</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_product_price_label.report_product_price_label_document</field>
        <field name="report_file">custom_product_price_label.report_product_price_label_document</field>
        <field name="print_report_name">'Product Label - %s' % (object.display_name or '')</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_product_price_label"/>
    </record>
</odoo>
