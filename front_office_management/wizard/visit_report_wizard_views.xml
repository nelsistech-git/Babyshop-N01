<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="fo_visit_report_wizard_view_form" model="ir.ui.view">
        <field name="name">fo.visit.report.wizard.view.form</field>
        <field name="model">fo.visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Visitor Report">
                <group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_export_excel"
                            string="Export Excel"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Window Action -->
    <record id="action_fo_visit_report_wizard" model="ir.actions.act_window">
        <field name="name">Visitor Report</field>
        <field name="res_model">fo.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
