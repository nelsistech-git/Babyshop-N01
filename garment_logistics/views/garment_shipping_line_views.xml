<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_shipping_line_tree" model="ir.ui.view">
        <field name="name">garment.shipping.line.tree</field>
        <field name="model">garment.shipping.line</field>
        <field name="arch" type="xml">
            <tree string="Shipping Lines" editable="bottom">
                <field name="name"/>
                <field name="origin_port"/>
                <field name="destination_port"/>
                <field name="transit_time_days"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_shipping_line" model="ir.actions.act_window">
        <field name="name">Shipping Lines</field>
        <field name="res_model">garment.shipping.line</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
