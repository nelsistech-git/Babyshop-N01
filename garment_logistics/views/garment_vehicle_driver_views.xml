<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_vehicle_tree" model="ir.ui.view">
        <field name="name">garment.vehicle.tree</field>
        <field name="model">garment.vehicle</field>
        <field name="arch" type="xml">
            <tree string="Vehicles" editable="bottom">
                <field name="vehicle_number"/>
                <field name="vehicle_type"/>
                <field name="capacity"/>
                <field name="driver_id"/>
                <field name="owner"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">garment.vehicle</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_garment_driver_tree" model="ir.ui.view">
        <field name="name">garment.driver.tree</field>
        <field name="model">garment.driver</field>
        <field name="arch" type="xml">
            <tree string="Drivers" editable="bottom">
                <field name="name"/>
                <field name="mobile_number"/>
                <field name="license_number"/>
                <field name="license_expiry"/>
                <field name="assigned_vehicle_id"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">garment.driver</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
