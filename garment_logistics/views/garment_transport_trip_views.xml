<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_transport_trip_tree" model="ir.ui.view">
        <field name="name">garment.transport.trip.tree</field>
        <field name="model">garment.transport.trip</field>
        <field name="arch" type="xml">
            <tree string="Transport Trips">
                <field name="trip_number"/>
                <field name="shipment_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_transport_trip_form" model="ir.ui.view">
        <field name="name">garment.transport.trip.form</field>
        <field name="model">garment.transport.trip</field>
        <field name="arch" type="xml">
            <form string="Transport Trip">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="requested,vehicle_selected,driver_assigned,approved,trip_started,gate_pass,port_delivered,confirmed"/>
                    <button name="action_next_stage" type="object" string="Move to Next Stage" class="btn-primary"
                            invisible="status == 'confirmed'"/>
                    <button name="action_next_port_delivery_status" type="object"
                            string="Advance Port Delivery Status" class="btn-secondary"
                            invisible="port_delivery_status == 'vessel_loading'"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="trip_number" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="shipment_id"/>
                            <field name="requested_by_id"/>
                            <field name="request_department"/>
                            <field name="vehicle_requirement"/>
                            <field name="pickup_location"/>
                            <field name="delivery_location"/>
                            <field name="delivery_port_id"/>
                            <field name="cargo_details"/>
                            <field name="requested_date"/>
                        </group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="route"/>
                            <field name="distance_km"/>
                            <field name="fuel_cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Port Delivery Tracking">
                        <field name="port_delivery_status" widget="badge"/>
                    </group>
                    <group string="GPS Tracking">
                        <field name="current_location"/>
                        <field name="estimated_arrival"/>
                        <field name="last_gps_update"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_transport_trip" model="ir.actions.act_window">
        <field name="name">Transport Trips</field>
        <field name="res_model">garment.transport.trip</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first transport trip.</p>
        </field>
    </record>
</odoo>
