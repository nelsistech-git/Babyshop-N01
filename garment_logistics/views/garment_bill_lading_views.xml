<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_bill_lading_tree" model="ir.ui.view">
        <field name="name">garment.bill.lading.tree</field>
        <field name="model">garment.bill.lading</field>
        <field name="arch" type="xml">
            <tree string="Bills of Lading">
                <field name="bl_number"/>
                <field name="shipment_id"/>
                <field name="vessel_name"/>
                <field name="port"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_bill_lading_form" model="ir.ui.view">
        <field name="name">garment.bill.lading.form</field>
        <field name="model">garment.bill.lading</field>
        <field name="arch" type="xml">
            <form string="Bill of Lading">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="bl_number" readonly="1"/></h1></div>
                    <group>
                        <field name="shipment_id"/>
                        <field name="vessel_name"/>
                        <field name="container_id"/>
                        <field name="port"/>
                        <field name="consignee"/>
                        <field name="date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_bill_lading" model="ir.actions.act_window">
        <field name="name">Bills of Lading</field>
        <field name="res_model">garment.bill.lading</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
