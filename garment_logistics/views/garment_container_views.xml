<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_container_tree" model="ir.ui.view">
        <field name="name">garment.container.tree</field>
        <field name="model">garment.container</field>
        <field name="arch" type="xml">
            <tree string="Containers">
                <field name="container_no"/>
                <field name="shipment_id"/>
                <field name="size"/>
                <field name="shipping_line_id"/>
                <field name="port_id"/>
                <field name="current_location"/>
                <field name="etd"/>
                <field name="eta"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_container_form" model="ir.ui.view">
        <field name="name">garment.container.form</field>
        <field name="model">garment.container</field>
        <field name="arch" type="xml">
            <form string="Container">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_next_status" type="object" string="Move to Next Status" class="btn-primary"
                            invisible="status == 'delivered'"/>
                    <button name="action_run_ai_utilization" type="object" string="AI Utilization Analysis"
                            class="btn-secondary" icon="fa-magic"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="container_no"/></h1></div>
                    <group>
                        <group>
                            <field name="shipment_id"/>
                            <field name="size"/>
                            <field name="container_type"/>
                            <field name="shipping_line_id"/>
                            <field name="booking_number"/>
                            <field name="seal_no"/>
                        </group>
                        <group>
                            <field name="vessel_name"/>
                            <field name="voyage_number"/>
                            <field name="etd"/>
                            <field name="eta"/>
                            <field name="port"/>
                            <field name="port_id"/>
                            <field name="current_location"/>
                        </group>
                    </group>
                    <group string="Loading">
                        <group>
                            <field name="loading_date"/>
                            <field name="carton_qty"/>
                            <field name="loading_person_id"/>
                            <field name="dispatch_date"/>
                        </group>
                        <group>
                            <field name="weight_kg"/>
                            <field name="volume_cbm"/>
                            <field name="capacity_cbm"/>
                            <field name="utilization_pct" readonly="1"/>
                        </group>
                    </group>
                    <group string="AI Utilization Analysis">
                        <field name="ai_utilization_note" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_container" model="ir.actions.act_window">
        <field name="name">Containers</field>
        <field name="res_model">garment.container</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
