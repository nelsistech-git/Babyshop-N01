<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_garment_shipment" model="ir.actions.report">
        <field name="name">Shipment Summary</field>
        <field name="model">garment.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">garment_logistics.report_garment_shipment</field>
        <field name="report_file">garment_logistics.report_garment_shipment</field>
        <field name="binding_model_id" ref="model_garment_shipment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Shipment - %s' % (object.shipment_no)</field>
    </record>

    <template id="report_garment_shipment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Shipment <span t-field="o.shipment_no"/></h2>
                        <p class="text-muted">
                            Buyer: <span t-field="o.buyer_id.name"/> | Destination: <span t-field="o.destination"/>
                            | Mode: <span t-field="o.mode"/> | Status: <span t-field="o.status"/>
                        </p>

                        <h4>Allocation</h4>
                        <table class="table table-sm">
                            <thead><tr><th>Style</th><th>Required</th><th>Allocated</th><th>Carton</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.allocation_ids" t-as="a">
                                    <td><span t-field="a.style_id.style_name"/></td>
                                    <td><span t-field="a.required_qty"/></td>
                                    <td><span t-field="a.allocated_qty"/></td>
                                    <td><span t-field="a.carton_qty"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Containers</h4>
                        <table class="table table-sm">
                            <thead><tr><th>Container No.</th><th>Size</th><th>ETD</th><th>ETA</th><th>Status</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.container_ids" t-as="c">
                                    <td><span t-field="c.container_no"/></td>
                                    <td><span t-field="c.size"/></td>
                                    <td><span t-field="c.etd"/></td>
                                    <td><span t-field="c.eta"/></td>
                                    <td><span t-field="c.status"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <p>Total Freight Cost: <span t-field="o.total_freight_cost"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
