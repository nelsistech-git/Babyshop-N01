<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_shipment" model="ir.sequence">
        <field name="name">Garment Shipment Number</field>
        <field name="code">garment.shipment</field>
        <field name="prefix">SHIP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_transport_trip" model="ir.sequence">
        <field name="name">Garment Transport Trip Number</field>
        <field name="code">garment.transport.trip</field>
        <field name="prefix">TRIP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_bill_lading" model="ir.sequence">
        <field name="name">Garment Bill of Lading Number</field>
        <field name="code">garment.bill.lading</field>
        <field name="prefix">BL/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
