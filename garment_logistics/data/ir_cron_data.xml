<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Logistics Alert System (SRS section 19): Shipment Delay Alert +
         Document Missing Alert, raised as scheduled activities. -->
    <record id="ir_cron_garment_logistics_alerts" model="ir.cron">
        <field name="name">Logistics: Check Shipment Delay / Document Missing Alerts</field>
        <field name="model_id" ref="model_garment_shipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_logistics_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
