<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Port Management master data (SRS section 28: Major Ports) -->
    <record id="port_chittagong" model="garment.port">
        <field name="name">Chittagong Port</field>
        <field name="port_type">sea</field>
        <field name="location">Chittagong, Bangladesh</field>
    </record>

    <record id="port_mongla" model="garment.port">
        <field name="name">Mongla Port</field>
        <field name="port_type">sea</field>
        <field name="location">Mongla, Bangladesh</field>
    </record>

    <record id="port_dhaka_icd" model="garment.port">
        <field name="name">Dhaka ICD</field>
        <field name="port_type">icd</field>
        <field name="location">Dhaka, Bangladesh</field>
    </record>

</odoo>
