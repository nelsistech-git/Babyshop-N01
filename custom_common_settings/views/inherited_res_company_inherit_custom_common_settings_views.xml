<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_inherited_res_company_inherit_cus_common_settings_form" model="ir.ui.view">
        <field name="name">inherited.res.company.inherit.cus.common.settings.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='vat']" position="after">
                 <field name="bin_no"/>
             </xpath>
             <xpath expr="//field[@name='currency_id']" position="after">
                 <field name="start_date"/>
                 <field name="display_year"/>
                 <field name="cpf_type"/>
                 <field name="cpf_percentage"/>
             </xpath>
        </field>
    </record>
</odoo>