<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cheque book type tree View -->
	<record id="bank_account_type_view_tree" model="ir.ui.view">
         <field name="name">bank.account.type.tree</field>
         <field name="model">bank.account.type</field>
         <field name="arch" type="xml">
             <tree string="Cheque Book Account Type List" editable="bottom">
             	<field name="name" required="1"/>
             	<field name="remarks"/>
             	<field name="active"/>
             </tree>
         </field>
     </record>

    <!-- Cheque book type search View -->
    <record id="bank_account_type_view_search" model="ir.ui.view">
         <field name="name">bank.account.type.search</field>
         <field name="model">bank.account.type</field>
        <field name="arch" type="xml">
            <search string="Search Bank">
                <field name="name"/>
           </search>
        </field>
    </record>

    <!-- Cheque book action window -->
	<record id="bank_account_type_action" model="ir.actions.act_window">
        <field name="name"> Bank Account Type</field>
        <field name="res_model">bank.account.type</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Please Create Bank Account Type
            </p>
        </field>
    </record>

    <!-- Cheque book accounts menu -->
    <menuitem id="bank_account_type_menu" name="Account Type" action="bank_account_type_action" sequence="12"
				  parent="account.menu_finance_configuration"/>


</odoo>
