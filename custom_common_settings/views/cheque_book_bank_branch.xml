<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cheque_book_bank_branch_view_form" model="ir.ui.view">
        <field name="name">cheque.book.bank.branch.form</field>
        <field name="model">cheque.book.bank.branch</field>
        <field name="arch" type="xml">
            <form string="Bank Information Form">
                <sheet>
                    <group>
                        <group>
                            <field name="bank_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" required="1"/>
                            <field name="name" required="1"/>
                            <field name="routing" />
                            <field name="remarks" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Cheque book branch tree View -->
	<record id="cheque_book_bank_branch_view_tree" model="ir.ui.view">
         <field name="name">cheque.book.bank.branch.tree</field>
         <field name="model">cheque.book.bank.branch</field>
         <field name="arch" type="xml">
             <tree string="Bank Branch List">
                 <field name="bank_id"/>
             	 <field name="name"/>
             	 <field name="routing" />
             </tree>
         </field>
     </record>

    <!-- Cheque book branch search View -->
    <record id="cheque_book_bank_branch_view_search" model="ir.ui.view">
         <field name="name">cheque.book.bank.branch.search</field>
         <field name="model">cheque.book.bank.branch</field>
        <field name="arch" type="xml">
            <search string="Bank Branch">
                <field name="name"/>
                <field name="bank_id"/>
           </search>
        </field>
    </record>

    <!-- Cheque book branch action window -->
	<record id="cheque_book_bank_branch_action" model="ir.actions.act_window">
        <field name="name">Bank Branch</field>
        <field name="res_model">cheque.book.bank.branch</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Please Create Cheque Book Bank Branch
            </p>
        </field>
    </record>

    <!-- Cheque book branch menu -->
    <menuitem id="bank_branch_cheque_book_menu" name="Bank Branch" action="cheque_book_bank_branch_action" sequence="11"
				  parent="account.menu_finance_configuration"/>


</odoo>
