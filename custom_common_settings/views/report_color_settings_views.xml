<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="custom_report_color_settings_view_tree" model="ir.ui.view">
         <field name="name">report.color.settings.tree</field>
         <field name="model">report.color.settings</field>
         <field name="arch" type="xml">
             <tree string="Report Color Settings" editable="bottom">
             	<field name="report_name" required="1"/>
                 <field name="color1"/>
                 <field name="color2"/>
                 <field name="color3"/>
                 <field name="note"/>
             </tree>
         </field>
     </record>

    <record id="action_custom_report_color_settings" model="ir.actions.act_window">
        <field name="name">Report Color Settings</field>
        <field name="res_model">report.color.settings</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_custom_report_color_settings" name="Report Color Settings" parent="custom_common_settings.menu_other_settings" action="action_custom_report_color_settings" groups="base.group_system" sequence="150"/>

</odoo>