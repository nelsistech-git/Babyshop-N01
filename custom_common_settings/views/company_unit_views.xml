<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="company_unit_view_form" model="ir.ui.view">
            <field name="name">company_unit.form</field>
            <field name="model">company.unit</field>
            <field name="arch" type="xml">
                <form string="Company unit Form">
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="name"/>
                            </group>
                            <group></group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
		
        <record id="company_unit_view_tree" model="ir.ui.view">
            <field name="name">company_unit.tree</field>
            <field name="model">company.unit</field>
            <field name="arch" type="xml">
                <tree string="Company unit Tree">
                    <field name="name"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>
		

        <record id="company_unit_list_action" model="ir.actions.act_window">
            <field name="name">Company Units</field>
            <field name="res_model">company.unit</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create company units
                </p>
            </field>
        </record>
        <menuitem id="root_planning_menu" name="Planning" sequence="10" parent="stock.menu_stock_config_settings"
                  groups="stock.group_stock_manager"/>
		
        <menuitem id="company_unit_menu" name="Company Units" parent="root_planning_menu"
                  action="company_unit_list_action" sequence="1"/>

    </data>
</odoo>