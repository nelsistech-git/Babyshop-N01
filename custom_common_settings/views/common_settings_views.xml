<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="custom_common_settings_view_tree" model="ir.ui.view">
         <field name="name">custom.common.settings.tree</field>
         <field name="model">custom.common.settings</field>
         <field name="arch" type="xml">
             <tree string="Common Settings List" editable="bottom" delete="false">
             	<field name="sequence" widget="handle"/>
                 <field name="code" invisible="1"/>
                 <field name="key" required="1"/>
                 <field name="value" required="1"/>
             </tree>
         </field>
     </record>

    <record id="custom_common_settings_view_search" model="ir.ui.view">
        <field name="name">custom.common.settings.search</field>
        <field name="model">custom.common.settings</field>
        <field name="arch" type="xml">
            <search string="Search Common Settings">
                <field name="code"/>
                <field name="key" />
           </search>
        </field>
    </record>
	
	<record id="custom_common_settings_action" model="ir.actions.act_window">
        <field name="name">Common Settings List</field>
        <field name="res_model">custom.common.settings</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Please Create Common Settings
            </p>
        </field>
    </record>

    <!-- Reporting menu -->
    <menuitem id="menu_custom_common_settings" name="Common Settings" parent="menu_other_settings" action="custom_common_settings_action" sequence="116"/>


</odoo>
