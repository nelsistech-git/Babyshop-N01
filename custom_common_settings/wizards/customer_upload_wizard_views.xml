<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_upload_wizard_form" model="ir.ui.view">
        <field name="name">customer.upload.wizard.form</field>
        <field name="model">customer.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Upload">
                <group>
                    <group>
                        <field name="upload_csv_file" help="CSV format with columns(Name, Phone No)"/>
                        <field name="upload_des" invisible="upload_des == False" readonly="1"/>
                    </group>
                </group>

                <footer>
                    <button name="action_customer_upload" type="object" string="Upload"
                        class="oe_highlight" confirm="Are you sure you want to upload?"/>
                    <button string="Cancel" special="cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>
	
    <!-- Product Upload Wizard Action -->
    <record id="action_customer_upload_wizard" model="ir.actions.act_window">
        <field name="name">Customer Upload</field>
        <field name="res_model">customer.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>