<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_quotation_tree" model="ir.ui.view">
        <field name="name">fw.quotation.tree</field>
        <field name="model">fw.quotation</field>
        <field name="arch" type="xml">
            <tree string="Quotations" decoration-success="state=='accepted'"
                  decoration-danger="state in ('rejected','expired')">
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="lead_id"/>
                <field name="quotation_date"/>
                <field name="valid_until"/>
                <field name="total_qty"/>
                <field name="total_amount" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_quotation_form" model="ir.ui.view">
        <field name="name">fw.quotation.form</field>
        <field name="model">fw.quotation</field>
        <field name="arch" type="xml">
            <form string="Quotation">
                <header>
                    <button name="action_send" type="object" string="Send"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_accept" type="object" string="Accept"
                            class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'sent'"/>
                    <button name="action_convert_to_order" type="object"
                            string="Convert to Buyer Order" class="btn-primary"
                            invisible="state != 'accepted' or converted_order_id"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="lead_id"/>
                        </group>
                        <group>
                            <field name="quotation_date"/>
                            <field name="valid_until"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="converted_order_id" readonly="1"
                                   invisible="not converted_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quotation Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="style_id"/>
                                    <field name="color_id"/>
                                    <field name="size_curve_id"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="amount" widget="monetary"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_qty"/>
                                <field name="total_amount" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Terms &amp; Conditions">
                            <field name="terms_conditions"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_quotation_search" model="ir.ui.view">
        <field name="name">fw.quotation.search</field>
        <field name="model">fw.quotation</field>
        <field name="arch" type="xml">
            <search string="Search Quotations">
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="lead_id"/>
                <filter string="Sent" name="sent" domain="[('state','=','sent')]"/>
                <filter string="Accepted" name="accepted" domain="[('state','=','accepted')]"/>
                <group expand="0" string="Group By">
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_quotation" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">fw.quotation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_quotation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first quotation</p>
        </field>
    </record>
</odoo>
