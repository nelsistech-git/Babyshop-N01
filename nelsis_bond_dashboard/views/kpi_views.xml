<odoo>
    <record id="view_bond_kpi_list" model="ir.ui.view">
        <field name="name">bond.dashboard.kpi.list</field>
        <field name="model">bond.dashboard.kpi</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="section"/>
                <field name="kpi_type"/>
                <field name="model_name"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_bond_kpi_form" model="ir.ui.view">
        <field name="name">bond.dashboard.kpi.form</field>
        <field name="model">bond.dashboard.kpi</field>
        <field name="arch" type="xml">
            <form class="nl-ui">
                <header>
                    <button name="action_test" type="object" string="Test Card" icon="fa-flask" class="btn-primary nl-btn nl-info"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Card title"/></h1></div>
                    <group>
                        <group string="Data">
                            <field name="section"/>
                            <field name="kpi_type"/>
                            <field name="model_name" placeholder="e.g. stock.quant"/>
                            <field name="domain"/>
                            <field name="measure_field" invisible="kpi_type == 'count'"/>
                            <field name="denominator_field" invisible="kpi_type != 'ratio'"/>
                            <field name="groupby_field" invisible="kpi_type != 'breakdown'"/>
                        </group>
                        <group string="Appearance and access">
                            <field name="icon"/>
                            <field name="color"/>
                            <field name="danger_if_positive"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Notes"><field name="description" nolabel="1" colspan="2"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bond_dashboard_kpi" model="ir.actions.act_window">
        <field name="name">Dashboard Cards</field>
        <field name="res_model">bond.dashboard.kpi</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
