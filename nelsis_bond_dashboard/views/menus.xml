<odoo>
    <record id="action_bond_dashboard_main" model="ir.actions.client">
        <field name="name">Bond Dashboard</field>
        <field name="tag">nelsis_bond_dashboard.main</field>
    </record>

    <menuitem id="menu_bond_dashboard_root" name="Bond Dashboard" sequence="45"
              web_icon="nelsis_bond_dashboard,static/description/icon.svg"
              groups="group_bond_dash_storekeeper,group_bond_dash_commercial,group_bond_dash_auditor,group_bond_dash_admin"/>
    <menuitem id="menu_bond_dashboard_main" name="Dashboard" parent="menu_bond_dashboard_root"
              action="action_bond_dashboard_main" sequence="10"/>
    <menuitem id="menu_bond_dashboard_alerts" name="Alerts" parent="menu_bond_dashboard_root"
              action="action_bond_dashboard_alert" sequence="20"/>

    <menuitem id="menu_bond_audit" name="Audit" parent="menu_bond_dashboard_root" sequence="30"
              groups="group_bond_dash_warehouse_manager,group_bond_dash_auditor,group_bond_dash_admin"/>
    <menuitem id="menu_bond_audit_move_line" name="Validated Stock Movements" parent="menu_bond_audit"
              action="action_bond_audit_move_line" sequence="10"/>
    <menuitem id="menu_bond_audit_picking" name="Validated Transfers" parent="menu_bond_audit"
              action="action_bond_audit_picking" sequence="20"/>

    <menuitem id="menu_bond_dashboard_config" name="Configuration" parent="menu_bond_dashboard_root" sequence="90"
              groups="group_bond_dash_bond_manager,group_bond_dash_admin"/>
    <menuitem id="menu_bond_alert_rules" name="Alert Rules" parent="menu_bond_dashboard_config"
              action="action_bond_dashboard_alert_rule" sequence="10"/>
    <menuitem id="menu_bond_dashboard_cards" name="Dashboard Cards" parent="menu_bond_dashboard_config"
              action="action_bond_dashboard_kpi" sequence="20" groups="group_bond_dash_admin"/>
</odoo>
