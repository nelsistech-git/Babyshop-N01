<odoo>
    <record id="view_bond_alert_rule_list" model="ir.ui.view">
        <field name="name">bond.dashboard.alert.rule.list</field>
        <field name="model">bond.dashboard.alert.rule</field>
        <field name="arch" type="xml">
            <tree decoration-danger="last_error" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="alert_type"/>
                <field name="model_name"/>
                <field name="severity"/>
                <field name="last_run"/>
                <field name="last_match_count"/>
                <field name="last_error" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_bond_alert_rule_form" model="ir.ui.view">
        <field name="name">bond.dashboard.alert.rule.form</field>
        <field name="model">bond.dashboard.alert.rule</field>
        <field name="arch" type="xml">
            <form class="nl-ui">
                <header>
                    <button name="action_preview_matches" type="object" string="Preview Matches" icon="fa-eye" class="btn-secondary nl-btn nl-info"
                            invisible="not model_name"/>
                    <button name="action_run_now" type="object" string="Run Now" icon="fa-play" class="btn-primary nl-btn nl-info"
                            invisible="not model_name"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Rule name"/></h1></div>
                    <group>
                        <group string="Rule">
                            <field name="alert_type"/>
                            <field name="severity"/>
                            <field name="active"/>
                        </group>
                        <group string="Last evaluation">
                            <field name="last_run"/>
                            <field name="last_match_count"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <group string="Condition (leave the model empty only for event rules)">
                        <group>
                            <field name="model_name" placeholder="e.g. bond.warehouse.license"/>
                            <field name="domain" placeholder="[('state', '=', 'active')]"/>
                        </group>
                        <group>
                            <field name="date_field" placeholder="e.g. expiry_date"/>
                            <field name="lead_days"/>
                        </group>
                        <group invisible="alert_type != 'entitlement_threshold'">
                            <field name="ratio_numerator_field"/>
                            <field name="ratio_denominator_field"/>
                            <field name="threshold_percent"/>
                        </group>
                    </group>
                    <group string="Notification">
                        <group>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="notify_message"/>
                            <field name="notify_activity"/>
                            <field name="message_template"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bond_dashboard_alert_rule" model="ir.actions.act_window">
        <field name="name">Alert Rules</field>
        <field name="res_model">bond.dashboard.alert.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
