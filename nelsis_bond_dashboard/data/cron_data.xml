<odoo noupdate="1">
    <record id="ir_cron_bond_alert_rules" model="ir.cron">
        <field name="name">Bond Dashboard: evaluate alert rules</field>
        <field name="model_id" ref="model_bond_dashboard_alert_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_rules()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
    <record id="param_renewal_review_days" model="ir.config_parameter">
        <field name="key">nelsis_bond_dashboard.renewal_review_days</field>
        <field name="value">90</field>
    </record>
</odoo>
