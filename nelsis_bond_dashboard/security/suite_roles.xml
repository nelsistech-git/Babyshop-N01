<?xml version="1.0" encoding="utf-8"?>
<!-- Connects the suite roles of nelsis_bond_warehouse to the dashboard roles. -->
<odoo>
    <record id="nelsis_bond_warehouse.group_bond_suite_operator" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_bond_dash_storekeeper'))]"/>
    </record>
    <record id="nelsis_bond_warehouse.group_bond_suite_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_bond_dash_bond_manager'))]"/>
    </record>
    <record id="nelsis_bond_warehouse.group_bond_suite_auditor" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_bond_dash_auditor'))]"/>
    </record>
</odoo>
