<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_merch_inquiry" model="ir.sequence">
        <field name="name">Garment Merchandising Inquiry Number</field>
        <field name="code">garment.merch.inquiry</field>
        <field name="prefix">INQ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_merch_quotation" model="ir.sequence">
        <field name="name">Garment Merchandising Quotation Number</field>
        <field name="code">garment.merch.quotation</field>
        <field name="prefix">QUO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_merch_negotiation" model="ir.sequence">
        <field name="name">Garment Merchandising Negotiation Number</field>
        <field name="code">garment.merch.negotiation</field>
        <field name="prefix">NEG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_merch_order_confirmation" model="ir.sequence">
        <field name="name">Garment Merchandising Order Confirmation Number</field>
        <field name="code">garment.merch.order.confirmation</field>
        <field name="prefix">OC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_merch_handover" model="ir.sequence">
        <field name="name">Garment Merchandising Handover Number</field>
        <field name="code">garment.merch.handover</field>
        <field name="prefix">HO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_merch_task" model="ir.sequence">
        <field name="name">Garment Merchandising Task Number</field>
        <field name="code">garment.merch.task</field>
        <field name="prefix">MTASK/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
