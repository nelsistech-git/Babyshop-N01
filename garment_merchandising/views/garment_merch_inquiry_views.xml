<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_merch_inquiry_form" model="ir.ui.view">
        <field name="name">garment.merch.inquiry.form</field>
        <field name="model">garment.merch.inquiry</field>
        <field name="arch" type="xml">
            <form string="Merchandising Inquiry">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="new,assigned,style_development,internal_review,costing,quotation_sent,negotiation,order_confirmed"/>
                    <button name="action_auto_assign_merchandiser" type="object" string="Auto-Assign Merchandiser (AI)"
                            class="btn-secondary" icon="fa-magic"
                            invisible="assigned_merchandiser_id != False"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotations" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="quotation_count" widget="statinfo" string="Quotations"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="inquiry_number"/>
                        <h1><field name="inquiry_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="inquiry_date"/>
                            <field name="rfq_id"/>
                            <field name="buyer_id"/>
                            <field name="buyer_contact_id"/>
                            <field name="buying_house"/>
                            <field name="brand"/>
                            <field name="season"/>
                            <field name="collection"/>
                        </group>
                        <group>
                            <field name="product_category_id"/>
                            <field name="product_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="assigned_merchandiser_id"/>
                            <field name="assignment_department"/>
                            <field name="assignment_team"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Product Details">
                            <group>
                                <group>
                                    <field name="product_description"/>
                                    <field name="fabric_type"/>
                                    <field name="fabric_composition"/>
                                    <field name="gsm"/>
                                    <field name="yarn_count"/>
                                    <field name="knit_type"/>
                                    <field name="weave_type"/>
                                </group>
                                <group>
                                    <field name="dyeing_type"/>
                                    <field name="washing_type"/>
                                    <field name="print_type"/>
                                    <field name="embroidery_type"/>
                                    <field name="finish_type"/>
                                </group>
                            </group>
                        </page>
                        <page string="Quantity">
                            <group>
                                <group>
                                    <field name="moq"/>
                                    <field name="order_quantity"/>
                                    <field name="destination_country_id"/>
                                    <field name="delivery_schedule"/>
                                </group>
                                <group>
                                    <field name="size_breakdown"/>
                                    <field name="color_breakdown"/>
                                </group>
                            </group>
                        </page>
                        <page string="Commercial Details">
                            <group>
                                <group>
                                    <field name="target_fob"/>
                                    <field name="currency_id"/>
                                    <field name="payment_term_id"/>
                                    <field name="incoterm_id"/>
                                </group>
                                <group>
                                    <field name="shipment_mode"/>
                                    <field name="port_of_loading"/>
                                    <field name="destination_port"/>
                                </group>
                            </group>
                        </page>
                        <page string="Styles">
                            <field name="style_line_ids">
                                <tree editable="bottom">
                                    <field name="style_name"/>
                                    <field name="buyer_style_number"/>
                                    <field name="factory_style_number"/>
                                    <field name="product_type"/>
                                    <field name="gender"/>
                                    <field name="age_group"/>
                                    <field name="main_fabric"/>
                                    <field name="size_range"/>
                                    <field name="color_name"/>
                                    <field name="style_id"/>
                                    <field name="status"/>
                                    <button name="action_create_style" type="object" string="Create Style" class="btn-link"
                                            invisible="style_id != False"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Review Checklists">
                            <field name="checklist_ids">
                                <tree>
                                    <field name="reviewer_id"/>
                                    <field name="review_date"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Quotations">
                            <field name="quotation_ids">
                                <tree>
                                    <field name="quotation_number"/>
                                    <field name="quotation_date"/>
                                    <field name="total_value"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Tasks">
                            <field name="task_ids">
                                <tree>
                                    <field name="task_number"/>
                                    <field name="name"/>
                                    <field name="task_type"/>
                                    <field name="assigned_to_id"/>
                                    <field name="due_date"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_merch_inquiry_tree" model="ir.ui.view">
        <field name="name">garment.merch.inquiry.tree</field>
        <field name="model">garment.merch.inquiry</field>
        <field name="arch" type="xml">
            <tree string="Inquiries" decoration-danger="status == 'lost'" decoration-success="status == 'order_confirmed'">
                <field name="inquiry_number"/>
                <field name="inquiry_date"/>
                <field name="buyer_id"/>
                <field name="product_category_id"/>
                <field name="assigned_merchandiser_id"/>
                <field name="priority" widget="priority"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_merch_inquiry_kanban" model="ir.ui.view">
        <field name="name">garment.merch.inquiry.kanban</field>
        <field name="model">garment.merch.inquiry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="inquiry_number"/>
                <field name="buyer_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top"><strong><field name="inquiry_number"/></strong></div>
                            <div><field name="buyer_id"/></div>
                            <field name="priority" widget="priority"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_garment_merch_inquiry_search" model="ir.ui.view">
        <field name="name">garment.merch.inquiry.search</field>
        <field name="model">garment.merch.inquiry</field>
        <field name="arch" type="xml">
            <search string="Search Inquiries">
                <field name="inquiry_number"/>
                <field name="buyer_id"/>
                <filter string="My Inquiries" name="filter_my" domain="[('assigned_merchandiser_id', '=', uid)]"/>
                <filter string="Unassigned" name="filter_unassigned" domain="[('assigned_merchandiser_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Merchandiser" name="group_merchandiser" context="{'group_by': 'assigned_merchandiser_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_merch_inquiry" model="ir.actions.act_window">
        <field name="name">Inquiries</field>
        <field name="res_model">garment.merch.inquiry</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first inquiry.</p>
        </field>
    </record>

</odoo>
