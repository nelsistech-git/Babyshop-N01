<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_merch_calendar_event_tree" model="ir.ui.view">
        <field name="name">garment.merch.calendar.event.tree</field>
        <field name="model">garment.merch.calendar.event</field>
        <field name="arch" type="xml">
            <tree string="Calendar Events" editable="bottom" decoration-success="is_completed == True">
                <field name="event_date"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="buyer_id"/>
                <field name="style_id"/>
                <field name="responsible_id"/>
                <field name="is_completed"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_merch_calendar_event_calendar" model="ir.ui.view">
        <field name="name">garment.merch.calendar.event.calendar</field>
        <field name="model">garment.merch.calendar.event</field>
        <field name="arch" type="xml">
            <calendar string="Merchandising Calendar" date_start="event_date" color="event_type">
                <field name="name"/>
                <field name="buyer_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_garment_merch_calendar_event" model="ir.actions.act_window">
        <field name="name">Merchandising Calendar</field>
        <field name="res_model">garment.merch.calendar.event</field>
        <field name="view_mode">calendar,tree,form</field>
    </record>
</odoo>
