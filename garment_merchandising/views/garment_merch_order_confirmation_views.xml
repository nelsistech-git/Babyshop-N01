<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_merch_order_confirmation_tree" model="ir.ui.view">
        <field name="name">garment.merch.order.confirmation.tree</field>
        <field name="model">garment.merch.order.confirmation</field>
        <field name="arch" type="xml">
            <tree string="Order Confirmations" decoration-success="status == 'completed'" decoration-danger="status == 'cancelled'">
                <field name="order_number"/>
                <field name="buyer_po_number"/>
                <field name="buyer_id"/>
                <field name="style_id"/>
                <field name="quantity"/>
                <field name="fob_value"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_merch_order_confirmation_form" model="ir.ui.view">
        <field name="name">garment.merch.order.confirmation.form</field>
        <field name="model">garment.merch.order.confirmation</field>
        <field name="arch" type="xml">
            <form string="Order Confirmation">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_create_handover" type="object" string="Create Production Handover" class="btn-secondary"
                            invisible="status == 'draft'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="order_number" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="buyer_po_number"/>
                            <field name="quotation_id"/>
                            <field name="buyer_id"/>
                            <field name="style_id"/>
                            <field name="color"/>
                            <field name="order_date"/>
                            <field name="merchandiser_id"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="fob_value" readonly="1"/>
                            <field name="payment_term_id"/>
                            <field name="incoterm_id"/>
                            <field name="delivery_date"/>
                            <field name="shipment_date"/>
                            <field name="factory"/>
                            <field name="production_unit"/>
                        </group>
                    </group>
                    <field name="size_breakdown"/>
                    <group string="Order Approval Workflow">
                        <field name="approval_stage" widget="statusbar"
                               statusbar_visible="draft,merchandiser,merchandising_manager,production_manager,commercial_manager,factory_head,approved"/>
                        <button name="action_next_approval_stage" type="object" string="Advance Approval" class="btn-secondary"
                                invisible="approval_stage == 'approved'"/>
                    </group>
                    <group col="4">
                        <field name="merchandiser_approver_id"/>
                        <field name="merchandiser_approved_date" readonly="1"/>
                        <field name="merchandising_manager_id"/>
                        <field name="merchandising_manager_approved_date" readonly="1"/>
                        <field name="production_manager_id"/>
                        <field name="production_manager_approved_date" readonly="1"/>
                        <field name="commercial_manager_id"/>
                        <field name="commercial_manager_approved_date" readonly="1"/>
                        <field name="factory_head_id"/>
                        <field name="factory_head_approved_date" readonly="1"/>
                    </group>
                    <field name="handover_ids">
                        <tree>
                            <field name="handover_number"/>
                            <field name="handover_date"/>
                            <field name="status"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_merch_order_confirmation" model="ir.actions.act_window">
        <field name="name">Order Confirmations</field>
        <field name="res_model">garment.merch.order.confirmation</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first order confirmation.</p>
        </field>
    </record>

</odoo>
