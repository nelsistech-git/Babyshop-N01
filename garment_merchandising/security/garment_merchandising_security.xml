<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_merch" model="ir.module.category">
            <field name="name">Smart Garment ERP - Merchandising</field>
            <field name="sequence">55</field>
        </record>

        <record id="group_merch_merchandiser" model="res.groups">
            <field name="name">Merchandiser (Manage Assigned Inquiries)</field>
            <field name="category_id" ref="module_category_garment_merch"/>
        </record>

        <record id="group_merch_planning_manager" model="res.groups">
            <field name="name">Planning Manager (Handover Review)</field>
            <field name="category_id" ref="module_category_garment_merch"/>
        </record>

        <record id="group_merch_production_manager" model="res.groups">
            <field name="name">Production Manager (Handover Acceptance)</field>
            <field name="category_id" ref="module_category_garment_merch"/>
        </record>

        <record id="group_merch_manager" model="res.groups">
            <field name="name">Merchandising Manager (Full Access)</field>
            <field name="category_id" ref="module_category_garment_merch"/>
            <field name="implied_ids" eval="[(4, ref('group_merch_merchandiser'))]"/>
        </record>

        <record id="group_merch_top_management" model="res.groups">
            <field name="name">Top Management (MD - Dashboard &amp; Reports)</field>
            <field name="category_id" ref="module_category_garment_merch"/>
            <field name="implied_ids" eval="[(4, ref('group_merch_manager')),
                                              (4, ref('group_merch_planning_manager')),
                                              (4, ref('group_merch_production_manager'))]"/>
        </record>

        <record id="rule_garment_merch_inquiry_own" model="ir.rule">
            <field name="name">Merchandiser: Assigned Inquiries Only</field>
            <field name="model_id" ref="model_garment_merch_inquiry"/>
            <field name="domain_force">[('assigned_merchandiser_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_merch_merchandiser'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_merch_inquiry_manager" model="ir.rule">
            <field name="name">Manager: All Inquiries</field>
            <field name="model_id" ref="model_garment_merch_inquiry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_merch_manager'))]"/>
        </record>

        <record id="rule_garment_merch_task_own" model="ir.rule">
            <field name="name">Merchandiser: Assigned Tasks Only</field>
            <field name="model_id" ref="model_garment_merch_task"/>
            <field name="domain_force">[('assigned_to_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_merch_merchandiser'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_merch_task_manager" model="ir.rule">
            <field name="name">Manager: All Tasks</field>
            <field name="model_id" ref="model_garment_merch_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_merch_manager'))]"/>
        </record>

        <record id="rule_garment_merch_portal_own_buyer" model="ir.rule">
            <field name="name">Portal Buyer: Own Quotations Only</field>
            <field name="model_id" ref="model_garment_merch_quotation"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.id),
                                        ('status', 'in', ['sent', 'buyer_review', 'negotiation', 'accepted', 'rejected'])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
