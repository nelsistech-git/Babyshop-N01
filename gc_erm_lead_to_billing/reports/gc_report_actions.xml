<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SRS 58 - printable documents. -->

    <record id="action_report_gc_lead" model="ir.actions.report">
        <field name="name">Lead Summary</field>
        <field name="model">gc.erm.lead</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gc_erm_lead_to_billing.report_gc_lead_document</field>
        <field name="report_file">gc_erm_lead_to_billing.report_gc_lead_document</field>
        <field name="print_report_name">'Lead - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_gc_erm_lead"/>
        <field name="binding_type">report</field>
    </record>

