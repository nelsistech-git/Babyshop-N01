<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_gc_installation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="gc_title" t-value="'INSTALLATION REPORT'"/>
                <t t-set="gc_date" t-value="doc.installation_date"/>
                <t t-set="gc_partner" t-value="doc.partner_id"/>
                <t t-set="gc_site" t-value="doc.service_location"/>
                <t t-call="web.internal_layout">
                    <div class="page">
                        <t t-call="gc_erm_lead_to_billing.gc_report_header"/>
                        <t t-call="gc_erm_lead_to_billing.gc_report_customer_block"/>

                        <table class="table table-sm">
                            <tr>
                                <td style="width:25%"><strong>Work Order</strong></td>
                                <td t-out="doc.work_order_id.name">GC-WO-00001</td>
                                <td style="width:25%"><strong>Visit Number</strong></td>
                                <td t-out="doc.visit_number">1</td>
                            </tr>
                            <tr>
                                <td><strong>Team</strong></td>
                                <td t-out="doc.team_id.display_name or '-'">-</td>
                                <td><strong>Engineer</strong></td>
                                <td t-out="doc.engineer_id.name">Engineer</td>
                            </tr>
                            <tr>
                                <td><strong>Start Time</strong></td>
                                <td t-out="doc.start_time or '-'">-</td>
                                <td><strong>End Time</strong></td>
                                <td t-out="doc.end_time or '-'">-</td>
                            </tr>
                            <tr>
                                <td><strong>Duration</strong></td>
                                <td><span t-out="doc.duration_hours">0</span> h</td>
                                <td><strong>Result</strong></td>
                                <td>
                                    <strong t-out="dict(doc._fields['result'].selection).get(doc.result, '-')">
                                        Successful
                                    </strong>
                                </td>
                            </tr>
                        </table>

                        <h5 class="mt-3" style="color:#17479e;">Installed Equipment</h5>
                        <table class="table table-sm table-bordered">
                            <thead style="background:#f2f4f8;">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end" style="width:9%">Qty</th>
                                    <th style="width:20%">Serial Number</th>
                                    <th style="width:16%">MAC</th>
                                    <th style="width:16%">IP</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td t-out="line.name or line.product_id.display_name">Product</td>
                                    <td class="text-end" t-out="line.quantity">1</td>
                                    <td t-out="line.serial_number or '-'">-</td>
                                    <td t-out="line.mac_address or '-'">-</td>
                                    <td t-out="line.ip_address or '-'">-</td>
                                </tr>
                            </tbody>
                        </table>

                        <h5 class="mt-3" style="color:#17479e;">Checklist</h5>
                        <table class="table table-sm table-bordered">
                            <thead style="background:#f2f4f8;">
                                <tr>
                                    <th style="width:5%">#</th>
                                    <th>Item</th>
                                    <th style="width:12%">Answer</th>
                                    <th style="width:32%">Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.checklist_line_ids" t-as="item">
                                    <td t-out="item_index + 1">1</td>
                                    <td t-out="item.name">Item</td>
                                    <td t-out="dict(item._fields['answer'].selection).get(item.answer, '-')">-</td>
                                    <td t-out="item.remarks or ''"/>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="doc.testing_results" class="mt-3">
                            <h5 style="color:#17479e;">Testing Results</h5>
                            <div t-field="doc.testing_results"/>
                        </div>
                        <div t-if="doc.ip_information" class="mt-3">
                            <h5 style="color:#17479e;">IP Information</h5>
                            <p t-out="doc.ip_information"/>
                        </div>
                        <div t-if="doc.remarks" class="mt-3">
                            <h5 style="color:#17479e;">Engineer Remarks</h5>
                            <p t-out="doc.remarks"/>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <div style="border-top:1px solid #333; padding-top:4px;">
                                    Engineer: <span t-out="doc.engineer_id.name">Engineer</span>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <img t-if="doc.customer_signature"
                                     t-att-src="image_data_uri(doc.customer_signature)"
                                     style="max-height:60px;" alt="Customer signature"/>
                                <div style="border-top:1px solid #333; padding-top:4px;">
                                    Customer:
                                    <span t-out="doc.customer_representative or '________'">-</span>
                                </div>
                            </div>
                        </div>

                        <t t-call="gc_erm_lead_to_billing.gc_report_footer"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_gc_revisit_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="gc_title" t-value="'REVISIT REPORT'"/>
                <t t-set="gc_date" t-value="doc.next_visit_date or doc.installation_date"/>
                <t t-set="gc_partner" t-value="doc.partner_id"/>
                <t t-set="gc_site" t-value="doc.service_location"/>
                <t t-call="web.internal_layout">
                    <div class="page">
                        <t t-call="gc_erm_lead_to_billing.gc_report_header"/>
                        <t t-call="gc_erm_lead_to_billing.gc_report_customer_block"/>

                        <table class="table table-sm">
                            <tr>
                                <td style="width:25%"><strong>Original Installation</strong></td>
                                <td t-out="doc.revisit_of_id.name or doc.name">GC-INS-00001</td>
                                <td style="width:25%"><strong>Visit Number</strong></td>
                                <td t-out="doc.visit_number">2</td>
                            </tr>
                            <tr>
                                <td><strong>Result</strong></td>
                                <td t-out="dict(doc._fields['result'].selection).get(doc.result, '-')">-</td>
                                <td><strong>Next Visit</strong></td>
                                <td t-out="doc.next_visit_date or '-'">-</td>
                            </tr>
                            <tr>
                                <td><strong>Assigned Engineer</strong></td>
                                <td colspan="3" t-out="doc.next_engineer_id.name or doc.engineer_id.name or '-'">-</td>
                            </tr>
                        </table>

                        <div t-if="doc.failure_reason" class="mt-3">
                            <h5 style="color:#17479e;">Reason</h5>
                            <p t-out="doc.failure_reason"/>
                        </div>
                        <div t-if="doc.required_action" class="mt-3">
                            <h5 style="color:#17479e;">Required Action</h5>
                            <p t-out="doc.required_action"/>
                        </div>

                        <div t-if="doc.revisit_ids" class="mt-3">
                            <h5 style="color:#17479e;">Follow-up Visits</h5>
                            <table class="table table-sm table-bordered">
                                <thead style="background:#f2f4f8;">
                                    <tr><th>Reference</th><th>Date</th><th>Engineer</th>
                                        <th>Result</th></tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.revisit_ids" t-as="rv">
                                        <td t-out="rv.name">GC-INS-00002</td>
                                        <td t-out="rv.installation_date">-</td>
                                        <td t-out="rv.engineer_id.name">-</td>
                                        <td t-out="dict(rv._fields['result'].selection).get(rv.result, '-')">-</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <t t-call="gc_erm_lead_to_billing.gc_report_footer"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
