<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_gc_work_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="gc_title" t-value="'WORK ORDER'"/>
                <t t-set="gc_date" t-value="doc.start_date or doc.create_date"/>
                <t t-set="gc_partner" t-value="doc.partner_id"/>
                <t t-set="gc_site" t-value="doc.service_location or doc.street"/>
                <t t-call="web.internal_layout">
                    <div class="page">
                        <t t-call="gc_erm_lead_to_billing.gc_report_header"/>
                        <t t-call="gc_erm_lead_to_billing.gc_report_customer_block"/>

                        <table class="table table-sm">
                            <tr>
                                <td style="width:25%"><strong>Sales Order</strong></td>
                                <td t-out="doc.sale_order_id.name">S00001</td>
                                <td style="width:25%"><strong>Status</strong></td>
                                <td t-out="dict(doc._fields['state'].selection).get(doc.state)">Draft</td>
                            </tr>
                            <tr>
                                <td><strong>Service</strong></td>
                                <td t-out="doc.service_summary or '-'">-</td>
                                <td><strong>Priority</strong></td>
                                <td t-out="dict(doc._fields['priority'].selection).get(doc.priority)">Normal</td>
                            </tr>
                            <tr>
                                <td><strong>Implementation Manager</strong></td>
                                <td t-out="doc.manager_id.name or '-'">-</td>
                                <td><strong>Team</strong></td>
                                <td t-out="doc.team_id.display_name or '-'">-</td>
                            </tr>
                            <tr>
                                <td><strong>Engineer</strong></td>
                                <td t-out="doc.engineer_id.name or '-'">-</td>
                                <td><strong>Technicians</strong></td>
                                <td t-out="', '.join(doc.technician_ids.mapped('name')) or '-'">-</td>
                            </tr>
                            <tr>
                                <td><strong>Start Date</strong></td>
                                <td t-out="doc.start_date or '-'">-</td>
                                <td><strong>Expected Completion</strong></td>
                                <td t-out="doc.expected_completion or '-'">-</td>
                            </tr>
                            <tr>
                                <td><strong>GPS</strong></td>
                                <td colspan="3">
                                    <span t-out="doc.gps_latitude"/>, <span t-out="doc.gps_longitude"/>
                                </td>
                            </tr>
                        </table>

                        <h5 class="mt-3" style="color:#17479e;">Required Materials</h5>
                        <table class="table table-sm table-bordered">
                            <thead style="background:#f2f4f8;">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end" style="width:12%">Required</th>
                                    <th class="text-end" style="width:12%">Available</th>
                                    <th class="text-end" style="width:12%">Shortage</th>
                                    <th style="width:14%">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td t-out="line.name or line.product_id.display_name">Product</td>
                                    <td class="text-end" t-out="line.required_qty">0</td>
                                    <td class="text-end" t-out="line.available_qty">0</td>
                                    <td class="text-end" t-out="line.shortage_qty">0</td>
                                    <td t-out="dict(line._fields['availability'].selection).get(line.availability, '-')">-</td>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="doc.installation_requirements" class="mt-3">
                            <h5 style="color:#17479e;">Installation Requirements</h5>
                            <div t-field="doc.installation_requirements"/>
                        </div>
                        <div t-if="doc.special_requirements" class="mt-3">
                            <h5 style="color:#17479e;">Special Requirements</h5>
                            <p t-out="doc.special_requirements"/>
                        </div>
                        <div t-if="doc.remarks" class="mt-3">
                            <h5 style="color:#17479e;">Remarks</h5>
                            <p t-out="doc.remarks"/>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <div style="border-top:1px solid #333; padding-top:4px;">
                                    Issued by
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <div style="border-top:1px solid #333; padding-top:4px;">
                                    Received by (team)
                                </div>
                            </div>
                        </div>

                        <t t-call="gc_erm_lead_to_billing.gc_report_footer"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_gc_material_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="gc_title" t-value="'MATERIAL REQUIREMENT'"/>
                <t t-set="gc_date" t-value="doc.last_stock_check or doc.create_date"/>
                <t t-set="gc_partner" t-value="doc.partner_id"/>
                <t t-call="web.internal_layout">
                    <div class="page">
                        <t t-call="gc_erm_lead_to_billing.gc_report_header"/>

                        <table class="table table-sm">
                            <tr>
                                <td style="width:25%"><strong>Work Order</strong></td>
                                <td t-out="doc.name">GC-WO-00001</td>
                                <td style="width:25%"><strong>Warehouse</strong></td>
                                <td t-out="doc.warehouse_id.name or '-'">-</td>
                            </tr>
                            <tr>
                                <td><strong>Material Status</strong></td>
                                <td t-out="dict(doc._fields['material_state'].selection).get(doc.material_state, '-')">-</td>
                                <td><strong>Last Check</strong></td>
                                <td t-out="doc.last_stock_check or '-'">-</td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered mt-3">
                            <thead style="background:#f2f4f8;">
                                <tr>
                                    <th>Product</th>
                                    <th style="width:10%">UoM</th>
                                    <th class="text-end" style="width:13%">Required</th>
                                    <th class="text-end" style="width:13%">Available</th>
                                    <th class="text-end" style="width:13%">Reserved</th>
                                    <th class="text-end" style="width:13%">Shortage</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td t-out="line.product_id.display_name">Product</td>
                                    <td t-out="line.uom_id.name or ''"/>
                                    <td class="text-end" t-out="line.required_qty">0</td>
                                    <td class="text-end" t-out="line.available_qty">0</td>
                                    <td class="text-end" t-out="line.reserved_qty">0</td>
                                    <td class="text-end" t-out="line.shortage_qty">0</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="background:#f2f4f8;">
                                    <td colspan="2"><strong>Total</strong></td>
                                    <td class="text-end"><strong t-out="doc.total_required_qty">0</strong></td>
                                    <td class="text-end"><strong t-out="doc.total_available_qty">0</strong></td>
                                    <td class="text-end"></td>
                                    <td class="text-end"><strong t-out="doc.total_shortage_qty">0</strong></td>
                                </tr>
                            </tfoot>
                        </table>

                        <t t-call="gc_erm_lead_to_billing.gc_report_footer"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
