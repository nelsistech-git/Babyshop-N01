<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gc_invoice_wizard_form" model="ir.ui.view">
        <field name="name">gc.erm.invoice.wizard.form</field>
        <field name="model">gc.erm.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Invoice">
                <group>
                    <group string="Work Order">
                        <field name="work_order_id" readonly="1"/>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="billing_policy" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Amounts">
                        <field name="amount_total" readonly="1"/>
                        <field name="amount_invoiced" readonly="1"/>
                        <field name="amount_remaining" readonly="1"/>
                    </group>
                </group>
                <group>
                    <group string="Invoice">
                        <field name="milestone"/>
                        <field name="invoice_percent"/>
                        <field name="invoice_date"/>
                        <field name="post_invoice"/>
                    </group>
                    <group string="Note">
                        <field name="narration" nolabel="1"
                               placeholder="Optional note printed on the invoice..."/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_invoice" type="object"
                            string="Create Invoice" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
