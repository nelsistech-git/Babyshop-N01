<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gc_survey_assign_wizard_form" model="ir.ui.view">
        <field name="name">gc.erm.survey.assign.wizard.form</field>
        <field name="model">gc.erm.survey.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Survey">
                <group>
                    <group>
                        <field name="survey_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="team_id" options="{'no_create': True}"/>
                        <field name="engineer_id" widget="many2one_avatar_user"/>
                    </group>
                    <group>
                        <field name="survey_date"/>
                        <field name="deadline"/>
                        <field name="priority" widget="priority"/>
                    </group>
                </group>
                <group string="Instructions to the Engineer">
                    <field name="note" nolabel="1"
                           placeholder="Access constraints, contact on site, what to verify..."/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
