<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         FORM (SRS 9 / 10 / 11 / 46)
         ================================================================ -->
    <record id="view_gc_lead_form" model="ir.ui.view">
        <field name="name">gc.erm.lead.form</field>
        <field name="model">gc.erm.lead</field>
        <field name="arch" type="xml">
            <form string="Lead">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="state != 'draft'"
                            help="Sends the lead to the Sales HOD for approval."/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'hod_approval'"
                            groups="gc_erm_lead_to_billing.group_gc_sales_hod"
                            confirm="Approve this lead and allow the survey to be generated?"/>
                    <button name="action_gc_request_revision" type="object"
                            string="Request Revision" invisible="state != 'hod_approval'"
                            groups="gc_erm_lead_to_billing.group_gc_sales_hod"/>
                    <button name="action_gc_reject" type="object" string="Reject"
                            invisible="state != 'hod_approval'"
                            groups="gc_erm_lead_to_billing.group_gc_sales_hod"/>
                    <button name="action_create_survey" type="object" string="Create Survey"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'approved')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,hod_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_surveys" type="object" class="oe_stat_button"
                                icon="fa-clipboard" invisible="survey_count == 0">
                            <field name="survey_count" widget="statinfo" string="Surveys"/>
                        </button>
                        <button name="action_view_proposals" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="proposal_count == 0">
                            <field name="proposal_count" widget="statinfo" string="Proposals"/>
                        </button>
                        <button name="action_view_quotations" type="object" class="oe_stat_button"
                                icon="fa-file-o" invisible="quotation_count == 0">
                            <field name="quotation_count" widget="statinfo" string="Quotations"/>
                        </button>
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart" invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Sales Orders"/>
                        </button>
                        <button name="action_view_work_orders" type="object" class="oe_stat_button"
                                icon="fa-wrench" invisible="work_order_count == 0">
                            <field name="work_order_count" widget="statinfo" string="Work Orders"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-money" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_gc_view_status_history" type="object"
                                class="oe_stat_button" icon="fa-history"
                                groups="gc_erm_lead_to_billing.group_gc_sales_hod">
                            <field name="status_history_count" widget="statinfo" string="History"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success"
                            invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="not revision_reason">
                        <strong>Revision requested:</strong> <field name="revision_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'rejected'">
                        <strong>Rejected:</strong> <field name="rejection_reason" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Customer">
                            <field name="partner_id" required="state != 'draft'"
                                   readonly="state not in ('draft',)"
                                   options="{'no_quick_create': True}"/>
                            <field name="contact_id" readonly="state not in ('draft',)"
                                   options="{'no_quick_create': True}"/>
                            <field name="crm_lead_id" groups="base.group_no_one"/>
                        </group>
                        <group string="Sales">
                            <field name="lead_date" readonly="state not in ('draft',)"/>
                            <field name="salesperson_id" widget="many2one_avatar_user"
                                   readonly="state not in ('draft',)"/>
                            <field name="team_id"/>
                            <field name="source_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Opportunity">
                            <field name="expected_revenue" widget="monetary"
                                   readonly="state not in ('draft',)"/>
                            <field name="date_deadline"/>
                            <field name="expected_golive_date"/>
                            <field name="contract_duration" readonly="state not in ('draft',)"/>
                        </group>
                        <group string="SLA">
                            <field name="sla_deadline" readonly="1"/>
                            <field name="sla_state" widget="badge"
                                   decoration-success="sla_state == 'on_time'"
                                   decoration-warning="sla_state == 'at_risk'"
                                   decoration-danger="sla_state == 'overdue'"/>
                            <field name="days_open"/>
                            <field name="survey_required"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Requirement" name="requirement">
                            <field name="service_line_ids" readonly="state not in ('draft',)">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="service_id" options="{'no_create': True}"/>
                                    <field name="product_id" optional="show"
                                           options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" groups="uom.group_uom" optional="hide"/>
                                    <field name="bandwidth"/>
                                    <field name="remarks" optional="show"/>
                                </tree>
                            </field>
                            <separator string="Requirement / Description"/>
                            <field name="description" readonly="state not in ('draft',)"
                                   placeholder="Describe what the customer asked for..."/>
                        </page>

                        <page string="Contact Details" name="contact">
                            <group>
                                <group>
                                    <field name="contact_person"/>
                                    <field name="contact_designation"/>
                                </group>
                                <group>
                                    <field name="contact_phone" widget="phone"/>
                                    <field name="contact_phone_alt" widget="phone"/>
                                    <field name="contact_email" widget="email"/>
                                </group>
                            </group>
                        </page>

                        <page string="Location" name="location">
                            <group>
                                <group string="Address">
                                    <field name="street" placeholder="Street..."/>
                                    <field name="street2" placeholder="Street 2..."/>
                                    <field name="city" placeholder="City"/>
                                    <field name="district"/>
                                    <field name="area"/>
                                    <field name="zip_code"/>
                                    <field name="state_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="country_id" options="{'no_open': True, 'no_create': True}"/>
                                </group>
                                <group string="GPS / Service Location">
                                    <field name="service_location"/>
                                    <field name="gps_latitude"/>
                                    <field name="gps_longitude"/>
                                    <field name="map_url" widget="url" readonly="1"
                                           text="Open in map" invisible="not map_url"/>
                                </group>
                            </group>
                        </page>

                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"
                                   string="LOI, layout, location map, customer documents"/>
                        </page>

                        <page string="Audit" name="audit"
                              groups="gc_erm_lead_to_billing.group_gc_sales_hod">
                            <group>
                                <group string="Submission">
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_date"/>
                                </group>
                                <group string="Decision">
                                    <field name="approved_by_id"/>
                                    <field name="approved_date"/>
                                    <field name="rejected_by_id"/>
                                    <field name="rejected_date"/>
                                </group>
                            </group>
                            <separator string="Status History"/>
                            <field name="status_history_ids" readonly="1">
                                <tree>
                                    <field name="change_date"/>
                                    <field name="old_state_label" string="From"/>
                                    <field name="new_state_label" string="To"/>
                                    <field name="user_id"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================================
         TREE
         ================================================================ -->
    <record id="view_gc_lead_tree" model="ir.ui.view">
        <field name="name">gc.erm.lead.tree</field>
        <field name="model">gc.erm.lead</field>
        <field name="arch" type="xml">
            <tree string="Leads" sample="1"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="state == 'rejected' or sla_state == 'overdue'"
                  decoration-warning="state == 'hod_approval'"
                  decoration-success="state == 'approved'">
                <field name="priority" widget="priority" nolabel="1"/>
                <field name="name"/>
                <field name="lead_date"/>
                <field name="partner_id"/>
                <field name="contact_person" optional="hide"/>
                <field name="district" optional="show"/>
                <field name="salesperson_id" widget="many2one_avatar_user" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="expected_revenue" sum="Expected Revenue" optional="show"/>
                <field name="date_deadline" optional="hide"/>
                <field name="sla_state" widget="badge" optional="show"
                       decoration-success="sla_state == 'on_time'"
                       decoration-warning="sla_state == 'at_risk'"
                       decoration-danger="sla_state == 'overdue'"/>
                <field name="survey_count" string="Surveys" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'hod_approval'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================
         KANBAN
         ================================================================ -->
    <record id="view_gc_lead_kanban" model="ir.ui.view">
        <field name="name">gc.erm.lead.kanban</field>
        <field name="model">gc.erm.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1"
                    quick_create="false">
                <field name="state"/>
                <field name="currency_id"/>
                <field name="activity_state"/>
                <field name="sla_state"/>
                <progressbar field="sla_state"
                             colors='{"on_time": "success", "at_risk": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_gc_kanban_card">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title o_gc_kanban_title">
                                        <field name="partner_id"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="name"/>
                                    </small>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body o_gc_kanban_meta">
                                <div t-if="record.district.raw_value">
                                    <i class="fa fa-map-marker me-1" title="District"/>
                                    <field name="district"/>
                                    <t t-if="record.area.raw_value"> - <field name="area"/></t>
                                </div>
                                <div t-if="record.expected_revenue.raw_value">
                                    <i class="fa fa-money me-1" title="Expected revenue"/>
                                    <field name="expected_revenue" widget="monetary"/>
                                </div>
                                <div t-if="record.date_deadline.raw_value">
                                    <i class="fa fa-clock-o me-1" title="Expected closing"/>
                                    <field name="date_deadline"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                    <span class="badge rounded-pill text-bg-danger ms-1"
                                          t-if="record.sla_state.raw_value == 'overdue'">Overdue</span>
                                    <span class="badge rounded-pill text-bg-warning ms-1"
                                          t-if="record.sla_state.raw_value == 'at_risk'">At risk</span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="salesperson_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         SEARCH (SRS 74)
         ================================================================ -->
    <record id="view_gc_lead_search" model="ir.ui.view">
        <field name="name">gc.erm.lead.search</field>
        <field name="model">gc.erm.lead</field>
        <field name="arch" type="xml">
            <search string="Leads">
                <field name="name" string="Lead"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('contact_person', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="salesperson_id"/>
                <field name="team_id"/>
                <field name="service_ids" string="Service"/>
                <field name="district"/>
                <filter name="filter_my" string="My Leads" domain="[('salesperson_id', '=', uid)]"/>
                <filter name="filter_my_team" string="My Team"
                        domain="[('team_id.member_ids', 'in', [uid])]"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_pending" string="Pending Approval"
                        domain="[('state', '=', 'hod_approval')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_overdue" string="Overdue (SLA)"
                        domain="[('sla_state', '=', 'overdue')]"/>
                <filter name="filter_no_survey" string="Without Survey"
                        domain="[('survey_ids', '=', False), ('state', '=', 'approved')]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('lead_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_week" string="This Week"
                        domain="[('lead_date', '&gt;=', (context_today() - relativedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_month" string="This Month"
                        domain="[('lead_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="filter_year" string="This Year"
                        domain="[('lead_date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <separator/>
                <filter name="filter_lead_date" string="Lead Date" date="lead_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_salesperson" string="Salesperson"
                            context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source_id'}"/>
                    <filter name="group_district" string="District" context="{'group_by': 'district'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                    <filter name="group_month" string="Lead Month"
                            context="{'group_by': 'lead_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Analysis views (SRS 48 / 57) -->
    <record id="view_gc_lead_pivot" model="ir.ui.view">
        <field name="name">gc.erm.lead.pivot</field>
        <field name="model">gc.erm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Lead Analysis" sample="1">
                <field name="salesperson_id" type="row"/>
                <field name="state" type="col"/>
                <field name="expected_revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_gc_lead_graph" model="ir.ui.view">
        <field name="name">gc.erm.lead.graph</field>
        <field name="model">gc.erm.lead</field>
        <field name="arch" type="xml">
            <graph string="Lead Analysis" type="bar" sample="1">
                <field name="lead_date" interval="month"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_gc_lead_calendar" model="ir.ui.view">
        <field name="name">gc.erm.lead.calendar</field>
        <field name="model">gc.erm.lead</field>
        <field name="arch" type="xml">
            <calendar string="Leads" date_start="lead_date" color="salesperson_id" mode="month">
                <field name="partner_id"/>
                <field name="expected_revenue"/>
            </calendar>
        </field>
    </record>

    <!-- ================================================================
         ACTIONS
         ================================================================ -->
    <record id="action_gc_lead" model="ir.actions.act_window">
        <field name="name">Leads</field>
        <field name="res_model">gc.erm.lead</field>
        <field name="view_mode">kanban,tree,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="view_gc_lead_search"/>
        <field name="context">{'search_default_filter_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first lead</p>
            <p>A lead captures the customer requirement. Once the Sales HOD approves
               it, you can generate the technical survey.</p>
        </field>
    </record>

    <record id="action_gc_lead_approval" model="ir.actions.act_window">
        <field name="name">Leads to Approve</field>
        <field name="res_model">gc.erm.lead</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_gc_lead_search"/>
        <field name="domain">[('state', '=', 'hod_approval')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for your approval</p>
            <p>Leads submitted by the sales team appear here.</p>
        </field>
    </record>

</odoo>