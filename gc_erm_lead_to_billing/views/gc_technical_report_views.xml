<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gc_technical_report_form" model="ir.ui.view">
        <field name="name">gc.erm.technical.report.form</field>
        <field name="model">gc.erm.technical.report</field>
        <field name="arch" type="xml">
            <form string="Technical Report">
                <header>
                    <button name="action_submit" type="object" string="Submit Report"
                            class="btn-primary" invisible="state not in ('draft', 'rejected')"
                            groups="gc_erm_lead_to_billing.group_gc_technical_user"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'review'"
                            groups="gc_erm_lead_to_billing.group_gc_technical_manager"/>
                    <button name="action_gc_request_revision" type="object"
                            string="Request Revision" invisible="state not in ('review', 'submitted')"
                            groups="gc_erm_lead_to_billing.group_gc_technical_manager"/>
                    <button name="action_gc_reject" type="object" string="Reject"
                            invisible="state != 'review'"
                            groups="gc_erm_lead_to_billing.group_gc_technical_manager"/>
                    <button name="action_create_proposal" type="object" string="Create Proposal"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="gc_erm_lead_to_billing.group_gc_sales_user"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'submitted')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,submitted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_survey" type="object" class="oe_stat_button"
                                icon="fa-clipboard">
                            <div class="o_stat_info"><span class="o_stat_text">Survey</span></div>
                        </button>
                        <button name="action_view_boq" type="object" class="oe_stat_button"
                                icon="fa-list-alt" invisible="not boq_id">
                            <div class="o_stat_info"><span class="o_stat_text">BOQ</span></div>
                        </button>
                        <button name="action_view_proposals" type="object" class="oe_stat_button"
                                icon="fa-handshake-o" invisible="proposal_count == 0">
                            <field name="proposal_count" widget="statinfo" string="Proposals"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Submitted" bg_color="text-bg-success"
                            invisible="state != 'submitted'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Not Feasible" bg_color="text-bg-danger"
                            invisible="feasibility != 'not_feasible'"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-danger" role="alert" invisible="not rejection_reason">
                        <strong>Rejected:</strong> <field name="rejection_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not revision_reason">
                        <strong>Revision requested:</strong> <field name="revision_reason" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Reference">
                            <field name="survey_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="engineer_id" widget="many2one_avatar_user"/>
                            <field name="salesperson_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Assessment">
                            <field name="survey_date" readonly="1"/>
                            <field name="report_date"/>
                            <field name="feasibility"/>
                            <field name="review_required"/>
                            <field name="sla_state" widget="badge"
                                   decoration-success="sla_state == 'on_time'"
                                   decoration-warning="sla_state == 'at_risk'"
                                   decoration-danger="sla_state == 'overdue'"/>
                        </group>
                    </group>

                    <group string="Costing" invisible="feasibility == 'not_feasible'">
                        <group>
                            <field name="boq_id" options="{'no_create': True}"
                                   required="feasibility != 'not_feasible' and state == 'submitted'"
                                   readonly="state not in ('draft', 'rejected')"/>
                            <field name="boq_state" widget="badge"/>
                        </group>
                        <group>
                            <field name="total_cost"/>
                            <field name="amount_untaxed"/>
                            <field name="amount_total"/>
                            <field name="margin_percentage" widget="percentage"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Technical Findings" name="findings">
                            <field name="technical_findings"
                                   placeholder="Summarise what was found on site..."/>
                            <group>
                                <group string="Implementation">
                                    <field name="implementation_timeline"/>
                                    <field name="implementation_days"/>
                                </group>
                            </group>
                            <separator string="Required Equipment"/>
                            <field name="required_equipment" nolabel="1"/>
                        </page>

                        <page string="Scope &amp; Risks" name="scope">
                            <separator string="Installation Scope"/>
                            <field name="installation_scope"/>
                            <separator string="Technical Risks"/>
                            <field name="technical_risks" nolabel="1"/>
                            <separator string="Recommendations"/>
                            <field name="recommendations"/>
                        </page>

                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"
                                   string="Drawings, photos, test results"/>
                        </page>

                        <page string="Audit" name="audit">
                            <group>
                                <group>
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_date"/>
                                </group>
                                <group>
                                    <field name="reviewed_by_id"/>
                                    <field name="reviewed_date"/>
                                    <field name="approved_by_id"/>
                                    <field name="approved_date"/>
                                </group>
                            </group>
                            <field name="status_history_ids" readonly="1">
                                <tree>
                                    <field name="change_date"/>
                                    <field name="old_state_label" string="From"/>
                                    <field name="new_state_label" string="To"/>
                                    <field name="user_id"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_gc_technical_report_tree" model="ir.ui.view">
        <field name="name">gc.erm.technical.report.tree</field>
        <field name="model">gc.erm.technical.report</field>
        <field name="arch" type="xml">
            <tree string="Technical Reports" sample="1"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="state == 'rejected'"
                  decoration-success="state == 'submitted'">
                <field name="name"/>
                <field name="report_date"/>
                <field name="partner_id"/>
                <field name="survey_id" optional="show"/>
                <field name="engineer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="feasibility" widget="badge"
                       decoration-success="feasibility == 'feasible'"
                       decoration-warning="feasibility in ('conditional', 'investigate')"
                       decoration-danger="feasibility == 'not_feasible'"/>
                <field name="total_cost" sum="Cost" optional="show"/>
                <field name="amount_total" sum="Selling Price" optional="show"/>
                <field name="margin_percentage" string="Margin %" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'review')"
                       decoration-success="state == 'submitted'"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_gc_technical_report_search" model="ir.ui.view">
        <field name="name">gc.erm.technical.report.search</field>
        <field name="model">gc.erm.technical.report</field>
        <field name="arch" type="xml">
            <search string="Technical Reports">
                <field name="name"
                       filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="engineer_id"/>
                <field name="survey_id"/>
                <filter name="filter_mine" string="My Reports" domain="[('engineer_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_review" string="Pending Review"
                        domain="[('state', '=', 'review')]"/>
                <filter name="filter_submitted" string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="filter_feasible" string="Feasible"
                        domain="[('feasibility', '=', 'feasible')]"/>
                <filter name="filter_not_feasible" string="Not Feasible"
                        domain="[('feasibility', '=', 'not_feasible')]"/>
                <filter name="filter_no_proposal" string="Without Proposal"
                        domain="[('state', '=', 'submitted'), ('proposal_ids', '=', False)]"/>
                <separator/>
                <filter name="filter_report_date" string="Report Date" date="report_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_engineer" string="Engineer" context="{'group_by': 'engineer_id'}"/>
                    <filter name="group_feasibility" string="Feasibility"
                            context="{'group_by': 'feasibility'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Report Month"
                            context="{'group_by': 'report_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gc_technical_report" model="ir.actions.act_window">
        <field name="name">Technical Reports</field>
        <field name="res_model">gc.erm.technical.report</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_gc_technical_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No technical report yet</p>
            <p>The technical report carries the feasibility, the BOQ and the costing
               back to Sales so that a proposal can be prepared.</p>
        </field>
    </record>

</odoo>
