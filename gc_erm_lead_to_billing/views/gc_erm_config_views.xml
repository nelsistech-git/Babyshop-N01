<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         SERVICE CATEGORY
         ================================================================ -->
    <record id="view_gc_service_category_tree" model="ir.ui.view">
        <field name="name">gc.erm.service.category.tree</field>
        <field name="model">gc.erm.service.category</field>
        <field name="arch" type="xml">
            <tree string="Service Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_gc_service_category" model="ir.actions.act_window">
        <field name="name">Service Categories</field>
        <field name="res_model">gc.erm.service.category</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first service category</p>
            <p>Categories group the services of the catalog, for example Connectivity or Hosting.</p>
        </field>
    </record>

    <!-- ================================================================
         SERVICE CATALOG (SRS 8.3)
         ================================================================ -->
    <record id="view_gc_service_catalog_tree" model="ir.ui.view">
        <field name="name">gc.erm.service.catalog.tree</field>
        <field name="model">gc.erm.service.catalog</field>
        <field name="arch" type="xml">
            <tree string="Service Catalog" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="pricing_rule" optional="show"/>
                <field name="default_margin" optional="show"/>
                <field name="billing_policy" optional="show"/>
                <field name="survey_required" widget="boolean_toggle" optional="show"/>
                <field name="installation_required" widget="boolean_toggle" optional="show"/>
                <field name="default_duration" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_gc_service_catalog_form" model="ir.ui.view">
        <field name="name">gc.erm.service.catalog.form</field>
        <field name="model">gc.erm.service.catalog</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Dedicated Internet Bandwidth"/></h1>
                        <h3><field name="code" placeholder="e.g. INT"/></h3>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="category_id"/>
                            <field name="product_id"/>
                            <field name="uom_id" groups="uom.group_uom"/>
                            <field name="default_duration"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Process Requirements">
                            <field name="survey_required"/>
                            <field name="installation_required"/>
                            <field name="billing_policy"/>
                        </group>
                    </group>
                    <group string="Default Pricing Rule (SRS 18)">
                        <group>
                            <field name="pricing_rule"/>
                            <field name="default_margin"
                                   help="Fixed amount, or percentage depending on the rule."/>
                        </group>
                    </group>
                    <group string="Milestone Split" invisible="billing_policy != 'milestone'">
                        <group>
                            <field name="advance_percent"/>
                            <field name="installation_percent"/>
                            <field name="completion_percent"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                The three percentages must add up to 100%.
                            </div>
                        </group>
                    </group>
                    <group string="Advance Split" invisible="billing_policy != 'advance_final'">
                        <field name="advance_percent" string="Advance %"/>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Internal description of the service..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_gc_service_catalog_search" model="ir.ui.view">
        <field name="name">gc.erm.service.catalog.search</field>
        <field name="model">gc.erm.service.catalog</field>
        <field name="arch" type="xml">
            <search string="Services">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="category_id"/>
                <filter name="filter_survey" string="Survey Required" domain="[('survey_required', '=', True)]"/>
                <filter name="filter_install" string="Installation Required" domain="[('installation_required', '=', True)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_policy" string="Billing Policy" context="{'group_by': 'billing_policy'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gc_service_catalog" model="ir.actions.act_window">
        <field name="name">Service Catalog</field>
        <field name="res_model">gc.erm.service.catalog</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_gc_service_catalog_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first service</p>
            <p>The service catalog drives whether a survey and an installation are
               required, and which billing policy and margin apply by default.</p>
        </field>
    </record>

    <!-- ================================================================
         TEAMS (SRS 14 / 29)
         ================================================================ -->
    <record id="view_gc_team_tree" model="ir.ui.view">
        <field name="name">gc.erm.team.tree</field>
        <field name="model">gc.erm.team</field>
        <field name="arch" type="xml">
            <tree string="Teams">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="team_type"/>
                <field name="leader_id"/>
                <field name="member_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_gc_team_form" model="ir.ui.view">
        <field name="name">gc.erm.team.form</field>
        <field name="model">gc.erm.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Dhaka Field Team A"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="team_type"/>
                            <field name="leader_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="member_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids" widget="many2many_avatar_user"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Coverage area, skills, shift..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gc_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">gc.erm.team</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first team</p>
            <p>Technical teams perform surveys, implementation teams perform installations.</p>
        </field>
    </record>

    <!-- ================================================================
         CHECKLIST TEMPLATES (SRS 37)
         ================================================================ -->
    <record id="view_gc_checklist_template_tree" model="ir.ui.view">
        <field name="name">gc.erm.checklist.template.tree</field>
        <field name="model">gc.erm.checklist.template</field>
        <field name="arch" type="xml">
            <tree string="Checklist Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="item_count"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_gc_checklist_template_form" model="ir.ui.view">
        <field name="name">gc.erm.checklist.template.form</field>
        <field name="model">gc.erm.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Standard Installation Checklist"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_default"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="item_count" invisible="1"/>
                        </group>
                        <group>
                            <field name="service_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist Items" name="items">
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="mandatory" widget="boolean_toggle"/>
                                    <field name="help_text" optional="show"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gc_checklist_template" model="ir.actions.act_window">
        <field name="name">Installation Checklists</field>
        <field name="res_model">gc.erm.checklist.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first checklist</p>
            <p>Checklists are copied onto every installation record and must be
               completed before the installation report can be submitted.</p>
        </field>
    </record>

    <!-- ================================================================
         APPROVAL MATRIX (SRS 59 / 60)
         ================================================================ -->
    <record id="view_gc_approval_matrix_tree" model="ir.ui.view">
        <field name="name">gc.erm.approval.matrix.tree</field>
        <field name="model">gc.erm.approval.matrix</field>
        <field name="arch" type="xml">
            <tree string="Approval Matrix" editable="bottom">
                <field name="document_type"/>
                <field name="amount_from"/>
                <field name="amount_to"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="approver_group_id" options="{'no_create': True}"/>
                <field name="approver_user_ids" widget="many2many_tags"
                       options="{'no_create': True}" optional="show"/>
                <field name="approval_required" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_gc_approval_matrix_form" model="ir.ui.view">
        <field name="name">gc.erm.approval.matrix.form</field>
        <field name="model">gc.erm.approval.matrix</field>
        <field name="arch" type="xml">
            <form string="Approval Rule">
                <sheet>
                    <group>
                        <group string="Scope">
                            <field name="document_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Amount Band">
                            <field name="amount_from"/>
                            <field name="amount_to"
                                   help="Leave at 0 for an open-ended upper limit."/>
                        </group>
                    </group>
                    <group string="Approver">
                        <group>
                            <field name="approver_group_id" options="{'no_create': True}"/>
                            <field name="approval_required"/>
                            <field name="notify"/>
                        </group>
                        <group>
                            <field name="approver_user_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gc_approval_matrix" model="ir.actions.act_window">
        <field name="name">Approval Matrix</field>
        <field name="res_model">gc.erm.approval.matrix</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your approval thresholds</p>
            <p>Each band routes a document to the group allowed to approve it,
               based on its amount.</p>
        </field>
    </record>

</odoo>
