<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gc_procurement_form" model="ir.ui.view">
        <field name="name">gc.erm.procurement.request.form</field>
        <field name="model">gc.erm.procurement.request</field>
        <field name="arch" type="xml">
            <form string="Procurement Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_accept" type="object" string="Accept"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="gc_erm_lead_to_billing.group_gc_purchase_user"/>
                    <button name="action_open_po_wizard" type="object"
                            string="Create RFQ" class="btn-primary"
                            invisible="state not in ('submitted', 'purchase_pending', 'rfq')"
                            groups="gc_erm_lead_to_billing.group_gc_purchase_user"/>
                    <button name="action_check_receipt" type="object"
                            string="Check Receipts"
                            invisible="state not in ('rfq', 'po', 'partial')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state in ('draft', 'received')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'received')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,purchase_pending,po,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_work_order" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <div class="o_stat_info"><span class="o_stat_text">Work Order</span></div>
                        </button>
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-credit-card"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="Purchases"/>
                        </button>
                        <button name="action_view_receipts" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Receipts"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Received" bg_color="text-bg-success"
                            invisible="state != 'received'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Request">
                            <field name="work_order_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="requested_by_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Planning">
                            <field name="request_date"/>
                            <field name="required_date"/>
                            <field name="priority" widget="priority"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="sla_state" widget="badge"
                                   decoration-success="sla_state == 'on_time'"
                                   decoration-warning="sla_state == 'at_risk'"
                                   decoration-danger="sla_state == 'overdue'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Shortage Lines" name="lines">
                            <field name="line_ids"
                                   readonly="state not in ('draft', 'submitted')">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="description"/>
                                    <field name="required_qty" optional="show"/>
                                    <field name="available_qty" optional="show"/>
                                    <field name="shortage_qty" sum="Shortage"/>
                                    <field name="ordered_qty" readonly="1" optional="show"/>
                                    <field name="received_qty" readonly="1" sum="Received"/>
                                    <field name="uom_id" groups="uom.group_uom" optional="hide"/>
                                    <field name="vendor_id" optional="show"/>
                                    <field name="estimated_price" optional="show"/>
                                    <field name="estimated_subtotal" readonly="1"
                                           sum="Estimated" optional="show"/>
                                    <field name="remarks" optional="hide"/>
                                    <field name="work_order_line_id" column_invisible="True"/>
                                </tree>
                            </field>
                            <group class="mt-2">
                                <group>
                                    <field name="total_shortage_qty"/>
                                    <field name="total_received_qty"/>
                                    <field name="receipt_progress" widget="progressbar"/>
                                </group>
                                <group class="oe_subtotal_footer">
                                    <field name="estimated_amount" widget="monetary"/>
                                </group>
                            </group>
                        </page>

                        <page string="Remarks" name="remarks">
                            <field name="remarks" nolabel="1"/>
                        </page>

                        <page string="Audit" name="audit">
                            <field name="status_history_ids" readonly="1">
                                <tree>
                                    <field name="change_date"/>
                                    <field name="old_state_label" string="From"/>
                                    <field name="new_state_label" string="To"/>
                                    <field name="user_id"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_gc_procurement_tree" model="ir.ui.view">
        <field name="name">gc.erm.procurement.request.tree</field>
        <field name="model">gc.erm.procurement.request</field>
        <field name="arch" type="xml">
            <tree string="Procurement Requests" sample="1"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'received'"
                  decoration-warning="state in ('submitted', 'purchase_pending')">
                <field name="priority" widget="priority" nolabel="1"/>
                <field name="name"/>
                <field name="request_date"/>
                <field name="work_order_id" optional="show"/>
                <field name="partner_id"/>
                <field name="required_date" optional="show"/>
                <field name="requested_by_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="total_shortage_qty" sum="Shortage" optional="show"/>
                <field name="total_received_qty" sum="Received" optional="show"/>
                <field name="receipt_progress" widget="progressbar" optional="show"/>
                <field name="estimated_amount" sum="Estimated" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'rfq', 'po')"
                       decoration-warning="state in ('submitted', 'purchase_pending', 'partial')"
                       decoration-success="state == 'received'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_gc_procurement_kanban" model="ir.ui.view">
        <field name="name">gc.erm.procurement.request.kanban</field>
        <field name="model">gc.erm.procurement.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1"
                    quick_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_gc_kanban_card">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_gc_kanban_title"><field name="name"/></strong>
                                    <small class="text-muted d-block"><field name="partner_id"/></small>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body o_gc_kanban_meta">
                                <div>
                                    <i class="fa fa-cubes me-1" title="Shortage"/>
                                    <field name="total_shortage_qty"/> to procure
                                </div>
                                <div t-if="record.required_date.raw_value">
                                    <i class="fa fa-calendar me-1" title="Required date"/>
                                    <field name="required_date"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="requested_by_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gc_procurement_search" model="ir.ui.view">
        <field name="name">gc.erm.procurement.request.search</field>
        <field name="model">gc.erm.procurement.request</field>
        <field name="arch" type="xml">
            <search string="Procurement Requests">
                <field name="name"
                       filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="work_order_id"/>
                <field name="partner_id"/>
                <field name="requested_by_id"/>
                <filter name="filter_mine" string="My Requests"
                        domain="[('requested_by_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_open" string="Open"
                        domain="[('state', 'not in', ('received', 'cancelled'))]"/>
                <filter name="filter_to_process" string="To Process"
                        domain="[('state', 'in', ('submitted', 'purchase_pending'))]"/>
                <filter name="filter_ordered" string="Ordered"
                        domain="[('state', 'in', ('rfq', 'po', 'partial'))]"/>
                <filter name="filter_received" string="Received"
                        domain="[('state', '=', 'received')]"/>
                <separator/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('required_date', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'not in', ('received', 'cancelled'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_wo" string="Work Order"
                            context="{'group_by': 'work_order_id'}"/>
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Request Month"
                            context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gc_procurement" model="ir.actions.act_window">
        <field name="name">Procurement Requests</field>
        <field name="res_model">gc.erm.procurement.request</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_gc_procurement_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No procurement request</p>
            <p>A procurement request is created from a work order whenever the
               required material is not available in stock.</p>
        </field>
    </record>

</odoo>
