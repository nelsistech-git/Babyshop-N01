<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gc_proposal_form" model="ir.ui.view">
        <field name="name">gc.erm.proposal.form</field>
        <field name="model">gc.erm.proposal</field>
        <field name="arch" type="xml">
            <form string="Proposal">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'hod_approval'"
                            groups="gc_erm_lead_to_billing.group_gc_sales_hod"
                            confirm="Approve this proposal? It becomes read-only afterwards."/>
                    <button name="action_gc_request_revision" type="object"
                            string="Request Revision" invisible="state != 'hod_approval'"
                            groups="gc_erm_lead_to_billing.group_gc_sales_hod"/>
                    <button name="action_gc_reject" type="object" string="Reject"
                            invisible="state != 'hod_approval'"
                            groups="gc_erm_lead_to_billing.group_gc_sales_hod"/>
                    <button name="action_create_quotation" type="object"
                            string="Create Quotation" class="btn-primary"
                            invisible="state != 'approved' or sale_order_id"/>
                    <button name="action_send_offer" type="object" string="Send Offer"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_open_acceptance_wizard" type="object"
                            string="Customer Accepted" class="btn-primary"
                            invisible="state not in ('approved', 'sent')"/>
                    <button name="action_customer_refused" type="object"
                            string="Customer Rejected"
                            invisible="state not in ('approved', 'sent')"
                            confirm="Mark this offer as rejected by the customer?"/>
                    <button name="action_create_revision" type="object" string="Create Revision"
                            invisible="state not in ('approved', 'sent', 'refused', 'rejected')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'refused', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'accepted', 'revised')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,hod_approval,approved,sent,accepted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not sale_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Quotation</span>
                                <span class="o_stat_value"><field name="sale_order_state"/></span>
                            </div>
                        </button>
                        <button name="action_view_work_orders" type="object"
                                class="oe_stat_button" icon="fa-wrench"
                                invisible="work_order_count == 0">
                            <field name="work_order_count" widget="statinfo" string="Work Orders"/>
                        </button>
                        <button name="action_view_revisions" type="object"
                                class="oe_stat_button" icon="fa-code-fork"
                                invisible="revision_count == 0">
                            <field name="revision_count" widget="statinfo" string="Revisions"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Accepted" bg_color="text-bg-success"
                            invisible="state != 'accepted'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state not in ('rejected', 'refused')"/>
                    <widget name="web_ribbon" title="Superseded" bg_color="text-bg-warning"
                            invisible="state != 'revised'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="not is_expired"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                            <span class="ms-2 text-muted">v<field name="version" readonly="1" class="oe_inline"/></span>
                        </h1>
                    </div>

                    <div class="alert alert-danger" role="alert" invisible="not rejection_reason">
                        <strong>Rejected:</strong> <field name="rejection_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not revision_reason">
                        <strong>Revision requested:</strong> <field name="revision_reason" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Customer">
                            <field name="partner_id" options="{'no_quick_create': True}"/>
                            <field name="contact_id" options="{'no_quick_create': True}"/>
                            <field name="salesperson_id" widget="many2one_avatar_user"/>
                            <field name="team_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="is_expired" invisible="1"/>
                        </group>
                        <group string="Commercial Terms">
                            <field name="proposal_date"/>
                            <field name="validity_date"/>
                            <field name="payment_term_id"/>
                            <field name="contract_duration"/>
                            <field name="service_start_date"/>
                            <field name="expected_golive_date"/>
                        </group>
                    </group>

                    <group string="Source Documents" class="text-muted">
                        <group>
                            <field name="lead_id" readonly="1"/>
                            <field name="survey_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="technical_report_id" readonly="1"/>
                            <field name="boq_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"
                                   invisible="not sale_order_id"/>
                            <field name="revision_of_id" readonly="1"
                                   invisible="not revision_of_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Products &amp; Services" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="partner_id" column_invisible="True"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" groups="uom.group_uom" optional="show"/>
                                    <field name="price_unit"/>
                                    <field name="discount" optional="show"/>
                                    <field name="tax_ids" widget="many2many_tags"
                                           options="{'no_create': True}" optional="show"/>
                                    <field name="unit_cost" optional="hide"
                                           groups="gc_erm_lead_to_billing.group_gc_sales_hod"/>
                                    <field name="cost_subtotal" optional="hide" sum="Cost"
                                           groups="gc_erm_lead_to_billing.group_gc_sales_hod"/>
                                    <field name="price_subtotal" sum="Subtotal"/>
                                    <field name="boq_line_id" column_invisible="True"/>
                                </tree>
                            </field>

                            <group class="mt-3">
                                <group>
                                    <field name="global_discount" readonly="state != 'draft'"/>
                                </group>
                                <group class="oe_subtotal_footer">
                                    <field name="amount_discount" widget="monetary"/>
                                    <field name="amount_untaxed" widget="monetary"/>
                                    <field name="amount_tax" widget="monetary"/>
                                    <div class="oe_subtotal_footer_separator">
                                        <label for="amount_total"/>
                                    </div>
                                    <field name="amount_total" nolabel="1" widget="monetary"
                                           class="oe_subtotal_footer_separator"/>
                                    <field name="margin_amount" widget="monetary"
                                           groups="gc_erm_lead_to_billing.group_gc_sales_hod"/>
                                    <field name="margin_percentage" widget="percentage"
                                           string="Margin %"
                                           groups="gc_erm_lead_to_billing.group_gc_sales_hod"/>
                                </group>
                            </group>
                        </page>

                        <page string="Scope" name="scope">
                            <separator string="Technical Scope"/>
                            <field name="technical_scope"/>
                            <separator string="Commercial Scope"/>
                            <field name="commercial_scope"/>
                            <separator string="Terms &amp; Conditions"/>
                            <field name="terms_conditions"/>
                            <separator string="Remarks"/>
                            <field name="remarks" nolabel="1"/>
                        </page>

                        <page string="Customer Acceptance" name="acceptance"
                              invisible="state not in ('accepted', 'refused')">
                            <group>
                                <group>
                                    <field name="acceptance_method"/>
                                    <field name="acceptance_date"/>
                                    <field name="accepted_by"/>
                                </group>
                                <group>
                                    <field name="acceptance_remarks"/>
                                </group>
                            </group>
                            <field name="acceptance_attachment_ids" widget="many2many_binary"
                                   string="Acceptance Documents"/>
                        </page>

                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>

                        <page string="Audit" name="audit">
                            <group>
                                <group>
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_date"/>
                                </group>
                                <group>
                                    <field name="approved_by_id"/>
                                    <field name="approved_date"/>
                                    <field name="rejected_by_id"/>
                                    <field name="rejected_date"/>
                                </group>
                            </group>
                            <field name="status_history_ids" readonly="1">
                                <tree>
                                    <field name="change_date"/>
                                    <field name="old_state_label" string="From"/>
                                    <field name="new_state_label" string="To"/>
                                    <field name="user_id"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_gc_proposal_tree" model="ir.ui.view">
        <field name="name">gc.erm.proposal.tree</field>
        <field name="model">gc.erm.proposal</field>
        <field name="arch" type="xml">
            <tree string="Proposals" sample="1"
                  decoration-muted="state in ('cancelled', 'revised')"
                  decoration-danger="state in ('rejected', 'refused') or is_expired"
                  decoration-warning="state == 'hod_approval'"
                  decoration-success="state == 'accepted'">
                <field name="name"/>
                <field name="version" optional="show"/>
                <field name="proposal_date"/>
                <field name="partner_id"/>
                <field name="salesperson_id" widget="many2one_avatar_user" optional="show"/>
                <field name="validity_date" optional="show"/>
                <field name="amount_untaxed" sum="Untaxed" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="margin_percentage" string="Margin %" optional="show"
                       groups="gc_erm_lead_to_billing.group_gc_sales_hod"/>
                <field name="sale_order_id" optional="hide"/>
                <field name="is_expired" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'sent')"
                       decoration-warning="state == 'hod_approval'"
                       decoration-success="state in ('approved', 'accepted')"
                       decoration-danger="state in ('rejected', 'refused', 'cancelled')"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_gc_proposal_kanban" model="ir.ui.view">
        <field name="name">gc.erm.proposal.kanban</field>
        <field name="model">gc.erm.proposal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1"
                    quick_create="false">
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_gc_kanban_card">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_gc_kanban_title"><field name="partner_id"/></strong>
                                    <small class="text-muted d-block">
                                        <field name="name"/> v<field name="version"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body o_gc_kanban_meta">
                                <div>
                                    <i class="fa fa-money me-1" title="Total"/>
                                    <field name="amount_total" widget="monetary"/>
                                </div>
                                <div t-if="record.validity_date.raw_value">
                                    <i class="fa fa-calendar me-1" title="Valid until"/>
                                    <field name="validity_date"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="salesperson_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gc_proposal_search" model="ir.ui.view">
        <field name="name">gc.erm.proposal.search</field>
        <field name="model">gc.erm.proposal</field>
        <field name="arch" type="xml">
            <search string="Proposals">
                <field name="name"
                       filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="salesperson_id"/>
                <field name="lead_id"/>
                <filter name="filter_mine" string="My Proposals"
                        domain="[('salesperson_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_pending" string="Pending Approval"
                        domain="[('state', '=', 'hod_approval')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="filter_sent" string="Offer Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_won" string="Won" domain="[('state', '=', 'accepted')]"/>
                <filter name="filter_lost" string="Lost"
                        domain="[('state', 'in', ('refused', 'rejected'))]"/>
                <separator/>
                <filter name="filter_expired" string="Expired" domain="[('is_expired', '=', True)]"/>
                <filter name="filter_current" string="Current Versions"
                        domain="[('state', '!=', 'revised')]"/>
                <separator/>
                <filter name="filter_date" string="Proposal Date" date="proposal_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_salesperson" string="Salesperson"
                            context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_month" string="Proposal Month"
                            context="{'group_by': 'proposal_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_gc_proposal_pivot" model="ir.ui.view">
        <field name="name">gc.erm.proposal.pivot</field>
        <field name="model">gc.erm.proposal</field>
        <field name="arch" type="xml">
            <pivot string="Proposal Analysis" sample="1">
                <field name="salesperson_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_gc_proposal_graph" model="ir.ui.view">
        <field name="name">gc.erm.proposal.graph</field>
        <field name="model">gc.erm.proposal</field>
        <field name="arch" type="xml">
            <graph string="Proposal Value" type="bar" sample="1">
                <field name="proposal_date" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_gc_proposal" model="ir.actions.act_window">
        <field name="name">Proposals</field>
        <field name="res_model">gc.erm.proposal</field>
        <field name="view_mode">kanban,tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_gc_proposal_search"/>
        <field name="context">{'search_default_filter_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No proposal yet</p>
            <p>Proposals are prepared from a submitted technical report and, once
               approved, generate a standard Odoo quotation.</p>
        </field>
    </record>

    <record id="action_gc_proposal_approval" model="ir.actions.act_window">
        <field name="name">Proposals to Approve</field>
        <field name="res_model">gc.erm.proposal</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_gc_proposal_search"/>
        <field name="domain">[('state', '=', 'hod_approval')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for your approval</p>
        </field>
    </record>

</odoo>
