<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SRS 80 - Automated scheduled jobs. All are active but light: they
         only flag records and create activities, they never change a state
         that a human must control. -->
    <data noupdate="1">

        <record id="cron_gc_survey_deadline" model="ir.cron">
            <field name="name">GC ERM: Survey deadline check</field>
            <field name="model_id" ref="model_gc_erm_survey"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_survey_deadline()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_gc_proposal_expiry" model="ir.cron">
            <field name="name">GC ERM: Proposal expiry</field>
            <field name="model_id" ref="model_gc_erm_proposal"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_proposals()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_gc_work_order_delay" model="ir.cron">
            <field name="name">GC ERM: Work order delay check</field>
            <field name="model_id" ref="model_gc_erm_work_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_work_order_delay()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_gc_procurement_aging" model="ir.cron">
            <field name="name">GC ERM: Procurement aging</field>
            <field name="model_id" ref="model_gc_erm_procurement_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_procurement_aging()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_gc_installation_aging" model="ir.cron">
            <field name="name">GC ERM: Installation aging</field>
            <field name="model_id" ref="model_gc_erm_installation"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_installation_aging()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_gc_invoice_reminder" model="ir.cron">
            <field name="name">GC ERM: Overdue invoice reminder</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc_invoice_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
