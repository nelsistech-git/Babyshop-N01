<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_production_order_tree" model="ir.ui.view">
        <field name="name">fw.production.order.tree</field>
        <field name="model">fw.production.order</field>
        <field name="arch" type="xml">
            <tree string="Production Orders" decoration-danger="state=='cancelled'"
                  decoration-success="state=='completed'">
                <field name="name"/>
                <field name="style_id"/>
                <field name="buyer_order_id"/>
                <field name="factory_id"/>
                <field name="production_line_id"/>
                <field name="planned_qty"/>
                <field name="finished_qty"/>
                <field name="completion_percent" widget="percentage"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-warning="state in ('released','in_progress')"
                       decoration-success="state=='completed'"
                       decoration-danger="state=='cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_production_order_form" model="ir.ui.view">
        <field name="name">fw.production.order.form</field>
        <field name="model">fw.production.order</field>
        <field name="arch" type="xml">
            <form string="Footwear Production Order">
                <header>
                    <button name="action_release" type="object" string="Release to Floor"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start Production"
                            class="btn-primary" invisible="state != 'released'"/>
                    <button name="action_complete" type="object" string="Mark Completed"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed','cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <button name="action_create_mrp_production" type="object"
                            string="Create Manufacturing Order"
                            invisible="mrp_production_id or state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,released,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="buyer_order_line_id"/>
                            <field name="style_id" readonly="1"/>
                            <field name="color_id" readonly="1"/>
                            <field name="bom_id"/>
                        </group>
                        <group>
                            <field name="factory_id"/>
                            <field name="production_line_id"/>
                            <field name="planned_qty"/>
                            <field name="finished_qty"/>
                            <field name="completion_percent" widget="percentage"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_planned_start"/>
                            <field name="date_planned_finish"/>
                        </group>
                        <group>
                            <field name="mrp_production_id" readonly="1"
                                   invisible="not mrp_production_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Process Stages">
                            <field name="stage_ids">
                                <tree editable="bottom" decoration-success="status=='done'"
                                      decoration-warning="status=='in_progress'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stage"/>
                                    <field name="production_line_id"/>
                                    <field name="planned_qty"/>
                                    <field name="completed_qty"/>
                                    <field name="defect_qty"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="status"/>
                                    <button name="action_start" type="object" string="Start"
                                            icon="fa-play" invisible="status != 'pending'"/>
                                    <button name="action_done" type="object" string="Done"
                                            icon="fa-check" invisible="status != 'in_progress'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_production_order_search" model="ir.ui.view">
        <field name="name">fw.production.order.search</field>
        <field name="model">fw.production.order</field>
        <field name="arch" type="xml">
            <search string="Search Production Orders">
                <field name="name"/>
                <field name="style_id"/>
                <field name="buyer_order_id"/>
                <field name="factory_id"/>
                <filter string="Released" name="released" domain="[('state','=','released')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <group expand="0" string="Group By">
                    <filter string="Factory" name="group_factory" context="{'group_by': 'factory_id'}"/>
                    <filter string="Style" name="group_style" context="{'group_by': 'style_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_production_order" model="ir.actions.act_window">
        <field name="name">Production Orders</field>
        <field name="res_model">fw.production.order</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_production_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first footwear production order</p>
        </field>
    </record>
</odoo>
