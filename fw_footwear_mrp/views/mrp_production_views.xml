<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_fw_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.fw.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="fw_style_id"/>
                <field name="fw_buyer_order_id"/>
                <field name="fw_factory_id"/>
                <field name="fw_production_line_id"/>
                <field name="fw_production_order_id" readonly="1" invisible="not fw_production_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
