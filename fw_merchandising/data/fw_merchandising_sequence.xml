<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fw_buyer_order" model="ir.sequence">
        <field name="name">FW Buyer Order</field>
        <field name="code">fw.buyer.order</field>
        <field name="prefix">ORD/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_shipment" model="ir.sequence">
        <field name="name">FW Shipment</field>
        <field name="code">fw.shipment</field>
        <field name="prefix">SHP/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_export_tracking" model="ir.sequence">
        <field name="name">FW Export Tracking</field>
        <field name="code">fw.export.tracking</field>
        <field name="prefix">EXP/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
