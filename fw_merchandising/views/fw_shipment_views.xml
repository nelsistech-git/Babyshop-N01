<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_shipment_tree" model="ir.ui.view">
        <field name="name">fw.shipment.tree</field>
        <field name="model">fw.shipment</field>
        <field name="arch" type="xml">
            <tree string="Shipments" decoration-success="state=='delivered'">
                <field name="name"/>
                <field name="order_id"/>
                <field name="buyer_id"/>
                <field name="shipment_date"/>
                <field name="mode"/>
                <field name="container_no"/>
                <field name="total_qty_shipped"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_shipment_form" model="ir.ui.view">
        <field name="name">fw.shipment.form</field>
        <field name="model">fw.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <button name="action_book" type="object" string="Book"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_ship" type="object" string="Ship"
                            class="btn-primary" invisible="state != 'booked'"/>
                    <button name="action_deliver" type="object" string="Mark Delivered"
                            invisible="state != 'shipped'"/>
                    <button name="action_reset_planned" type="object" string="Reset to Planned"
                            invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,booked,shipped,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="buyer_id" readonly="1"/>
                            <field name="shipment_date"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="container_no"/>
                            <field name="vessel_flight_no"/>
                            <field name="port_of_loading"/>
                            <field name="port_of_discharge"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoice_value" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shipment Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="order_line_id"
                                           domain="[('order_id','=',parent.order_id)]"/>
                                    <field name="style_id" readonly="1"/>
                                    <field name="color_id" readonly="1"/>
                                    <field name="ordered_qty" readonly="1"/>
                                    <field name="qty_shipped"/>
                                    <field name="carton_count"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_qty_shipped"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_shipment_search" model="ir.ui.view">
        <field name="name">fw.shipment.search</field>
        <field name="model">fw.shipment</field>
        <field name="arch" type="xml">
            <search string="Search Shipments">
                <field name="name"/>
                <field name="order_id"/>
                <field name="buyer_id"/>
                <field name="container_no"/>
                <group expand="0" string="Group By">
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">fw.shipment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_shipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first shipment</p>
        </field>
    </record>
</odoo>
