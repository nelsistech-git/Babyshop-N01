<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_sample_type_tree" model="ir.ui.view">
        <field name="name">garment.sample.type.tree</field>
        <field name="model">garment.sample.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_sample_type" model="ir.actions.act_window">
        <field name="name">Sample Types</field>
        <field name="res_model">garment.sample.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
