<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_sample_activity_tree" model="ir.ui.view">
        <field name="name">garment.sample.activity.tree</field>
        <field name="model">garment.sample.activity</field>
        <field name="arch" type="xml">
            <tree string="Development Activities" editable="bottom" decoration-success="status == 'completed'" decoration-danger="status == 'delayed'">
                <field name="sample_id"/>
                <field name="activity_type"/>
                <field name="responsible_person_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="progress"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_sample_activity" model="ir.actions.act_window">
        <field name="name">Development Activities</field>
        <field name="res_model">garment.sample.activity</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
