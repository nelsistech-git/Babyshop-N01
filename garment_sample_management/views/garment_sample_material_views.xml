<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_sample_material_tree" model="ir.ui.view">
        <field name="name">garment.sample.material.tree</field>
        <field name="model">garment.sample.material</field>
        <field name="arch" type="xml">
            <tree string="Material Reservations" editable="bottom" decoration-danger="shortage_qty &gt; 0">
                <field name="sample_id"/>
                <field name="material_type"/>
                <field name="description"/>
                <field name="required_qty"/>
                <field name="available_qty"/>
                <field name="reserved_qty"/>
                <field name="issued_qty"/>
                <field name="shortage_qty"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_sample_material" model="ir.actions.act_window">
        <field name="name">Material Reservations</field>
        <field name="res_model">garment.sample.material</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
