<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_sample_approval_tree" model="ir.ui.view">
        <field name="name">garment.sample.approval.tree</field>
        <field name="model">garment.sample.approval</field>
        <field name="arch" type="xml">
            <tree string="Approvals" editable="bottom" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'">
                <field name="sample_id"/>
                <field name="approval_stage"/>
                <field name="approval_type"/>
                <field name="approver_id"/>
                <field name="status"/>
                <field name="approval_date"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_sample_approval_form" model="ir.ui.view">
        <field name="name">garment.sample.approval.form</field>
        <field name="model">garment.sample.approval</field>
        <field name="arch" type="xml">
            <form string="Sample Approval">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="status == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary"
                            invisible="status == 'rejected'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="sample_id"/>
                            <field name="approval_stage"/>
                            <field name="approval_type"/>
                        </group>
                        <group>
                            <field name="approver_id"/>
                            <field name="approval_date"/>
                        </group>
                    </group>
                    <field name="comments"/>
                    <group string="Attachment">
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_sample_approval" model="ir.actions.act_window">
        <field name="name">Sample Approvals</field>
        <field name="res_model">garment.sample.approval</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_garment_sample_comment_tree" model="ir.ui.view">
        <field name="name">garment.sample.comment.tree</field>
        <field name="model">garment.sample.comment</field>
        <field name="arch" type="xml">
            <tree string="Buyer Comments" editable="bottom" decoration-success="completion_status == 'completed'">
                <field name="sample_id"/>
                <field name="comment_date"/>
                <field name="buyer_user_id"/>
                <field name="comment_description"/>
                <field name="responsible_person_id"/>
                <field name="completion_status"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_sample_comment" model="ir.actions.act_window">
        <field name="name">Buyer Comments</field>
        <field name="res_model">garment.sample.comment</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
