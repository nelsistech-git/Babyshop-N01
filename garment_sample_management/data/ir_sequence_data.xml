<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_sample" model="ir.sequence">
        <field name="name">Garment Sample Number</field>
        <field name="code">garment.sample</field>
        <field name="prefix">SMP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_sample_request" model="ir.sequence">
        <field name="name">Garment Sample Request Number</field>
        <field name="code">garment.sample.request</field>
        <field name="prefix">SREQ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_sample_courier" model="ir.sequence">
        <field name="name">Garment Sample Courier Number</field>
        <field name="code">garment.sample.courier</field>
        <field name="prefix">CUR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
