<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="sample_type_proto" model="garment.sample.type">
        <field name="name">Proto Sample</field><field name="code">proto</field><field name="sequence">10</field>
        <field name="purpose">Initial design confirmation — style appearance, construction checking, fabric confirmation.</field>
    </record>
    <record id="sample_type_fit" model="garment.sample.type">
        <field name="name">Fit Sample</field><field name="code">fit</field><field name="sequence">20</field>
        <field name="purpose">Check garment fitting — measurement, shape, silhouette, construction.</field>
    </record>
    <record id="sample_type_size_set" model="garment.sample.type">
        <field name="name">Size Set Sample</field><field name="code">size_set</field><field name="sequence">30</field>
        <field name="purpose">Check all size grading across the full size range.</field>
    </record>
    <record id="sample_type_pp" model="garment.sample.type">
        <field name="name">PP (Pre-Production) Sample</field><field name="code">pp</field><field name="sequence">40</field>
        <field name="purpose">Final approval before bulk production — fabric, color, measurement, construction, workmanship.</field>
    </record>
    <record id="sample_type_salesman" model="garment.sample.type">
        <field name="name">Salesman Sample</field><field name="code">salesman</field><field name="sequence">50</field>
        <field name="purpose">Buyer showroom presentation.</field>
    </record>
    <record id="sample_type_shipment" model="garment.sample.type">
        <field name="name">Shipment Sample</field><field name="code">shipment</field><field name="sequence">60</field>
        <field name="purpose">Final production reference.</field>
    </record>
    <record id="sample_type_development" model="garment.sample.type">
        <field name="name">Development Sample</field><field name="code">development</field><field name="sequence">5</field>
        <field name="purpose">Woven process — earliest development sample ahead of the Fit Sample.</field>
    </record>
    <record id="sample_type_sealed" model="garment.sample.type">
        <field name="name">Sealed Sample</field><field name="code">sealed</field><field name="sequence">35</field>
        <field name="purpose">Woven process — buyer-sealed reference sample kept for bulk production matching.</field>
    </record>
    <record id="sample_type_yarn_approval" model="garment.sample.type">
        <field name="name">Yarn Approval</field><field name="code">yarn_approval</field><field name="sequence">2</field>
        <field name="purpose">Sweater process — buyer approval of yarn before knitting.</field>
    </record>
    <record id="sample_type_color_approval" model="garment.sample.type">
        <field name="name">Color Approval</field><field name="code">color_approval</field><field name="sequence">3</field>
        <field name="purpose">Sweater process — buyer approval of dyed/colored yarn shade.</field>
    </record>
    <record id="sample_type_knitting" model="garment.sample.type">
        <field name="name">Knitting Sample</field><field name="code">knitting</field><field name="sequence">15</field>
        <field name="purpose">Sweater process — knitted panel sample confirming gauge and structure.</field>
    </record>
    <record id="sample_type_linking" model="garment.sample.type">
        <field name="name">Linking Sample</field><field name="code">linking</field><field name="sequence">16</field>
        <field name="purpose">Sweater process — linked/assembled sample confirming seam and shaping.</field>
    </record>
    <record id="sample_type_wash" model="garment.sample.type">
        <field name="name">Wash Sample</field><field name="code">wash</field><field name="sequence">45</field>
        <field name="purpose">Sweater/Woven process — post-wash appearance and shrinkage confirmation.</field>
    </record>
</odoo>
