<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_cctv_attendance_close_stale" model="ir.cron">
            <field name="name">CCTV Face Attendance: Close Forgotten Check-outs</field>
            <field name="model_id" ref="model_cctv_attendance_punch"/>
            <field name="state">code</field>
