            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
        <record id="cron_cctv_attendance_purge_snapshots" model="ir.cron">
            <field name="name">CCTV Face Attendance: Purge Old Snapshots (retention)</field>
            <field name="model_id" ref="model_cctv_attendance_punch"/>
            <field name="state">code</field>
            <field name="code">model.cron_purge_snapshots()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
