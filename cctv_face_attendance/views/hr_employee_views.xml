<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_cctv_face" model="ir.ui.view">
        <field name="name">hr.employee.form.cctv.face</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="cctv_person_id" invisible="1"/>
                <button name="action_open_cctv_punches" type="object" class="oe_stat_button" icon="fa-camera"
                        groups="hr_attendance.group_hr_attendance_officer">
                    <field name="cctv_punch_count" widget="statinfo" string="Face Punches"/>
                </button>
                <button name="action_enroll_face" type="object" class="oe_stat_button" icon="fa-user-plus"
                        invisible="cctv_person_id" string="Enrol Face"
                        groups="hr_attendance.group_hr_attendance_officer"/>
            </xpath>
        </field>
    </record>

    <record id="server_action_enroll_face" model="ir.actions.server">
        <field name="name">Enrol for Face Attendance</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_enroll_face()</field>
    </record>
</odoo>
