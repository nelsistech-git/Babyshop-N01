<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cctv_attendance_punch_tree" model="ir.ui.view">
        <field name="name">cctv.attendance.punch.tree</field>
        <field name="model">cctv.attendance.punch</field>
        <field name="arch" type="xml">
            <tree create="0" decoration-warning="result == 'review'" decoration-danger="result == 'error'"
                  decoration-muted="result in ('ignored', 'dismissed')" decoration-success="result in ('check_in', 'check_out')">
                <field name="punch_time"/>
                <field name="employee_id"/>
                <field name="camera_id"/>
                <field name="office_id" optional="hide"/>
                <field name="result" widget="badge"/>
                <field name="confidence" string="Match %"/>
                <field name="sightings" optional="hide"/>
                <field name="reason"/>
                <field name="source" optional="hide"/>
                <field name="attendance_id" optional="hide"/>
                <button name="action_approve" type="object" icon="fa-check" string="Approve"
                        invisible="result != 'review'" groups="hr_attendance.group_hr_attendance_officer,cctv_management.group_cctv_hr_manager"/>
                <button name="action_dismiss" type="object" icon="fa-times" string="Dismiss"
                        invisible="result != 'review'" groups="hr_attendance.group_hr_attendance_officer,cctv_management.group_cctv_hr_manager"/>
            </tree>
        </field>
    </record>

    <record id="view_cctv_attendance_punch_form" model="ir.ui.view">
        <field name="name">cctv.attendance.punch.form</field>
        <field name="model">cctv.attendance.punch</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="result != 'review'"
                            groups="hr_attendance.group_hr_attendance_officer,cctv_management.group_cctv_hr_manager"/>
                    <button name="action_dismiss" type="object" string="Dismiss" invisible="result != 'review'"
                            groups="hr_attendance.group_hr_attendance_officer,cctv_management.group_cctv_hr_manager"/>
                    <field name="result" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="person_id"/>
                            <field name="camera_id"/>
                            <field name="office_id"/>
                            <field name="punch_time"/>
                        </group>
                        <group>
                            <field name="confidence"/>
                            <field name="sightings"/>
                            <field name="source"/>
                            <field name="is_old"/>
                            <field name="attendance_id"/>
                            <field name="reviewed_by"/>
                            <field name="reviewed_on"/>
                        </group>
                    </group>
                    <group><field name="reason"/></group>
                    <field name="snapshot" widget="image" options="{'size': [320, 240]}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cctv_attendance_punch_search" model="ir.ui.view">
        <field name="name">cctv.attendance.punch.search</field>
        <field name="model">cctv.attendance.punch</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="camera_id"/>
                <field name="office_id"/>
                <filter name="today" string="Today" domain="[('punch_time', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter name="review" string="Needs Review" domain="[('result', '=', 'review')]"/>
                <filter name="accepted" string="Check-ins / Check-outs" domain="[('result', 'in', ['check_in', 'check_out'])]"/>
                <filter name="errors" string="Errors" domain="[('result', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_camera" string="Camera" context="{'group_by': 'camera_id'}"/>
                    <filter name="g_result" string="Result" context="{'group_by': 'result'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'punch_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cctv_attendance_punch" model="ir.actions.act_window">
        <field name="name">Punch Log</field>
        <field name="res_model">cctv.attendance.punch</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_accepted': 1}</field>
    </record>

    <record id="action_cctv_attendance_review" model="ir.actions.act_window">
        <field name="name">Needs Review</field>
        <field name="res_model">cctv.attendance.punch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('result', '=', 'review')]</field>
    </record>
</odoo>
