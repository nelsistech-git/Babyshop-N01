                                    <field name="rec_amt_type" required="1"/>
                                    <field name="rec_sign" required="1"/>
                                </tree>
                                <form >
                                    <group>
                                        <field name="fs_particular_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                        <!--<field name="rec_type" readonly="1"/>-->
                                        <field name="rec_title_id" readonly="1" domain="[('acc_particular_id', '=', fs_particular_id)]" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                        <field name="rec_amt_type" readonly="1"/>
                                        <field name="rec_sign" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </group>
                        <group>
                            <field name="rpt_config_line_ids" invisible="account_type == 'view'">
                                <tree editable="bottom">
                                    <field name="fs_particular_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                    <!--<field name="rec_type" />-->
                                    <field name="rec_title_id" domain="[('acc_particular_id', '=', fs_particular_id)]" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" required="1"/>
                                    <field name="rec_amt_type" required="1"/>
                                    <field name="rec_sign" required="1"/>

                                    <field name="conf_fs_particular_id" readonly="1" style="background-color: #fae7e6;" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                    <!--<field name="conf_type" readonly="1" style="background-color: #fae7e6;"/>-->
                                    <field name="conf_title_id" readonly="1" style="background-color: #fae7e6;"/>
                                    <field name="conf_amt_type" readonly="1" style="background-color: #fae7e6;"/>
                                    <field name="conf_sign" readonly="1" style="background-color: #fae7e6;"/>
                                </tree>
                                <form >
                                    <group>
                                        <field name="fs_particular_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                        <!--<field name="rec_type" readonly="1"/>-->
                                        <field name="rec_title_id" readonly="1" domain="[('acc_particular_id', '=', fs_particular_id)]" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                        <field name="rec_amt_type" readonly="1"/>
                                        <field name="rec_sign" readonly="1"/>

                                        <field name="conf_fs_particular_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                        <!--<field name="conf_type" readonly="1"/>-->
                                        <field name="conf_title_id" readonly="1"/>
                                        <field name="conf_amt_type" readonly="1"/>
                                        <field name="conf_sign" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </group>
                    </page>
				</xpath>

			</field>
		</record>

