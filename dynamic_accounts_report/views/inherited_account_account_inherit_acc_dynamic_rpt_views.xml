<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>
        <record id="act_coa_child" model="ir.actions.act_window">
            <field name="name">Child COA</field>
            <field name="res_model">account.account</field>
            <field name="view_mode">tree,form</field>
            <!--<field name="context">{'search_default_customer': active_id, 'default_customer': active_id}</field>-->
            <field name="domain">[('parent_id', '=', active_id)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Child COA
                </p>
            </field>
        </record>

        <record id="inherited_account_inherit_dynamic_rpt_form" model="ir.ui.view">
			<field name="name">account.account.form.inherit.dynamic.rpt</field>
			<field name="model">account.account</field>
			<field name="inherit_id" ref="account.view_account_form" />
            <field name="priority">20</field>
			<field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="parent_child_type" invisible="1"/>

                    <button class="oe_stat_button" type="action" string="Child Accounts"
                            name="%(dynamic_accounts_report.act_coa_child)d"
                            icon="fa-sitemap" invisible="parent_child_type != 'parent'" >
                        <!--<field string="Child" name="coa_child_count" widget="statinfo"/>-->
                    </button>
                </xpath>
<!--                <xpath expr="//field[@name='parent_id']" position="replace">-->
<!--                </xpath>-->
                <xpath expr="//field[@name='account_type']" position="replace">
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="replace">
                </xpath>


                <xpath expr="//div[2]" position="replace">
                    <group>
                        <group>
                            <field name="parent_child_type" required="1"/>
                            <field name="parent_id"
                                    domain="[('account_type','=','view')]"
                                    groups="account_parent.group_coas_user"
                                    context="{'show_parent_account':True}"
                                    required="parent_child_type == 'child'"/>
                            <field name="account_type" widget="account_type_selection"/>
                            <field name="user_type_id_type" invisible="1"/>
                            <field name="account_type_allow" invisible="account_type != 'view'"/>
                            <field name="code" string="Code" placeholder="e.g. 101000" class="oe_inline"/>
                            <field name="name" string="Account Name" placeholder="e.g. Current Assets" style="width:80% !important;"/>
                            <field name="tag_ids" widget="many2many_tags" domain="[('applicability', '=', 'accounts')]" context="{'default_applicability': 'accounts'}" options="{'no_create_edit': True}"/>

                        </group>
                        <group>
                            <field name="parent_hierarchy" readonly="1" decoration-info="parent_hierarchy!=''" style="font-weight:bold;"/>
                            <field name="child_parent_child_type" required="1" invisible="parent_child_type == 'child'" />
					        <field name="child_code_digit" required="1" invisible="parent_child_type == 'child'" />
                        </group>

                    </group>
                </xpath>

                <!--<xpath expr="//button[@name='account.action_move_line_select']" position="attributes">
                    <attribute name="invisible">parent_child_type != 'child'</attribute>
                </xpath>-->

