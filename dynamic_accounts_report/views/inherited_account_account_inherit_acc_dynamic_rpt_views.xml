                <xpath expr="//page[@name='accounting']" position="before">
                    <page string="FS Recommendation And Settings" name="fs_recom_settings">
                        <group>
                            <field name="parent_rpt_config_line_ids" invisible="account_type != 'view'">
                                <tree editable="bottom">
                                    <field name="fs_particular_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                    <!--<field name="rec_type" />--> <!--required="1"-->
                                    <!--<field name="rec_title_id" domain="[('acc_particular_id.type', '=', rec_type)]" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" required="1"/>-->
