        <record id="view_account_list_inherit_acc_dynamic_rpt" model="ir.ui.view">
            <field name="name">view.account.list.inherit.acc.dynamic.rpt</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_list"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="decoration-info">parent_child_type == 'parent'</attribute>
                    <attribute name="edit">false</attribute>
                    <!--<attribute name="delete">false</attribute>-->
                </xpath>

                <xpath expr="//field[@name='name']" position="after">
                    <!--<field name="parent_id" optional="hide"/>-->
					<field name="rpt_config_line_ids" string="Report Mapping" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='code']" position="before">
					<field name="parent_child_type"/>
                </xpath>

            </field>
        </record>

