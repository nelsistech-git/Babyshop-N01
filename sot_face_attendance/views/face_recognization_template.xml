<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="face_attendance" name="Face Attendance">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'face_attendance'"/>
            <div id="wrap" class="oe_structure">
                <link rel="stylesheet" href="/sot_face_attendance/static/src/css/face_attendance.css"/>
                <main>
                    <div class="row">
                        <div class="col-sm">
                            <div class="title text-center"></div>
                        </div>
                        <div class="col-md">
                            <div class="o_hr_attendance_kiosk_mode text-center py-4">
                                <div class="o_hr_attendance_user_badge o_home_menu_background">
                                    <img class="img rounded-circle" id="employee_image" alt="Employee"
                                         style="width:100px; height:100px; display:none"/>
                                </div>

                                <h1 class="mb8" id="employee_name">
                                    Employee Name
                                </h1>
                                <h3 class="mt8 mb24" id="employee_attendance_status">
                                    Welcome
                                </h3>
                                <h4 class="mt0 mb0 text-muted" id="employee_work_hour"></h4>

                                <div class="row justify-content-center">
                                    <div class="col-6">
                                        <input type="text" name="employee_id" class="form-control"
                                               id="face_employee_id" placeholder="Employee ID"/>
                                        <a class="fa fa-7x o_hr_attendance_sign_in_out_face o_sot_face_sign_in_out fa-meh-o btn-secondary"
                                           id="face_sign_in_out"
                                           aria-label="Sign in" title="Sign in"
                                           onclick="face_recognition()"></a>
                                    </div>
                                </div>

                                <div>
                                    <div class="container" id="container"
                                         style="display: flex; justify-content: center; align-items: center; flex-direction: column;">
                                        <video id="videoInput" width="420" height="300"
                                               muted="muted" controls="controls" style="display:none"></video>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm text-center">
                            <div class="title"></div>
                        </div>
                    </div>
                </main>
                <script type="text/javascript" src="/sot_face_attendance/static/src/js/face-api.min.js"></script>
                <script type="text/javascript" src="/sot_face_attendance/static/src/js/browser_face_attendance.js"></script>
            </div>
        </t>
    </template>
</odoo>
