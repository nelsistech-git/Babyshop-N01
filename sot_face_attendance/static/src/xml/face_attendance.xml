<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sot_face_attendance.FaceAttendance">
        <div class="o_action o_sot_face_attendance d-flex flex-column align-items-center justify-content-center text-center p-4">
            <t t-if="state.loaded and state.employeeId">
                <img class="rounded-circle mb-3" style="width:100px; height:100px"
                     t-attf-src="/web/image/hr.employee.public/{{ state.employeeId }}/avatar_128"
                     t-att-alt="user.name"/>
                <h1 class="mb-2" t-esc="user.name"/>
                <h3 class="mt-2 mb-3">
                    <t t-if="!state.checkedIn">Welcome!</t>
                    <t t-else="">Want to check out?</t>
                </h3>
                <h4 class="text-muted" t-if="state.message" t-esc="state.message"/>
                <button class="btn btn-lg mt-2"
                        t-attf-class="btn-{{ state.checkedIn ? 'warning' : 'secondary' }}"
                        t-att-disabled="state.scanning"
                        t-on-click="onFaceSignInOut">
                    <i class="fa fa-5x fa-meh-o"
                       t-att-aria-label="state.checkedIn ? 'Sign out' : 'Sign in'"
                       t-att-title="state.checkedIn ? 'Sign out' : 'Sign in'"/>
                </button>
                <h3 class="mt-3 mb-0 text-muted">
                    Click to <b t-if="state.checkedIn">check out</b><b t-else="">check in</b> with your face
                </h3>
            </t>
            <t t-elif="state.loaded">
                Warning : Your user should be linked to an employee to use attendance. Please contact your administrator.
            </t>
            <div class="mt-3">
                <video t-ref="video" width="420" height="300" muted="muted"
                       t-att-style="state.scanning ? '' : 'display:none'"></video>
            </div>
        </div>
    </t>

</templates>
