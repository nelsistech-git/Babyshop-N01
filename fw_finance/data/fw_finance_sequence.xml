<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fw_style_costing" model="ir.sequence">
        <field name="name">FW Style Costing</field>
        <field name="code">fw.style.costing</field>
        <field name="prefix">COST/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_factory_costing" model="ir.sequence">
        <field name="name">FW Factory Costing</field>
        <field name="code">fw.factory.costing</field>
        <field name="prefix">FCOST/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_export_costing" model="ir.sequence">
        <field name="name">FW Export Costing</field>
        <field name="code">fw.export.costing</field>
        <field name="prefix">EXCOST/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
