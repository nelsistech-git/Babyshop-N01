<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fw_environmental_record" model="ir.sequence">
        <field name="name">FW Environmental Record</field>
        <field name="code">fw.environmental.record</field>
        <field name="prefix">ENV/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_social_compliance_audit" model="ir.sequence">
        <field name="name">FW Social Compliance Audit</field>
        <field name="code">fw.social.compliance.audit</field>
        <field name="prefix">SCA/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_fw_factory_certification_expiry" model="ir.cron">
        <field name="name">FW Compliance: Notify Expiring Factory Certifications</field>
        <field name="model_id" ref="model_fw_factory_certification"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_expiring_certifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
