<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_environmental_record_tree" model="ir.ui.view">
        <field name="name">fw.environmental.record.tree</field>
        <field name="model">fw.environmental.record</field>
        <field name="arch" type="xml">
            <tree string="Environmental Records">
                <field name="name"/>
                <field name="factory_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="water_consumption_m3"/>
                <field name="energy_consumption_kwh"/>
                <field name="waste_recycled_percent"/>
                <field name="chemical_incident_count"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_environmental_record_form" model="ir.ui.view">
        <field name="name">fw.environmental.record.form</field>
        <field name="model">fw.environmental.record</field>
        <field name="arch" type="xml">
            <form string="Environmental Record">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="factory_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="total_production_qty"/>
                        </group>
                    </group>
                    <group string="Resource Consumption">
                        <group>
                            <field name="water_consumption_m3"/>
                            <field name="water_per_pair_liters" readonly="1"/>
                        </group>
                        <group>
                            <field name="energy_consumption_kwh"/>
                            <field name="energy_per_pair_kwh" readonly="1"/>
                        </group>
                    </group>
                    <group string="Waste &amp; Emissions">
                        <group>
                            <field name="waste_generated_kg"/>
                            <field name="waste_recycled_kg"/>
                            <field name="waste_recycled_percent" readonly="1"/>
                        </group>
                        <group>
                            <field name="co2_emission_tons"/>
                            <field name="chemical_incident_count"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_environmental_record_graph" model="ir.ui.view">
        <field name="name">fw.environmental.record.graph</field>
        <field name="model">fw.environmental.record</field>
        <field name="arch" type="xml">
            <graph string="Environmental Trends" type="line">
                <field name="period_end" type="row"/>
                <field name="water_per_pair_liters" type="measure"/>
                <field name="energy_per_pair_kwh" type="measure"/>
                <field name="waste_recycled_percent" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_fw_environmental_record" model="ir.actions.act_window">
        <field name="name">Environmental Records</field>
        <field name="res_model">fw.environmental.record</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first environmental data entry</p>
        </field>
    </record>
</odoo>
