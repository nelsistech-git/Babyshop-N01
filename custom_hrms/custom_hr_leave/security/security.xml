<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups" id="group_leave_requester">
       <field name="name">Employee Leave Requester</field>
    </record>

    <record id="group_employee_leave_requester_viewer_view_all" model="ir.rule">
        <field name="name">Employee Leave Requester</field>
        <field name="model_id" ref="model_hr_leave"/>
        <field name="domain_force">[('user_work_location_id.id','=',user.user_work_location_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('custom_hr_leave.group_leave_requester'))]"/>
    </record>

    <!--from common settings-->
    <record id="group_hr_timeoff_root_menu" model="res.groups">
        <field name="name">HR- Time Off</field>
        <field name="category_id" ref="custom_common_settings.root_menu_access_group_category"/>
    </record>

</odoo>