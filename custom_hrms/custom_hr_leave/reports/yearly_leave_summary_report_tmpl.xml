<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="paperformat_yearly_leave_report" model="report.paperformat">
            <field name="name">Yearly Leave Report Paperformat</field>
            <field name="default" eval="True"/>
            <field name="format">Legal</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">25</field>
            <field name="dpi">120</field>
        </record>

        <record id="yearly_leave_report_tmpl" model="ir.actions.report">
            <field name="name">Yearly Leave Summary Report</field>
            <field name="model">yearly.leave.summary.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_hr_leave.yearly_leave_report_view</field>
            <field name="report_file">custom_hr_leave.yearly_leave_report_view</field>
            <field name="paperformat_id" ref="custom_hr_leave.paperformat_yearly_leave_report"/>
        </record>

        <template id="yearly_leave_report_view">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style type="text/css">
                            th, tr, td {
                                background: white !important;
                                border: 1px solid black !important;
                            }
                        </style>
                        <div class="oe_structure"/>
                        <div>
                            <h3 class="text-center head_font_color">
                                <strong>
                                    <span t-esc="form['company_id'][1]"/>
                                    <br/>
                                    Yearly Leave Summary Report
                                    <br/>
                                    For the year of <span t-esc="year"/>
                                </strong>
                            </h3>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p style="color: #000; font-size: 15px;">
                                    <strong>Work/Job Location:</strong>
                                    <t t-esc="work_location_name"/>
                                    <t t-if="buisness_unit">
                                        <br/>
                                        <strong>Office/business Unit:</strong>
                                        <t t-esc="buisness_unit"/>
                                    </t>
                                </p>
                            </div>
                            <div class="col-6 text-right">
                                <p style="color: #000; font-size: 15px;">
                                    <strong>Department Name:</strong>
                                    <t t-esc="dept_name"/>
                                    <t t-if="tag_names_list">
                                        <br/>
                                        <strong>Tags:</strong>
                                        <t t-esc="tag_names_list"/>
                                    </t>
                                </p>
                            </div>
                        </div>
                        <br/>

                        <t t-set="sl_no" t-value="1"/>

                        <t t-foreach="csr" t-as="line">
                            <t t-foreach="line" t-as="line2">
                                <div>
                                    <h6 class="text-left">
                                        <strong>
                                            Branch: <span t-esc="line[str(line2)][0]['loc_name']"/>
                                        <br/>
                                    </strong>
                                </h6>
                            </div>
                            <table style="border-collapse: collapse;width: 100%; margin-bottom: 2em;" class="table table-condensed">
                                <thead>
                                    <tr>
                                        <th rowspan="2" class="text-center align-middle bg_color font_color">Sl.
                                                No.</th>
                                        <th rowspan="2" class="text-left align-middle bg_color font_color">Employee
                                                Name</th>
                                        <th rowspan="2" class="text-left align-middle bg_color font_color">Employee
                                                ID</th>
                                        <th rowspan="2" class="text-left align-middle bg_color font_color">Work/Job
                                                Location</th>
                                        <th rowspan="2" class="text-left align-middle bg_color font_color">
                                                Department</th>
                                        <th rowspan="2" class="text-left align-middle bg_color font_color">
                                                Designation</th>
                                        <th t-att-colspan="len(leave_type_list)" class="text-center align-middle bg_color font_color">Allowable
                                                Leave</th>
                                        <t t-foreach="len(leave_type_list)" t-as="l">
                                            <th colspan="12" class="text-center align-middle bg_color font_color">
                                                    Total <span t-esc="leave_type_list[l]['leave_name']"/>
                                            <span t-esc="year"/>
                                        </th>
                                    </t>
                                    <th colspan="3" class="text-center align-middle bg_color font_color">
                                                Balance Leave
                                    </th>
                                </tr>
                                <tr>
                                    <t t-foreach="len(leave_type_list)" t-as="l">
                                        <th class="text-center align-middle bg_color font_color">
                                            <span t-esc="leave_type_list[l]['leave_name']"/>
                                        </th>
                                    </t>
                                    <t t-foreach="len(leave_type_list)" t-as="l">
                                        <th class="text-center align-middle bg_color font_color">Jan</th>
                                        <th class="text-center align-middle bg_color font_color">Feb</th>
                                        <th class="text-center align-middle bg_color font_color">Mar</th>
                                        <th class="text-center align-middle bg_color font_color">Apr</th>
                                        <th class="text-center align-middle bg_color font_color">May</th>
                                        <th class="text-center align-middle bg_color font_color">Jun</th>
                                        <th class="text-center align-middle bg_color font_color">Jul</th>
                                        <th class="text-center align-middle bg_color font_color">Aug</th>
                                        <th class="text-center align-middle bg_color font_color">Sep</th>
                                        <th class="text-center align-middle bg_color font_color">Oct</th>
                                        <th class="text-center align-middle bg_color font_color">Nov</th>
                                        <th class="text-center align-middle bg_color font_color">Dec</th>
                                    </t>
                                    <t t-foreach="len(leave_type_list)" t-as="l">
                                        <th class="text-center align-middle bg_color font_color">
                                            <span t-esc="leave_type_list[l]['leave_name']"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody class="consumed_tbody">
                                <t t-foreach="line[str(line2)]" t-as="line3">
                                    <tr>
                                        <td class="text-center align-middle">
                                            <span t-esc="sl_no"/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line3['emp_name']"/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line3['old_emp_id']"/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line3['loc_name']"/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line3['dept_name']"/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line3['job_name']"/>
                                        </td>
                                        <t t-foreach="line3['leave_types']" t-as="type">
                                            <td class="text-center align-middle">
                                                <span t-esc="type['alloc_count']"/>
                                            </td>
                                        </t>
                                        <t t-foreach="line3['leave_types']" t-as="type">
                                            <td class="text-center align-middle">
                                                <span t-esc="type['1']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['2']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['3']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['4']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['5']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['6']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['7']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['8']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['9']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['10']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['11']"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-esc="type['12']"/>
                                            </td>
                                        </t>
                                        <t t-foreach="line3['leave_types']" t-as="type">
                                            <td class="text-center align-middle">
                                                <span t-esc="type['leave_remain']"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-set="sl_no" t-value="sl_no + 1"/>
                                </t>
                            </tbody>
                        </table>
                        <t t-set="sl_no" t-value="1"/>
                    </t>
                </t>
            </div>
        </t>
    </t>
</template>
</data>
</odoo>