<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Employee Form View -->
        <record id="inherited_hr_emp_employee_inherit_custom_hr_leave" model="ir.ui.view">
            <field name="name">HR inherited</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_leave_allocate" string="Leave Allocate" type="object"
                            groups="base.group_erp_manager,base.group_system"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
