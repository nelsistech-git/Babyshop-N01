    <record id="inherited_hr_leave_view_tree_inherit_custom_hr_leave" model="ir.ui.view">
        <field name="name">inherited.hr.leave.view.tree.inherit.custom.hr.leave</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name='delete'>0</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="user_work_location_id"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="first_approve_reject" optional="hide"/>
                <field name="first_approve_reject_id" optional="hide"/>
                <field name="second_approve_reject" optional="hide"/>
                <field name="second_approve_reject_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- HR Leave Details Tree View -->
    <record id="view_hr_leave_details_tree" model="ir.ui.view">
        <field name="name">hr.leave.details.tree</field>
        <field name="model">hr.leave.details</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" editable="bottom">
                <field name="leave_id"
                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                <field name="employee_id"
                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                <field name="leave_date"/>
                <field name="leave_no"/>
            </tree>
        </field>
    </record>

    <!-- HR Leave Details Search View -->
    <record id="view_hr_leave_details_search" model="ir.ui.view">
        <field name="name">hr.leave.details.search</field>
        <field name="model">hr.leave.details</field>
        <field name="arch" type="xml">
            <search string="Time Off Details Search">
                <field name="employee_id"/>
                <group expand="0" string="Group By" colspan="4">
                    <filter string="Date" name="group_by_leave_date" context="{'group_by':'leave_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- HR Leave Details Action -->
    <record id="action_hr_leave_details" model="ir.actions.act_window">
        <field name="name">Time Off Details</field>
        <field name="res_model">hr.leave.details</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_hr_leave_details_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an HR Time Off Details!
            </p>
        </field>
    </record>

    <!-- HR Leave Detail Menu -->
    <menuitem id="menu_hr_leave_details" name="Time Off Details" parent="hr_holidays.menu_hr_holidays_management"
              action="action_hr_leave_details" groups="base.group_system" sequence="11"/>

