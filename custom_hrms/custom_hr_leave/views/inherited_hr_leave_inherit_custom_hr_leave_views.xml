                <attribute name="options">{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
                <attribute name="context">{'employee_id':employee_id}</attribute>
            </xpath>
            <xpath expr="//field[@name='holiday_type']" position="attributes">
                <attribute name="groups">hr_holidays.group_hr_holidays_user, custom_hr_leave.group_leave_requester</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name='options'>{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
                <attribute name="groups">hr_holidays.group_hr_holidays_user, custom_hr_leave.group_leave_requester</attribute>
            </xpath>-->
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="id_card_no" readonly="1" force_save="1"
                       groups="hr_holidays.group_hr_holidays_user,custom_hr_leave.group_leave_requester"
                       invisible="holiday_type!='employee'" required="holiday_type=='employee'"/>
                <field name="job_id" readonly="1" force_save="1"
                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                       groups="hr_holidays.group_hr_holidays_user,custom_hr_leave.group_leave_requester"
                       invisible="holiday_type!='employee'"/> <!--'required': [('holiday_type', '=', 'employee')], -->
                <field name="user_work_location_id" readonly="1" force_save="1"
                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                       groups="hr_holidays.group_hr_holidays_manager"
                       invisible="holiday_type!='employee'"/> <!--'required': [('holiday_type', '=', 'employee')], -->
            </xpath>
            <!--<xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name='attrs'>{'readonly': [('holiday_type', '=', 'employee')]}</attribute>
                <attribute name='force_save'>1</attribute>
