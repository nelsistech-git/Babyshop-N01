                <attribute name='options'>{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
            </xpath>-->

            <xpath expr="//group[@name='col_left']" position="after">
                <!-- <div >-->
                <notebook>
                    <page string="Requested Employee"> <!--nolabel="1" -->
                        <field readonly="1" name="requested_employee_ids" string="Requested Employee">
                            <tree>
                                <field name="employee_id"/>
                                <field name="request_date_from"/>
                                <field name="request_date_to"/>
                            </tree>
                            <form>
                                <group>
                                    <field name="employee_id"/>
                                    <field name="request_date_from"/>
