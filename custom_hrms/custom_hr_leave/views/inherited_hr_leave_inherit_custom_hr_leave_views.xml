<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="inherited_hr_leave_view_form_manager_inherit_custom_hr_leave" model="ir.ui.view">
        <field name="name">inherited.hr.leave.view.form.manager.inherit.custom.hr.leave</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_refuse']" position="after">
                <button string="Missing Generate" name="action_missing_generate" type="object"
                        invisible="can_approve == False or state not in ('confirm','validate','validate1')"
                        groups="base.group_system"/>
                <button string="Refresh Request" name="action_refresh_request" type="object"
                        invisible="state not in ('confirm','validate','validate1')"
                        groups="hr_holidays.group_hr_holidays_manager,hr.group_hr_manager" class="oe_highlight"/>
            </xpath>
            <xpath expr="//button[@name='action_approve']" position="replace">
                <button string="Department Approve" name="action_approve_dept" type="object" class="oe_highlight"
                        invisible="can_approve == False or state != 'confirm'"/>
                <button string="HR Approve" name="action_approve_hr" type="object" class="oe_highlight"
                        invisible="can_approve == False or state != 'confirm2'" groups="hr.group_hr_manager"/>
                <button string="Management Approve" name="action_approve" type="object" class="oe_highlight"
                        invisible="can_approve == False or state != 'confirm3'"
                        groups="hr_holidays.group_hr_holidays_manager"/>
            </xpath>
            <!--<xpath expr="//button[@name='action_draft']" position="replace">
                <button string="Reset to Draft" name="action_draft" type="object"
                        attrs="{'invisible': ['|', ('can_reset', '=', False), ('state', 'not in', ['confirm','confirm2','confirm3', 'refuse'])]}"/>
            </xpath>-->

            <xpath expr="//button[@name='action_refuse']" position="replace">
                <button string="Refuse" name="action_refuse" type="object"
                        invisible="can_approve == False or state not in ('confirm','confirm2','confirm3','validate','validate1')"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="confirm,confirm2,confirm3,validate"/>
            </xpath>

            <xpath expr="//form/sheet/field[@name='tz_mismatch']" position="after">
                <div class="oe_button_box" name="button_box"
                     groups="custom_common_settings.group_branch_manager, hr_holidays.group_hr_holidays_user">
                    <button name="act_hr_employee_holiday_request"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                            groups="custom_common_settings.group_branch_manager,hr_holidays.group_hr_holidays_user"
                            help="Remaining leaves">
                        <div class="o_field_widget o_stat_info"
                             groups="custom_common_settings.group_branch_manager,hr_holidays.group_hr_holidays_user">
                            <span class="o_stat_value">
                                <field name="leaves_count"
                                       groups="custom_common_settings.group_branch_manager,hr_holidays.group_hr_holidays_user"/>
                                /<field name="allocation_count"
                                        groups="custom_common_settings.group_branch_manager,hr_holidays.group_hr_holidays_user"/>
                                Days
                            </span>
                            <span class="o_stat_text"
                                  groups="custom_common_settings.group_branch_manager,hr_holidays.group_hr_holidays_user">
                                Time Off
                            </span>
                        </div>
                    </button>
                    <button name="act_leave_details" type="object" class="oe_stat_button" icon="fa-calendar"
                            groups="base.group_system">
                        <field name="leave_details" widget="statinfo" string="Leave Details"
                               groups="base.group_system"/>
                    </button>
                </div>
            </xpath>
            <!--<xpath expr="//field[@name='number_of_days']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>-->
            <!--<xpath expr="//field[@name='holiday_type']" position="replace"/>
