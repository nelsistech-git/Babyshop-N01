                                </group>
                            </form>

                        </field>
                    </page>
                </notebook>

                <!--<group></group>-->
                <!--</div>-->
            </xpath>
            <!--<xpath expr="//field[@name='mode_company_id']" position="attributes">
                <attribute name="groups">hr_holidays.group_hr_holidays_user, custom_hr_leave.group_leave_requester</attribute>
                <attribute name='options'>{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
