<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_attendance_sheet_wizard" model="ir.ui.view">
        <field name="name">view.batch.attendance.sheet.wizard</field>
        <field name="model">batch.attendance.sheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Attendance Sheet">
                <field name="user_work_location_id" invisible="1"/>
                <field name="department_id" invisible="1"/>
                <field name="date_from" invisible="1"/>
                <field name="date_to" invisible="1"/>
                <!--<group >-->
                <separator string="Employees" />
                <!--<newline/>-->
                <field name="employee_ids" widget="many2many_tags" options="{'no_open': True,'no_create': 1,
                    'no_create_edit': 1}"/>
               <!-- </group>-->
                <footer>
                    <button icon="fa-cogs" string="Generate" name="generate_att_sheet" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
           </form>
        </field>
    </record>

    <record id="action_batch_attendance_sheet_wizard" model="ir.actions.act_window">
        <field name="name">Generate Attendance Sheets</field>
        <field name="res_model">batch.attendance.sheet.wizard</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_batch_attendance_sheet_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
