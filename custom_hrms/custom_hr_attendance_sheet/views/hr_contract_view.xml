<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_form" model="ir.ui.view">
        <field name="name">hr.contract.view</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hr_responsible_id']" position="after">
                <field name="att_policy_id" required="1"
                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
            </xpath>

            <xpath expr="//field[@name='job_id']" position="attributes">
                <attribute name="domain">['|', ('company_id', '=', False), ('company_id', '=', company_id),
                                          ('department_id', '=', department_id)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>


