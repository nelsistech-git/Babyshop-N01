<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="hr_employee_wppf_details_view_form" model="ir.ui.view">
            <field name="name">hr.employee.wppf.form</field>
            <field name="model">hr.employee.wppf</field>
            <field name="arch" type="xml">
                <form string="Employee WPPF">
                    <sheet>
                        <group name="employee_wppf">
                            <group>
                                <field name="employee_id" required="1"
                                       options="{'no_open': True,'no_create': True, 'no_create_edit': True}"/>
                                <field name="year" required="1"/>
                                <field name="month" required="1"/>
                            </group>
                            <group>
                                <field name="pf_amount" required="1"/>
                                <field name="cpf_amount" readonly="1" force_save="1"/>
                                <field name="total_pf_amount" readonly="1"/>
                                <field name="contribution_type" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--Tree View-->
        <record id="hr_employee_wppf_details_tree" model="ir.ui.view">
            <field name="name">hr.employee.wppf.tree</field>
            <field name="model">hr.employee.wppf</field>
            <field name="arch" type="xml">
                <tree string="Employee Provident Fund Information" decoration-success="state=='done'"
                      decoration-info="state=='draft'">
                    <field name="employee_id" readonly="1"/>
                    <field name="year"/>
                    <field name="month"/>
                    <field name="pf_amount" sum="Total"/>
                    <field name="cpf_amount" sum="Total"/>
                    <field name="total_pf_amount" sum="Total"/>
                    <field name="contribution_type" readonly="1"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="hr_employee_wppf_details_search" model="ir.ui.view">
            <field name="name">hr.employee.wppf.search</field>
            <field name="model">hr.employee.wppf</field>
            <field name="arch" type="xml">
                <search string="Search PF contribution">
                    <field name="employee_id"/>
                    <field name="month"/>
                    <field name="contribution_type"/>
                    <field name="state"/>

                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Done" name="done" domain="[('state','=','done')]"/>
                    <filter string="Closed" name="close" domain="[('state','=','close')]"/>
                    <separator/>
                    <filter string="WPPF" name="wppf" domain="[('contribution_type','=','wppf')]"/>
                    <filter string="Profit" name="profit" domain="[('contribution_type','=','profit')]"/>
                    <separator/>

                    <group expand="1" string="Group By">
                        <filter string="Year" name="year" context="{'group_by':'year'}"/>
                        <filter string="Month" name="month" context="{'group_by':'month'}"/>
                        <filter string="State" name="state" context="{'group_by':'state'}"/>
                        <filter string="Contribution Type" name="contribution_type"
                                context="{'group_by':'contribution_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="hr_employee_wppf_details_action" model="ir.actions.act_window">
            <field name="name">Employee WPPF Contribution</field>
            <field name="res_model">hr.employee.wppf</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the First Employee WPPF</p>
            </field>
        </record>

        <!-- This Menu Item will appear in the Upper bar, That's why It needs NO parent or action -->
        <menuitem id="menu_hr_employee_wppf_root" name="WPPF" sequence="27"
                  web_icon="wppf,static/description/wppf_icon.png"
                  groups="wppf.group_hr_wppf_root_menu"/>

        <menuitem id="menu_hr_employee_wppf_root_sub_pf"
                  name="WPPF Contribution"
                  sequence="1"
                  action="hr_employee_wppf_details_action"
                  parent="menu_hr_employee_wppf_root"/>

    </data>
</odoo>