<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_loan_emi_form" model="ir.ui.view">
		<field name="name">view.loan.emi.form</field>
		<field name="model">installment.line</field>
		<field name="arch" type="xml">
			<form string="Installment Form">
                <header>
                    <button name="%(loan_installment_payment_wizard_action)d" string="Paid Installment" type="action" invisible="is_paid == True or is_skip == True" groups="account.group_account_manager"/>
				</header>

				<sheet>
                    <group>
                        <group>
                            <field name="loan_id" readonly="1" />
                             <field name="employee_id" readonly="1"  />
                             <field name="amount" readonly="1"  />
                            <field name="interest" readonly="1"  />
                        </group>
                        <group>
                             <field name="name" readonly="1" />
                             <field name="date" readonly="1"  />
                             <field name="installment_amt" readonly="1"  />
                            <field name="ins_interest" readonly="1"  />
                             <field name="total_installment" readonly="1"  />
                             <field name="is_paid" readonly="1"  />
                             <field name="paid_date" readonly="1"  />
                            <field name="is_skip" readonly="1"  />
                            <field name="payslip_id" readonly="1"  />
                             <field name="move_id" readonly="1" groups="account.group_account_manager"/>
                        </group>
                    </group>
				</sheet>
			</form>
		</field>
	</record>
    <record id="installment_line_tree" model="ir.ui.view">
        <field name="name">installment.line.tree</field>
        <field name="model">installment.line</field>
        <field name="arch" type="xml">
            <tree string="Loan Installment">
                <field name="name"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="interest"/>
                <field name="installment_amt"/>
                <field name="ins_interest"/>
                <field name="total_installment"/>
                <field name="is_skip" readonly="1"  />
                <field name="is_paid" readonly="1"  />
                <field name="paid_date" readonly="1"  />
            </tree>
        </field>
    </record>
    
    
    <record model="ir.actions.act_window" id="action_installment_line">
        <field name="name">Installment Loan</field>
        <field name="res_model">installment.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context"></field>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
          </p>
        </field>
    </record>
    <record id="action_installment_line_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="installment_line_tree"/>
        <field name="act_window_id" ref="action_installment_line"/>
    </record>
    <record id="action_installment_line_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_loan_emi_form"/>
        <field name="act_window_id" ref="action_installment_line"/>
    </record>


</odoo>
