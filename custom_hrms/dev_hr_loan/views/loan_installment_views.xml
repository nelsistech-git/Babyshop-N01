<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_emp_loan_installment_form" model="ir.ui.view">
		<field name="name">view.installment.line.form</field>
		<field name="model">installment.line</field>
		<field name="arch" type="xml">
			<form string="Loan Installment" create="0" edit="0" delete="0">
                <group>
                    <group>
                        <field name="loan_id"/>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="date"/>
                        <field name="is_paid"/>
                        <field name="paid_date"/>
                        <field name="amount" style="font-weight:bold;"/>
                        <field name="interest"/>
                        <field name="ins_interest"/>
                        <field name="installment_amt"/>
                        <field name="total_installment" style="font-weight:bold;"/>
                    </group>
                    <group>
                        <field name="payslip_id"/>
                        <field name="is_skip"/>
                        <field name="is_early_settlement"/>
                        <field name="is_remission"/>
                        <field name="move_id"/>
                    </group>
                </group>
            </form>
		</field>
	</record>
    <record id="view_emp_loan_installment_tree" model="ir.ui.view">
        <field name="name">view.installment.line.tree</field>
        <field name="model">installment.line</field>
        <field name="arch" type="xml">
            <tree string="Loan Installment" create="false" delete="false" edit="false">
                <field name="loan_id"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="is_paid"/>
                <field name="paid_date"/>
                <field name="amount"/>
                <field name="interest"/>
                <field name="ins_interest"/>
                <field name="installment_amt"/>
                <field name="total_installment" sum="total_installment"/>
                <field name="payslip_id"/>
                <field name="is_skip"/>
                <field name="is_early_settlement"/>
                <field name="is_remission"/>
                <field name="move_id"/>
            </tree>
        </field>
    </record>
    
    <record id="view_emp_loan_installment_filter" model="ir.ui.view">
        <field name="name">installment.line.filter</field>
        <field name="model">installment.line</field>
        <field name="arch" type="xml">
            <search string="Search Installment">
                <field name="name" string="Installment" filter_domain="[('name','ilike',self)]"/>
                <field name="loan_id"/>
                <field name="employee_id"/>
                <field name="paid_date"/>
                <field name="payslip_id"/>
                <field name="move_id"/>
                <separator/>
                <filter name="is_paid" string="Is Paid" domain="[('is_paid','=',True)]" />
                <filter name="is_paid" string="Not Paid" domain="[('is_paid','=',False)]" />
                <separator/>
                <filter name="is_skip" string="Is Skip" domain="[('is_skip','=',True)]" />
                <filter name="is_skip" string="Not Skip" domain="[('is_skip','=',False)]" />
                <separator/>
                <filter name="is_early_settlement" string="Is Early Settlement" domain="[('is_early_settlement','=',True)]" />
                <filter name="is_early_settlement" string="Not Early Settlement" domain="[('is_early_settlement','=',False)]" />
                <separator/>
                <filter name="is_remission" string="Is Remission" domain="[('is_remission','=',True)]" />
                <filter name="is_remission" string="Not Remission" domain="[('is_remission','=',False)]" />

                <group expand="0" string="Group By">
                    <filter string="Employees" name="employee_id" context="{'group_by':'employee_id'}"/>
                    <filter string="Loans" name="loan_id" context="{'group_by':'loan_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="action_emp_loan_installment">
        <field name="name">Loan Installment</field>
        <field name="res_model">installment.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_emp_loan_installment_filter" />
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            	Click to define a new Loan Installment.
          </p>
        </field>
    </record>

    <record id="action_emp_loan_installment_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_emp_loan_installment_tree"/>
        <field name="act_window_id" ref="action_emp_loan_installment"/>
    </record>
    <record id="action_emp_loan_installment_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_emp_loan_installment_form"/>
        <field name="act_window_id" ref="action_emp_loan_installment"/>
    </record>

    <menuitem name="Employee Loan Installment" id="menu_emp_loan_installment" parent="dev_hr_loan.menu_main_employee_loan_sub" action="action_emp_loan_installment" groups="hr.group_hr_user"/>
    <menuitem name="Employee Loan Installment" id="menu_emp_loan_installment_pf" parent="menu_hr_loan_pf_sub" action="action_emp_loan_installment" groups="hr.group_hr_user" sequence="4"/>

</odoo>
