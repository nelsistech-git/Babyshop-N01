<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_employee_loan_remission_type_form" model="ir.ui.view">
		<field name="name">view.loan.remission.type.form</field>
		<field name="model">loan.remission.type</field>
		<field name="arch" type="xml">
			<form string="Employee Loan Remission Type">
				<sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="debit_account_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                        <group>
                            <field name="credit_account_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
				</sheet>
			</form>
		</field>
	</record>
    <record id="view_employee_loan_remission_type_tree" model="ir.ui.view">
        <field name="name">view.loan.remission.type.tree</field>
        <field name="model">loan.remission.type</field>
        <field name="arch" type="xml">
            <tree string="Employee Loan Remission Type">
                <field name="name"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_employee_loan_remission_type">
        <field name="name">Employee Loan Remission Type</field>
        <field name="res_model">loan.remission.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Loan Remission Type" id="menu_employee_loan_remission_type" parent="menu_main_employee_loan_config"
              action="action_employee_loan_remission_type"
              groups="hr.group_hr_user" sequence="2"/>

</odoo>
