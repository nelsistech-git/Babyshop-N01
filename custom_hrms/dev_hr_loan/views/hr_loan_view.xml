   <!-- request-->
    <record id="view_employee_loan_form_request" model="ir.ui.view">
		<field name="name">view.employee.loan.request.form</field>
		<field name="model">employee.loan</field>
		<field name="arch" type="xml">
			<form string="Employee Loan Request">
				<header>
                    <button name="compute_installment" invisible="state not in ('draft','request','dep_approval','hr_approval','acc_approval')" string="Compute Installment"
                            class="btn-primary" type="object" groups="base.group_user"/>

                    <button name="action_send_request" invisible="state not in ('draft')" string="Submit Request"
                            class="btn-primary" type="object" groups="base.group_user"/>

                    <field name="is_dm" invisible="1"/>

                    <button name="set_to_draft" invisible="state not in ('cancel','reject')" string="Set to Draft" type="object"
                            groups="base.group_user"/>
                    <button name='action_loan_application_print' string='Print Application' type="object" /> <!--attrs="{'invisible':[('state','in',['close','reject','cancel'])]}"-->

					<field name="state" widget="statusbar" statusbar_visible="draft,request,dep_approval,hr_approval,acc_approval,trusty_approval,paid,done"/>
				</header>
				<sheet>

                	<label for="name" class="oe_edit_only"/>
                	<h1><field name="name" readonly="1"/></h1>

                    <label for="loan_type_id" />
                    <field name="loan_type_id" readonly="state != 'draft'" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                    <field name="type_id_type" invisible="1"/>

                    <group >
                        <group string="Employee Information">
                            <field name="employee_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="company_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="partner_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="job_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="joining_date"/>
                            <field name="date_of_confirmation"/>
                            <field name="loan_url" invisible="1"/>
                            <field name="user_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="hr_manager_id" invisible="1"/>
                            <field name="move_id" invisible="1" />
                            <field name="manager_id" readonly="state != 'draft'" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>

                        </group>
                        <group string="Account Status">
                                <field name="current_balance" readonly="1" force_save="1"/>
                                <field name="eligible_amount" readonly="1" force_save="1"/>
                                <field name="eligible_pf" string="Eligible (PF)" readonly="1" force_save="1" invisible="type_id_type != 'pf_loan'" />
                                <field name="eligible_cpf" string="Eligible (CPF)" readonly="1" force_save="1" invisible="type_id_type != 'pf_loan'" />

                                <field name="current_loan" readonly="1" force_save="1"/>
                                <field name="applicable_amount" readonly="1" force_save="1" style="font-weight:bold;"/>

                                <field name="notes" readonly="state not in ('draft','request')" required="1"/>
                        </group>
                    </group>

                    <group string="Loan Information">
                        <group>
                            <field name="is_apply_interest" invisible="1"/>

                            <field name="start_date_requested" readonly="state != 'draft'" required="state == 'draft'" />

                            <field name="requested_amount" readonly="state != 'draft'" required="1" style="font-weight:bold;"/>
                            <field name="approved_amount" readonly="1" force_save="1" style="font-weight:bold;"/>
                            <field name="loan_amount" readonly="state != 'draft'" force_save="1" style="font-weight:bold;" invisible="1"/>
                            <field name="loan_amount_pf" readonly="1" force_save="1" invisible="type_id_type != 'pf_loan'" />
                            <field name="loan_amount_cpf" readonly="1" force_save="1" invisible="type_id_type != 'pf_loan'" />

                            <field name="distributed_by" readonly="state != 'draft'" required="1"/>
                            <field name="term" required="1" readonly="state != 'draft' or distributed_by == 'inst'" force_save="1"/>
                            <field name="installment_amount" required="1" readonly="state != 'draft' or distributed_by == 'term'" force_save="1"/>
                            <field name="installment_amount_previous" readonly="1" force_save="1"/>

                            <field name="interest_amount" invisible="is_apply_interest != True"/>
                            <field name="extra_in_amount" invisible="is_apply_interest != True"/>
                            <field name="payment_method" readonly="state != 'draft'"/>
                            <field name="is_revised" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="approve_date" readonly="1"/>
                            <field name="end_date"/>
                            <field name="paid_amount" style="font-weight:bold;" decoration-success="(paid_amount &gt; 0)"/>
                            <field name="remaing_amount" style="font-weight:bold;" decoration-danger="(remaing_amount &gt; 0)"/>
                            <field name="remaining_pf" string="Remaining (PF)" readonly="1" force_save="1" invisible="type_id_type != 'pf_loan'" />
                            <field name="remaining_cpf" string="Remaining (CPF)" readonly="1" force_save="1" invisible="type_id_type != 'pf_loan'" />

                            <field name="interest_rate" invisible="is_apply_interest != True" readonly="state != 'draft'"/>
                            <field name="interest_type" invisible="is_apply_interest != True" readonly="state != 'draft'"/>

                            <field name="is_apply_top_up" readonly="1" force_save="1"/>


                        </group>
                    </group>

                    <notebook>
                        <page string="Installment">
                            <br/>
                            <field name="installment_lines" readonly="1" >
                                <tree string="Installment" decoration-success="is_paid == True"  decoration-muted="is_skip == True">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount" invisible="1"/>
                                    <field name="interest" invisible="1"/>
                                    <field name="installment_amt" sum="installment_amt"/>
                                    <field name="ins_interest" sum="ins_interest"/>
                                    <field name="total_installment" sum="total_installment"/>

                                    <field name="is_paid" /><!-- invisible="1" -->
                                    <field name="is_skip" /><!-- invisible="1" -->
                                </tree>
                                <form string="Installment">
                                    <group>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount" invisible="1"/>
                                    <field name="interest" invisible="1"/>
                                    <field name="installment_amt" />
                                    <field name="ins_interest" />
                                    <field name="total_installment" />
                                    <field name="is_paid" />
                                    <field name="is_skip" />
                                    </group>
                                </form>
                            </field>
                        </page>


                        <page string='Reject Reason' invisible="state != 'reject'">
                            <br/>
                            <field name="reject_reason" readonly="1"/>
                        </page>
                    </notebook>
				</sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
			</form>
		</field>
	</record>

    <record model="ir.actions.act_window" id="action_employee_loan_request">
        <field name="name">Employee Loan Requests</field>
        <field name="res_model">employee.loan</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_loans':1}</field>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            	Click to define a new loan.
          </p>
        </field>
    </record>
    <record id="action_employee_loan_request_tree" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_employee_loan_tree"/>
        <field name="act_window_id" ref="action_employee_loan_request"/>
    </record>
    <record id="action_employee_loan_request_from" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_loan_form_request"/>
        <field name="act_window_id" ref="action_employee_loan_request"/>
    </record>
    <!--end request-->

    <menuitem name="Employee Loan" id="menu_employee_loan" parent="menu_main_employee_loan_sub" groups="hr.group_hr_user,group_loan_requester" action="action_employee_loan"/>
    <menuitem id="hr_loan_expenses" name="Employee Loan" parent="hr_payroll.menu_root_hr_related_expenses" action="dev_hr_loan.action_employee_loan" groups="account.group_account_manager" sequence="1"/>

    <!--Under PF menu-->
    <menuitem name="Loan Requests" id="menu_employee_loan_pf_request" parent="menu_hr_loan_pf_sub" groups="hr.group_hr_user,group_loan_requester" action="action_employee_loan_request" sequence="1"/>
    <menuitem name="Employee Loan All" id="menu_employee_loan_pf" parent="menu_hr_loan_pf_sub" groups="hr.group_hr_user" action="action_employee_loan" sequence="2"/>

</odoo>
