<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_emp_loan_early_settle_remission_wizard_form" model="ir.ui.view">
            <field name="name">emp.loan.early.settle.remission.wizard.form</field>
            <field name="model">emp.loan.early.settle.remission.wizard</field>
            <field name="arch" type="xml">
                <form string="Early Settlement/Remission">
                    <group>
                        <group>
                            <field name="type" widget="radio"/>
                            <field name="employee_id" readonly="1"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="loan_amt" readonly="1"/>
                            <field name="remain_amt" readonly="1"/>
                            <field name="paid_amt" readonly="1"/>
                            <field name="term" readonly="1"/>
                        </group>
                        <group>
                            <field name="remission_reason" invisible="type == 'es'" required="remission_reason == '1'"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="amount" string="Settlement Amount" invisible="type == 'remission'"
                                   force_save="1"/>
                            <field name="amount" string="Remission Amount" invisible="type == 'es'" force_save="1"/>
                            <field name="new_remain_amt" readonly="1" force_save="1"/>
                            <field name="remain_term" readonly="1" force_save="1"/>
                            <field name="journal_id"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                   required="1"/>
                            <field name="debit_account_id"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                   required="1"/>
                            <field name="credit_account_id"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                   required="1"/>
                            <field name="paid_date" required="1"/>

                        </group>
                    </group>
                    <footer>
                        <button name="recompute_inst_and_confirm" string="Recompute Installment &amp; Confirm"
                                type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="emp_loan_early_settle_remission_wizard_action" model="ir.actions.act_window">
            <field name="name">Early Settlement/Remission</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">emp.loan.early.settle.remission.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_emp_loan_early_settle_remission_wizard_form"/>
            <field name="target">new</field>
        </record>


        <record id="view_loan_installment_payment_wizard_form" model="ir.ui.view">
            <field name="name">loan.installment.payment.wizard.form</field>
            <field name="model">loan.installment.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="Loan Installment Payment">
                    <group>
                        <group>
                            <field name="loan_id"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                   readonly="1" force_save="1"/>
                            <field name="employee_id" readonly="1"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="partner_id" readonly="1"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="installment_id" readonly="1"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                   force_save="1"/>
                            <field name="date" readonly="1"/>
                            <field name="installment_amt" readonly="1"/>
                            <field name="ins_interest" readonly="1"/>
                            <field name="total_installment" readonly="1"/>
                            <field name="paid_date" required="1"/>
                        </group>
                        <group>
                            <field name="journal_id"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                   required="1"/>
                            <field name="credit_account_id"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                   required="1"/>
                            <field name="debit_account_id"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                   required="1"/>
                            <field name="interest_account_id"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                   required="ins_interest > 0"/>
                        </group>
                    </group>
                    <footer>
                        <button name="confirm" string="Confirm Paid" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="loan_installment_payment_wizard_action" model="ir.actions.act_window">
            <field name="name">Loan Installment Payment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">loan.installment.payment.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_loan_installment_payment_wizard_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
