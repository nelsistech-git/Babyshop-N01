<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_loan_reschedule_wizard_form" model="ir.ui.view">
            <field name="name">loan.reschedule.wizard.form</field>
            <field name="model">loan.reschedule.wizard</field>
            <field name="arch" type="xml">
                <form string="Loan Reschedule">
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"
                                   options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="loan_amt" readonly="1"/>
                            <field name="paid_amt" readonly="1"/>
                            <field name="remain_amt" readonly="1"/>
                            <field name="term" readonly="1"/>
                            <field name="installment_amt" readonly="1"/>
                        </group>
                        <group>
                            <field name="distributed_by" widget="radio" required="1"/>
                            <field name="new_term" readonly="distributed_by == 'inst'" required="1" force_save="1"/>
                            <field name="new_installment_amt" readonly="distributed_by == 'term'" required="1"
                                   force_save="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="recompute_inst_and_confirm" string="Loan Reschedule &amp; Confirm" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_loan_reschedule_wizard" model="ir.actions.act_window">
            <field name="name">Loan Reschedule</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">loan.reschedule.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_loan_reschedule_wizard_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
