<odoo>
    <data>
        <record model="ir.ui.view" id="custom_hr_employee_travelling.form">
            <field name="name">Employee Travelling Form</field>
            <field name="model">hr_employee_travelling</field>
            <field name="arch" type="xml">
                <form string="Employee Travelling Form">

                    <header>
                        <button name="button_confirm" string="Confirm"
                                type="object" groups="hr.group_hr_manager,hr.group_hr_user"
                                invisible="state in ('confirm', 'approve', 'done', 'cancel')"/>
                        <button name="button_approve" string="Approve"
                                type="object" groups="hr.group_hr_manager"
                                invisible="state in ('draft', 'approve', 'done', 'cancel')"/>
                        <button name="button_done" string="Done"
                                type="object" groups="hr.group_hr_manager"
                                invisible="state in ('draft', 'confirm', 'done', 'cancel')"/>
                        <button name="button_cancel" string="Cancel"
                                type="object" groups="hr.group_hr_manager,hr.group_hr_user"
                                invisible="state in ('confirm', 'approve', 'done', 'cancel')"/>
                        <button name="button_draft" string="Reset to Draft"
                                type="object" groups="hr.group_hr_manager,hr.group_hr_user"
                                invisible="state in ('draft', 'approve', 'done', 'cancel')"/>

                        <field name="state" widget="statusbar" clickable="0"/>
                    </header>

                    <sheet>
                        <group name="main" string="Employee Travelling Form">
                            <group>
                                <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="employee_id" options="{'no_open':True,'no_create':1,'no_create_edit':1}"
                                       domain="[('company_id', '=', company_id)]"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="designation_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="department_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Travelling Program">
                                <field name="employee_travelling_line_ids"
                                       mode="tree" options="{'reload_whole_on_button': true}">
                                    <tree string="Travelling Program">
                                        <field name="travel_date"/>
                                        <field name="travel_time" widget="float_time"/>
                                        <field name="location_from"/>
                                        <field name="location_to"/>
                                        <field name="purpose_of_visit"/>
                                    </tree>
                                    <form string="Travelling Program" create="false">
                                        <group>
                                            <group>
                                                <field name="travel_date"/>
                                                <field name="travel_time" widget="float_time"/>
                                            </group>
                                            <group>
                                                <field name="location_from"/>
                                                <field name="location_to"/>
                                            </group>
                                            <group colspan="2">
                                                <field name="purpose_of_visit"/>
                                            </group>
                                        </group>
                                        <!--                    <group string="Travel Expenses">-->
                                        <field name="travelling_expense_ids"
                                               mode="tree" options="{'reload_whole_on_button': true}">
                                            <tree delete="true">
                                                <field name="travel_expense_date"/>
                                                <field name="location_from"/>
                                                <field name="location_to"/>
                                                <field name="transport_mode"/>
                                                <field name="transport_cost"/>
                                                <field name="lodge"/>
                                                <field name="daily_allowance"/>
                                                <field name="refreshment"/>
                                                <field name="other_entertainment"/>
                                                <field name="total" readonly="1" force_save="1"/>
                                            </tree>
                                            <form string="Travelling Expenses" create="false" edit="false">
                                                <group>
                                                    <group>
                                                        <field name="travel_expense_date"/>
                                                        <field name="location_from"/>
                                                        <field name="location_to"/>
                                                    </group>
                                                    <group>
                                                        <field name="transport_mode"/>
                                                        <field name="transport_cost"/>
                                                    </group>
                                                    <group>
                                                        <field name="lodge"/>
                                                        <field name="daily_allowance"/>
                                                    </group>
                                                    <group>
                                                        <field name="refreshment"/>
                                                        <field name="other_entertainment"/>
                                                    </group>
                                                    <group colspan="2">
                                                        <field name="total" readonly="1"/>
                                                    </group>
                                                </group>
                                            </form>
                                        </field>
                                        <!--                    </group>-->
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="custom_hr_employee_travelling.list">
            <field name="name">Employee Travelling List</field>
            <field name="model">hr_employee_travelling</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="employee_id"/>
                    <field name="designation_id"/>
                    <field name="department_id"/>
                    <field name="company_id"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>


        <!-- actions opening views on models -->

        <record model="ir.actions.act_window" id="hr_employee_travelling_action_window">
            <field name="name">Employee Travelling</field>
            <field name="res_model">hr_employee_travelling</field>
            <field name="view_mode">tree,form</field>
        </record>


        <!-- server action to the one above -->
