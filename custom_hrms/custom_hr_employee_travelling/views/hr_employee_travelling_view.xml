                }
              </field>
            </record>
        -->

        <!-- Top menu item -->

        <menuitem name="HR- Travelling &amp; Conveyance" id="hr_employee_travelling_menu_root"
                  groups="custom_common_settings.group_hr_travelling_conv_root_menu" sequence="45"
                  web_icon="custom_hr_employee_travelling,static/description/icon.png"/>

        <!-- menu categories -->
        <!--
            <menuitem name="Menu 1" id="custom_hr_employee_travelling.menu_1" parent="custom_hr_employee_travelling.menu_root"/>
            <menuitem name="Menu 2" id="custom_hr_employee_travelling.menu_2" parent="custom_hr_employee_travelling.menu_root"/>
        -->
        <!-- actions -->

        <menuitem name="Employee Travelling" id="employee_travelling_tree"
                  parent="hr_employee_travelling_menu_root"
                  action="hr_employee_travelling_action_window"/>

        <menuitem id="employee_travelling_configuration"
                  name="Configuration" parent="hr_employee_travelling_menu_root" sequence="98"
                  groups="hr.group_hr_manager"/>

        <menuitem id="employee_conveyance_type"
                  name="Conveyance Settings" parent="employee_travelling_configuration" sequence="1"
                  action="action_employee_conveyance_type"
                  groups="hr.group_hr_user"/>
