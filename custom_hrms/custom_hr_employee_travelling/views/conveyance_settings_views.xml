<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_conveyance_settings_form" model="ir.ui.view">
		<field name="name">view.hr.conveyance.settings.form</field>
		<field name="model">hr.conveyance.settings</field>
		<field name="arch" type="xml">
            <form string="HR Conveyance Settings">
                <sheet>
                    <group>
                        <group>
                            <field name="conveyance_type" required="1"/>
                            <field name="purpose" required="1"/>
                            <field name="is_active" required="1"/>
                        </group>
                        <group>
                            <field name="journal_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="debit_account_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="credit_account_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_conveyance_settings_tree" model="ir.ui.view">
		<field name="name">view.hr.conveyance.settings.tree</field>
		<field name="model">hr.conveyance.settings</field>
        <field name="arch" type="xml">
            <tree string="HR Conveyance Settings">
                <field name="conveyance_type"/>
                <field name="purpose"/>
                <field name="journal_id"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_employee_conveyance_type">
        <field name="name">HR Conveyance Settings</field>
        <field name="res_model">hr.conveyance.settings</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            	Click to add a New HR Conveyance Settings.
          </p>
        </field>
    </record>

</odoo>