<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_increment_letter_wizard" model="ir.ui.view">
        <field name="name">employee.increment.letter.wizard.form</field>
        <field name="model">employee.increment.letter</field>
        <field name="arch" type="xml">
            <form string="Employee Increment/Decrement Letter">
                <sheet>
                    <group>
                        <group>
                            <field name="type"  required="1"/>
                            <field name="ref_id"  domain="[('state', 'in', ['approved','applied']), ('type', '=', type)]" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" required="1"/>
                            <field name="user_work_location_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="employee_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print" type="object" string="Print" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_employee_increment_letter_wizard" model="ir.actions.act_window">
        <field name="name">Employee Increment/Decrement Letter</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.increment.letter</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_increment_letter_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_employee_increment_letter_wizard"
          name="Employee Increment/Decrement Letter Print"
          sequence="100"
          action="action_employee_increment_letter_wizard"
          parent="custom_hr_employee.menu_hr_employee_operations"
          groups="hr.group_hr_manager"
    />

</odoo>