<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salary_payment_wizard" model="ir.ui.view">
        <field name="name">salary.payment.wizard.form</field>
        <field name="model">salary.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Salary Payment">
                <sheet>
                    <group>
                        <group>
                            <field name="struct_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <label for="date_from" string="Payslip Period"/>
                            <div>
                                <field name="date_from" class="oe_inline" style="font-weight:bold;" readonly="1"/>
                                - <field name="date_to" class="oe_inline" style="font-weight:bold;" readonly="1"/>
                            </div>
                            <field name="payment_date" readonly="1" style="font-weight:bold;"/>
                        </group>
                        <group>
                            <field name="disbursement_type" readonly="1" style="font-weight:bold;"/>
                            <field name="bank_journal_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" invisible="disbursement_type == 'cash'" required="disbursement_type in  ('bank','bank_cash')"/>
                            <field name="bank_credit_account_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" invisible="disbursement_type == 'cash'" required="disbursement_type in  ('bank','bank_cash')"/>
                            <field name="cash_journal_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" invisible="disbursement_type == 'bank'" required="disbursement_type in  ('cash','bank_cash')"/>
                            <field name="cash_credit_account_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" invisible="disbursement_type == 'bank'" required="disbursement_type in  ('cash','bank_cash')"/>
                            <field name="debit_account_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
                    <group string="Payslips">
                        <field name="payslip_ids" nolabel="1">
                            <tree create="0" editable="bottom">
<!--                                <field name="number"/>-->
<!--                                <field name="employee_id"/>-->
                                <field name="user_work_location_id"/>
<!--                                <field name="emp_private_address_id"/>-->
<!--                                <field name="net_wage" sum="Total"/>-->
                                <field name="disbursement_type"/>
<!--                                <field name="bank_amount" sum="Total"/>-->
<!--                                <field name="cash_amount" sum="Total"/>-->
<!--                                <field name="company_id" invisible="1"/>-->
<!--                                <field name="state" invisible="1"/>-->
                            </tree>
                            <group col="4">
<!--                                <field name="number"/>-->
<!--                                <field name="employee_id"/>-->
                                <field name="user_work_location_id"/>
<!--                                <field name="emp_private_address_id"/>-->
<!--                                <field name="net_wage"/>-->
                                <field name="disbursement_type"/>
<!--                                <field name="bank_amount"/>-->
<!--                                <field name="cash_amount"/>-->
<!--                                <field name="company_id" invisible="1"/>-->
<!--                                <field name="state" invisible="1"/>-->
                            </group>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_salary_payment_wizard" model="ir.actions.act_window">
        <field name="name">Salary Payment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">salary.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>