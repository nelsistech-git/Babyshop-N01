<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="action_report_payslip" model="ir.actions.report">
            <field name="name">Payslip (Format-1)</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hr_payroll.report_payslip</field>
            <field name="report_file">hr_payroll.report_payslip</field>
            <field name="print_report_name">'Payslip - %s' % (object.employee_id.name)</field>
        </record>

        <record id="action_report_register" model="ir.actions.report">
            <field name="name">Contribution Registers</field>
            <field name="model">hr.payslip.line</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hr_payroll.contribution_register</field>
            <field name="report_file">hr_payroll.contribution_register</field>
        </record>

        <record id="action_report_payslip_extra" model="ir.actions.report">
            <field name="name">Payslip (Format-2)</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hr_payroll.report_payslip_extra</field>
            <field name="report_file">hr_payroll.report_payslip_extra</field>
            <field name="print_report_name">'Payslip - %s' % (object.employee_id.name)</field>
        </record>

</odoo>
