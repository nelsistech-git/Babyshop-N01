<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <!--Tree View-->
        <record id="contract_particular_settings_view_tree" model="ir.ui.view">
            <field name="name">hr.contract.particular.settings.tree</field>
            <field name="model">hr.contract.particular.settings</field>
            <field name="arch" type="xml">
                <tree string="Particulars" editable="bottom">
                    <field name="name"/>
                    <field name="value"/>
                </tree>
                
            </field>
        </record>
		
        <!--Action View-->
        <record id="contract_particular_settings_list_action" model="ir.actions.act_window">
            <field name="name">Contract Particular Settings</field>
            <field name="res_model">hr.contract.particular.settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first record</p>
            </field>
        </record>
		
        <!--Add Menu Item-->
        <menuitem id="menu_contract_particular_config" name="Contract Particular Settings" parent="hr.menu_human_resources_configuration"
        sequence="101" action="contract_particular_settings_list_action" groups="hr.group_hr_manager"/>		
    </data>
</odoo>


