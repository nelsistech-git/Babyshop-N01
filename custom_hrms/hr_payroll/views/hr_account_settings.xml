<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_account_settings_form" model="ir.ui.view">
		<field name="name">view.hr.account.settings.form</field>
		<field name="model">hr.account.settings</field>
		<field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="dr_acc" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="is_transfer_dr"/>
                            <field name="is_receive_dr"/>
                        </group>
                        <group>
                            <field name="cr_acc" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="is_transfer_cr"/>
                            <field name="is_receive_cr"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_account_settings_tree" model="ir.ui.view">
        <field name="name">view.hr.account.settings.tree</field>
        <field name="model">hr.account.settings</field>
        <field name="arch" type="xml">
            <tree string="HR Account Settings">
                <field name="type"/>
                <field name="dr_acc"/>
                <field name="is_transfer_dr"/>
                <field name="is_receive_dr"/>
                <field name="cr_acc"/>
                <field name="is_transfer_cr"/>
                <field name="is_receive_cr"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_hr_account_settings">
        <field name="name">HR Account Settings</field>
        <field name="res_model">hr.account.settings</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            	Click to add a New Accounting Settings.
          </p>
        </field>
    </record>

</odoo>