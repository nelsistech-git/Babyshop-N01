<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inherited_hr_punishments_view_form" model="ir.ui.view">
            <field name="name">inherited.hr.punishments.form.inherit.payroll</field>
            <field name="model">hr.punishments</field>
            <field name="inherit_id" ref="custom_hr_employee.hr_punishments_view_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//button[@name='action_approve']" position="replace">
                   	 <button name="action_approve" string="Approve" type="object" invisible="state != 'confirm'" class="oe_highlight" groups="hr.group_hr_manager, hr.group_hr_user"/>
                 </xpath>
                 
                 <xpath expr="//field[@name='amount']" position="after">
                     <field name="is_deducted" readonly="1" invisible="not allow_payslip"/>
                     <field name="payslip_id" readonly="1" invisible="not allow_payslip"/>
                 </xpath>
            </field>
        </record>
        
        <record id="inherited_hr_punishments_view_tree" model="ir.ui.view">
            <field name="name">inherited.hr.punishments.tree.inherit.payroll</field>
            <field name="model">hr.punishments</field>
            <field name="inherit_id" ref="custom_hr_employee.hr_punishments_view_tree"/>
            <field name="arch" type="xml">
                 <xpath expr="//field[@name='amount']" position="after">
                     <field name="is_deducted" readonly="1"/>
                 </xpath>
            </field>
        </record>
        
        </data>
        
        <data noupdate = "1">
	        <!-- Disciplinary salary rule -->
	        <record id="hr_payslip_rule_disciplinary" model="hr.salary.rule">
	            <field name="code">DISP</field>
	            <field name="name">Disciplinary</field>
	            <field name="category_id" ref="hr_payroll.DED"/>
	            <field name="struct_id" ref="hr_payroll.structure_base"/>
	            <field name="amount_select">code</field>
	            <field name="amount_python_compute">result = inputs.DISP and - (inputs.DISP.amount)</field>
	            <field name="appears_on_payslip" eval="True"/>
	            <field name="sequence" eval="66"/>
	        </record>
			
	        <!-- Disciplinary salary input -->
	        <record id="hr_payslip_input_type_disciplinary" model="hr.payslip.input.type">
	            <field name="name">Disciplinary</field>
	            <field name="code">DISP</field>
	            <field name="struct_ids" eval="[(6, 0, [ref('hr_payroll.structure_base')])]"/>
	        </record>
	    </data>
</odoo>