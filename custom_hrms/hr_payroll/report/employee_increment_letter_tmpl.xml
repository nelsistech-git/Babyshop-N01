<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>

        <record id="employee_increment_letter_tmpl" model="ir.actions.report">
            <field name="name">Employee Increment Letter Report</field>
            <field name="model">employee.increment.letter</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hr_payroll.employee_increment_letter_report_view</field>
            <field name="report_file">hr_payroll.employee_increment_letter_report_view</field>
        </record>

		<template id="employee_increment_letter_report_view">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div style="width: 100%;">
                            <t t-foreach="csr" t-as="line">
                                <t t-raw="line['letter_text']"/>
                                <p style="page-break-after: always;"/>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
		</template>

	</data>
</odoo>