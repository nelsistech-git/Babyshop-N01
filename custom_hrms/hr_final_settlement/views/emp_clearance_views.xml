<odoo>
    <data>

        <record id="employee_contract_clearance_form" model="ir.ui.view">
            <field name="name">employee.contract.clearance.view.form</field>
            <field name="model">employee.contract.clearance</field>
            <field name="arch" type="xml">
                <form delete ="0" string="">
                    <header>
                        <button name="action_submit" type="object" string="Submit" invisible="state not in ['draft']" class="oe_highlight" />
                        <button name="action_concerned_dept_approve"  type="object" string="Concerned Dept. Clearance" invisible="state not in ['confirm']" class="oe_highlight" />
                        <button name="action_accounts_approve"  type="object" string="Accounts Clearance" invisible="state not in ['concerned_dept']"  class="oe_highlight"/>
                        <button name="action_admin_approve"  type="object" string="Admin Clearance" invisible="state not in ['account']"  class="oe_highlight"/>
                        <button name="action_it_approve" type="object" string="IT Clearance" invisible="state not in ['admin']" class="oe_highlight" />
                        <button name="action_hr_approve"  type="object" string="HR Clearance" invisible="state not in  ['it']" class="oe_highlight" />
                        <button name="action_done"  type="object" string="Settlement Done" invisible="state not in ['hr']" class="oe_highlight" />
                        <button name="action_cancel" type="object" string="Cancel" invisible="state not in ['done']" confirm="Are you sure you want to Cancel?" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,concerned_dept,account,admin,it,hr,done,cancel"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box" groups="base.group_user">
                            <button name="act_current_employee_loan" type="object" class="oe_stat_button" icon="fa-calendar" >
                                <field name="loan_count" widget="statinfo" string="Loans" />
                            </button>

                            <button name="act_current_payslips_count" type="object" class="oe_stat_button" icon="fa-calendar" >
                                <field name="payslips_count" widget="statinfo" string="Payslip" />
                            </button>

                            <button name="act_current_advance_count" type="object" class="oe_stat_button" icon="fa-calendar" >
                                <field name="advance_count" widget="statinfo" string="Salary Advance"/>
                            </button>

                            <button name="act_current_disciplinary_action" type="object" class="oe_stat_button" icon="fa-calendar" >
                                <field name="disciplinary_count" widget="statinfo" string="Disciplinary Actions" />
                            </button>
                        </div>

                        <group>
                            <group>
                                <field name="employee_id" required="1" force_save="1" domain="[('final_settlement_status', '=', False), ('is_separated', '=', True)]" options="{'no_open':True,'no_create':1,'no_create_edit':1}" readonly="state != 'draft'"/> <!--('pf_settlement_status', '=', True),-->
                                <field name="doc_ref" required="1" readonly="state != 'draft'"/>
                            </group>
                            <group></group>
                        </group>
                        <group>
                            <group string="Employee Information">
                                <field name="company_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="job_position" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1}" />
                                <field name="old_empid" readonly="1" force_save="1"/>
                                <field name="user_work_location_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="department_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="initial_employment_date" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="length_of_service" readonly="1" force_save="1"/>

                            </group>
                            <group string="Resignation Information">
                                <field name="date_requested" readonly="1" force_save="1"/>
                                <field name="ref_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="last_day_of_work" readonly="1" force_save="1"/>
                                <field name="date_of_separation" readonly="1" force_save="1"/>
                                <field name="resignation_type_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="notice_period_days" readonly="1" force_save="1"/>

                                <field name="notice_served" readonly="state != 'draft'"/>
                                <field name="notice_period" readonly="state != 'draft'"/>

                                <field name="date_of_notice" readonly="state != 'draft'"/>
                                <field name="deduction_value" readonly="1" force_save="1"/>
                                <field name="gross_salary" readonly="1" force_save="1"/>
                            </group>
                        </group>
                         <group>
                            <group string="Salary Information">
                                <field name="gross_salary" readonly="1" force_save="1"/>
                                <field name="per_day_salary" readonly="1" force_save="1"/>
                                <field name="no_of_present_day" readonly="1" force_save="1"/>
                                <field name="total_attendance_salary" readonly="1" force_save="1"/>
                                <field name="no_overtime" readonly="1" force_save="1"/>
                                <field name="ot_day_count" readonly="1" force_save="1"/>
                                <field name="daily_allowance" readonly="1" force_save="1"/>
                                <field name="total_daily_allowance" readonly="1"/>
                                <field name="lunch_allowance" readonly="1" force_save="1"/>
                                <field name="leave_encashment" readonly="state == 'done'"/>
                            </group>
                            <group string="Deduction And Others">
                                <field name="advance_salary" readonly="1" force_save="1"/>
                                <field name="loan" readonly="1" force_save="1"/>
                                <field name="lunch_bill" force_save="1" readonly="state == 'done'"/>
                                <field name="penalty" force_save="1" readonly="state == 'done'"/>
                                <field name="excess_leave" force_save="1" readonly="state == 'done'"/>
                                <field name="other_dues" force_save="1" readonly="state == 'done'"/>
                                <field name="deduction_of_gross" force_save="1" readonly="state == 'done'"/>
                                <field name="total_deduct" readonly="1" force_save="1"/>
                            </group>

                         </group>

                        <separator string="Fringe Benefits" colspan="12"></separator>

                        <!--<group name="facilities" string="Fringe Benefits" >-->
                             <field name="facility_lines" context="{'default_employee_id': active_id}" nolable="1" readonly="state in  ('draft','confirm','concerned_dept','account','done','cancel')" force_save="1">
                                 <tree editable="bottom">
                                     <field name="dept_name" force_save="1" readonly="1" />
                                     <field name="particular_id" force_save="1" readonly="1" />
                                     <field name="qty" force_save="1" readonly="1" />
                                     <field name="value" force_save="1" readonly="1" />
                                     <field name="observation_type" force_save="1"/>
                                     <field name="note" force_save="1"/>
                                 </tree>
                             </field>
                        <!--</group>-->

                        <notebook>
                                 <page string="A. Concerned Department/Division">
                                     <field name="section_a_lines" readonly="state != 'concerned_dept'">
                                         <tree editable="bottom">
                                            <field name="final_settlement_settings_id" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                            <field name="observation_type"/>
                                            <field name="note"/>
                                        </tree>
                                     </field>
                                  <group>
                                         <field name = "a_remarks" readonly="state != 'concerned_dept'"/>
                                     </group>
                                 </page>
                                 <page string="B. Accounts Department">
                                      <field name="section_b_lines" readonly="state != 'account'">
                                         <tree editable="bottom">
                                            <field name="final_settlement_settings_id" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                            <field name="observation_type"/>
                                            <field name="note"/>
                                        </tree>
                                     </field>
                                     <group>
                                         <field name = "b_remarks" readonly="state != 'account'"/>
                                     </group>
                                 </page>
                                 <page string="C. Admin Department">
                                        <field name="section_c_lines" readonly="state != 'admin'">
                                         <tree editable="bottom">
                                            <field name="final_settlement_settings_id" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                            <field name="observation_type"/>
                                            <field name="note"/>
                                        </tree>
                                     </field>
                                    <group>
                                         <field name = "c_remarks" readonly="state != 'admin'"/>
                                     </group>
                                 </page>
                                 <page string="D. IT Department">
                                     <field name="section_d_lines" readonly="state != 'it'">
                                         <tree editable="bottom">
                                            <field name="final_settlement_settings_id" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                            <field name="observation_type"/>
                                            <field name="note"/>
                                        </tree>
                                     </field>
                                    <group>
                                         <field name = "d_remarks" readonly="state != 'it'"/>
                                     </group>
                                 </page>
                                 <page string="E. HR Department">
                                      <field name="section_e_lines" readonly="state != 'hr'">
                                         <tree editable="bottom">
                                            <field name="final_settlement_settings_id" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                            <field name="observation_type"/>
                                            <field name="note"/>
                                        </tree>
                                     </field>
                                    <group>
                                         <field name = "e_remarks" readonly="state != 'hr'"/>
                                     </group>
                                 </page>
                                 <page string="To Be Completed by Outgoing Employee">
                                 <group>
                                     <group>
                                        <field name="outgoing_emp_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                         <field name="mailing_address" force_save="1" readonly="state == 'done'"/>
                                         <field name="emp_id_phone" force_save="1" readonly="state == 'done'"/>
                                         <field name="emp_id_mobile" force_save="1" readonly="state == 'done'"/>
                                         <field name="emp_id_email" force_save="1" readonly="state == 'done'"/>
                                         <field name="emp_id_nid" force_save="1" readonly="state == 'done'"/>
                                         <field name="emp_id_passport" force_save="1" readonly="state == 'done'"/>
                                     </group>
                                     <group>
                                     </group>
                                 </group>
                                     <group>
                                         <field name="remarks" force_save="1" readonly="state == 'done'"/>
                                     </group>
                                 </page>
                                 <page string="Declaration">
                                     <field name="note" force_save="1" readonly="state == 'done'"/>
                                 </page>
                        </notebook>
                        <group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"
                            groups="base.group_user" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>


        <record id="employee_contract_clearance_view_tree" model="ir.ui.view">
            <field name="name">employee.contract.clearance.view.tree</field>
            <field name="model">employee.contract.clearance</field>
            <field name="arch" type="xml">
                <tree delete ="0" string="Final Settlement" decoration-muted="state=='cancel'" decoration-info="state=='draft'"
					decoration-success="state=='done'">
                    <field name="name"/>
                    <field name="doc_ref"/>
                    <field name="date_requested"/>
                    <field name="employee_id"/>
                    <field name="resignation_type_id"/>
                    <field name="date_of_separation"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>


        <record id="search_employee_settlement_form" model="ir.ui.view">
			<field name="name">search.employee.settlement.form</field>
			<field name="model">employee.contract.clearance</field>
			<field name="arch" type="xml">
				<search string="Search Employee Settlement">
                    <field name="name"/>
                    <field name="doc_ref"/>
                    <field name="employee_id"/>
                    <field name="old_empid"/>
                    <field name="user_work_location_id"/>
                    <field name="department_id"/>
                    <field name="date_requested"/>
                    <field name="resignation_type_id"/>
					<separator />
					<filter name="state" string="Not Cancel"
						domain="[('state', '!=', 'cancel')]" />
					<separator />
				</search>
			</field>
		</record>

        <record id="employee_final_settlement_action" model="ir.actions.act_window">
            <field name="name">Final Settlement</field>
            <field name="res_model">employee.contract.clearance</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_state':1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Final Settlement of a Employee
                </p>
            </field>
        </record>

        <menuitem id="menu_employee_final_settlement_action" name="Final Settlement" parent="custom_hr_employee.menu_hr_employee_operations"
                  action="hr_final_settlement.employee_final_settlement_action" groups="hr.group_hr_manager" sequence="10"/>
    </data>
</odoo>