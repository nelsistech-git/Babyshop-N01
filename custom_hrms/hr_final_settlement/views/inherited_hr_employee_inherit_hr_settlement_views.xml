<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="hr_employee_pf_settlement_form_view">
        <field name="name">view.hr.employee.pf.settlement.form.</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_resignation.hr_employee_resign_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='separation_date']" position="after">
                <field name="final_settlement_status" invisible="not final_settlement_status" readonly="1"/>
                <field name="pf_settlement_status" invisible="not pf_settlement_status" readonly="1"/>
                <field name="wppf_settlement_status" invisible="not wppf_settlement_status" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>