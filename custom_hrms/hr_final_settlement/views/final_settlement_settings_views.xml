<odoo>
    <data>
        <record id="view_hr_final_settlement_settings_tree" model="ir.ui.view">
            <field name="name">view.final.settlement.settings.tree</field>
            <field name="model">final.settlement.settings</field>
            <field name="arch" type="xml">
                <tree string="Final Settlement Settings" editable="bottom">
                    <field name="section_type" required="1"/>
                    <field name="particulars" required="1"/>
                </tree>
            </field>
        </record>

        <record id="action_hr_final_settlement_settings" model="ir.actions.act_window">
            <field name="name">Final Settlement Settings</field>
            <field name="res_model">final.settlement.settings</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Final Settlement Settings
                </p>
            </field>
        </record>

        <menuitem id="menu_hr_final_settlement_settings" name="Final Settlement Settings" parent="custom_hr_employee.menu_hr_employee_settings_root"
                  action="action_hr_final_settlement_settings" groups="hr.group_hr_manager" sequence="15"/>
    </data>
</odoo>