<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <!--Form View-->
        <record id="view_hr_separation_type_settings_form" model="ir.ui.view">
            <field name="name">hr.separation.type.settings.form</field>
            <field name="model">hr.separation.type.settings</field>
            <field name="arch" type="xml">
                <form string="Separation Type Settings">
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="type"/>
<!--                            <field name="resigned"/>-->
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <!--Tree View-->
        <record id="view_hr_separation_type_settings_tree" model="ir.ui.view">
            <field name="name">hr.separation.type.settings.tree</field>
            <field name="model">hr.separation.type.settings</field>
            <field name="arch" type="xml">
                <tree string="Separation Type Settings">
                    <field name="name" required="1"/>
                    <field name="type"/>
<!--                    <field name="resigned"/>-->
                </tree>
            </field>
        </record>

        <!--Action View-->
        <record id="action_hr_separation_type_settings" model="ir.actions.act_window">
            <field name="name">Separation Type Settings</field>
            <field name="res_model">hr.separation.type.settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Employee Type</p>
            </field>
        </record>


        <!--Add Menu Item-->
        <menuitem id="menu_hr_separation_type_settings"
                  parent="custom_hr_employee.menu_hr_employee_settings_root"
                  name="Separation Type Settings"
                  action="action_hr_separation_type_settings" groups="hr.group_hr_manager"
                  sequence="14"/>
    </data>
</odoo>


