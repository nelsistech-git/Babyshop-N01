<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <!--Tree View-->
        <record id="hr_resignation_notice_period_setting_view_tree" model="ir.ui.view">
            <field name="name">hr.resignation.notice.period.setting.tree</field>
            <field name="model">hr.resignation.notice.period.setting</field>
            <field name="arch" type="xml">
                <tree string="Separation Notice Period Settings" editable="bottom">
                    <field name="days"/>
                    <field name="particular"/>
                </tree>

            </field>
        </record>

        <!--Action View-->
        <record id="hr_resignation_notice_period_setting_list_action" model="ir.actions.act_window">
            <field name="name">Separation Notice Period Settings</field>
            <field name="res_model">hr.resignation.notice.period.setting</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first record</p>
            </field>
        </record>

        <!--Add Menu Item-->
        <menuitem id="menu_hr_resignation_notice_period_setting_config"
                  parent="custom_hr_employee.menu_hr_employee_settings_root"
                  name="HR Separation Notice Period Setting"
                  action="hr_resignation_notice_period_setting_list_action" groups="hr.group_hr_manager,hr.group_hr_user"
                  sequence="14"/>
    </data>
</odoo>


