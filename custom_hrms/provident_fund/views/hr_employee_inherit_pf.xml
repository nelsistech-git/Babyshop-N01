<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_inherited_hr_employee_inherit_employee_pf" model="ir.ui.view">
        <field name="name">HR Employee PF</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">

                <page name="hr_employee_pf" string="PF Information">
                    <group>
                        <group>
                            <field name="is_pf_user"/>
                            <field name="pf_start_date"/>
                        </group>
                        <group></group>
                    </group>
                    <separator string="PF Information" colspan="2"/>
                    <group name="employee_pf" colspan="2">
                        <field name="employee_pf_ids" context="{'default_employee_id': active_id}" >
                            <tree string="Employee PF" editable="bottom" create="0" delete="0" edit="0">
                                <field name="year" readonly="1"/>
                                <field name="month" readonly="1"/>
                                <field name="pf_amount" sum="Total"/>
                                <field name="cpf_amount" sum="Total"/>
                                <field name="total_pf_amount" sum="Total"/>
                                <field name="contribution_type" readonly="1" force_save="1"/>
                                <field name="state" readonly="1" force_save="1"/>
                            </tree>
                            <form string="Employee PF">
                                <group name="employee_pf">
                                    <group>
                                        <field name="year"/>
                                        <field name="month"/>
                                    </group>
                                    <group>
                                        <field name="pf_amount"/>
                                        <field name="cpf_amount"/>
                                        <field name="total_pf_amount"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </group>
                </page>


            </xpath>
             <xpath expr="//field[@name='reference']" position="before">
                <field name="pf_settlement_status" invisible="not pf_settlement_status" />

            </xpath>
        </field>
    </record>

</odoo>
