<!--<?xml version="1.0" encoding="UTF-8" ?>-->
<odoo>
    <data>
        <record id="pf_provident_board_view_form" model="ir.ui.view">
            <field name="name">pf.provident.board.form</field>
            <field name="model">pf.provident.board</field>
            <field name="arch" type="xml">
                <form string="Provident Fund">
                    <header>
                        <button name="button_confirm" string="Confirm" invisible="state != 'draft'" type="object"/>
                        <button name="button_unlock" string="Unlock" invisible="state != 'confirm'" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1 col="4">
                                <field name="name" placeholder="Name Here" readonly="state == 'confirm'"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="type" readonly="1" force_save="1"/>
                                <field name="emp_type" widget="selection" invisible="1" readonly="state == 'confirm'"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="percentage_based_on" required="1" invisible="type == 'wppf'" readonly="state == 'confirm'"/>
                                <field name="pf_percentage" required="1" invisible="type == 'wppf'" readonly="state == 'confirm'"/>
                            </group>
                        </group>
                        <notebook colspan="4">
                            <page string="Employee Lines">
                                <field name="employee_lines" readonly="state == 'confirm'">
                                    <tree string="Employee Lines" editable="false">
                                        <field name="employee_id" options='{"no_create_edit": True, "no_create": True}'/> <!--domain="[('is_pf_user','=',True)]"  -->
                                        <field name="start_date"/>
                                        <field name="is_interest_free" widget="boolean_toggle" />
                                        <field name="company_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>

                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="pf_provident_board_view_tree" model="ir.ui.view">
            <field name="name">pf.provident.board.tree</field>
            <field name="model">pf.provident.board</field>
            <field name="arch" type="xml">
                <tree string="Provident Fund Board">
                    <field name="name" readonly="state == 'confirm'"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>


    </data>
</odoo>