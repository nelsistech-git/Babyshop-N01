<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agent_commission_type_view_tree" model="ir.ui.view">
        <field name="name">agent.commission.type.tree</field>
        <field name="model">agent.commission.type</field>
        <field name="arch" type="xml">
            <tree string="Cheque Book Account Type List" editable="bottom">
                <field name="name" required="1"/>
                <field name="type_account_id"
                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                <field name="remarks"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="agent_commission_type_view_search" model="ir.ui.view">
        <field name="name">agent.commission.type.search</field>
        <field name="model">agent.commission.type</field>
        <field name="arch" type="xml">
            <search string="Search Bank">
                <field name="name"/>
                <field name="type_account_id"/>
            </search>
        </field>
    </record>

    <record id="agent_commission_type_action" model="ir.actions.act_window">
        <field name="name"> Commission Type</field>
        <field name="res_model">agent.commission.type</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Please Create Commission Type
            </p>
        </field>
    </record>

    <menuitem id="agent_commission_type_menu" name="Commission Type" action="agent_commission_type_action" sequence="5"
              parent="root_menu_agent_fee"/>


</odoo>
