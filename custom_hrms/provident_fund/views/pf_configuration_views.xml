<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_pf_configuration_form" model="ir.ui.view">
            <field name="name">pf.configuration.form</field>
            <field name="model">pf.configuration</field>
            <field name="arch" type="xml">
                <form string="PF Settlement Configuration">
                    <sheet>
                        <h1 class="mt0">
                            <div>
                                <field name="name" class="oe_inline" placeholder="Name"/>
                            </div>
                        </h1>
                        <group>
                            <group>
                                <field name="type" required="1"/>
                                <field name="eligibility_based_on"/>
                                <field name="note" placeholder="Some Notes Here"/>
                            </group>
                            <group>
                                <field name="minimum_loan_amount" invisible="type == 'settlement'"/>
                                <field name="max_no_installment" invisible="type == 'settlement'"/>
                                <field name="minimum_installment_amount" invisible="type == 'settlement'"/>
                            </group>
                        </group>
                        <notebook colspan="4">
                            <page string="Policy Line">
                                <field name="pf_conf_line">
                                    <tree string="Policy" editable="bottom">
                                        <field name="from_month"/>
                                        <field name="to_month"/>
                                        <field name="pf_percentage"/>
                                        <field name="pf_profit_percentage"/>

                                        <field name="cpf_percentage"/>
                                        <field name="cpf_profit_percentage"/>
                                        <field name="type" invisible="parent.type == 'loan'"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <group invisible="type == 'loan'">
                            <group string="Settlement Accounts Settings">
                                <field name="journal_id_settlement"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                       domain="[('is_pf_display','=',True)]"/>
                                <field name="payable_acc_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                <field name="loan_acc_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                <field name="reserve_acc_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                <field name="other_acc_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                <field name="payable_emp_acc_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                <separator/>
                                <field name="journal_id_payment"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                                       domain="[('is_pf_display','=',True)]"/>
                                <field name="payment_acc_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pf_configuration_tree" model="ir.ui.view">
            <field name="name">pf.configuration.tree</field>
            <field name="model">pf.configuration</field>
            <field name="arch" type="xml">
                <tree string="PF Configuration">
                    <field name="type"/>
                    <field name="name"/>
                    <field name="eligibility_based_on"/>
                    <field name="amount_source"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="pf_configuration_action">
            <field name="name">PF Loan &amp; Settlement Policy</field>
            <field name="res_model">pf.configuration</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_pf_configuration" name="Configuration" parent="base.menu_hr_employee_pf_root"
                  groups="provident_fund.group_provident_fund_officer" sequence="100"/>

        <menuitem id="menu_pf_policy_config"
                  name="PF Loan &amp; Settlement Policy"
                  parent="menu_pf_configuration"
                  action="pf_configuration_action"
                  sequence="1"/>


        <!--PF profit disb configuration-->
        <record id="view_pf_profit_disb_configuration_form" model="ir.ui.view">
            <field name="name">pf.profit.disb.configuration.form</field>
            <field name="model">pf.profit.disb.configuration</field>
            <field name="arch" type="xml">
                <form string="PF Profit Disbursement Configuration">
                    <sheet>
                        <group>
                            <group string="Accounts Settings">
                                <field name="journal_id_disbursement"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                <field name="payable_acc_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                                <field name="expense_acc_id"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pf_profit_disb_configuration_tree" model="ir.ui.view">
            <field name="name">pf.profit.disb.configuration.tree</field>
            <field name="model">pf.profit.disb.configuration</field>
            <field name="arch" type="xml">
                <tree string="PF Profit Disbursement Configuration">
                    <field name="journal_id_disbursement"/>
                    <field name="payable_acc_id"/>
                    <field name="expense_acc_id"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="pf_profit_disb_configuration_action">
            <field name="name">PF Profit Disbursement Settings</field>
            <field name="res_model">pf.profit.disb.configuration</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_pf_profit_disb_config"
                  name="PF Profit Disbursement Settings"
                  parent="menu_pf_configuration"
                  action="pf_profit_disb_configuration_action"
                  sequence="2"/>
    </data>
</odoo>