<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_emp_leave_encashment_report_wizard_form" model="ir.ui.view">
            <field name="name">employee.leave.encashment.report.wizard.form</field>
            <field name="model">employee.leave.encashment.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Leave Encashment Report Wizard">
                    <group>
                        <group>
                            <field name="year" required="1"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="sbu_unit_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True, 'no_create': 1, 'no_create_edit': 1, 'no_quick_create': True}" />
                        </group>
                    </group>
                    <footer>
                        <button name="employee_leave_encashment_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="employee_leave_encashment_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_emp_leave_encashment_report_wizard" model="ir.actions.act_window">
            <field name="name">Employee Leave Encashment Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.leave.encashment.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_emp_leave_encashment_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!--<menuitem id="menu_emp_leave_encashment_report_wizard_form" name="Employee Leave Encashment Report" sequence="24" action="action_emp_leave_encashment_report_wizard" parent="custom_hr_report.menu_salary_report_root" groups="hr.group_hr_user" />-->

        <menuitem id="menu_emp_leave_encashment_report_wizard_form_payroll" name="Employee Leave Encashment Report" sequence="15" action="action_emp_leave_encashment_report_wizard" parent="hr_payroll.menu_report_payroll_salary" groups="hr.group_hr_user" />
    </data>
</odoo>