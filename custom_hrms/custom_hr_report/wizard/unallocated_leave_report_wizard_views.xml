<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_unallocated_employee_leave_report_wizard_form" model="ir.ui.view">
            <field name="name">unallocated.employee.leave.report.wizard.form</field>
            <field name="model">unallocated.employee.leave.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Unallocated Employee Leave Report">
                    <group>
                        <group>
                            <field name="year" required="1"/>
                            <field name="leave_type_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
                    <footer>
                        <button name="unallocated_employee_leave_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="unallocated_employee_leave_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_unallocated_employee_leave_report_wizard" model="ir.actions.act_window">
            <field name="name">Unallocated Employee Leave Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">unallocated.employee.leave.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_unallocated_employee_leave_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!--<menuitem id="menu_unallocated_employee_leave_report_wizard"
              name="Unallocated Employee Leave Report"
              sequence="70"
              action="action_unallocated_employee_leave_report_wizard"
              parent="custom_hr_report.menu_leave_report_root"
              groups="hr.group_hr_user"
        />-->
        <menuitem id="menu_unallocated_employee_leave_report_wizard_leave"
              name="Unallocated Employee Leave Report"
              sequence="52"
              action="action_unallocated_employee_leave_report_wizard"
              parent="hr_holidays.menu_hr_holidays_report"
              groups="hr.group_hr_user"
        />

    </data>
</odoo>