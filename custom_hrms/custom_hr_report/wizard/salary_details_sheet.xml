<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_salary_detail_sheet_wizard_form" model="ir.ui.view">
            <field name="name">salary.details.sheet.report.wizard.form</field>
            <field name="model">salary.details.sheet.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Salary Detail Sheet Report">
                    <group>
                        <group>
                            <field name="year" required="1"/>
                            <field name="month"/>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                            <field name="state"/>
                            <field name="report_type" widget="radio"/>
                            <field name="include_zero_less_payable"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <!--<field name="rpt_type" widget="radio"/>-->
                            <field name="rpt_for" widget="radio"/>
                            <field name="disbursement_type" widget="radio"/>
                        </group>
                    </group>
                    <footer>
                        <button name="salary_detail_sheet_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="salary_detail_sheet_wizard_action" model="ir.actions.act_window">
            <field name="name">Master Salary Sheet</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">salary.details.sheet.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_salary_detail_sheet_wizard_form"/>
            <field name="target">new</field>
        </record>

       <!--<menuitem
              name="Master Salary Sheet"
              id="menu_salary_detail_sheet"
              sequence="100"
              parent="custom_hr_report.menu_salary_report_root"
              action="salary_detail_sheet_wizard_action"
              groups="base.group_system"
        />-->
        <menuitem
              name="Master Salary Sheet"
              id="menu_salary_detail_sheet_payroll"
              sequence="100"
              parent="hr_payroll.menu_report_payroll_salary"
              action="salary_detail_sheet_wizard_action"
              groups="base.group_system"
        />

    </data>
</odoo>