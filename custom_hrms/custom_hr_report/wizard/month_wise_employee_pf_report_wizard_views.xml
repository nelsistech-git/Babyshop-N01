<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_month_wise_employee_pf_report_wizard_form" model="ir.ui.view">
            <field name="name">month.wise.employee.pf.report.wizard.form</field>
            <field name="model">month.wise.employee.pf.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Month Wise Employee PF Report">
                    <group>
                        <group>
                            <field name="fiscalyear_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="date_from" readonly="1" force_save="1"/>
                            <field name="date_to" readonly="1" force_save="1"/>
                            <field name="month_count" invisible="1" />
                            <field name="contribution_type" />
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="sbu_unit_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True, 'no_create': 1, 'no_create_edit': 1, 'no_quick_create': True}" />
                        </group>
                    </group>
                    <footer>
                        <button name="month_wise_pf_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_month_wise_employee_pf_report_wizard" model="ir.actions.act_window">
            <field name="name">Month Wise Employee PF Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">month.wise.employee.pf.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_month_wise_employee_pf_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!--<menuitem id="menu_month_wise_employee_pf_report" name="Month Wise PF Report" sequence="21" action="action_month_wise_employee_pf_report_wizard" parent="custom_hr_report.menu_salary_report_root" groups="hr.group_hr_user" />-->

        <menuitem id="menu_month_wise_employee_pf_report_payroll" name="Month Wise PF Report" sequence="34" action="action_month_wise_employee_pf_report_wizard" parent="hr_payroll.menu_report_payroll_salary" groups="hr.group_hr_user" />

        <menuitem id="menu_month_wise_employee_pf_report_pfund" name="Month Wise PF Report" sequence="2" action="action_month_wise_employee_pf_report_wizard" parent="provident_fund.menu_hr_employee_pf_sub_reports" groups="hr.group_hr_user" />

    </data>
</odoo>