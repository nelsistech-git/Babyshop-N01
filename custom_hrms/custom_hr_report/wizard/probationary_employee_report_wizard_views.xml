<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_probationary_employee_report_wizard_form" model="ir.ui.view">
            <field name="name">probationary.employee.report.wizard.form</field>
            <field name="model">probationary.employee.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Probationary Employee Report">
                    <group>
                        <group>
                            <field name="from_date" required="1"/>
                            <field name="to_date" required="1"/>
                            <!--                            <field name="status"/>-->
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <!--                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>-->
                            <field name="sbu_unit_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True, 'no_create': 1, 'no_create_edit': 1, 'no_quick_create': True}" />
                        </group>
                    </group>
                    <footer>
                        <button name="probationary_employee_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="probationary_employee_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_probationary_employee_report_wizard" model="ir.actions.act_window">
            <field name="name">Probationary Employee Report Sheet</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">probationary.employee.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_probationary_employee_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_probationary_employee_report" name="Probationary Employee Report" sequence="35" action="action_probationary_employee_report_wizard" parent="custom_hr_report.menu_employee_info_report_root" />
    </data>
</odoo>