<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_location_wise_employee_salary_sheet_wizard_form" model="ir.ui.view">
            <field name="name">location.wise.employee.salary.sheet.report.wizard.form</field>
            <field name="model">location.wise.employee.salary.sheet.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Location wise Employee Salary Summary Report Wizard">
                    <group>
                        <group>
                            <field name="year" required="1"/>
                            <field name="month"/>
                            <field name="state"/>
                            <field name="include_zero_less_payable"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="sbu_unit_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True, 'no_create': 1, 'no_create_edit': 1, 'no_quick_create': True}" />
                        </group>
                    </group>
                    <footer>
                        <button name="location_wise_employee_salary_summary_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="location_wise_employee_salary_summary_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_location_wise_employee_salary_sheet_wizard" model="ir.actions.act_window">
            <field name="name">Location wise Employee Salary Summary Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">location.wise.employee.salary.sheet.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_location_wise_employee_salary_sheet_wizard_form"/>
            <field name="target">new</field>
        </record>
        <!--<menuitem name="Location wise Employee Salary Summary Report" id="menu_location_wise_employee_salary_sheet" sequence="15" parent="custom_hr_report.menu_salary_report_root" action="action_location_wise_employee_salary_sheet_wizard" groups="hr.group_hr_user"/>-->
        <!--payroll-->
        <menuitem name="Location wise Employee Salary Summary Report" id="menu_location_wise_employee_salary_sheet_payroll" sequence="16" parent="hr_payroll.menu_report_payroll_salary" action="action_location_wise_employee_salary_sheet_wizard" groups="hr.group_hr_user"/>
    </data>
</odoo>