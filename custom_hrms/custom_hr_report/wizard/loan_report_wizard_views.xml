<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="loan_report_wizard_form" model="ir.ui.view">
            <field name="name">loan.report.wizard.form</field>
            <field name="model">loan.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Loan Report">
                    <group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                        <group>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
                    <footer>
                        <!--<button name="loan_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>-->
                        <button name="loan_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="loan_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Employee Loan Issue Detail</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">loan.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="loan_report_wizard_form"/>
            <field name="target">new</field>
        </record>

