<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_length_of_service_report_wizard_form" model="ir.ui.view">
            <field name="name">employee.length.of.service.report.wizard.form</field>
            <field name="model">employee.length.of.service.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Length of Service Report Wizard">
                    <group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id"/>
                            <field name="employee_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="sbu_unit_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True, 'no_create': 1, 'no_create_edit': 1, 'no_quick_create': True}" />


                        </group>
                    </group>
                    <footer>
                        <button name="employee_length_of_service_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="employee_length_of_service_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_employee_length_of_service_report_wizard" model="ir.actions.act_window">
            <field name="name">Employee Length of Service Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.length.of.service.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_employee_length_of_service_report_wizard_form"/>
            <field name="target">new</field>
        </record>
        <menuitem name="Employee Length of Service Report" id="menu_employee_length_of_service_report" sequence="15" parent="custom_hr_report.menu_employee_info_report_root" action="action_employee_length_of_service_report_wizard" groups="hr.group_hr_user"/>
    </data>
</odoo>