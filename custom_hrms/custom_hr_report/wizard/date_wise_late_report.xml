<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_date_wise_late_report_wizard_form" model="ir.ui.view">
            <field name="name">date.wise.late.report.wizard.form</field>
            <field name="model">date.wise.late.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Date Wise Late Report">
                    <group>
                        <group>
                            <field name="from_date" required="1"/>
                            <field name="to_date" required="1"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="sbu_unit_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True, 'no_create': 1, 'no_create_edit': 1, 'no_quick_create': True}" />
                        </group>
                    </group>
                    <footer>
                        <button name="date_wise_late_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="date_wise_late_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="date_wise_late_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Date Wise Late Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">date.wise.late.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_date_wise_late_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!--<menuitem id="menu_date_wise_late_report" name="Date Wise Late Report" sequence="5" action="date_wise_late_report_wizard_action" parent="custom_hr_report.menu_attendance_report_root" groups="hr.group_hr_user" />-->
        <menuitem id="menu_date_wise_late_report_att" name="Date Wise Late Report" sequence="10" action="date_wise_late_report_wizard_action" parent="custom_hr_attendance_sheet.menu_attendance_report_root_attendance_sub" groups="hr.group_hr_user" />

    </data>
</odoo>