<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_employee_detail_salary_sheet_wizard_form" model="ir.ui.view">
            <field name="name">employee.detail.salary.sheet.report.wizard.form</field>
            <field name="model">employee.detail.salary.sheet.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Detail Salary Sheet Report">
                    <group>
                        <group>
                            <field name="report_type" widget="radio"/>
                            <field name="year" required="1"/>
                            <field name="month"/>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                            <field name="state"/>
                            <field name="include_zero_less_payable"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="sbu_unit_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True, 'no_create': 1, 'no_create_edit': 1, 'no_quick_create': True}" />
                        </group>
                    </group>
                    <footer>
                        <button name="employee_detail_salary_sheet_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="employee_detail_salary_sheet_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="employee_detail_salary_sheet_wizard_action" model="ir.actions.act_window">
            <field name="name">Employee Details Salary Sheet Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.detail.salary.sheet.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_employee_detail_salary_sheet_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!--<menuitem name="Employee Details Salary Sheet" id="menu_employee_detail_salary_sheet" sequence="1" parent="custom_hr_report.menu_salary_report_root" action="employee_detail_salary_sheet_wizard_action" groups="hr.group_hr_user" />-->
        <!--payroll-->
        <menuitem name="Employee Details Salary Sheet" id="menu_employee_detail_salary_sheet_payroll" sequence="1" parent="hr_payroll.menu_report_payroll_salary" action="employee_detail_salary_sheet_wizard_action" groups="hr.group_hr_user" />

    </data>
</odoo>