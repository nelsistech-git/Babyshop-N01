<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_leave_emp_attendance_sheet_wizard_form" model="ir.ui.view">
            <field name="name">leave.emp.attendance.sheet.wizard.form</field>
            <field name="model">leave.emp.attendance.sheet.wizard</field>
            <field name="arch" type="xml">
                <form string="Leave Employee Attendance Sheet">
                    <group>
                        <group>
                            <field name="from_date" required="1"/>
                            <field name="to_date" required="1"/>
                            <field name="status" placeholder="All"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_ids" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" widget="many2many_tags"/>
                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="sbu_unit_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True, 'no_create': 1, 'no_create_edit': 1, 'no_quick_create': True}" />
                        </group>
                    </group>
                    <footer>
                        <button name="leave_emp_attendance_sheet_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_leave_emp_attendance_sheet_wizard" model="ir.actions.act_window">
            <field name="name">Leave Employee Attendance Sheet</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">leave.emp.attendance.sheet.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_leave_emp_attendance_sheet_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!--<menuitem id="menu_leave_emp_attendance_sheet" name="Leave Employee Attendance Sheet" sequence="35" action="action_leave_emp_attendance_sheet_wizard" parent="menu_attendance_report_root" groups="hr.group_hr_user" />-->
        <menuitem id="menu_leave_emp_attendance_sheet_att" name="Leave Employee Attendance Sheet" sequence="45" action="action_leave_emp_attendance_sheet_wizard" parent="custom_hr_attendance_sheet.menu_attendance_report_root_attendance_sub" groups="hr.group_hr_user" />

    </data>
</odoo>