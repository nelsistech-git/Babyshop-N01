<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_employee_migration_report_wizard_form" model="ir.ui.view">
            <field name="name">employee.migration.report.wizard.form</field>
            <field name="model">employee.migration.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Migration Report">
                    <group>
                        <group>
                            <field name="year" required="1"/>
                            <field name="month"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id"  placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="transfer_company"/>
                        </group>
                    </group>
                    <footer>
                        <button name="employee_migration_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="employee_migration_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="employee_migration_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Employee Migration Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.migration.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_employee_migration_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem
              name="Employee Migration Report"
              id="menu_employee_migration_report"
              sequence="1"
              parent="custom_hr_report.menu_employee_info_report_root"
              action="employee_migration_report_wizard_action"
              groups="hr.group_hr_user"
        />

    </data>
</odoo>