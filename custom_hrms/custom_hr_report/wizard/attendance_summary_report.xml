<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_attendance_summary_report_wizard_form" model="ir.ui.view">
            <field name="name">attendance.summary.report.wizard.form</field>
            <field name="model">attendance.summary.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Attendance Summary Report">
                    <group>
                        <group>
                            <!--                            <field name="year"/>-->
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <!--                            <field name="month"/>-->
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="sbu_unit_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True, 'no_create': 1, 'no_create_edit': 1, 'no_quick_create': True}" />
                        </group>
                    </group>
                    <footer>
                        <button name="attendance_summary_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="attendance_summary_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="attendance_summary_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Attendance Summary Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">attendance.summary.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_attendance_summary_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!--<menuitem name="Attendance Summary Report" id="menu_attendance_summary_report" sequence="30" parent="custom_hr_report.menu_attendance_report_root" action="attendance_summary_report_wizard_action" groups="hr.group_hr_user" />-->
        <menuitem id="menu_attendance_summary_report_att" name="Attendance Summary Report" sequence="35" parent="custom_hr_attendance_sheet.menu_attendance_report_root_attendance_sub" action="attendance_summary_report_wizard_action" groups="hr.group_hr_user" />


    </data>
</odoo>