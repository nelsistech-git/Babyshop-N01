<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>

        <record id="paperformat_employee_salary_sheet_report_tmpl"
                model="report.paperformat">
                <field name="name">Employee Salary Sheet Format</field>
                <field name="default" eval="True" />
                <field name="format">custom</field>
                <field name="orientation">Portrait</field>
                <field name="page_height">297 </field>
                <field name="page_width">210</field>
                <field name="margin_top">30</field>
                <field name="margin_bottom">15</field>
                <field name="margin_left">1</field>
                <field name="margin_right">1</field>
                <!--<field name="header_line" eval="False" />-->
                <field name="header_spacing">25</field>
                <field name="dpi">90</field>
            </record>

            <record id="employee_salary_sheet_report_tmpl" model="ir.actions.report">
                <field name="name">Employee Salary Sheet Report</field>
                <field name="model">employee.salary.sheet.wizard</field>
                <field name="report_type">qweb-pdf</field>
                <field name="report_name">custom_hr_report.employee_salary_sheet_report_view</field>
                <field name="report_file">custom_hr_report.employee_salary_sheet_report_view</field>
                <field name="paperformat_id" ref="custom_hr_report.paperformat_employee_salary_sheet_report_tmpl"/>
            </record>

		<template id="employee_salary_sheet_report_view">
            <t t-call="web.html_container">
                <t t-call="custom_hr_report.custom_external_layout_salary_sheet">
                    <div class="page">
                        <style type="text/css">
                            table, th, tr, td{
                                background: white !important;
                                border: 1px solid black;
                            }
                        </style>
                        <!--<t t-set="data" t-value="request.env['employee.salary.sheet.wizard'].search([('id', '=', ftr_id)], limit=1).employee_salary_sheet_report_sql()"/>
                        <t t-set="model" t-value="data['model']"/>
                        <t t-set="form" t-value="data['form']"/>
                        <t t-set="csr" t-value="data['csr']"/>
                        <t t-set="month" t-value="data['month']"/>
                        <t t-set="color1" t-value="data['color1']"/>
                        <t t-set="color2" t-value="data['color2']"/>
                        <t t-set="color3" t-value="data['color3']"/>
                        <t t-set="dept_name" t-value="data['dept_name']"/>
                        <t t-set="emp_name" t-value="data['emp_name']"/>
                        <t t-set="year" t-value="data['year']"/>-->

                        <div class="oe_structure"/>
                        <div>
                            <h3 class="text-center head_font_color">
                                <strong>
                                    <span t-esc="form['company_id'][1]"/><br/>
                                    Employee Salary Sheet
                                    <span t-esc="month"/>-<span t-esc="year"/>
                                    <br/>
                                    <t t-if="form['location_id']">
                                        Branch: <span t-esc="form['location_id'][1]"/>
                                    </t>
                                    <t t-else="">
                                        Branch: All Branches
                                    </t>
                                </strong>
                            </h3>
                        </div>
                        <br/>
                        <t t-set="sl_no" t-value="1"/>
                        <!-- Branch wise Total Variables -->
                        <t t-set="total_gross" t-value="0"/>
                        <t t-set="total_absent" t-value="0"/>
                        <t t-set="total_leave" t-value="0"/>
                        <t t-set="total_ab_ded" t-value="0"/>
                        <t t-set="total_att_sal" t-value="0"/>
                        <t t-set="total_advance" t-value="0"/>
                        <t t-set="total_loan" t-value="0"/>
                        <t t-set="total_tpf" t-value="0"/>
                        <t t-set="total_other_alw" t-value="0"/>
                        <t t-set="total_ota" t-value="0"/>
                        <t t-set="total_dla" t-value="0"/>
                        <t t-set="total_other_ded" t-value="0"/>
                        <t t-set="total_other_pay" t-value="0"/>
                        <t t-set="total_no_overtime" t-value="0"/>
                        <t t-set="total_actual_late" t-value="0"/>
                        <t t-set="total_late_ded" t-value="0"/>

                        <!-- Grand Total Variables -->
<!--                        <t t-set="gtotal_gross" t-value="0"/>
                        <t t-set="gtotal_absent" t-value="0"/>
                        <t t-set="gtotal_leave" t-value="0"/>
                        <t t-set="gtotal_ab_ded" t-value="0"/>
                        <t t-set="gtotal_att_sal" t-value="0"/>
                        <t t-set="gtotal_advance" t-value="0"/>
                        <t t-set="gtotal_loan" t-value="0"/>
                        <t t-set="gtotal_tpf" t-value="0"/>
                        <t t-set="gtotal_other_alw" t-value="0"/>
                        <t t-set="gtotal_ota" t-value="0"/>
                        <t t-set="gtotal_dla" t-value="0"/>
