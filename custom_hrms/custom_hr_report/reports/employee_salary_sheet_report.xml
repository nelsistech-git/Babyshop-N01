        <template id="custom_external_layout_salary_sheet">
            <t t-if="not o" t-set="o" t-value="doc"/>

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>

            <t t-call="{{company.external_report_layout_id.key}}">
                <t t-raw="0" />
                <t t-call="custom_hr_report.custom_footer_employee_salary_sheet" />
            </t>

<!--        <t t-if="company.external_report_layout_id" t-call="{{company.external_report_layout_id.key}}"><t t-raw="0"/></t>
        <t t-else="else" t-call="web.external_layout_standard"><t t-raw="0"/></t>-->
        </template>


        <template id="custom_footer_employee_salary_sheet">

            <div t-attf-class="footer">
                <div class="row" style="color: #374151; padding-top:15px;">
                    <div class="col-3 text-center">
                        <div>
                            <p style="text-align:center;text-decoration: overline;"><strong>Prepared By</strong></p>
                        </div>
                        <div>
                            <span t-esc="create_uid"/>
                        </div>
                    </div>
                    <div class="col-3 text-center">
                        <div>
                            <p style="text-align:center;text-decoration: overline;"><strong>Checked By</strong></p>
                        </div>
                    </div>
                    <div class="col-3 text-center">
                        <div>
                            <p style="text-align:center;text-decoration: overline;"><strong>Paid By</strong></p>
                        </div>
                    </div>
                    <div class="col-3 text-center">
                        <div>
                            <p style="text-align:center;text-decoration: overline;"><strong>Approved By</strong></p>
                        </div>
                    </div>
                </div>
                <div class="text-center" style="border-top: 3px solid #374151;">
<!--                    <ul class="list-inline" style="color: #374151 !important; margin-top : 10px; margin-bottom : 0;">
                        <li t-if="company.phone" class="list-inline-item">Mobile: <span class="o_force_ltr" t-field="company.phone"/></li>
                        <li t-if="company.email" class="list-inline-item">Email: <span t-field="company.email"/></li>
                        <li t-if="company.website" class="list-inline-item">Website: <span t-esc="(company.website).replace('http://', '').replace('https://', '')"/></li>
                        <li t-if="company.vat" class="list-inline-item"><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-field="company.vat"/></li>
                    </ul>-->
                    <div t-field="company.report_footer"/>
                    <div style="color: #374151 !important; margin-top: 0px; margin-bottom: 0px;" t-if="report_type == 'pdf'">
                        Page: <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
		</template>

