                            h5 {
                                color:teal;
                                text-align:center !important;
                            }

                            .total-row{
                                background-color: #ffffff !important;
                                text-align: center !important;
                                border: 1px solid #000; !important
                            }

                            .th-td-style{
                                font-size:12px;
