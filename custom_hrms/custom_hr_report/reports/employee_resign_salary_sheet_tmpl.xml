<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>

        <record id="paperformat_employee_resign_salary_sheet" model="report.paperformat">
            <field name="name">Employee Resign Salary Sheet Paperformat</field>
            <field name="default" eval="True"/>
            <field name="format">Legal</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">25</field>
            <field name="dpi">110</field>
        </record>


        <record model="ir.actions.report" id="employee_resign_salary_sheet_tmpl">
            <field name="name">Employee Resign Salary Sheet</field>
            <field name="model">employee.resign.salary.sheet.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_hr_report.employee_resign_salary_sheet_view</field>
            <field name="report_file">custom_hr_report.employee_resign_salary_sheet_view</field>
            <field name="paperformat_id" ref="custom_hr_report.paperformat_employee_resign_salary_sheet"/>
        </record>

		<template id="employee_resign_salary_sheet_view">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style type="text/css">
                            table, th, tr, td{
                                background: white !important;
                                border: 1px solid black;
                            }
                        </style>
                        <div class="oe_structure"/>
                        <div>
                            <h3 class="text-center head_font_color">
                                <strong>
                                    <span t-esc="form['company_id'][1]"/>
                                    <br/>
                                    Employee Resign Salary Sheet -
                                    <span t-esc="month"/> <span t-esc="year"/>
                                    <br/>
                                </strong>
                            </h3>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <p style="color: #000; font-size: 15px;"><strong>Work/Job Location:</strong> <t t-esc="work_loc_name"/>
                                    <t t-if="buisness_unit">
                                        <br/>
                                        <strong>Office/business Unit:</strong>
                                        <t t-esc="buisness_unit"/>
                                    </t>
                                </p>
                            </div>
                            <div class="col-4 text-center">
                                <p style="color: #000; font-size: 15px;"><strong>Status:</strong> <t t-esc="state_name"/>
                                    <t t-if="tag_names_list">
                                        <br/>
                                        <strong>Tags:</strong>
                                        <t t-esc="tag_names_list"/>
                                    </t>
                                </p>
                            </div>
                            <div class="col-4 text-right">
                                <p style="color: #000; font-size: 15px;"><strong>Department Name:</strong>  <t t-esc="dept_name"/></p>
                            </div>
                        </div>
                        <br/>
                        <table style="border-collapse: collapse;width: 100%; margin-bottom: 2em;" class="table table-condensed">
                            <thead>
                                <tr style="color: black !important;">
                                    <th rowspan="2" class="text-center align-middle bg_color font_color">Sl.</th>
                                    <th colspan="7" class="text-center align-middle bg_color font_color">Employee Information</th>
                                    <th colspan="5" class="text-center align-middle bg_color font_color">Salary Information</th>
                                    <th colspan="6" class="text-center align-middle bg_color font_color">Attendance Details</th>
                                    <th colspan="6" class="text-center align-middle bg_color font_color">Deduct</th>
                                    <th rowspan="2" class="text-right align-middle bg_color font_color">Cash Payment</th>
                                    <th rowspan="2" class="text-right align-middle bg_color font_color">Bank Payment</th>
                                    <th rowspan="2" class="text-right align-middle bg_color font_color">Adjusted</th>
                                    <th rowspan="2" class="text-center align-middle bg_color font_color">Signature</th>
                                </tr>
                                <tr style="color: black !important;">
                                    <th class="text-center align-middle bg_color font_color">Employee ID</th>
                                    <th class="text-left align-middle bg_color font_color">Name</th>
                                    <th class="text-center align-middle bg_color font_color">Joining Date</th>
                                    <th class="text-left align-middle bg_color font_color">Department</th>
                                    <th class="text-left align-middle bg_color font_color">Designation</th>
                                    <th class="text-left align-middle bg_color font_color">Bank Account</th>
                                    <th class="text-left align-middle bg_color font_color">Location</th>
                                    <th class="text-right align-middle bg_color font_color">Basic</th>
                                    <th class="text-right align-middle bg_color font_color">House Rent</th>
                                    <th class="text-right align-middle bg_color font_color">Medical</th>
                                    <th class="text-right align-middle bg_color font_color">Con. Allowance</th>
                                    <th class="text-right align-middle bg_color font_color">Gross Salary</th>
                                    <th class="text-center align-middle bg_color font_color">Holy Day(Friday + Occasion)</th>
                                    <th class="text-center align-middle bg_color font_color">Leave</th>
                                    <th class="text-center align-middle bg_color font_color">Absent Day</th>
                                    <th class="text-center align-middle bg_color font_color">Total Present Day</th>
                                    <th class="text-center align-middle bg_color font_color">Day of Month</th>
                                    <th class="text-right align-middle bg_color font_color">Absent Amount</th>
                                    <th class="text-right align-middle bg_color font_color">Accrued Salary Payable</th>
                                    <th class="text-right align-middle bg_color font_color">Tax</th>
                                    <th class="text-right align-middle bg_color font_color">Advance Amount</th>
                                    <th class="text-right align-middle bg_color font_color">Loan Adjustment</th>
                                    <th class="text-right align-middle bg_color font_color">PF</th>
                                    <th class="text-right align-middle bg_color font_color">Stamp</th>
                                </tr>
                            </thead>
                            <tbody class="consumed_tbody">
                                <t t-set="sl_no" t-value="1"/>
                                <t t-foreach="csr" t-as="line">
                                    <tr>
                                        <td class="text-center align-middle">
                                            <span t-esc="sl_no"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-esc="line['id_card_no']"/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line['employee_name']"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-esc="line['joining_date']" t-options='{"widget": "date"}'/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line['dept_name']"/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line['emp_designation']"/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line['bnk_ac']"/>
                                        </td>
                                        <td class="text-left align-middle">
                                            <span t-esc="line['emp_work_location']"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['basic_salary'])"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['house_rent'])"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['medical_alw'])"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['conv_alw'])"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['gross_salary'])"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-esc="line['holy_day']"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-esc="line['leave']"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-esc="line['abs_day']"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-esc="line['present_day']"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-esc="line['total_day_of_month']"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['abs_amt'])"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['payable_salary'])"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['advance_amount'])"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['loan_adj'])"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span t-esc="'{0:,.2f}'.format(line['pf'])"/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span/>
                                        </td>
                                        <td class="text-right align-middle">
                                            <span/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span/>
                                        </td>
                                    </tr>
                                    <t t-set="sl_no" t-value="sl_no + 1"/>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
		</template>
	</data>
</odoo>
