<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>

        <record id="date_wise_late_early_report_tmpl" model="ir.actions.report">
            <field name="name">Date wise Employee Late-Early Report</field>
            <field name="model">date.wise.late.early.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_hr_report.date_wise_late_early_report_view</field>
            <field name="report_file">custom_hr_report.date_wise_late_early_report_view</field>
            <field name="paperformat_id" ref="custom_common_settings.paperformat_custom_a4_bd"/>
        </record>

		<template id="date_wise_late_early_report_view">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style type="text/css">
                             table, th, tr, td{
                                background: white !important;
                                border: 1px solid black;
                            }
                        </style>
                        <div class="oe_structure"/>
                        <div>
                            <h3 class="text-center head_font_color">
                                <strong>
                                    <span t-esc="form['company_id'][1]"/>
                                    <br/>
                                    Date wise Employee Late-Early Report
                                </strong>
                            </h3>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p style="color: #000; font-size: 15px;">
                                    <strong>From Date:</strong> <t t-esc="form['from_date']" t-options='{"widget": "date"}'/>
                                    <br/>
                                    <strong>Work/Job Location:</strong> <t t-esc="work_loc_name"/></p>
                            </div>
                            <div class="col-6 text-right">
                                <p style="color: #000; font-size: 15px;">
                                    <strong>To Date:</strong> <t t-esc="form['to_date']" t-options='{"widget": "date"}'/>
                                    <br/>
                                    <strong>Department Name:</strong>  <t t-esc="dept_name"/>
                                    <t t-if="buisness_unit">
                                        <br/>
                                        <strong>Office/business Unit:</strong>  <t t-esc="buisness_unit"/>
                                    </t>
                                    <t t-if="tag_names_list">
                                        <br/>
                                        <strong>Tags:</strong>  <t t-esc="tag_names_list"/>
                                    </t>
                                    </p>
                            </div>
                        </div>
                        <br/>

                         <t t-set="sl_no" t-value="1"/>

                        <t t-foreach="csr" t-as="line">
                            <t t-foreach="line" t-as="line2">
                                <div>
                                    <h6 class="text-left">
                                        <strong>
                                            Branch: <span t-esc="line[str(line2)][0]['location_name']"/><br/>
                                        </strong>
                                    </h6>
                                </div>
                                <table style="border-collapse: collapse;width: 100%; margin-bottom: 2em;" class="table table-condensed">
                                    <thead>
                                        <tr>
                                            <th class="text-center align-middle bg_color font_color">Sl. No.</th>
                                            <th class="text-left align-middle bg_color font_color">Employee Name</th>
                                            <th class="text-left align-middle bg_color font_color">Employee ID No</th>
                                            <th class="text-left align-middle bg_color font_color">Department</th>
                                            <th class="text-left align-middle bg_color font_color">Designation</th>
                                            <th class="text-center align-middle bg_color font_color">Actual Late Days</th>
                                            <th class="text-center align-middle bg_color font_color">Deduction Absent</th>
                                            <th class="text-center align-middle bg_color font_color">Real Absent Days</th>
                                            <th class="text-center align-middle bg_color font_color">Total Absent Day</th>
                                            <th class="text-center align-middle bg_color font_color">Early Out</th>
                                        </tr>
                                    </thead>
                                    <tbody class="consumed_tbody">
                                        <t t-foreach="line[str(line2)]" t-as="line3">
                                            <tr>
                                                <td class="text-center align-middle">
                                                    <t t-esc="sl_no"/>
                                                </td>
                                                <td class="text-left align-middle">
                                                    <span t-esc="line3['employee_name']"/>
                                                </td>
                                                <td class="text-left align-middle">
                                                    <span t-esc="line3['emp_id_card']"/>
                                                </td>
                                                <td class="text-left align-middle">
                                                    <span t-esc="line3['department_name']"/>
                                                </td>
                                                <td class="text-left align-middle">
                                                    <span t-esc="line3['designation_name']"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-esc="line3['total_late']"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-esc="line3['deduct_abs']"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-esc="line3['total_ab']"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-esc="line3['total_ab_with_deduct']"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-esc="line3['early_out']"/>
                                                </td>
                                            </tr>
                                            <t t-set="sl_no" t-value="sl_no + 1"/>
                                        </t>
                                    </tbody>
                                </table>
                                <t t-set="sl_no" t-value="1"/>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
		</template>
	</data>
</odoo>