<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>

        <record id="loan_report_tmpl" model="ir.actions.report">
            <field name="name">Loan Report</field>
            <field name="model">loan.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_hr_report.loan_report_view</field>
            <field name="report_file">custom_hr_report.loan_report_view</field>
        </record>

		<template id="loan_report_view">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style type="text/css">
                            th, tr, td{
                                background: white !important;
                                border: 1px solid black;
                            }
                        </style>
                        <div class="oe_structure"/>
                        <div>
                            <h3 class="text-center head_font_color">
                                <strong>
                                    <span t-esc="form['company_id'][1]"/>
                                </strong>
                            </h3>
                            <h4 class="text-center head_font_color">
                                <strong>
                                    Employee Loan Issue Detail
                                </strong>
                            </h4>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p style="color: #000; font-size: 15px;"><strong>Work/Job Location:</strong> <t t-esc="work_loc_name"/></p>
                            </div>
                            <div class="col-6 text-right">
                                <p style="color: #000; font-size: 15px;"><strong>Department Name:</strong>  <t t-esc="dept_name"/></p>
                            </div>
                        </div>
                        <br/>

                        <t t-set="sl_no" t-value="1"/>
                        <t t-set="total_loan_amt" t-value="0"/>
                        <t t-set="total_adj_amt" t-value="0"/>
                        <t t-set="total_remain_amt" t-value="0"/>
                        <t t-set="total_inst_amt" t-value="0"/>

                        <t t-foreach="csr" t-as="line">
                            <t t-foreach="line" t-as="line2">
                                <div>
                                    <h6 class="text-left">
                                        <strong>
                                            Branch: <span t-esc="line[str(line2)][0]['location_name']"/><br/>
                                        </strong>
                                    </h6>
                                </div>
                                <table style="border-collapse: collapse;width: 100%; margin-bottom: 2em;" class="table table-condensed">
                                    <thead>
                                        <tr>
                                            <th class="text-center align-middle bg_color font_color">Sl.</th>
                                            <th class="text-left align-middle bg_color font_color">ID</th>
                                            <th class="text-left align-middle bg_color font_color">Name</th>
                                            <th class="text-left align-middle bg_color font_color ">Loan No.</th>
                                            <th class="text-center align-middle bg_color font_color">Loan Dt</th>
                                            <th class="text-right align-middle bg_color font_color">Loan Amt</th>
                                            <th class="text-right align-middle bg_color font_color">Adj Amt</th>
                                            <th class="text-right align-middle bg_color font_color">Due Amt</th>
                                            <th class="text-right align-middle bg_color font_color">Schedule Amt</th>
                                        </tr>
                                    </thead>
                                    <tbody class="consumed_tbody">
                                        <t t-foreach="line[str(line2)]" t-as="line3">
                                            <tr>
                                                <td>
                                                    <span t-esc="sl_no"/>
                                                </td>
                                                <td>
                                                    <span t-esc="line3['id_no']"/>
                                                </td>
                                                <td>
                                                    <span t-esc="line3['emp_name']"/>
                                                </td>
                                                <td class="text-left">
                                                    <span t-esc="line3['loan_no']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="line3['loan_date']"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="'{0:,.2f}'.format(line3['loan_amt'])"/>
                                                    <t t-set="total_loan_amt" t-value="total_loan_amt + line3['loan_amt']"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="'{0:,.2f}'.format(line3['adj_amt'])"/>
                                                    <t t-set="total_adj_amt" t-value="total_adj_amt + line3['adj_amt']"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="'{0:,.2f}'.format(line3['loan_amt'] - line3['adj_amt'])"/>
                                                    <t t-set="total_remain_amt" t-value="total_remain_amt + (line3['loan_amt'] - line3['adj_amt'])"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="'{0:,.2f}'.format(line3['inst_amt'])"/>
                                                    <t t-set="total_inst_amt" t-value="total_inst_amt + line3['inst_amt']"/>
                                                </td>
                                            </tr>
                                            <t t-set="sl_no" t-value="sl_no + 1"/>
                                        </t>
                                        <tr style="border: 1px solid black;">
                                            <td class="text-right" colspan="5"><strong>TOTAL</strong></td>
                                            <td class="text-right">
                                                <strong><t t-esc="'{0:,.2f}'.format(total_loan_amt)"/></strong>
                                            </td>
                                            <td class="text-right">
                                                <strong><t t-esc="'{0:,.2f}'.format(total_adj_amt)"/></strong>
                                            </td>
                                            <td class="text-right">
                                                <strong><t t-esc="'{0:,.2f}'.format(total_remain_amt)"/></strong>
                                            </td>
                                            <td class="text-right">
                                                <strong><t t-esc="'{0:,.2f}'.format(total_inst_amt)"/></strong>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <t t-set="sl_no" t-value="1"/>
                                <t t-set="total_loan_amt" t-value="0"/>
                                <t t-set="total_adj_amt" t-value="0"/>
                                <t t-set="total_remain_amt" t-value="0"/>
                                <t t-set="total_inst_amt" t-value="0"/>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
		</template>
	</data>
</odoo>
