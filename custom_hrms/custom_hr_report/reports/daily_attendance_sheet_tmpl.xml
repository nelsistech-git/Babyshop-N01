<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <record id="daily_attendance_sheet_report_id" model="ir.actions.report">
            <field name="name">Daily Attendance Sheet</field>
            <field name="model">daily.attendance.sheet.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_hr_report.daily_attendance_sheet_report_view</field>
            <field name="report_file">custom_hr_report.daily_attendance_sheet_report_view</field>
            <field name="paperformat_id" ref="custom_common_settings.paperformat_custom_a4_bd" />
        </record>

        <!--<record id="paperformat_daily_attendance_sheet_report_id_format"
			model="report.paperformat">
