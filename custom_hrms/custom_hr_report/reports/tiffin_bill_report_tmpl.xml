<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <record id="tiffin_bill_report_id" model="ir.actions.report">
            <field name="name">Tiffin Bill Report</field>
            <field name="model">night.food.allowance.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_hr_report.tiffin_bill_report_view</field>
            <field name="report_file">custom_hr_report.tiffin_bill_report_view</field>
        </record>

		<template id="tiffin_bill_report_view">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style type="text/css">
                            th, tr, td{
                                background: white !important;
                                border: 1px solid black !important;
                            }
                        </style>

                        <t t-set="data" t-value="request.env['night.food.allowance.report.wizard'].sudo().search([('id', '=', ftr_id)], limit=1).night_food_allowance_report_sql()"/>

                        <t t-set="model" t-value="data['model']"/>
                        <t t-set="form" t-value="data['form']"/>
                        <t t-set="csr" t-value="data['csr']"/>
                        <t t-set="touch_time_after" t-value="data['touch_time_after']"/>
                        <t t-set="work_loc_name" t-value="data['work_loc_name']"/>
                        <t t-set="start_date" t-value="data['start_date']"/>
                        <t t-set="end_date" t-value="data['end_date']"/>
                        <t t-set="dept_name" t-value="data['dept_name']"/>
                        <t t-set="eligible_hour" t-value="data['eligible_hour']"/>

                        <div class="oe_structure"/>
                        <div>
                            <h3 class="text-center head_font_color">
                                <strong>
                                    <span t-esc="form['company_id'][1]"/>
                                    <br/>
                                    Tiffin Bill Report</strong>
                            </h3>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <p style="color: #000; font-size: 15px;"><strong>Work/Job Location:</strong> <t t-esc="work_loc_name"/></p>
                            </div>
                            <div class="col-4 text-center">
                                <p style="color: #000; font-size: 15px;"><strong>Eligible Hour:</strong> <t t-esc="eligible_hour"/></p>
                            </div>
                            <div class="col-4 text-right">
                                <p style="color: #000; font-size: 15px;"><strong>Department/Section:</strong> <t t-esc="dept_name"/></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p style="color: #000; font-size: 15px;"><strong>From Date:</strong> <t t-esc="start_date" t-options='{"widget": "date"}'/></p>
                            </div>
                            <div class="col-6 text-right">
                                <p style="color: #000; font-size: 15px;"><strong>To Date:</strong> <t t-esc="end_date" t-options='{"widget": "date"}'/></p>
                            </div>
                        </div>
                        <br/>

                        <t t-set="sub_section_total_emp" t-value="0"/>
                        <t t-set="total_emp" t-value="0"/>

                        <t t-foreach="csr" t-as="line">
                            <t t-foreach="line" t-as="line2">
                                <t t-if="sub_section_total_emp > 0">
                                    <t t-set="total_emp" t-value="total_emp + sub_section_total_emp"/>
                                     <div style="margin-top:0em;padding-top:0em;">
                                        <h7 class="text-left">
                                            <strong>
                                                Sub-Total: <span t-esc="sub_section_total_emp"/><br/>
                                            </strong>
                                        </h7>
                                    </div>
                                     <br/>
                                 </t>

                                <div>
                                    <h6 class="text-left">
                                        <strong>
                                            Department/Section: <span t-esc="line[line2][0]['department_name']"/><br/>
                                        </strong>
                                    </h6>
                                </div>

                                <table style="border-collapse: collapse;width: 100%; margin-bottom: 2em;" class="table table-condensed">
                                    <thead>
                                        <tr>
                                            <th class="text-center align-middle bg_color font_color">Sl.No.</th>
                                            <th class="text-center align-middle bg_color font_color">Date</th>
                                            <th class="text-center align-middle bg_color font_color">Emp.ID</th>
                                            <th class="text-left align-middle bg_color font_color">Name of Employee</th>
                                            <th class="text-left align-middle bg_color font_color">Category</th>
                                            <th class="text-left align-middle bg_color font_color">Designation</th>
                                            <th class="text-left align-middle bg_color font_color">Shift</th>
                                            <th class="text-left align-middle bg_color font_color">Out<br/>Time</th>
                                        </tr>
                                    </thead>
                                    <t t-set="sl_no" t-value="0"/>
                                    <t t-set="sub_section_total_emp" t-value="0"/>

                                    <tbody class="consumed_tbody" style="font-size:12px;">
                                        <t t-foreach="line[line2]" t-as="line3">
                                            <t t-set="sl_no" t-value="sl_no + 1"/>
                                            <t t-set="sub_section_total_emp" t-value="sub_section_total_emp + 1"/>

                                            <tr>
                                                <td class="text-center align-middle">
                                                    <span t-esc="sl_no"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-esc="line3['date']"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-esc="line3['emp_id_card']"/>
                                                </td>
                                                <td class="text-left align-middle">
                                                    <span t-esc="line3['employee_name']"/>
                                                </td>
                                                <td class="text-left align-middle">
                                                    <span t-esc="line3['emp_category']"/>
                                                </td>
                                                <td class="text-left align-middle">
                                                    <span t-esc="line3['designation_name']"/>
                                                </td>
                                                <td class="text-left align-middle">
                                                    <span t-esc="line3['emp_shift']"/>
                                                </td>
                                                <td class="text-left align-middle">
                                                    <t t-set="out_time" t-value="request.env['night.food.allowance.report.wizard'].sudo().search([('id', '=', ftr_id)], limit=1)._get_time_from_float(line3['date'], line3['check_out_time'])"/>

                                                    <span t-esc="out_time" widget="float_time"/>
                                                </td>

                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                <t t-set="sl_no" t-value="1"/>
                            </t>
                        </t>
                        <t t-if="sub_section_total_emp > 0">
                            <t t-set="total_emp" t-value="total_emp + sub_section_total_emp"/>
                             <div style="margin-top:0em;padding-top:0em;">
                                <h7 class="text-left">
                                    <strong>
                                        Sub-Total: <span t-esc="sub_section_total_emp"/><br/>
                                    </strong>
                                </h7>
                            </div>
                             <br/>
                         </t>

                        <t t-if="total_emp > 0">
                             <div>
                                <h7 class="text-left">
                                    <strong>
                                        Grand-Total: <span t-esc="total_emp"/><br/>
                                    </strong>
                                </h7>
                            </div>

                         </t>

                    </div>
                </t>
            </t>
		</template>
	</data>
</odoo>
