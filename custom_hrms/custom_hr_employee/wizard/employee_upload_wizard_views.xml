<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_list_upload_wizard_form" model="ir.ui.view">
            <field name="name">employee.list.upload.wizard.form</field>
            <field name="model">employee.list.upload.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Upload">
                    <group>
                        <group>
                            <field name="upload_csv_file" help="Follow CSV sample format"/>
                            <field name="upload_des" invisible="upload_des == False" readonly="1"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <footer>
                        <button name="action_employee_list_upload" type="object" string=" Upload"
                        class="oe_highlight fa fa-upload" confirm="Are you sure you want to upload?"/>
                        <button name="action_sample_download" class="oe_highlight fa fa-download" type="object" string=" Sample"/>
                        <button string="Cancel" special="cancel" class="oe_link" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_employee_list_upload_wizard" model="ir.actions.act_window">
            <field name="name">Employee Upload</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.list.upload.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_employee_list_upload_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_employee_list_upload_wizard" name="Employee Upload" parent="custom_hr_employee.menu_hr_employee_operations" action="action_employee_list_upload_wizard" sequence="150"/>
    </data>
</odoo>