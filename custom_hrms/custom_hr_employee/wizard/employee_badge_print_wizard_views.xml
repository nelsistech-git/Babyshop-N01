<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_badge_print_wizard_form" model="ir.ui.view">
            <field name="name">employee.badge.print.wizard.form</field>
            <field name="model">employee.badge.print.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Badge Print">
                    <group>
                        <field name="employee_ids"/>
                    </group>
                    <footer>
                        <button name="print_badge" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="employee_badge_print_wizard_action" model="ir.actions.act_window">
            <field name="name">Employee Badge Print</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.badge.print.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_employee_badge_print_wizard_form"/>
            <field name="target">new</field>
        </record>
