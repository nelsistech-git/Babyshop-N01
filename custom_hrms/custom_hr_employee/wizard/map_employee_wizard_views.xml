<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_map_employee_wizard" model="ir.ui.view">
        <field name="name">map.employee.wizard.form</field>
        <field name="model">map.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Map Employee">
                <sheet>
                    <group>
                        <field name="employee_id" readonly="1"/>
                        <field name="employee_name" readonly="1"/>
                        <field name="employee_email" readonly="1"/>
                        <field name="employee_mobile" readonly="1"/>
                        <field name="related_user_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        <field name="address_home_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight"/>
                    <button name="action_confirm_all" type="object" string="Map all Employee" class="oe_highlight" groups="hr.group_hr_manager" help="Max 100 Employee Mapped at a time!"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>