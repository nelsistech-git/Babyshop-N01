<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--Form View -->
        <record id="hr_job_grade_type_view_form" model="ir.ui.view">
            <field name="name">hr.job.grade.type.form</field>
            <field name="model">hr.job.grade.type</field>
            <field name="arch" type="xml">
                <form string="Grade Type">
                    <group name="main">
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <!--Tree View -->
        <record id="hr_job_grade_type_view_tree" model="ir.ui.view">
            <field name="name">hr.job.grade.type.tree</field>
            <field name="model">hr.job.grade.type</field>
            <field name="arch" type="xml">
                <tree string="Grade Type">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <!--Action View -->
        <record id="hr_job_grade_type_view_list_action"
                model="ir.actions.act_window">
            <field name="name">Grade Type</field>
            <field name="res_model">hr.job.grade.type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Grade Type</p>
            </field>
        </record>

        <!--Create Job Grade Submenu -->
        <menuitem id="menu_hr_job_grade_type" name="Grade Type"
                  parent="menu_hr_job_grade_root" sequence="5"
                  action="hr_job_grade_type_view_list_action"
                  groups="hr.group_hr_manager"/>

    </data>
</odoo>

