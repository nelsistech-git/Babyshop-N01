<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--form View-->
        <record id="inherited_hr_department_view_form" model="ir.ui.view">
            <field name="name">inherited.hr.department.form</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='manager_id']" position="replace">
                    <field name="manager_id" options="{'no_open': True, 'no_create': 1, 'no_create_edit': 1}"/>
                </xpath>


                <xpath expr="//field[@name='parent_id']" position="replace">
                    <field name="parent_id" options="{'no_open': True, 'no_create': 1, 'no_create_edit': 1}"/>
                </xpath>

            </field>
        </record>

        <!--Search View-->
        <record id="inherited_hr_emp_dept_view_search" model="ir.ui.view">
            <field name="name">hr.department.search.inherit.hr</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search/field[@name='manager_id']" position="replace">
                    <field name="manager_id"/>
                    <field name="parent_id"/>
                </xpath>
                <xpath expr="//search/field[@name='parent_id']" position="after">
                    <filter string="Parent Department" domain="[]" context="{'group_by':'parent_id'}"/>

                    <!-- <filter string="Permanent" name="permanent" domain="[('employee_type', '=', 'Permanent')]"/> -->

                </xpath>
            </field>
        </record>

        <!--Employee Tree View-->
        <record id="inherited_hr_emp_dept_view_tree" model="ir.ui.view">
            <field name="name">hr.department.tree.inherit.hr</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_tree"/>
            <field name="arch" type="xml">
                <!-- <xpath expr="//tree/field[@name='work_phone']" position="replace"></xpath>
                <xpath expr="//tree/field[@name='work_email']" position="replace"></xpath>
                <xpath expr="//tree/field[@name='parent_id']" position="replace"></xpath>-->

                <xpath expr="//tree/field[@name='parent_id']" position="replace"></xpath>

                <xpath expr="//tree/field[@name='display_name']" position="before">
                    <field name="name"/>
                    <field name="parent_id"/>
                </xpath>

                <xpath expr="//tree/field[@name='display_name']" position="replace"></xpath>

            </field>
        </record>
    </data>
</odoo>