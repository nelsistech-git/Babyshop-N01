<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_sbu_unit_form" model="ir.ui.view">
        <field name="name">hr.sbu.unit.form</field>
        <field name="model">hr.sbu.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="1" force_save="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sbu_tower_id"/>
                            <field name="sbu_head_id"/>
                            <field name="hr_unit_manager_id"/>
                            <field name="marketing_unit_manager_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_sbu_unit_tree" model="ir.ui.view">
        <field name="name">hr.sbu.unit.tree</field>
        <field name="model">hr.sbu.unit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="sbu_tower_id"/>
                <field name="sbu_head_id"/>
                <field name="hr_unit_manager_id"/>
                <field name="marketing_unit_manager_id"/>
            </tree>
        </field>
    </record>
    <record id="view_hr_sbu_unit_search" model="ir.ui.view">
        <field name="name">hr.sbu.unit.search</field>
        <field name="model">hr.sbu.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="sbu_tower_id"/>
                <field name="sbu_head_id"/>
                <field name="hr_unit_manager_id"/>
                <field name="marketing_unit_manager_id"/>
            </search>
        </field>
    </record>
    <record id="action_hr_sbu_unit_form" model="ir.actions.act_window">
        <field name="name">Strategic Business Unit (SBU)</field>
        <field name="res_model">hr.sbu.unit</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create your first Unit.
            </p>
        </field>
    </record>

    <menuitem
            id="menu_hr_sbu_unit"
            name="SBU"
            parent="menu_hr_employee_settings_root"
            action="action_hr_sbu_unit_form"
            groups="hr.group_hr_user"
            sequence="100"/>
</odoo>