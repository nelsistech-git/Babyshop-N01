<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_extra_info_partner_fields" model="ir.ui.view">
        <field name="name">crm.lead.form.extra.info.partner.fields</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='lead']//field[@name='source_id']" position="replace">
                <field name="source_id" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="inside">
                <group string="Custom Contact Info">
                    <field name="followers_type"/>
                    <field name="product_details"/>
                    <field name="fabric_type"/>
                    <field name="business_type"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>