<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <!--Tree View-->
        <record id="hr_document_type_tree" model="ir.ui.view">
            <field name="name">hr.document.type.tree</field>
            <field name="model">hr.document.type</field>
            <field name="arch" type="xml">
                <tree string="Employee Contact Relation" editable="bottom">
                    <field name="name"/>
                </tree>

            </field>
        </record>

        <!--Action View-->
        <record id="hr_document_type_action" model="ir.actions.act_window">
            <field name="name">Employee Document Type</field>
            <field name="res_model">hr.document.type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Employee Document Type</p>
            </field>
        </record>

        <!--Add Menu Item-->
        <menuitem id="menu_hr_document_type" name="Document Type" parent="menu_hr_employee_settings_root"
                  sequence="55" action="hr_document_type_action" groups="hr.group_hr_manager"/>

    </data>
</odoo>