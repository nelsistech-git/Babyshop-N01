<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <!-- Attendance Reprocess Dates Tree View -->
    <record id="view_attendance_reprocess_dates_tree" model="ir.ui.view">
        <field name="name">attendance.reprocess.dates.tree</field>
        <field name="model">attendance.reprocess.dates</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" editable="bottom">
                <field name="type"/>
                <field name="employee_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                <field name="date"/>
                <field name="process_flag"/>
            </tree>
        </field>
    </record>
	
    <!-- Attendance Reprocess Dates Action -->
    <record id="action_attendance_reprocess_dates" model="ir.actions.act_window">
        <field name="name">Attendance Reprocess Dates</field>
        <field name="res_model">attendance.reprocess.dates</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an Attendance Reprocess Dates!
            </p>
        </field>
    </record>
</odoo>
