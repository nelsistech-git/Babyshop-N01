<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <!--Tree View-->
        <record id="hr_bank_view_tree" model="ir.ui.view">
            <field name="name">hr.bank.tree</field>
            <field name="model">hr.bank</field>
            <field name="arch" type="xml">
                <tree string="Bank Name" editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <!--Action View-->
        <record id="hr_bank_action" model="ir.actions.act_window">
            <field name="name">HR Bank</field>
            <field name="res_model">hr.bank</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Bank Name</p>
            </field>
        </record>

        <!--Add Menu Item-->
        <menuitem id="menu_hr_bank" name="HR Bank" parent="menu_hr_employee_settings_root"
                  sequence="25" action="hr_bank_action" groups="hr.group_hr_manager"/>

    </data>
</odoo>