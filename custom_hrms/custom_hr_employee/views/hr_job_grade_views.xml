<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--Form View-->
        <record id="hr_job_grade_view_form" model="ir.ui.view">
            <field name="name">hr.job.grade.form</field>
            <field name="model">hr.job.grade</field>
            <field name="arch" type="xml">
                <form string="Grade Type">
                    <sheet>
                        <group name="main">
                            <group>
                                <field name="name" string="Name"/>
                                <field name="grade_type" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                            </group>
                            <group>
                                <field name="job_level" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                            </group>
                            <field name="line_ids" nolabel="1">
                                <tree editable="bottom" string="Designation">
                                    <field name="name" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                    <field name="dept_name" options="{'no_open':True,'no_create':1,'no_create_edit':1}"
                                           readonly="1"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--Tree View-->
        <record id="hr_job_grade_view_tree" model="ir.ui.view">
            <field name="name">hr.job.grade.tree</field>
            <field name="model">hr.job.grade</field>
            <field name="arch" type="xml">
                <tree string="Grade Type">
                    <field name="name" string="Name"/>
                    <field name="grade_type"/>
                    <field name="job_level"/>
                </tree>
            </field>
        </record>


        <!--Action View Job grade-->
        <record id="hr_job_grade_view_list_action" model="ir.actions.act_window">
            <field name="name">Job Grade</field>
            <field name="res_model">hr.job.grade</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'readonly_by_pass': ['name', 'grade_type', 'job_level']}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Job Grade</p>
            </field>
        </record>

        <!--Action View Job grade Line-->
        <record id="hr_job_grade_line_view_list_action" model="ir.actions.act_window">
            <field name="name">Job Grade Line</field>
            <field name="res_model">hr.job.grade.line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Job Grade</p>
            </field>
        </record>


        <record id="inherit_hr_job_work_location_inherit_hr_job" model="ir.ui.view">
            <field name="name">hr.job.work.location</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr_recruitment.hr_job_survey"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='address_id']" position="replace">
                    <field name="address_id" invisible="1"/>
                    <field name="user_work_location_id" string="Work/Job Location"
                           context="{'show_address': 1}"
                           domain="[('company_id','=',company_id),('is_work_loc','=',True)]"
                           options='{"no_open":True,"no_create":1,"no_create_edit":1}'/>
                </xpath>
            </field>
        </record>

        <record id="inherit_view_hr_job_form_inherit_hr_job" model="ir.ui.view">
            <field name="name">hr.job.form.inherit</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='contract_type_id']" position="after">
                    <field name="approved_man"/>
                </xpath>
            </field>
        </record>
        <record id="inherit_view_hr_job_tree_inherit_hr_job" model="ir.ui.view">
            <field name="name">hr.job.tree.inherit</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='no_of_employee']" position="before">
                    <field name="approved_man"/>
                </xpath>
            </field>
        </record>


        <!--parent="menu_hr_job_grade_root"-->
        <menuitem id="menu_hr_job_grade" name="Job Grade" parent="menu_hr_job_grade_root"
                  sequence="15" action="hr_job_grade_view_list_action"
                  groups="hr.group_hr_manager"/>

    </data>
</odoo>