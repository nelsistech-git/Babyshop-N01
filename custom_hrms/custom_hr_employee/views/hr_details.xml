<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--Dependence Details-->
        <!--Form View-->
        <record id="hr_dependence_details_view_form" model="ir.ui.view">
            <field name="name">hr.employee.form</field>
            <field name="model">hr.employee.family</field>
            <field name="arch" type="xml">
                <form string="Dependence Details">
                    <sheet>
                        <group name="main">
                            <group>
                                <field name="employee_id" required="1" string="Employee"/>
                                <field name="member_name" required="1" string="Name"/>
                                <field name="relation_id" required="1" string="Relation"/>
                            </group>
                            <group>
                                <field name="member_contact" string="Contact No"/>
                                <field name="birth_date" string="Date of Birth"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--Tree View-->
        <record id="hr_dependence_details_view_tree" model="ir.ui.view">
            <field name="name">hr.employee.tree.dependence</field>
            <field name="model">hr.employee.family</field>
            <field name="arch" type="xml">
                <tree string="Dependence Details">
                    <field name="employee_id" required="1" string="Employee"/>
                    <field name="member_name" required="1" string="Name"/>
                    <field name="relation_id" required="1" string="Relation"/>
                    <field name="member_contact" string="Contact No"/>
                    <field name="birth_date" string="Date of Birth"/>
                </tree>
            </field>
        </record>

        <record id="hr_dependence_details_view_list_action" model="ir.actions.act_window">
            <field name="name">Dependence Details</field>
            <field name="res_model">hr.employee.family</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Dependence Details</p>
            </field>
        </record>

        <menuitem id="menu_hr_dependence_details" name="Dependence Details" parent="menu_hr_employee_details"
                  sequence="10" action="hr_dependence_details_view_list_action" groups="hr.group_hr_manager"/>


