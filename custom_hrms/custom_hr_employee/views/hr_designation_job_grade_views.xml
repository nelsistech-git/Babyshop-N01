<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--Form View-->
        <record id="hr_desig_job_grade_line_view_form" model="ir.ui.view">
            <field name="name">hr.job.grade.line.form</field>
            <field name="model">hr.job.grade.line</field>
            <field name="arch" type="xml">
                <form string="Designation-Job Grade">
                    <sheet>
                        <group name="main">
                            <group>
                                <field name="job_grade" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="grade_type" options="{'no_open':True,'no_create':1,'no_create_edit':1}"
                                       readonly="1"/>
                                <field name="job_level" options="{'no_open':True,'no_create':1,'no_create_edit':1}"
                                       readonly="1"/>
                            </group>
                            <group>
                                <field name="name" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                                <field name="dept_name" options="{'no_open':True,'no_create':1,'no_create_edit':1}"
                                       readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--Tree View-->
        <record id="hr_desig_job_grade_line_view_tree" model="ir.ui.view">
            <field name="name">hr.job.grade.line.tree</field>
            <field name="model">hr.job.grade.line</field>
            <!--            <field name="view_type">tree</field>-->
            <field name="arch" type="xml">
                <tree string="Grade Type">
                    <field name="job_grade" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                    <field name="grade_type" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                    <field name="job_level" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                    <field name="name" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                    <field name="dept_name" options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                </tree>
            </field>
        </record>

