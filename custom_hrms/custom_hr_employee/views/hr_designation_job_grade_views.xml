        <!--Action View Job grade-->
        <record id="hr_desig_job_grade_line_view_list_action" model="ir.actions.act_window">
            <field name="name">Designation-Job Grade</field>
            <field name="res_model">hr.job.grade.line</field>
            <!--            <field name="view_type">form</field>-->
