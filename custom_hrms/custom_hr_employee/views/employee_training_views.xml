<odoo>
    <data>
        <record id="view_employee_training_form" model="ir.ui.view">
            <field name="name">employee.training.view.form</field>
            <field name="model">employee.training</field>
            <field name="arch" type="xml">
                <form delete="0" duplicate="0" string="Employee Training">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm"
                                invisible="state not in ['draft']" class="oe_highlight"/>
                        <button name="action_cancel" type="object" string="Cancel" invisible="state not in ['confirm']"
                                confirm="Are you sure you want to Cancel?" class="oe_highlight"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,cancel"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Employee Training">
                                <field name="training_session_name" required="1"
                                       readonly="state  in ['confirm','cancel']"/>
                                <field name="start_date" required="1" readonly="state  in ['confirm','cancel']"/>
                                <field name="to_date" required="1" readonly="state  in ['confirm','cancel']"/>
                                <field name="expenses" required="1" readonly="state  in ['confirm','cancel']"/>
                                <field name="expense_bear" required="1" readonly="state  in ['confirm','cancel']"/>
                            </group>
                            <group>
                            </group>
                        </group>
                        <separator string="Employee Training List" colspan="12"></separator>
                        <!--<group name="employee_training_ids" string="Employee Training List">-->
                        <field name="employee_training_ids" nolable="1">
                            <tree editable="bottom">
                                <field name="employee_id" required="1"
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1}"/>
                            </tree>
                        </field>
                        <!--</group>-->

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"
                               groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_employee_training_tree" model="ir.ui.view">
            <field name="name">employee.training.view.tree</field>
            <field name="model">employee.training</field>
            <field name="arch" type="xml">
                <tree delete="0" string="Employee Training" decoration-muted="state=='cancel'"
                      decoration-success="state=='confirm'" decoration-info="state=='draft'">
                    <field name="training_session_name"/>
                    <field name="start_date"/>
                    <field name="to_date"/>
                    <field name="expenses"/>
                    <field name="expense_bear"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="search_employee_training_form" model="ir.ui.view">
            <field name="name">search.employee.training</field>
            <field name="model">employee.training</field>
            <field name="arch" type="xml">
                <search string="Search Employee Training">
                    <field name="training_session_name"/>
                    <field name="start_date"/>
                    <field name="to_date"/>
                    <field name="expenses"/>
                    <field name="expense_bear"/>
                    <field name="state"/>
                    <group expand="0" string="Group By...">
                        <filter string="Status" name="state"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_employee_training" model="ir.actions.act_window">
            <field name="name">Employee Training</field>
            <field name="res_model">employee.training</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create an Employee Training Record
                </p>
            </field>
        </record>

        <menuitem id="menu_employee_training" name="Employee Training"
                  parent="custom_hr_employee.menu_hr_employee_operations" action="action_employee_training"
                  groups="hr.group_hr_manager" sequence="300"/>
    </data>
</odoo>