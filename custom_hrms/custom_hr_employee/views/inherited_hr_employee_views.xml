					<page name="skills_resume" string="Resume">
						<div class="row">
							<div class="o_hr_skills_editable o_hr_skills_group o_group_resume col-lg-7 d-flex flex-column">
								<separator string="Resume" class="mb-4"/>
								<!-- This field uses a custom tree view rendered by the 'resume_one2many' widget.
									Adding fields in the tree arch below makes them accessible to the widget
								-->
								<field mode="tree" nolabel="1" name="resume_line_ids" widget="resume_one2many">
									<tree>
										<field name="line_type_id"/>
										<field name="name"/>
										<field name="description"/>
										<field name="date_start"/>
										<field name="date_end"/>
										<field name="display_type" column_invisible="True"/>
									</tree>
								</field>

							</div>
							<div class="o_hr_skills_editable o_hr_skills_group o_group_skills col-lg-5 d-flex flex-column">
								<field mode="tree" nolabel="1" name="employee_skill_ids" widget="skills_one2many" class="mt-2">
									<tree>
										<field name="skill_id"/>
										<field name="skill_level_id"/>
										<field name="level_progress" widget="progressbar"/>
										<field name="skill_type_id" optional="hidden"/>
									</tree>
								</field>
							</div>
						</div>
					</page>
				</xpath>

			</field>
		</record>

		<!--Employee Tree View -->
		<record id="inherited_hr_emp_employee_view_tree"
			model="ir.ui.view">
			<field name="name">hr.employee.tree</field>
			<field name="model">hr.employee</field>
			<field name="inherit_id" ref="hr.view_employee_tree" />
			<field name="arch" type="xml">
				<xpath expr="//tree/field[@name='work_phone']" position="replace"></xpath>
				<xpath expr="//tree/field[@name='work_email']" position="replace"></xpath>
				<xpath expr="//tree/field[@name='parent_id']" position="replace"></xpath>
				<xpath expr="//tree/field[@name='coach_id']" position="replace"></xpath>

				<!--<xpath expr="//tree/field[@name='work_location_id']" position="attributes">
					<attribute name="string">Emp Location</attribute>
				</xpath>-->

				<xpath expr="//tree/field[@name='job_id']" position="replace">
					<field name="job_id" string="Designation" />
				</xpath>

				<xpath expr="//tree/field[@name='name']" position="after">
					<field name="id_card_no"/>
					<field name="device_user_id" />
				</xpath>

				<xpath expr="//tree/field[@name='name']" position="before">
					<field name="identification_id" />
				</xpath>

				<xpath expr="//tree/field[@name='department_id']"
					position="after">
					<field name="company_unit_id" string="Company unit" optional="hide"/>
					<field name="user_work_location_id" string="Job Location" />
					<field name="inter_company_id" string="Internal Company" optional="hide"/>
				</xpath>

				<xpath expr="//tree/field[@name='job_id']" position="after">
					<field name="mobile_phone" string="Cell No (Official)" />
					<field name="contact_no" string="Mobile (Personal)" />
					<field name="work_email" string="E-mail (Official)" />
					<field name="email_personal" string="E-mail(Personal)" />
				</xpath>
			</field>
		</record>
		
		<!--Employee Tree View -->
		<record id="inherited_hr_emp_employee_view_search"
			model="ir.ui.view">
			<field name="name">inherited.hr.employee.search</field>
			<field name="model">hr.employee</field>
			<field name="inherit_id" ref="hr.view_employee_filter" />
			<field name="arch" type="xml">
				<xpath expr="//search/field[@name='name']" position="before">
<!--						<field name="old_emp_id"/>-->
					<field name="id_card_no" filter_domain="[('id_card_no', '=', self)]"/>
				</xpath>
				<xpath expr="//search/field[@name='name']" position="after">
					<field name="device_user_id" filter_domain="[('device_user_id', '=', self)]"/>
					<field name="identification_id" />
					<field name="nid" />
					<field name="department_id" />
					<field name="parent_id" />
					<field name="mobile_phone" />
					<field name="home_town_id" />
					<field name="contact_no" string="Mobile (personal)" />
					<!--<field name="company_unit_id" />-->
					<field name="inter_company_id" />
					<field name="user_work_location_id" />

					<separator/>
					<filter string="Mapped" domain="[('address_home_id', '!=', None)]" name="mapped_emp"/>
					<filter string="Not Mapped" domain="[('address_home_id', '=', None)]" name="not_mapped_emp"/>
                	<separator/>

				</xpath>

			</field>
		</record>
		
		<!--Institution Action View -->
		<record id="institution_list_action"
			model="ir.actions.act_window">
			<field name="name">institution</field>
			<field name="res_model">res.partner</field>
			<!-- <field name="view_type">form</field> -->
			<field name="type">ir.actions.act_window</field>
			<field name="view_mode">tree,form</field>
			<field name="help" type="html">
				<p class="oe_view_nocontent_create">Create the first Institution</p>
			</field>
		</record>



		<!--Inherit hr.employee action view -->
		<record id="hr.open_view_employee_list_my"
			model="ir.actions.act_window">
			<field name="context">{'readonly_by_pass':['job_grade','grade_type','job_level']}
			</field>
		</record>



		<!-- ================= resource calendar ======================== -->
		<record id="inherited_resource_calendar_form_hr_employee" model="ir.ui.view">
			<field name="name">resource.calendar.form.hr.employee</field>
			<field name="model">resource.calendar</field>
			<field name="inherit_id" ref="resource.resource_calendar_form" />
			<field name="arch" type="xml">
				<xpath expr="//group[@name='resource_details']" position="replace">
					<group name="resource_details">
						<group>
							<field name="company_id" groups="base.group_multi_company"/>
							<field name="hours_per_day" widget="float_time"/>
							<field name="tz" widget="timezone_mismatch" options="{'tz_offset_field': 'tz_offset', 'mismatch_title': 'Timezone Mismatch : This timezone is different from that of your browser.\nPlease, be mindful of this when setting the working hours or the time off.'}"/>
							<field name="tz_offset" invisible="1"/>

							<field name="short_name" required="1"/>
							 <field name="is_default"/>
							 <field name="is_over_ride_day"/>
							 <field name="check_in_start" widget="float_time" required="1" help="Check IN time for new day start and Previous Day end point!"/>
							 <!--<field name="check_in_end" widget="float_time" required="1"/>-->
							 <!--<field name="check_out_start" widget="float_time"/>
							 <field name="check_out_end" widget="float_time" help="Over-Ride day last checkout time."/>-->
						</group>
						<group>
							<field name="hour_from_per_day_m" widget="float_time"/>
							<field name="hour_to_per_day_m" widget="float_time"/>
							<field name="hour_from_per_day_e" widget="float_time"/>
							<field name="hour_to_per_day_e" widget="float_time"/>
							<field name="active" invisible="1"/>
						</group>
					</group>
				</xpath>
				<!--<xpath expr="//field[@name='tz']" position="after">
					 <field name="short_name"/>
					 <field name="is_default"/>
					 <field name="is_over_ride_day"/>
					 <field name="check_in_start" widget="float_time"/>
					 <field name="check_in_end" widget="float_time"/>
					 <field name="check_out_start" widget="float_time"/>
					 <field name="check_out_end" widget="float_time" required="1" help="Over-Ride day last checkout time."/>
				</xpath>-->
			</field>
    	</record>

		<record id="inherited_resource_calendar_tree_hr_employee" model="ir.ui.view">
			<field name="name">resource.calendar.tree.hr.employee</field>
			<field name="model">resource.calendar</field>
			<field name="inherit_id" ref="resource.view_resource_calendar_tree" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='name']" position="after">
					 <field name="short_name"/>
					 <field name="is_default"/>
					 <field name="is_over_ride_day"/>

					<field name="check_in_start" widget="float_time"/>

					<field name="hour_from_per_day_m" widget="float_time"/>
					<field name="hour_to_per_day_m" widget="float_time"/>
					<field name="hour_from_per_day_e" widget="float_time"/>
					<field name="hour_to_per_day_e" widget="float_time"/>

					<!--<field name="check_in_end" widget="float_time"/>-->
					<!--<field name="check_out_start" widget="float_time" optional="hide"/>
					<field name="check_out_end" widget="float_time" optional="hide"/>-->
				</xpath>
			</field>
		</record>

	</data>
</odoo>
