            <field name="groups_id" eval="[(6,0,[ref('custom_common_settings.group_timesheets_root_menu')])]"/>
        </record>

        <!--<record model="ir.ui.menu" id="hr_expense.menu_hr_expense_root">
            <field name="sequence" eval="140" />
            &lt;!&ndash;<field name="groups_id" eval="[(6,0,[ref('hr.group_hr_user')])]"/>&ndash;&gt;
            <field name="groups_id" eval="[(6,0,[ref('custom_common_settings.group_expense_root_menu')])]"/>
        </record>-->

        <record model="ir.ui.menu" id="hr.hr_menu_hr_reports">
            <field name="groups_id"
                   eval="[(6,0,[ref('hr.group_hr_user'), ref('custom_common_settings.group_branch_manager')])]"/>
        </record>

