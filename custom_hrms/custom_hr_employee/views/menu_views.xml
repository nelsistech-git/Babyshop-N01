                  action="hr_skills.hr_resume_type_action"
                  parent="menu_hr_employee_settings_root"
                  sequence="47" groups="base.group_no_one,base.group_erp_manager"/>

        <menuitem id="hr_skill_type_menu" name="Skills"
                  action="hr_skills.hr_skill_type_action"
                  parent="menu_hr_employee_settings_root" sequence="48"
                  groups="base.group_no_one,base.group_erp_manager"/>


        <record model="ir.ui.menu" id="hr_timesheet.timesheet_menu_root">
