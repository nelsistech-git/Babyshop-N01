<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--Form View-->
        <record id="hr_job_level_view_form" model="ir.ui.view">
            <field name="name">hr.job.level.form</field>
            <field name="model">hr.job.level</field>
            <field name="arch" type="xml">
                <form string="Job Level">
                    <group name="main">
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <!--Tree View-->
        <record id="hr_job_level_view_tree" model="ir.ui.view">
            <field name="name">hr.job.level.tree</field>
            <field name="model">hr.job.level</field>
            <field name="arch" type="xml">
                <tree string="Job Level">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <!--Action View-->
        <record id="hr_job_level_view_list_action" model="ir.actions.act_window">
            <field name="name">Job Level</field>
            <field name="res_model">hr.job.level</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Job Level</p>
            </field>
        </record>

        <!--        parent="menu_hr_job_grade_root"-->
        <menuitem id="menu_hr_job_level" name="Job Level" parent="menu_hr_job_grade_root"
                  sequence="10" action="hr_job_level_view_list_action" groups="hr.group_hr_manager"/>

    </data>
</odoo>
