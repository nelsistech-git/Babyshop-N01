<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="inherit_view_partner_form_custom_hr" model="ir.ui.view">
        <field name="name">inherit.view.partner.property.form.custom_hr</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="before">
                <field name="is_employee"/>                
                <field name="employee_id"/>
            </xpath>

            <xpath expr="//field[@name='vat']" position="after">
                    <field name="followers_type" />
                    <field name="product_details"/>
                    <field name="fabric_type"/>
                    <field name="business_type"/>
            </xpath>
        </field>
    </record>
    
    <record id="inherit_view_partner_tree_inherit_custom_hr" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit.custom_hr</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
	         <xpath expr="//field[@name='phone']" position="after">
	             <field name="is_employee"/>
	         </xpath>
        </field>
    </record>

    <record id="inherited_res_partner_view_search_custom_hr" model="ir.ui.view">
        <field name="name">res.partner.search.custom_hr</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="after">
                <field name="is_employee"/>
            </xpath>
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Employee" name="is_employee_filter" domain="[('is_employee','=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>


    <!--Bank Action View -->
    <record id="res_bank_list_action" model="ir.actions.act_window">
        <field name="name">Bank Account</field>
        <field name="res_model">res.partner.bank</field>
        <!-- <field name="view_type">form</field> -->
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first Account</p>
        </field>
    </record>
    <menuitem id="menu_account_config" name="Bank Account"
			parent="hr.menu_human_resources_configuration" sequence="7"
			action="res_bank_list_action" groups="hr.group_hr_manager" />
		<!-- <menuitem id="menu_account_config_hr_settings" name="Bank Account"
			parent="menu_hr_employee_settings_root" sequence="21" action="res_bank_list_action"
			groups="hr.group_hr_manager"/> -->

</odoo>
