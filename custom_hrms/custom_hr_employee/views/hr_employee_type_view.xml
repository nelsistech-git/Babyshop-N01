<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <!--Form View-->
        <record id="hr_employee_type_view_form" model="ir.ui.view">
            <field name="name">hr.employee.type.form</field>
            <field name="model">hr.employee.type</field>
            <field name="arch" type="xml">
                <form string="Employee Type">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="is_probation"/>
                                <field name="is_permanent"/>
                                <field name="is_contractual"/>
                                <field name="is_casual"/>
                                <field name="is_part_time"/>
                                <field name="is_deny_pf"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--Tree View-->
        <record id="hr_employee_type_view_tree" model="ir.ui.view">
            <field name="name">hr.employee.type.tree</field>
            <field name="model">hr.employee.type</field>
            <field name="arch" type="xml">
                <tree string="Employee Type">
                    <field name="name"/>
                    <field name="is_probation"/>
                    <field name="is_permanent"/>
                    <field name="is_deny_pf"/>
                </tree>
            </field>
        </record>

        <!--Action View-->
        <record id="hr_employee_type_action" model="ir.actions.act_window">
            <field name="name">Employee Type</field>
            <field name="res_model">hr.employee.type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Employee Type</p>
            </field>
        </record>

        <!--Add Menu Item-->
        <menuitem id="menu_hr_employee_type" name="Employee Type" parent="menu_hr_employee_settings_root"
                  sequence="10" action="hr_employee_type_action" groups="hr.group_hr_manager"/>

    </data>
</odoo>