<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Employee list Tree View -->
        <record id="employee_list_report_view_tree" model="ir.ui.view">
            <field name="name">employee.list.report.tree</field>
            <field name="model">hr.employee.list</field>
            <field name="arch" type="xml">
                <tree string="Employee List" create="false" edit="false" delete="false">
                    <field name="employee_id"/>
                    <field name="master_id"/>
                    <field name="old_emp_id"/>
                    <field name="device_user_id"/>
                    <field name="user_work_location_id"/>
                    <field name="department_id"/>
                    <field name="designation_id"/>
                    <field name="mobile_phone"/>
                    <field name="contact_no"/>
                    <field name="email"/>
                    <field name="email_personal"/>
                </tree>
            </field>
        </record>

        <!-- Employee List Search View -->
        <record id="employee_list_report_view_search" model="ir.ui.view">
            <field name="name">employee.list.report.search</field>
            <field name="model">hr.employee.list</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="old_emp_id" filter_domain="[('old_emp_id', '=', self)]"/>
                    <field name="employee_id"/>
                    <field name="master_id"/>
                    <field name="device_user_id" filter_domain="[('device_user_id', '=', self)]"/>
                    <field name="user_work_location_id"/>
                    <field name="department_id"/>
                    <field name="designation_id"/>
                    <field name="mobile_phone"/>
                    <field name="contact_no"/>
                    <field name="email"/>
                    <field name="email_personal"/>
                    <separator />
                </search>
            </field>
        </record>

        <!-- Employee List Window Action -->
        <record id="employee_list_report_action" model="ir.actions.act_window">
            <field name="type">ir.actions.act_window</field>
            <field name="name">Employee List</field>
            <field name="res_model">hr.employee.list</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create First Employee List</p>
            </field>
        </record>

        <!-- Employee List Server Action -->
        <record id="employee_list_report_srv_action" model="ir.actions.server">
            <field name="name">Employee List Server Action</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="custom_hr_employee.model_hr_employee_list"/>
            <field name="state">code</field>
            <field name="code">action = model.action_generate_employee_list_report()</field>
        </record>

        <menuitem id="employee_list_report_menu" name="Employee List" parent="hr.menu_hr_root"
                  action="employee_list_report_srv_action" sequence="1"
                  groups="group_employee_list_viewer,hr.group_hr_user" active="false"/>
    </data>
</odoo>