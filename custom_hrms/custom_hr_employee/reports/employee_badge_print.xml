    <record id="employee_badge_print_format" model="ir.actions.report">
        <field name="name">"Employee Badge Print</field>
        <field name="model">employee.badge.print.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_hr_employee.employee_badge_print_format_line_qweb</field>
        <field name="report_file">custom_hr_employee.employee_badge_print_format_line_qweb</field>

    </record>

    <record id="paperformat_employee_badge_print_format_line"
        model="report.paperformat">
        <field name="name">Employee Badge Format</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">310 </field>
        <field name="page_width">220</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="custom_hr_employee.employee_badge_print_format" model="ir.actions.report">
        <field name="paperformat_id"
            ref="custom_hr_employee.paperformat_employee_badge_print_format_line" />
    </record>

