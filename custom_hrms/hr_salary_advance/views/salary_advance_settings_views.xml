<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <!--Tree View-->
        <record id="view_salary_advance_settings_tree" model="ir.ui.view">
            <field name="name">salary.advance.settings.tree</field>
            <field name="model">salary.advance.settings</field>
            <field name="arch" type="xml">
                <tree string="Salary Advance Settings" editable="bottom">
                    <field name="name"/>
                    <field name="value"/>
                </tree>

            </field>
        </record>

        <!--Action View-->
        <record id="action_salary_advance_settings" model="ir.actions.act_window">
            <field name="name">Salary Advance Settings</field>
            <field name="res_model">salary.advance.settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first record</p>
            </field>
        </record>

        <!--Add Menu Item-->
        <menuitem id="menu_salary_adv_settings" name="Salary Advance Settings"
                  parent="dev_hr_loan.menu_main_employee_loan_config"
                  sequence="102" action="action_salary_advance_settings" groups="hr.group_hr_manager"/>
    </data>
</odoo>


