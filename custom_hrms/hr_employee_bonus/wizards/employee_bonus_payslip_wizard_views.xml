<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_bonus_payslip_wizard_form" model="ir.ui.view">
        <field name="name">employee.bonus.payslip.wizard.form</field>
        <field name="model">employee.bonus.payslip.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Bonus Payslip">
                <group>
                    <group>
                        <field name="bonus_id" readonly="1" force_save="1"
                               options="{'no_open':True,'no_create_edit':1}"/>
                        <field name="bonus_type_id" readonly="1" force_save="1"
                               options="{'no_open':True,'no_create_edit':1}"/>
                        <field name="date" readonly="1" force_save="1"/>
                        <field name="bonus_amount" readonly="1" force_save="1"/>
                        <field name="disbursement_type"/>
                    </group>
                    <group>
                    </group>
                </group>
                <footer>
                    <button icon="fa-cogs" string="Generate Payslip" name="generate_bonus_payslip" type="object"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_employee_bonus_payslip_wizard" model="ir.actions.act_window">
        <field name="name">Generate Employee Bonus Payslip</field>
        <field name="res_model">employee.bonus.payslip.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="employee_bonus_payslip_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="batch_employee_bonus_payslip_wizard_form" model="ir.ui.view">
        <field name="name">batch.employee.bonus.payslip.wizard.form</field>
        <field name="model">batch.employee.bonus.payslip.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Employee Bonus Payslip">
                <group>
                    <group>
                        <field name="batch_id" readonly="1" force_save="1"
                               options="{'no_open':True,'no_create_edit':1}"/>
                        <field name="date" readonly="1" force_save="1"/>
                        <field name="disbursement_type"/>
                    </group>
                    <group>
                    </group>
                </group>
                <footer>
                    <button icon="fa-cogs" string="Generate Payslip" name="generate_bonus_payslip" type="object"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_batch_employee_bonus_payslip_wizard" model="ir.actions.act_window">
        <field name="name">Generate Batch Employee Bonus Payslip</field>
        <field name="res_model">batch.employee.bonus.payslip.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="batch_employee_bonus_payslip_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
