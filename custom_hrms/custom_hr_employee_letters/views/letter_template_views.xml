        <!--List Action-->
        <record id="employee_letter_template_list_action" model="ir.actions.act_window">
			<field name="name">Letter Template</field>
			<field name="res_model">employee.letter.template</field>
<!--			<field name="view_type">form</field>-->
<!--			<field name="view_mode">tree,form</field>-->
