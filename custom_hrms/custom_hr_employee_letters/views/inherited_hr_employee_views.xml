<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
		<!--Employee Form View -->
		<record id="inherited_hr_emp_employee_inh_letter_view_form"
			model="ir.ui.view">
			<field name="name">HR inherited Letters</field>
			<field name="model">hr.employee</field>
			<field name="inherit_id" ref="custom_hr_employee.inherited_hr_emp_employee_view_form" />
			<field name="arch" type="xml">				
				<xpath expr="//page[@name='hr_documents']/group[@name='hr_doc_group']" position="after">
					<group name="hr_letter_group" string="Letters">
						<field name="letter_ids" string="Employee Letter" >
							<tree string="Letter List" create="false" edit="false" delete="false">
								<field name="letter_name" />
								<field name="letter_id" options="{'no_open':True,'no_create_edit':1}"/>
							</tree>
							<form string="Employee Letter" create="false" edit="false" delete="false">
								<group>
								<field name="employee_id" readonly="1" options="{'no_open':True,'no_create_edit':1}"/>
								<field name="letter_name" readonly="1"/>
								<field name="letter_id" readonly="1"/>
								</group>
							</form>							
						</field>
					</group>
				</xpath>
			</field>
		</record>
	</data>
</odoo>

