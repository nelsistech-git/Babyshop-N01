        <!--List Action -->
        <record id="employee_letter_list_action"
                model="ir.actions.act_window">
            <field name="name">Employee Letter</field>
            <field name="res_model">hr.employee.letters</field>
            <!--			<field name="view_type">form</field>-->
            <!--			<field name="view_mode">tree,form</field>-->
            <field name="context">{'readonly_by_pass':
                                       ['letter_type', 'job_id', 'department_id', 'letter_template_id']}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create Letter</p>
            </field>
        </record>

        <!--Menu Item -->
        <menuitem id="menu_employee_letter" name="Letters"
                  parent="custom_hr_employee.menu_hr_employee_operations" action="employee_letter_list_action"
                  sequence="6" groups="hr.group_hr_manager,hr.group_hr_user"/>


        <!--Tree View-->
        <record id="hr_employee_letter_details_view_tree" model="ir.ui.view">
            <field name="name">hr.employee.letters.history.tree</field>
            <field name="model">hr.employee.letters.history</field>
            <field name="arch" type="xml">
                <tree string="Letter Details">
                    <field name="employee_id"/>
                    <field name="letter_name"/>
                    <field name="letter_id"/>
                </tree>
            </field>
        </record>
        <record id="hr_employee_letter_details_view_form" model="ir.ui.view">
            <field name="name">hr.employee.letters.history.form</field>
            <field name="model">hr.employee.letters.history</field>
            <field name="arch" type="xml">
                <form string="Letter Details">
                    <group create="false" edit="false" delete="false">
                    <field name="employee_id" readonly="1"/>
                    <field name="letter_name" readonly="1"/>
                    <field name="letter_id" readonly="1"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="hr_employee_letter_details_view_list_action" model="ir.actions.act_window">
            <field name="name">Letter Details</field>
            <field name="res_model">hr.employee.letters.history</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Letter Details</p>
            </field>
        </record>

        <menuitem id="hr_employee_letter_details_view_menu" name="Letter Details"
