        <template id="custom_hr_employee_letters.report_employee_letter_wo_head_layout_footer">
            <div class="footer">

                <div class="row" style="border-top:solid 1px #000;">
                    <div class="col-4">
                        <span
                                t-esc="context_timestamp(datetime.datetime.now()).strftime('%a, %d %b %Y %H:%M:%S')"/>
                    </div>
                    <div class="col-4">
                        Printed By:
                        <span t-esc="user.name"></span>
                    </div>
                    <div t-if="report_type == 'pdf'" class="col-4 text-right">
                        Page:
                        <span class="page"/>
                        of
                        <span class="topage"/>
                    </div>
                </div>
            </div>
