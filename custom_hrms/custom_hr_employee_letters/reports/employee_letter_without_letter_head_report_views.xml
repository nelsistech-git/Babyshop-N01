<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="paperformat_emp_letter_wo_head_report" model="report.paperformat">
            <field name="name">Employee Letter without Letter Head</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">35</field>
            <field name="margin_bottom">7</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_spacing">30</field>
            <field name="dpi">90</field>
        </record>

        <record id="report_employee_letter_wo_head" model="ir.actions.report">
            <field name="name">Employee Letter without Letter Head</field>
            <field name="model">hr.employee.letters</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_hr_employee_letters.emp_letter_wo_report_qweb</field>
            <field name="report_file">custom_hr_employee_letters.emp_letter_wo_report_qweb</field>
            <field name="paperformat_id" ref="custom_hr_employee_letters.paperformat_emp_letter_wo_head_report"/>
        </record>

        <template id="emp_letter_wo_report_qweb">
            <t t-call="web.html_container">

                <link rel='stylesheet' href="/custom_hr_employee_letters/static/src/css/custom_report.css"/>
                <t t-if="o and 'company_id' in o">
                    <t t-set="company" t-value="o.company_id"></t>
                </t>
                <t t-if="not o or not 'company_id' in o">
                    <t t-set="company" t-value="res_company"></t>
                </t>
                <t t-call="custom_hr_employee_letters.report_employee_letter_wo_head_layout_header"/>
                <!--<t t-call="web.basic_layout">-->
                    <div class="page" style="margin-top:0px;">
                        <tr t-foreach="data" t-as="doc">
                            <span t-raw="doc['details']"/>
                            <!--<span t-esc="doc['details']" />-->
                        </tr>
                    </div>
               <!--</t>-->
                <t t-call="custom_hr_employee_letters.report_employee_letter_wo_head_layout_footer"/>
            </t>
        </template>

