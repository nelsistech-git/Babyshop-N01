<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.rule" id="record_restricted_company_employee_letters_rule">
        <field name="name">Employee Letters Rule</field>
        <field name="model_id" ref="model_hr_employee_letters"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>


    <record id="module_category_letter" model="ir.module.category">
			<field name="name">Employee Letters Rule</field>
			<field name="sequence">95</field>
		</record>

		<record id="letter_group_user" model="res.groups">
			<field name="name">User</field>
			<field name="category_id" ref="module_category_letter" />
		</record>

		<record id="letter_group_manager" model="res.groups">
			<field name="name">Manager</field>
			<field name="category_id" ref="module_category_letter" />
			<field name="implied_ids"
				eval="[(4, ref('custom_hr_employee_letters.letter_group_user'))]" />
			<field name="users" eval="[(4, ref('base.user_root'))]" />
		</record>
</odoo>