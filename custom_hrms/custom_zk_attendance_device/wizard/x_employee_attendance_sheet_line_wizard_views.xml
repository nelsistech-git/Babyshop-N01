<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_emp_attendance_sheet_line_wizard_form" model="ir.ui.view">
            <field name="name">employee.attendance.sheet.line.wizard.form</field>
            <field name="model">employee.attendance.sheet.line.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Attendance Sheet Line Wizard">
                    <group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
                    <footer>
                        <button name="generate_attendance" string="Generate Attendance" type="object" class="btn-primary" confirm="Are you sure want to generate attendance details?"/>
                        <button name="delete_attendance" string="Delete Attendance Details" type="object" class="btn-primary" confirm="Are you sure want to delete attendance details?" groups="base.group_system"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_emp_attendance_sheet_line_wizard" model="ir.actions.act_window">
            <field name="name">Employee Attendance Details Generate</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.attendance.sheet.line.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_emp_attendance_sheet_line_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_emp_attendance_sheet_line_wizard"
              name="Employee Attendance (Re-Generate)"
              sequence="9"
              action="action_emp_attendance_sheet_line_wizard"
              parent="menu_hr_attendance_manage_attendances"
              groups="hr_attendance.group_hr_attendance_manager"
        />

        <!--all function process-->
        <record id="view_emp_attendance_process_wizard_form" model="ir.ui.view">
            <field name="name">employee.attendance.process.wizard.form</field>
            <field name="model">employee.attendance.process.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Attendance Process Wizard">
                    <group>
                        <group>
                            <field name="date" required="1"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="user_work_location_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="department_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="employee_id" placeholder="All" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
                    <footer>
                        <button name="process_attendance" string="Process Attendance" type="object" class="btn-primary" confirm="Are you sure want to process attendance details?"/>
                        <button name="delete_extra_attendance" string="Delete Inactive Emp. Attendance Details" type="object" class="btn-primary" confirm="Are you sure want to delete extra attendance?"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_emp_attendance_process_wizard" model="ir.actions.act_window">
            <field name="name">Missing Attendance Process</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.attendance.process.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_emp_attendance_process_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_view_emp_attendance_process_wizard"
              name="Missing Attendance Process"
              sequence="8"
              action="action_emp_attendance_process_wizard"
              parent="menu_hr_attendance_manage_attendances"
              groups="hr_attendance.group_hr_attendance_manager"
        />

    </data>
</odoo>