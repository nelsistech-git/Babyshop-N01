<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="view_hr_manual_absence_wizard_form" model="ir.ui.view">
			<field name="name">hr.manual.absence.wizard.form</field>
			<field name="model">hr.manual.absence.wizard</field>
			<field name="arch" type="xml">
				<form string="Manual Absence">
					<group>
						<group>
							<field name="date" required="1"/>
							<field name="employee_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
							<field name="id_card_no" readonly="1"/>
							<field name="device_user_id" readonly="1"/>
							<field name="user_work_location_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
							<field name="department_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
							<field name="note"/>
						</group>
					</group>
					<footer>
						<button name="action_submit_absence" string="Submit" type="object"
							class="btn-primary" />
						or
						<button string="Cancel" class="btn-danger" special="cancel" />
					</footer>
				</form>
			</field>
		</record>

		<record id="action_hr_manual_absence_wizard" model="ir.actions.act_window">
			<field name="name">Manual Absence</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">hr.manual.absence.wizard</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="view_hr_manual_absence_wizard_form" />
			<field name="target">new</field>
		</record>

		<!-- <menuitem id="menu_hr_manual_absence_wizard"
		name="Manual Absence" parent="menu_hr_attendance_manage_attendances"
		sequence="26" groups="hr_attendance.group_hr_attendance_manager"
		action="action_hr_manual_absence_wizard" /> -->

	</data>
</odoo>