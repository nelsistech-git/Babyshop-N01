<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="view_update_manual_reason_note_wizard_form" model="ir.ui.view">
			<field name="name">update.manual.reason.note.wizard.form</field>
			<field name="model">update.manual.reason.note.wizard</field>
			<field name="arch" type="xml">
				<form string="Update Manual Readon/Note">
					<group>
						<group>
							<field name="record" readonly="1" groups="base.group_system"/>
							<field name="manual_reason"/>
							<field name="note"/>
						</group>
						<group>
							<field name="manual_uid" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
							<field name="manual_time" readonly="1"/>
						</group>
					</group>
					<footer>
						<button name="action_update_manual_reason" string="Submit" type="object"
							class="btn-primary" />
						or
						<button string="Cancel" class="btn-danger" special="cancel" />
					</footer>
				</form>
			</field>
		</record>
	</data>
</odoo>