<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem  id="root_menu_shift_management" name="Shift Management" parent="hr_attendance.menu_hr_attendance_root"  sequence="15"/>


    <record id="resource_calendar_form_shift_management" model="ir.ui.view">
        <field name="name">resource.calendar.form.shift_management</field>
        <field name="model">resource.calendar</field>
        <field name="arch" type="xml">
            <form string="Working Time" create="false" edit="false" delete="false">
                <sheet string="Working Time" >

                    <h1>
                        <field name="name"/>
                    </h1>
                    <group name="resource_details">
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="hours_per_day" widget="float_time"/>
                            <field name="tz"/>

                             <field name="short_name"/>
							 <field name="is_over_ride_day"/>

							 <field name="check_in_start" widget="float_time"/>
							 <!--<field name="check_in_end" widget="float_time"/>-->
							 <!--<field name="check_out_start" widget="float_time"/>
							 <field name="check_out_end" widget="float_time"/>-->
                        </group>
                        <group>
                            <field name="hour_from_per_day_m" widget="float_time"/>
                            <field name="hour_to_per_day_m" widget="float_time"/>
                            <field name="hour_from_per_day_e" widget="float_time"/>
                            <field name="hour_to_per_day_e" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Working Hours" name="working_hours">
                        <field name="two_weeks_calendar" invisible="1"/>
                        <group invisible="two_weeks_calendar == False" >
                            <field name="two_weeks_explanation" nolabel="1"/>
                        </group>
                            <field name="attendance_ids" widget="section_one2many"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_resource_calendar_tree_shift_management" model="ir.ui.view">
        <field name="name">resource.calendar.tree.shift_management</field>
        <field name="model">resource.calendar</field>
        <field name="arch" type="xml">
            <tree string="Working Time" create="false" edit="false" delete="false">
                <field name="name" string="Working Time/Shift"/>
                <field name="short_name"/>
                <field name="check_in_start" widget="float_time"/>
                <field name="hour_from_per_day_m" widget="float_time" string="Start Time"/>
                <field name="hour_to_per_day_e" widget="float_time" string="End Time"/>
                <field name="hours_per_day"/>
                <field name="is_over_ride_day"/>


                <!--<field name="check_in_end" widget="float_time"/>-->
                <!--<field name="check_out_start" widget="float_time" optional="hide"/>
                <field name="check_out_end" widget="float_time" optional="hide"/>-->

            </tree>
        </field>
    </record>

   <record id="action_resource_calendar_form_shift_management" model="ir.actions.act_window">
        <field name="name">Working Hours/Shift</field>
        <field name="res_model">resource.calendar</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" eval="False"/>
        <field name="search_view_id" ref="resource.view_resource_calendar_search"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Define working hours and time table that could be scheduled to your project members
          </p>
        </field>
    </record>

    <record id="action_resource_calendar_form_shift_management_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_resource_calendar_tree_shift_management"/>
        <field name="act_window_id" ref="action_resource_calendar_form_shift_management"/>
    </record>
    <record id="action_resource_calendar_form_shift_management_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="resource_calendar_form_shift_management"/>
        <field name="act_window_id" ref="action_resource_calendar_form_shift_management"/>
    </record>

    <menuitem  id="sub_menu_shift_management_shift" name="Working Hours/Shift" parent="root_menu_shift_management" action="action_resource_calendar_form_shift_management" sequence="10" groups="hr_attendance.group_hr_attendance_officer"/>

</odoo>
