               <field name="from_resource_calendar_id" string="Previous Working Hours/Shift"/>
               <field name="from_hour_from_per_day_m" string="Previous Start Time"/>
               <field name="from_hour_to_per_day_e" string="Previous End Time"/>

               <field name="to_resource_calendar_id" string="New Working Hours/Shift"/>
                <field name="from_hour_from_per_day_m" string="New Start Time"/>
               <field name="from_hour_to_per_day_e" string="New End Time"/>

               <field name="state"/>
           </tree>
       </field>
