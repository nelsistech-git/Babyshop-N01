		<record model="ir.ui.view" id="view_employee_filter">
			<field name="name">hr.employee.search</field>
			<field name="model">hr.employee</field>
			<field name="inherit_id" ref="hr.view_employee_filter" />
			<field name="arch" type="xml">
				<xpath expr="//filter[@name='inactive']" position="after">
					<separator />
					<filter string="Created from an Attendance Device"
						name="created_from_attendance_device"
						domain="[('created_from_attendance_device','=',True)]" />

					<separator />
					<filter string="Is Rostering Employee?"
						name="is_rostering_employee_yes"
						domain="[('is_rostering_employee','=',True)]" />
					<filter string="Not Rostering Employee?"
						name="is_rostering_employee_not"
						domain="[('is_rostering_employee','=',False)]" />
				</xpath>

<!--				<xpath expr="//search/field[@name='name']" position="after">-->
<!--					<field name="device_user_id" />-->
<!--				</xpath>-->
				
			</field>
