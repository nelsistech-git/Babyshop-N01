<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="view_attendance_data_form" model="ir.ui.view">
			<field name="name">Attendance Data Form</field>
			<field name="model">user.attendance</field>
			<field name="arch" type="xml">
				<form string="Attendance Data">
					<sheet>
						<group>
							<group>
								<field name="user_id" />
								<field name="timestamp" />
								<field name="status" groups="base.group_no_one" />
								<field name="attendance_state_id" />
								<field name="valid" />
								<field name="employee_id" />
								<field name="hr_attendance_id" groups="base.group_no_one" />
								<field name="device_id" />
							</group>
							<group></group>
							 <div class="oe_chatter">
								<field name="message_follower_ids" widget="mail_followers" />
								<field name="activity_ids" widget="mail_activity"/>
								<field name="message_ids" widget="mail_thread"/>
							</div>
						</group>
					</sheet>
				</form>
			</field>
		</record>
		
		<record id="view_attendance_data_pivot" model="ir.ui.view">
			<field name="name">Attendance Data Pivot</field>
			<field name="model">user.attendance</field>
			<field name="arch" type="xml">
				<pivot string="Attendance Data">
					<field name="timestamp" type="col" />
					<field name="user_id" type="row" />
				</pivot>
			</field>
		</record>
		
		<record id="view_attendance_data_tree" model="ir.ui.view">
			<field name="name">Attendance Data</field>
			<field name="model">user.attendance</field>
			<field name="arch" type="xml">
				<tree string="Attendance Data" create="False"
					edit="False" js_class="inv_list_controller">
					<field name="timestamp" />
					<field name="user_id" />
					<field name="status" groups="base.group_no_one" />
					<field name="attendance_state_id" string="Attendance State"/>
					<field name="attendance_type" />
					<field name="valid" />
					<field name="employee_id" />
					<field name="user_work_location_id" />
					<field name="hr_attendance_id" groups="base.group_no_one" />
					<field name="device_id" />
					<field name="process_flag" />
					<button name="reset_attendance_data" type="object" string="Reset" invisible="process_flag == 0" groups="base.group_erp_manager"
						confirm="Are you sure you want to Reset?"/>
				</tree>
			</field>
		</record>
		<record id="user_attendance_data_search_view" model="ir.ui.view">
			<field name="name">Attendance Data</field>
			<field name="model">user.attendance</field>
			<field name="arch" type="xml">
				<search string="Search User Attendance Data">
					<field name="employee_id" filter_domain="['|',('employee_id.name', 'ilike', self), ('employee_id.id_card_no', 'ilike', self)]"/>
					<field name="user_id" />
					<field name="device_id" />
					<separator />
					<filter string="Valid" name="valid" domain="[('valid','=',True)]"
						help="Show attendance records that are valid for synchronizing with Odoo's HR Atteandnce" />
					<separator />
					<filter string="Synced" name="process_flag" domain="[('process_flag','=',1)]"
						help="Synced user attendance details to Attendance" />
					<filter string="Not Synced" name="not_process_flag" domain="[('process_flag','=',0), ('employee_id', '!=', False)]"
						help="Not Synced user attendance details to Attendance" />
					<separator />

					<filter string="Today" name="today" domain="[('timestamp', '&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
					<!--DateTime.now().replace(year=2017, month=10, day=2, hour=2, minute=27, second=0)-->
					<separator />
					<filter string="Not Synchronized" name="not_synch"
						domain="[('hr_attendance_id','=',False)]"
						help="Show attendance records that have no link to Odoo's HR Atteandnce" />
					<group expand="0" string="Group By...">
						<filter string="User" name="user_id" context="{'group_by': 'user_id'}" />
						<filter string="Device" name="device_id" context="{'group_by': 'device_id'}" />
						<filter string="Employee" name="employee_id"
							context="{'group_by': 'employee_id'}" />
					</group>
				</search>
			</field>
		</record>

		<record model="ir.actions.act_window" id="action_user_attendance_data">
			<field name="name">Attendance Devices Data</field>
			<field name="res_model">user.attendance</field>
			<field name="view_mode">tree,pivot</field>
			<field name="context">{'search_default_valid':1,'search_default_today':1, 'group_by':[]}
			</field>
		</record>

		<menuitem id="user_attendance_data_menu" name="Attendance Data"
			parent="attendace_device_menu" sequence="10" action="action_user_attendance_data"
			groups="hr_attendance.group_hr_attendance_officer" />
			
		<menuitem id="user_attendance_data_menu2" name="Attendance Devices Data"
			parent="menu_hr_attendance_manage_attendances" sequence="5" action="action_user_attendance_data"
			groups="hr_attendance.group_hr_attendance_officer" />
			

	</data>
</odoo>