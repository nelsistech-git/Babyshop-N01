<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="view_hr_manual_weekend_alter_form" model="ir.ui.view">
			<field name="name">hr.manual.weekend.alter.form</field>
			<field name="model">hr.manual.weekend.alter</field>
			<field name="arch" type="xml">
				<form string="Manual Weekend Alter Form">
					<header>
                         <button name="action_confirm" id="action_confirm" class="btn-primary" type="object" string="Confirm"
                                invisible="state not in ['draft']"/>
                         <button name="action_approve" id="action_approve" class="btn-primary" type="object" string="Approve"
                                invisible="state not in ['confirm']"/>
                         <button name="action_draft" id="action_draft" type="object" string="Set to Draft"
                                invisible="state == 'draft'"/>
                         <button name="action_cancel" id="action_cancel" type="object" string="Cancel"
                                invisible="state == 'draft'"/>
                               
                         <button name="action_is_apply" id="action_is_apply" class="btn-primary" type="object" string="Apply"
                                invisible="is_apply == True or state != 'approve'"/>
                         <button name="action_is_reverse" id="action_is_reverse" type="object" string="Reverse"
                                invisible="is_reverse == True or is_apply == False"/>
                                
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,approve"/>
                    </header>
                    <sheet>
                    	<group>
	                    	<group>
								<field name="employee_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" readonly="state != 'draft'"/>
								<field name="date_from" readonly="state != 'draft'"/>
								<field name="day_from" readonly="1" force_save="1"/>								
								<field name="date_to" readonly="state != 'draft'"/>
								<field name="day_to" readonly="1" force_save="1"/>								
								<field name="reason" readonly="state != 'draft'"/>
							</group>
							<group>
								<field name="user_work_location_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
								<field name="department_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
								<field name="id_card_no" readonly="1" force_save="1"/>
								<field name="device_user_id" readonly="1" force_save="1"/>
								<field name="resource_calendar_id" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" /> <!--readonly="state != 'draft'"-->
								
								<field name="is_apply" readonly="1"/>
	                    		<field name="apply_date" readonly="1"/>
	                    		<field name="apply_uid" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
	                    		<field name="is_reverse" readonly="1"/>
	                    		<field name="reverse_date" readonly="1"/>
	                    		<field name="reverse_uid" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
							</group>
						</group>
					</sheet>
					<div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
				</form>
			</field>
		</record>
		
		<record id="view_hr_manual_weekend_alter_tree" model="ir.ui.view">
			<field name="name">hr.manual.weekend.alter.tree</field>
			<field name="model">hr.manual.weekend.alter</field>
			<field name="arch" type="xml">
				<tree string="Manual Weekend Alter Tree">
					<field name="employee_id"/>			
					<field name="date_from" />
					<field name="day_from"/>
					<field name="date_to" />
					<field name="day_to"/>						
					<field name="reason" />
					<field name="state" />
					<field name="is_apply" />
					<field name="is_reverse" />
				</tree>
			</field>
		</record>
		<record id="view_hr_manual_weekend_alter_search" model="ir.ui.view">
			<field name="name">hr.manual.weekend.alter.tree</field>
			<field name="model">hr.manual.weekend.alter</field>
			<field name="arch" type="xml">
				<search string="Manual Weekend Alter search">
					<field name="employee_id"/>			
					<field name="date_from" />
					<field name="day_from"/>	
					<field name="date_to" />
					<field name="day_to"/>				
					<field name="reason" />
					<field name="state" />
					<field name="is_apply" />
					<field name="is_reverse" />
				</search>
			</field>
		</record>
		
		<record model="ir.actions.act_window" id="action_hr_manual_weekend_alter">
			<field name="name">Manual Weekend Alter</field>
			<field name="res_model">hr.manual.weekend.alter</field>
			<field name="type">ir.actions.act_window</field>
			<field name="view_mode">tree,form</field>
			<field name="help" type="html">
				<p class="oe_view_nocontent_create">Create the first Manual weekend alter</p>
			</field>
		</record>
		
		<!--<menuitem id="hr_manual_weekend_alter_menu" name="Manual Weekend Alter"
			parent="menu_hr_attendance_manage_attendances_sub_manual" sequence="7" action="action_hr_manual_weekend_alter"
			groups="hr_attendance.group_hr_attendance_manager" />--> <!-- hr_attendance.group_hr_attendance_officer -->
			
	</data>
</odoo>