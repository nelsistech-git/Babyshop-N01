<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_rostering_monthly_shift_form" model="ir.ui.view">
     <field name="name">view.rostering.monthly.shift.form</field>
     <field name="model">rostering.monthly.shift</field>
     <field name="arch" type="xml">
           <form>
               <header>
                    <button name="action_confirm" id="action_confirm" class="btn-primary"
                            type="object" string="Confirm" invisible="state not in ['draft']" />

                    <button name="action_draft" id="action_draft" class="btn-secondary"
                            type="object" string="Set to Draft"  /> <!-- invisible="state not in ['confirm','cancel']"-->

                    <button name="action_approve" confirm="Are you sure you want to Approve?" id="action_approve" class="btn-primary"
                            type="object" string="Approve" invisible="state not in ['confirm','cancel']" />

                    <button name="action_cancel" confirm="Are you sure you want to Cancel?" type="object" string="Cancel" invisible="state not in ['draft']" />
                   <field name="state" widget="statusbar" statusbar_visible="draft,confirm,approve"/>
                </header>
               <sheet>
                   <group>
                       <group>
<!--                           <field name="name" required="1" />-->
                           <field name="year"  readonly="state not in ['draft']" required="1"/>
                           <field name="month"  readonly="state not in ['draft']"/>
                           <field name="department_id"  readonly="state not in ['draft']"  options='{"no_open": True, "no_create": True}'/>
                           <field name="remarks"  readonly="state not in ['draft']"/>
                       </group>
                   </group>

                   <h3 style="color:#7C7BAD">Monthly Shifting Line</h3>
                    <field readonly="state not in ['draft']" name="line_ids">
                        <tree>
                            <field name="employee_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field widget="many2many_tags"  name="day_1" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field widget="many2many_tags"  name="day_2" required="1"  options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field widget="many2many_tags"  name="day_3" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
