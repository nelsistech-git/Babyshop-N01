   <record id="view_rostering_monthly_shift_tree" model="ir.ui.view">
       <field name="name">rostering.monthly.shift.tree</field>
       <field name="model">rostering.monthly.shift</field>
       <field name="arch" type="xml">
           <tree string="Rostering Monthly List">
               <field name="year" />
               <field name="month" />
               <field name="department_id" />
           </tree>
       </field>
   </record>

   <record id="view_rostering_monthly_shift_filter" model="ir.ui.view">
       <field name="name">rostering.monthly.shift.filter</field>
       <field name="model">rostering.monthly.shift</field>
       <field name="arch" type="xml">
           <search string="Search List">
               <field name="name" filter_domain="[('name', 'ilike', self)]"/>
               <field name="department_id" filter_domain="[('department_id', 'ilike', self)]"/>
               <field name="month" filter_domain="[('month', 'ilike', self)]"/>
          </search>
       </field>
   </record>
    
   <record id="rostering_monthly_shift_action" model="ir.actions.act_window">
       <field name="name">Employee Monthly Shifting</field>
       <field name="res_model">rostering.monthly.shift</field>
       <field name="view_mode">tree,form</field>
       <field name="help" type="html">
           <p class="o_view_nocontent_smiling_face">
               Create a New Employee Monthly Shift
           </p>
       </field>
   </record>

