                            <field widget="many2many_tags"  name="day_8" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field widget="many2many_tags"  name="day_9" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field widget="many2many_tags"  name="day_10" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field widget="many2many_tags"  name="day_11" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field widget="many2many_tags"  name="day_12" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field widget="many2many_tags"  name="day_13" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
