<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    	<record id="group_attendance_devices_manager" model="res.groups">
	        <field name="name">Attendance Device Manager</field>
	        <field name="category_id" ref="base.module_category_usability" />
	        <field name="comment">The users in this group will have full access rights to attendance devices and their data.</field>
    	</record>

    	<record id="hr_attendance.group_hr_attendance_manager" model="res.groups">
	        <field name="implied_ids" eval="[(4, ref('group_attendance_devices_manager'))]"/>
	    </record>
    </data>

	<record model="res.groups" id="group_attendance_list_viewer">
       <field name="name">Attendance List Viewer</field>
    </record>

	<record id="group_attendance_list_viewer_view_all" model="ir.rule">
        <field name="name">Attendance List Viewer</field>
        <field name="model_id" ref="model_hr_attendance"/>
		<field name="domain_force">[('user_work_location_id.id','=',user.user_work_location_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('custom_zk_attendance_device.group_attendance_list_viewer'))]"/>
    </record>

    <!-- Shift management security -->
    <!-- Category Group -->
    <record id="category_emp_shift_management" model="ir.module.category">
        <field name="name">Employee Shift Management</field>
        <field name="sequence">96</field>
    </record>

    <!-- User Group -->
    <record id="group_emp_shifting_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="category_emp_shift_management" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!-- Manager Group -->
    <record id="group_emp_shifting_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="category_emp_shift_management" />
        <field name="implied_ids" eval="[(4, ref('custom_zk_attendance_device.group_emp_shifting_user'))]"/>
    </record>

    <!--record rules shift request-->
    <record id="group_emp_shifting_viewer_rule" model="ir.rule">
        <field name="name">Employee Shifting Viewer Rule</field>
        <field ref="model_shift_management_request" name="model_id"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_emp_shifting_user_rule" model="ir.rule">
        <field name="name">Employee Shifting User Rule</field>
        <field name="model_id" ref="model_shift_management_request"/>
        <field name="domain_force">['|',('employee_id.user_id','=',user.id),('manager_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('custom_zk_attendance_device.group_emp_shifting_user'))]"/>
    </record>
    <record id="group_emp_shifting_administrator_rule" model="ir.rule">
        <field name="name">Employee Shifting Administrator Rule</field>
        <field name="model_id" ref="model_shift_management_request"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('custom_zk_attendance_device.group_emp_shifting_administrator'))]"/>
    </record>

    <!--record rules shift alter and exchange all-->
    <record id="group_emp_shifting_viewer_rule_exchange_alter" model="ir.rule">
        <field name="name">Employee Shifting Viewer Rule Exc_Alter</field>
        <field ref="model_shift_management_exchange" name="model_id"/>
        <field name="domain_force">['|',('from_employee_id.user_id','=',user.id),('to_employee_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_emp_shifting_user_rule_exchange_alter" model="ir.rule">
        <field name="name">Employee Shifting User Rule Exc_Alter</field>
        <field name="model_id" ref="model_shift_management_exchange"/>
        <field name="domain_force">['|','|',('from_employee_id.user_id','=',user.id),('manager_id.user_id','=',user.id),'|',('to_employee_id.user_id','=',user.id),('to_manager_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('custom_zk_attendance_device.group_emp_shifting_user'))]"/>
    </record>
    <record id="group_emp_shifting_administrator_rule_exchange_alter" model="ir.rule">
        <field name="name">Employee Shifting Administrator Rule Exc_Alter</field>
        <field name="model_id" ref="model_shift_management_exchange"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('custom_zk_attendance_device.group_emp_shifting_administrator'))]"/>
    </record>

    <!--record rules shift alter and exchange all-->
    <record id="group_emp_shifting_viewer_rule_exchange_alt_all" model="ir.rule">
        <field name="name">Employee Shifting Viewer Rule Alter All</field>
        <field ref="model_shift_management_exchange_shift" name="model_id"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_emp_shifting_user_rule_exchange_alt_all" model="ir.rule">
        <field name="name">Employee Shifting User Rule Alter All</field>
        <field name="model_id" ref="model_shift_management_exchange_shift"/>
        <field name="domain_force">['|',('employee_id.user_id','=',user.id),('manager_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('custom_zk_attendance_device.group_emp_shifting_user'))]"/>
    </record>
    <record id="group_emp_shifting_administrator_rule_exchange_alt_all" model="ir.rule">
        <field name="name">Employee Shifting Administrator Rule Alter All</field>
        <field name="model_id" ref="model_shift_management_exchange_shift"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('custom_zk_attendance_device.group_emp_shifting_administrator'))]"/>
    </record>

    <!--from settings-->
    <record id="group_hr_attendance_root_menu" model="res.groups">
        <field name="name">HR- Attendances</field>
        <field name="category_id" ref="custom_common_settings.root_menu_access_group_category"/>
    </record>

</odoo>