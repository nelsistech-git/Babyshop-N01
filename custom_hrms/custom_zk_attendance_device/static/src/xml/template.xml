<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="custom_zk_attendance_device.ImportInvController" t-inherit="web.ListView.Buttons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <button t-if="model.root.resModel == 'user.attendance'" type="button" t-on-click="uploadInv"
                    class="btn btn-primary o_cash_incentive_button px-5" style="margin-left: 10px;">
                Upload Attendance
            </button>
        </xpath>
    </t>

</templates>