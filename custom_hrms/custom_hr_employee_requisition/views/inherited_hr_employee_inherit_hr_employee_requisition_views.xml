<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Add Facilities in additional_info page of pims form -->
        <record id="inherited_hr_employee_inherit_hr_emp_requisition_form_view" model="ir.ui.view">
            <field name="name">inherited.hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="before">
                    <field name="is_recruiter" />
                    <!-- <field name="user_id" string="Related User" options="{'no_open':True,'no_create':1,'no_create_edit':1}" /> -->
                </xpath>
            </field>
        </record>
    </data>
</odoo>