<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="hr_emp_rec_print_paperformat" model="report.paperformat">
            <field name="name">HR Employee Requisition Print</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">39</field>
            <field name="margin_bottom">7</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
            <field name="header_line" eval="False"/>
        </record>

        <record id="hr_emp_rec_print_report" model="ir.actions.report">
            <field name="name">Employee Requisition Report</field>
            <field name="model">hr.employee.requisition</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_hr_employee_requisition.hr_emp_rec_print_qweb</field>
            <field name="report_file">custom_hr_employee_requisition.hr_emp_rec_print_qweb</field>
            <field name="binding_model_id" ref="model_hr_employee_requisition"/>
            <field name="binding_type">action</field>
            <field name="paperformat_id" ref="custom_hr_employee_requisition.hr_emp_rec_print_paperformat" />
            <!--<field name="paperformat_id" ref="custom_common_settings.paperformat_custom_a4_bd" />-->
        </record>

        <!--Report Paper format-->
