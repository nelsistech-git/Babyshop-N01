        </record>-->


        <!--<record id="custom_hr_employee_requisition.hr_emp_rec_print_report" model="ir.actions.report">
            <field name="paperformat_id" ref="custom_hr_employee_requisition.hr_emp_rec_print_paperformat" />
        </record>-->

        <template id="hr_emp_rec_print_qweb">
            <t t-call="web.html_container">
                <link rel='stylesheet' href="/custom_hr_employee_requisition/static/src/css/custom_report.css" />
                <!-- <t t-if="o and 'company_id' in o">
                    <t t-set="company" t-value="o.company_id"></t>
                </t>
                <t t-if="not o or not 'company_id' in o">
                    <t t-set="company" t-value="res_company"></t>
                </t> -->
                <!--<t t-call="custom_hr_employee_requisition.hr_emp_rec_print_layout_header" />-->
                <t t-call="web.internal_layout">
                    <div class="page" style="margin-top:0px;">
                        <div class="container">
                            <p>
                               data <t t-esc="data"/>
                            </p>
                            <p>
                                docs<t t-esc="doc"/>
                            </p>
                            <p>
                              doc_ids  <t t-esc="doc_ids"/>
                            </p>
                            <p>
                              doc_model  <t t-esc="doc_model"/>
                            </p>
                            <p>
                                other<t t-esc="other"/>
                            </p>
                            <p>
                               context <t t-esc="context"/>
                            </p>                            
                            <p>
                               o <t t-esc="o"/>

                            </p>
                            <t t-foreach="data" t-as="doc">
                                <div class="row">
                                    <p>
                                        <b>REQUISITION:</b>
                                    </p>
                                    <table class="col-xs-6">
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Company requested for</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="other['requisition_company']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Position requested for</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['department']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Requested Position</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['designation']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Position type</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <t t-if="doc['position_type']=='new'">
                                                    <span>New</span>
                                                </t>
                                                <t t-else="">
                                                    <span>Replacement</span>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Gender</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <t t-if="doc['gender']=='male'">
                                                    <span>Male</span>
                                                </t>
                                                <t t-else="">
                                                    <span>Female</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                    <table class="col-xs-6">
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Date</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['date']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Approved Manpower</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['approved_man']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Actual Manpower</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['actual_man']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Request Manpower</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['request_man']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Estimated Salary</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['est_salary']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Actual Salary</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['act_salary']" />
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="row">
                                    <p>
                                        <b>RECOMMENDED APPLICANT DETAILS:</b>
                                    </p>
                                    <table class="col-xs-6">
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>1. Expertise</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <t t-if="doc['expertise']=='fresh'">
                                                    <span>Fresh</span>
                                                </t>
                                                <t t-else="">
                                                    <span>Experienced</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                    <table class="col-xs-6">
                                        <t t-if="doc['expertise']=='experienced'">
                                            <tr>
                                                <td class="text-left" style="width: 40%%;">
                                                    <p>Experience(In Year)</p>
                                                </td>
                                                <td class="text-left" style="width: 5%%;">:</td>
                                                <td class="text-left" style="width: 50%%;">
                                                    <span t-esc="doc['exp_year']" />
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                    <br/>
                                    <table class="col-xs-12">
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>2. Educational Qualification</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['edu_qual']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>3. Provide some details regarding the type of employee required, as well as the qualifications and work experience, and any other factors which need to be considered</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['requirements']" />
                                            </td>
                                        </tr>
                                    </table>
                                    <table class="col-xs-12">
                                        <tr>
                                            <td class="text-left" style="width: 70%%;">
                                                <p>4. Can the vacancy be filled by a temporary/part-time employee?</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <t t-if="doc['is_parttime'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['is_parttime']" />-->
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 70%%;">
                                                <p>5. Does a job description exist for this position?</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <t t-if="doc['is_desc_exist'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['is_desc_exist']" />-->
                                            </td>
                                        </tr>
                                    </table>
                                    <table class="col-xs-12">
                                        <p>
                                            <b>6. Can the job function be restructured in such as way as to:</b>
                                        </p>
                                        <tr>
                                            <td class="text-left" style="width: 70%%;padding-left:30px;">
                                                <p>Reduce manpower requirements in the department?</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <t t-if="doc['is_reduce_mp'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['is_reduce_mp']" />-->
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 70%%;padding-left:30px;">
                                                <p>Make the functioning of the department more effective?</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <t t-if="doc['is_fucn_effective'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['is_fucn_effective']" />-->
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 70%%;padding-left:30px;">
                                                <p>Reduce the Payroll cost to company?</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <t t-if="doc['is_cost_reduce'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['is_cost_reduce']" />-->
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 70%%;padding-left:30px;">
                                                <p>Will the position be advertised internally first?</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <t t-if="doc['is_internal'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['is_internal']" />-->
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="row">
                                    <table class="col-xs-12">
                                        <p>
                                            <b>JUSTIFICATION:</b>
                                        </p>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>What are the prospects of filling this position with a qualified candidate?</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 55%%;">
                                                <span t-esc="doc['prospects']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>What investigations have been conducted to determine the availability of quality candidates?</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 55%%;">
                                                <span t-esc="doc['investigations']" />
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="row">
                                    <p>
                                        <b>PROPOSALS:</b>
                                    </p>
                                    <table class="col-xs-6">
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Proposed date of commencement</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['commencement_date']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Company Mobile Allowance</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <t t-if="doc['have_mobile_allowance'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['have_mobile_allowance']" />-->
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Desktop/Laptop</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <t t-if="doc['need_computer'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['need_computer']" />-->
                                            </td>
                                        </tr>
                                    </table>
                                    <table class="col-xs-6">
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Proposed Salary per annum</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['proposed_salary']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Company Travel Allowance</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <t t-if="doc['have_travel_allowance'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['have_travel_allowance']" />-->
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Company Provided Lunch</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <t t-if="doc['need_lunch'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['need_lunch']" />-->
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="row">
                                    <table>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Other benefits (please specify)</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['other_benefits']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 70%%;">
                                                <p>Probation Period (Months)</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <span t-esc="doc['probation_name']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 70%%;">
                                                <p>Internal transfer/ promotion from within the Company?</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <t t-if="doc['internal_transfer'] == True">
                                                    <span>Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['internal_transfer']" />-->
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 70%%;">
                                                <p>Training/ Induction Details (Required)</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <t t-if="doc['required_training'] == True">
                                                    <span>Yes</span>
                                                    <!--<input id="required_training" type="checkbox" t-att-checked="'checked'"/>-->
                                                </t>
                                                <t t-else="">
                                                    <span>No</span>
                                                </t>
                                                <!--<span t-esc="doc['required_training']" />-->
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 70%%;">
                                                <p>Duration of Training (Weeks/Months)</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 20%%;">
                                                <span t-esc="doc['training_name']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-left" style="width: 40%%;">
                                                <p>Specify the required Training details</p>
                                            </td>
                                            <td class="text-left" style="width: 5%%;">:</td>
                                            <td class="text-left" style="width: 50%%;">
                                                <span t-esc="doc['training_details']" />
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <br/>
                                <br/>
                                <div class="row">
                                    <div class="col-xs-3">
                                        <table>
                                            <tr>
                                                <ul class="list-inline">
                                                    <li>Requested By:</li>
                                                    <li>
                                                        <!--                                                        <span t-esc="doc['requested_by']"/>-->
                                                    </li>
                                                </ul>
                                                <ul class="list-inline">
                                                    <li>Designation:</li>
                                                    <li>
                                                        <!--                                                        <span t-esc="doc['requested_designation']"/>-->
                                                    </li>
                                                </ul>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-xs-3">
                                        <table>
                                            <tr>
                                                <ul class="list-inline">
                                                    <li>Authorized By:</li>
                                                    <li>
                                                        <!--                                                        <span t-esc="doc['authorized_by']"/>-->
                                                    </li>
                                                </ul>
                                                <ul class="list-inline">
                                                    <li>Designation:</li>
                                                    <li>
                                                        <!--                                                        <span t-esc="doc['authorized_designation']"/>-->
                                                    </li>
                                                </ul>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-xs-3">
                                        <table>
                                            <tr>
                                                <ul class="list-inline">
                                                    <li>Recommended By:</li>
                                                    <li>
                                                        <!--                                                        <span t-esc="doc['recommended_by']"/>-->
                                                    </li>
                                                </ul>
                                                <ul class="list-inline">
                                                    <li>Designation:</li>
                                                    <li>
                                                        <!--                                                        <span t-esc="doc['recommended_designation']"/>-->
                                                    </li>
                                                </ul>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-xs-3">
                                        <table>
                                            <tr>
                                                <ul class="list-inline">
                                                    <li>Approved By:</li>
                                                    <li>
                                                        <!--                                                        <span t-esc="doc['approved_by']"/>-->
                                                    </li>
                                                </ul>
                                                <ul class="list-inline">
                                                    <li>Designation:</li>
                                                    <li>
                                                        <!--                                                        <span t-esc="doc['approved_designation']"/>-->
                                                    </li>
                                                </ul>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
                <t t-call="custom_hr_employee_requisition.hr_emp_rec_print_layout_footer" />
            </t>
        </template>

        <template id="custom_hr_employee_requisition.hr_emp_rec_print_layout_header">
            <div class="header">
                <table>
                    <tr>
                        <td style="width:10%;">
                            <!-- <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height:80px;" alt="Company Logo"/> -->
                        </td>
                        <td style="width:35%;" class="text-left">
                            <strong>
                                <!-- <div t-field="company.name" style="font-size:25px;"/> -->
                            </strong>
                            <!-- <span t-field="company.street"/>
                            <span t-field="company.street2"/>
                            <span t-field="company.city"/>
                            <span t-field="company.zip"/>
                            Phone:
                            <span t-field="company.phone"/> -->
                            Fax:
