<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
<record id="action_report_employee_requisition" model="ir.actions.report">
    <field name="name">Employee Requisition Report</field>
    <field name="model">hr.employee.requisition</field>
    <field name="report_name">custom_hr_employee_requisition.report_employee_requisition</field>
    <field name="report_type">qweb-pdf</field>
    <field name="binding_model_id" ref="model_hr_employee_requisition"/>
                <field name="paperformat_id" ref="custom_hr_employee_requisition.hr_emp_rec_print_paperformat" />

</record>

<template id="report_employee_requisition">
    <t t-call="web.internal_layout">
        <div class="page">
            <main>
                <style>
                    body {
                        font-family: 'Roboto', sans-serif;
                        font-size: 14px;
                        background-color: #f4f7fa;
                        color: #444;
                        margin: 0;
                        padding: 0;
                    }

                    .page {
                        max-width: 100%;
                        width: 100%;
                        background-color: #ffffff;
                        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
                        padding: 20px;
                    }

                    .report-header {
                        text-align: center;
                        padding: 20px 0;
                        margin-bottom: 30px;
                        background-color: #5D8DA8;
                        color: #ffffff;
                        border-radius: 10px;
                    }

                    .report-header h1 {
                        font-size: 32px;
                        font-weight: bold;
                        margin: 0;
                        letter-spacing: 1px;
                    }

                    .section {
                        margin-bottom: 30px;
                        padding: 20px;
                        background-color: #f8fafc;
                        border-radius: 10px;
                        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
                    }

                    .section-title {
                        font-size: 20px;
                        font-weight: bold;
                        color: #5D8DA8;
                        margin-bottom: 15px;
                        padding-left: 12px;
                        border-left: 5px solid #5D8DA8;
                    }

                    .info-row {
                        display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: 20px;
                        margin-bottom: 15px;
                    }

                    .info-label {
                        font-weight: 600;
                        color: #333;
                        font-size: 15px;
                    }

                    .info-value {
                        font-size: 15px;
                        color: #555;
                        text-align: right;
                    }

                    .comments-section {
                        background-color: #dff1f8;
                        padding: 20px;
                        border-radius: 8px;
                        border-left: 6px solid #5D8DA8;
                        margin-top: 20px;
                    }

                    .comments-section strong {
                        display: block;
                        font-size: 16px;
                        color: #5D8DA8;
                        margin-bottom: 10px;
                    }

                    .comments-section p {
                        font-size: 14px;
                        color: #444;
                    }

                    hr {
                        margin: 40px 0;
                        border: 0;
                        border-top: 2px solid #ddd;
                    }

                    /* Responsive Design */
                    @media screen and (max-width: 768px) {
                        .info-row {
                            grid-template-columns: 1fr;
                        }
                    }
                </style>

                <!-- Report Header -->
                <div class="report-header">
                    <h1>Employee Requisition Report</h1>
                </div>

                <t t-foreach="docs" t-as="doc">
                    <!-- General Information Section -->
                    <div class="section">
                        <div class="section-title">General Information</div>
                        <div class="info-row">
                            <div>
                                <span class="info-label">Form No.:</span>
                                <span class="info-value"><t t-esc="doc.rec_no"/></span>
                            </div>
                            <div>
                                <span class="info-label">Position:</span>
                                <span class="info-value"><t t-esc="doc.rec_position.name"/></span>
                            </div>
                        </div>
                        <div class="info-row">
                            <div>
                                <span class="info-label">Department:</span>
                                <span class="info-value"><t t-esc="doc.rec_dept.name"/></span>
                            </div>
                            <div>
                                <span class="info-label">Gender:</span>
                                <span class="info-value"><t t-esc="doc.gender"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- Manpower Details Section -->
                    <div class="section">
                        <div class="section-title">Manpower Details</div>
                        <div class="info-row">
                            <div>
                                <span class="info-label">Approved:</span>
                                <span class="info-value"><t t-esc="doc.approved_man"/></span>
                            </div>
                            <div>
                                <span class="info-label">Actual:</span>
                                <span class="info-value"><t t-esc="doc.actual_man"/></span>
                            </div>
                        </div>
                        <div class="info-row">
                            <div>
                                <span class="info-label">Required:</span>
                                <span class="info-value"><t t-esc="doc.required_man"/></span>
                            </div>
                            <div>
                                <span class="info-label">Est. Salary:</span>
                                <span class="info-value"><t t-esc="doc.est_salary"/></span>
                            </div>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">Expertise &amp; Qualifications</div>
                        <div class="info-row">
                            <div>
                                <span class="info-label">Expertise:</span>
                                <span class="info-value"><t t-esc="doc.expertise"/></span>
                            </div>
                            <div>
                                <span class="info-label">Experience:</span>
                                <span class="info-value"><t t-esc="doc.exp_year"/> years</span>
                            </div>
                        </div>
                        <div class="info-row">
                            <div>
                                <span class="info-label">Education:</span>
                                <span class="info-value"><t t-esc="doc.edu_qual"/></span>
                            </div>
                            <div>
                                <span class="info-label">Position Type:</span>
                                <span class="info-value"><t t-esc="doc.position_type"/></span>
                            </div>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">Other Details</div>
                        <div class="info-row">
                            <div>
                                <span class="info-label">Proposed Salary:</span>
                                <span class="info-value"><t t-esc="doc.proposed_salary"/></span>
                            </div>
                            <div>
                                <span class="info-label">Probation:</span>
                                <span class="info-value"><t t-esc="doc.probation_period_id.name"/></span>
                            </div>
                        </div>
                        <div class="info-row">
                            <div>
                                <span class="info-label">Requested By:</span>
                                <span class="info-value"><t t-esc="doc.requested_by.name"/></span>
                            </div>
                            <div>
                                <span class="info-label">Designation:</span>
                                <span class="info-value"><t t-esc="doc.requested_designation.name"/></span>
                            </div>
                        </div>
                    </div>

                    <div class="comments-section">
                        <strong>Comments:</strong>
                        <p><t t-esc="doc.comments"/></p>
                    </div>

                    <hr/>
                </t>
            </main>
        </div>
    </t>
</template>


</data>
</odoo>
