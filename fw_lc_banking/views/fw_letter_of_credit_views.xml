<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_letter_of_credit_tree" model="ir.ui.view">
        <field name="name">fw.letter.of.credit.tree</field>
        <field name="model">fw.letter.of.credit</field>
        <field name="arch" type="xml">
            <tree string="Letters of Credit" decoration-danger="status not in ('utilized','closed') and expiry_date and expiry_date &lt; context_today()"
                  decoration-success="status in ('utilized','closed')">
                <field name="lc_no"/>
                <field name="buyer_order_id"/>
                <field name="buyer_id"/>
                <field name="lc_type"/>
                <field name="issuing_bank"/>
                <field name="lc_amount" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="expiry_date"/>
                <field name="latest_shipment_date"/>
                <field name="all_documents_submitted" widget="boolean_toggle"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_letter_of_credit_form" model="ir.ui.view">
        <field name="name">fw.letter.of.credit.form</field>
        <field name="model">fw.letter.of.credit</field>
        <field name="arch" type="xml">
            <form string="Letter of Credit">
                <header>
                    <button name="action_mark_received" type="object" string="Mark Received"
                            class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="status != 'received'"/>
                    <button name="action_mark_utilized" type="object" string="Mark Utilized"
                            class="btn-primary" invisible="status != 'active'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="status != 'utilized'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,received,active,utilized,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="lc_no" placeholder="Bank's L/C Number"/></h1>
                        <h3><field name="name" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="buyer_order_id"/>
                            <field name="buyer_id" readonly="1"/>
                            <field name="lc_type"/>
                            <field name="payment_terms"/>
                        </group>
                        <group>
                            <field name="issuing_bank"/>
                            <field name="advising_bank"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="lc_amount"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="latest_shipment_date"/>
                        </group>
                        <group>
                            <field name="partial_shipment_allowed"/>
                            <field name="transshipment_allowed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Required Document Checklist">
                            <button name="action_generate_standard_checklist" type="object"
                                    string="Generate Standard Checklist" class="btn-secondary mb-2"/>
                            <field name="document_line_ids">
                                <tree editable="bottom" decoration-success="submitted==True">
                                    <field name="document_type"/>
                                    <field name="document_name"
                                           invisible="document_type != 'other'"/>
                                    <field name="required"/>
                                    <field name="submitted"/>
                                    <field name="submitted_date"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Discrepancy Notes">
                            <field name="discrepancy_notes"/>
                        </page>
                        <page string="Remarks">
                            <field name="remarks"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_letter_of_credit_search" model="ir.ui.view">
        <field name="name">fw.letter.of.credit.search</field>
        <field name="model">fw.letter.of.credit</field>
        <field name="arch" type="xml">
            <search string="Search Letters of Credit">
                <field name="lc_no"/>
                <field name="buyer_order_id"/>
                <field name="buyer_id"/>
                <field name="issuing_bank"/>
                <filter string="Active" name="active_lc" domain="[('status','=','active')]"/>
                <filter string="Documents Pending" name="docs_pending"
                        domain="[('all_documents_submitted','=',False),('status','!=','draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="L/C Type" name="group_type" context="{'group_by': 'lc_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_letter_of_credit" model="ir.actions.act_window">
        <field name="name">Letters of Credit</field>
        <field name="res_model">fw.letter.of.credit</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_letter_of_credit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first Letter of Credit</p>
        </field>
    </record>
</odoo>
