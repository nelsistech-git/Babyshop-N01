<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_production_line_list" model="ir.ui.view">
        <field name="name">fw.production.line.list</field>
        <field name="model">fw.production.line</field>
        <field name="arch" type="xml">
            <tree string="Production Lines">
                <field name="code"/>
                <field name="name"/>
                <field name="factory_id"/>
                <field name="line_type"/>
                <field name="rated_capacity_pairs_per_day"/>
                <field name="supervisor_id"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_production_line_form" model="ir.ui.view">
        <field name="name">fw.production.line.form</field>
        <field name="model">fw.production.line</field>
        <field name="arch" type="xml">
            <form string="Production Line">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="factory_id"/>
                            <field name="line_type"/>
                        </group>
                        <group>
                            <field name="workstation_count"/>
                            <field name="rated_capacity_pairs_per_day"/>
                            <field name="supervisor_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fw_production_line" model="ir.actions.act_window">
        <field name="name">Production Lines</field>
        <field name="res_model">fw.production.line</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
