<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_color_list" model="ir.ui.view">
        <field name="name">fw.color.list</field>
        <field name="model">fw.color</field>
        <field name="arch" type="xml">
            <tree string="Colors" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="pantone_code"/>
                <field name="color_swatch" placeholder="#RRGGBB"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_color_form" model="ir.ui.view">
        <field name="name">fw.color.form</field>
        <field name="model">fw.color</field>
        <field name="arch" type="xml">
            <form string="Color">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="pantone_code"/>
                        <field name="color_swatch" placeholder="#RRGGBB"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fw_color" model="ir.actions.act_window">
        <field name="name">Colors</field>
        <field name="res_model">fw.color</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
