<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_operation_list" model="ir.ui.view">
        <field name="name">fw.operation.list</field>
        <field name="model">fw.operation</field>
        <field name="arch" type="xml">
            <tree string="Operations" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="process_type"/>
                <field name="machine_type"/>
                <field name="standard_smv"/>
                <field name="skill_level"/>
            </tree>
        </field>
    </record>

    <record id="action_fw_operation" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">fw.operation</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
