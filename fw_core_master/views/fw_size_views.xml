<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_size_list" model="ir.ui.view">
        <field name="name">fw.size.list</field>
        <field name="model">fw.size</field>
        <field name="arch" type="xml">
            <tree string="Sizes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="size_value"/>
                <field name="size_system"/>
            </tree>
        </field>
    </record>

    <record id="action_fw_size" model="ir.actions.act_window">
        <field name="name">Sizes</field>
        <field name="res_model">fw.size</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_fw_size_curve_form" model="ir.ui.view">
        <field name="name">fw.size.curve.form</field>
        <field name="model">fw.size.curve</field>
        <field name="arch" type="xml">
            <form string="Size Curve">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="size_system"/>
                        <field name="total_ratio"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="size_id" domain="[('size_system','=',parent.size_system)]"/>
                            <field name="ratio"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fw_size_curve_list" model="ir.ui.view">
        <field name="name">fw.size.curve.list</field>
        <field name="model">fw.size.curve</field>
        <field name="arch" type="xml">
            <tree string="Size Curves">
                <field name="name"/>
                <field name="size_system"/>
                <field name="total_ratio"/>
            </tree>
        </field>
    </record>

    <record id="action_fw_size_curve" model="ir.actions.act_window">
        <field name="name">Size Curves</field>
        <field name="res_model">fw.size.curve</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
