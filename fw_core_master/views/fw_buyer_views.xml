<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_buyer_list" model="ir.ui.view">
        <field name="name">fw.buyer.list</field>
        <field name="model">fw.buyer</field>
        <field name="arch" type="xml">
            <tree string="Buyers">
                <field name="code"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="buyer_grade"/>
                <field name="compliance_required"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_buyer_form" model="ir.ui.view">
        <field name="name">fw.buyer.form</field>
        <field name="model">fw.buyer</field>
        <field name="arch" type="xml">
            <form string="Buyer">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="order_count == 0">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Buyer Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="country_id"/>
                            <field name="buyer_grade"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="payment_term_id"/>
                            <field name="compliance_required"/>
                        </group>
                    </group>
                    <group string="Assigned Merchandisers">
                        <field name="merchandiser_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fw_buyer" model="ir.actions.act_window">
        <field name="name">Buyers</field>
        <field name="res_model">fw.buyer</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
