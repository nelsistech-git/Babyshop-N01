<odoo>
    <record id="module_category_nelsis_lc" model="ir.module.category">
        <field name="name">Nelsis LC Management</field>
        <field name="description">Letter of Credit roles</field>
        <field name="sequence">40</field>
    </record>
    <record id="module_category_nelsis_lc_bond" model="ir.module.category">
        <field name="name">Nelsis LC Bond Warehouse</field>
        <field name="sequence">41</field>
    </record>
    <record id="module_category_nelsis_lc_audit" model="ir.module.category">
        <field name="name">Nelsis LC Compliance</field>
        <field name="sequence">42</field>
    </record>

    <record id="group_lc_user" model="res.groups">
        <field name="name">LC User</field>
        <field name="category_id" ref="module_category_nelsis_lc"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Create and update own draft LC records.</field>
    </record>
    <record id="group_lc_officer" model="res.groups">
        <field name="name">LC Officer</field>
        <field name="category_id" ref="module_category_nelsis_lc"/>
        <field name="implied_ids" eval="[(4, ref('group_lc_user'))]"/>
        <field name="comment">Manage documentation, shipments, Bills of Entry and amendments.</field>
    </record>
    <record id="group_lc_manager" model="res.groups">
        <field name="name">LC Manager</field>
        <field name="category_id" ref="module_category_nelsis_lc"/>
        <field name="implied_ids" eval="[(4, ref('group_lc_officer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Approve LCs and amendments, close LCs, configure.</field>
    </record>

    <record id="group_lc_bond_officer" model="res.groups">
        <field name="name">Bond Warehouse Officer</field>
        <field name="category_id" ref="module_category_nelsis_lc_bond"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Read opened LC data and link warehouse receipts.</field>
    </record>
    <record id="group_lc_auditor" model="res.groups">
        <field name="name">Compliance / Audit User</field>
        <field name="category_id" ref="module_category_nelsis_lc_audit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read-only access to all LC records and the audit trail.</field>
    </record>
</odoo>
