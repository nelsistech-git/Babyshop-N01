<odoo noupdate="0">

    <!-- ===== model_nelsis_lc ===== -->
    <record id="rule_lc_company" model="ir.rule">
        <field name="name">LC lc: multi-company</field>
        <field name="model_id" ref="model_nelsis_lc"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_lc_own" model="ir.rule">
        <field name="name">LC lc: LC users see their own LCs</field>
        <field name="model_id" ref="model_nelsis_lc"/>
        <field name="groups" eval="[(4, ref('group_lc_user'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_lc_all" model="ir.rule">
        <field name="name">LC lc: officers, managers and auditors see all</field>
        <field name="model_id" ref="model_nelsis_lc"/>
        <field name="groups" eval="[(4, ref('group_lc_officer')), (4, ref('group_lc_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_lc_bond" model="ir.rule">
        <field name="name">LC lc: bond officers see LCs past review</field>
        <field name="model_id" ref="model_nelsis_lc"/>
        <field name="groups" eval="[(4, ref('group_lc_bond_officer'))]"/>
        <field name="domain_force">[('state', 'not in', ['draft', 'review'])]</field>
    </record>

