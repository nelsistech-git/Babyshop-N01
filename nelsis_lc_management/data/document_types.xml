     Seed checklist items. NONE are marked required by default: the mandatory list
     depends on the LC terms and the applicable customs rules and must be set by the
     company after confirmation by its customs/compliance professional. -->
<odoo noupdate="1">
    <record id="doctype_lc_application" model="nelsis.lc.document.type">
        <field name="name">LC Application</field>
        <field name="code">LC-APP</field>
        <field name="scope">lc</field>
        <field name="sequence">1</field>
    </record>
    <record id="doctype_proforma_invoice" model="nelsis.lc.document.type">
        <field name="name">Proforma Invoice</field>
        <field name="code">PI</field>
        <field name="scope">lc</field>
        <field name="sequence">2</field>
    </record>
    <record id="doctype_insurance" model="nelsis.lc.document.type">
        <field name="name">Insurance Cover Note / Policy</field>
        <field name="code">INS</field>
        <field name="scope">lc</field>
        <field name="sequence">3</field>
    </record>
    <record id="doctype_commercial_invoice" model="nelsis.lc.document.type">
        <field name="name">Commercial Invoice</field>
        <field name="code">CI</field>
        <field name="scope">shipment</field>
        <field name="sequence">10</field>
    </record>
    <record id="doctype_packing_list" model="nelsis.lc.document.type">
        <field name="name">Packing List</field>
        <field name="code">PL</field>
        <field name="scope">shipment</field>
        <field name="sequence">11</field>
    </record>
    <record id="doctype_bl_awb" model="nelsis.lc.document.type">
        <field name="name">Bill of Lading / Airway Bill</field>
        <field name="code">BL</field>
        <field name="scope">shipment</field>
        <field name="sequence">12</field>
    </record>
    <record id="doctype_certificate_origin" model="nelsis.lc.document.type">
        <field name="name">Certificate of Origin</field>
        <field name="code">COO</field>
        <field name="scope">shipment</field>
        <field name="sequence">13</field>
    </record>
    <record id="doctype_inspection" model="nelsis.lc.document.type">
        <field name="name">Inspection / Quality Certificate</field>
        <field name="code">INSP</field>
        <field name="scope">shipment</field>
        <field name="sequence">14</field>
    </record>
    <record id="doctype_boe_copy" model="nelsis.lc.document.type">
        <field name="name">Bill of Entry (copy)</field>
        <field name="code">BOE</field>
        <field name="scope">shipment</field>
        <field name="sequence">20</field>
    </record>
</odoo>
