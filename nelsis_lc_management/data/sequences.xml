<odoo noupdate="1">
    <record id="seq_nelsis_lc" model="ir.sequence">
        <field name="name">Nelsis LC</field>
        <field name="code">nelsis.lc</field>
        <field name="prefix">LC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_nelsis_lc_shipment" model="ir.sequence">
        <field name="name">Nelsis LC Shipment</field>
        <field name="code">nelsis.lc.shipment</field>
        <field name="prefix">SHP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
