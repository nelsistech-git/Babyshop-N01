<odoo>
    <record id="view_nelsis_lc_reason_wizard_form" model="ir.ui.view">
        <field name="name">nelsis.lc.reason.wizard.form</field>
        <field name="model">nelsis.lc.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason" class="nl-ui">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="action_type" invisible="1"/>
                    <field name="reason" placeholder="Explain why (recorded in the audit log)..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary nl-btn nl-success"
                            icon="fa-check"/>
                    <button string="Discard" class="btn-secondary nl-btn nl-ghost" special="cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_nelsis_lc_link_receipt_wizard_form" model="ir.ui.view">
        <field name="name">nelsis.lc.link.receipt.wizard.form</field>
        <field name="model">nelsis.lc.link.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Warehouse Receipts" class="nl-ui">
                <p class="text-muted">
                    This only links existing receipts to the LC for traceability.
                    No stock move is created or validated.
                </p>
                <group>
                    <field name="lc_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="shipment_id" options="{'no_create': True}"/>
                    <field name="picking_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_link" string="Link Receipts" type="object" class="btn-primary nl-btn nl-info"
                            icon="fa-link"/>
                    <button string="Discard" class="btn-secondary nl-btn nl-ghost" special="cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
