<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <data>
        <record id="batch_scrap_wizard_form" model="ir.ui.view">
            <field name="name">stock.batch.scrap.wizard.form</field>
            <field name="model">stock.batch.scrap.wizard</field>
            <field name="arch" type="xml">
                <form string="Batch Scrap">
                    <group>
                        <group>
                            <field name="src_location_id" required="1" options="{'no_create': True, 'no_open': True}"/>
<!--                            <field name="scrap_location_id" required="1" options="{'no_create': True, 'no_open': True}"/>-->
                            <field name="partner_id"/>
                            <field name="source_document"/>
                        </group>

                        <group>
                            <field name="order_by_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="approve_by_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <field name="batch_scrap_ids" >
                        <tree editable="bottom">
                            <field name="product_id" required="1"/>
                            <field name="product_available_qty"/>
                            <field name="scrap_qty" required="1"/>
                            <field name="product_uom"/>
                            <field name="product_cost_price"/>
                            <field name="product_other_cost"/>
                        </tree>
                    </field>

                    <footer>
                        <button name="action_batch_scrap" string="Confirm &amp; Save" type="object" class="btn-primary"
                        confirm="Are you sure you want to create Batch Scrap?"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="custom_batch_scrap_action" model="ir.actions.act_window">
            <field name="name">Batch Scrap</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.batch.scrap.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="batch_scrap_wizard_form"/>
            <field name="target">new</field>
        </record>

       <menuitem id="menu_stock_batch_scrap"
                 name="Batch Scrap"
                 sequence="100"
                 action="custom_batch_scrap_action"
                 parent="stock.menu_stock_warehouse_mgmt"/>
    </data>
</odoo>