<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_challan_qty_wizard" model="ir.ui.view">
        <field name="name">challan.qty.wizard.form</field>
        <field name="model">challan.qty.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Challan Quantity">
                <sheet>
                    <field name="stock_move_ids">
                        <tree create="false" delete="false" editable="bottom">
                            <field name="product_id"/>
                            <field name="product_uom_qty"/>
                            <field name="challan_qty"/>
                        </tree>
                        <form>
                            <group>
                                <field name="product_id" />
                                <field name="product_uom_qty" readonly="1"/>
                                <field name="challan_qty" readonly="1"/>
                            </group>
                        </form>
                    </field>
                </sheet>
                <footer>
                    <button name="action_update" type="object" string="Update" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>