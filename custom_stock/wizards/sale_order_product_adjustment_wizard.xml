<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_challan_qty_wizard" model="ir.ui.view">
        <field name="name">sale.product.adjustment.wizard.form</field>
        <field name="model">sale.product.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Product Stock">
                <sheet>
                    <group>
                        <field readonly="1" force_save="1" name="location_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                    </group>
                    <group string="Below Products are stock out:">
                        <field nolabel="1" readonly="1" force_save="1" name="pr_err_msg"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_adjustment" type="object" string="Adjustment" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>