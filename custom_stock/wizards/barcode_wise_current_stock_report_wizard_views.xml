<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="barcode_wise_current_stock_report_wizard_form" model="ir.ui.view">
            <field name="name">barcode.wise.current.stock.report.wizard.form</field>
            <field name="model">barcode.wise.current.stock.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Barcode wise Current Stock Report">
                    <group>
                        <group>
                            <field name="report_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="location_type" required="1" /> <!--attrs="{'invisible': [('report_type', '=', '02')]}"-->
                            <field name="location_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" /> <!--attrs="{'invisible': [('report_type', '=', '02')]}"-->
                            <field name="category_id" invisible="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="product_id" invisible="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="product_ids" widget="many2many_tags" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="vendor_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
                    <footer>
<!--                        <button name="barcode_wise_current_stock_report_pdf" string="Download (PDF)" type="object" class="btn-primary" />-->
                        <button name="barcode_wise_current_stock_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_barcode_wise_current_stock_report" model="ir.actions.act_window">
            <field name="name">Barcode wise Current Stock Report with Cost</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">barcode.wise.current.stock.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="context">{'is_without_cost': False, 'is_supplier_cost': False}</field>
            <field name="view_id" ref="barcode_wise_current_stock_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_barcode_wise_current_stock_report_wizard"
              name="Barcode wise Current Stock/Supplier Report with Cost"
              sequence="150"
              action="action_barcode_wise_current_stock_report"
              parent="stock.menu_warehouse_report"
              groups="base.group_erp_manager"
        />

        <record id="action_barcode_wise_current_stock_report_without_cost" model="ir.actions.act_window">
            <field name="name">Barcode wise Current Stock Report without Cost</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">barcode.wise.current.stock.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="context">{'is_without_cost': True, 'is_supplier_cost': False}</field>
            <field name="view_id" ref="barcode_wise_current_stock_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_barcode_wise_current_stock_report_without_cost_wizard"
              name="Barcode wise Current Stock Report without Cost"
              sequence="150"
              action="action_barcode_wise_current_stock_report_without_cost"
              parent="stock.menu_warehouse_report"
              groups="stock.group_stock_user"
        />

        <!--<record id="action_barcode_wise_detail_supplier_report" model="ir.actions.act_window">
            <field name="name">Barcode wise Detail Supplier Report with cost</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">barcode.wise.current.stock.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="context">{'is_without_cost': False, 'is_supplier_cost': True}</field>
            <field name="view_id" ref="barcode_wise_current_stock_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_barcode_wise_detail_supplier_report_wizard"
              name="Barcode wise Detail Supplier Report with cost"
              sequence="150"
              action="action_barcode_wise_detail_supplier_report"
              parent="stock.menu_warehouse_report"
              groups="stock.group_stock_manager"
        />-->

    </data>
</odoo>