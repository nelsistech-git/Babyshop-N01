<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="check_barcode_details_wizard_form" model="ir.ui.view">
            <field name="name">check.barcode.details.wizard.form</field>
            <field name="model">check.barcode.details.wizard</field>
            <field name="arch" type="xml">
                <form string="Check Barcode Details">
                    <group>
                        <group>
                            <field name="barcode"/>
                            <field name="product_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="category_id" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" />
                            <field name="brand" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>

                        </group>
                        <group>
                            <field name="style" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" />
                            <field name="attribute_ids" readonly="1" widget="many2many_tags" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" />
                            <field name="country" readonly="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="sales_price" readonly="1" />
                        </group>
                    </group>
                    <footer>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_check_barcode_details" model="ir.actions.act_window">
            <field name="name">Check Barcode Details</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">check.barcode.details.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_check_barcode_details_wizard"
              name="Check Barcode Details"
              sequence="3"
              action="action_check_barcode_details"
              parent="stock.menu_stock_inventory_control"
        />

    </data>
</odoo>