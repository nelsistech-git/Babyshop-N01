<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Terms Condition Form View -->
	<record id=">stock_terms_condition_view_form" model="ir.ui.view">
        <field name="name">stock.terms.condition.form</field>
        <field name="model">stock.terms.condition</field>
        <field name="arch" type="xml">
            <form delete="0" string="Stock Terms &amp; Condition">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" />
                            <field name="description" required="1" />
                        </group>
                        <group>
                            <field name="active"  />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stock_terms_condition Tree View -->
	<record id="stock_terms_condition_view_tree" model="ir.ui.view">
         <field name="name">stock.terms.condition.tree</field>
         <field name="model">stock.terms.condition</field>
         <field name="arch" type="xml">
             <tree delete="0" string="Stock Terms &amp; Condition List">
                 <field name="name"/>
                 <field name="description"/>
                 <field name="active"/>
             </tree>
         </field>
     </record>

    <!--Stock Terms Condition Search View -->
    <record id="stock_terms_condition_view_search" model="ir.ui.view">
         <field name="name">stock.terms.condition.search</field>
         <field name="model">stock.terms.condition</field>
        <field name="arch" type="xml">
            <search string="Search Cheque Book Bank">
                <field name="name"/>
           </search>
        </field>
    </record>

    <!-- Stock Terms Condition action window  -->
	<record id="stock_terms_condition_action" model="ir.actions.act_window">
        <field name="name">Stock Terms &amp; Condition</field>
        <field name="res_model">stock.terms.condition</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Please Create Stock Terms &amp; Condition
            </p>
        </field>
    </record>

    <!-- Stock Terms Condition menu -->
    <menuitem id="stock_terms_condition_menu" name="Stock Terms &amp; Condition" action="stock_terms_condition_action" sequence="50"
                  parent="custom_common_settings.root_planning_menu"/>

</odoo>
