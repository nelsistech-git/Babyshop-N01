<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <record id="view_stock_return_picking_form_inherit_custom_stock" model="ir.ui.view">
          <field name="name">stock.return.picking.custom.stock.form</field>
          <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
          <field name="model">stock.return.picking</field>
          <field name="arch" type="xml">
              <xpath expr="//field[@name='picking_id']" position="after">
                  <group>
                      <field name="type" widget="radio"/>
                      <field readonly="1" force_save="1" name="location_id"/>
                      <field readonly="1" force_save="1" name="location_dest_id"/>
                      <field name="barcode_list" invisible="type == '1'"/>
                  </group>
                  <group invisible="type == '1'">
                      <button name="barcode_scan" id="barcode_scan" class="btn-primary pull-left" type="object" string="Scan"/>
                  </group>
              </xpath>
              <xpath expr="//field[@name='location_id']" position="before">
                  <field name="return_reason" required="1"/>
              </xpath>
          </field>
      </record>
</odoo>