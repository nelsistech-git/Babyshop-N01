<?xml version="1.0" encoding="UTF-8"?>

<odoo>
	<data>
		<record id="store_godown_view_form" model="ir.ui.view">
			<field name="name">store.godown.form</field>
			<field name="model">store.godown</field>
			<field name="arch" type="xml">
				<form string="Go-down Form">
					<sheet>
						<group>
							<group string="Basic Information">
								<field name="name" />
								<field name="godown_address" />
							</group>
							<group string="Go-down Capacity">
								<field name="godown_shelf" />
								<field name="godown_area" />
							</group>
						</group>
						<separator string="Agreement Details" colspan="12"></separator>
						<group>
							<group>
								<field name="godown_agreement_signup_date" />
								<field name="godown_agreement_expire_date" />
								<field name="rent" />
								<field name="increment_rate" />
							</group>
							<group></group>
							<group colspan="12">
								<separator string="Go-down Owner Details" colspan="12"></separator>
								<field name="godown_owner_ids" nolabel="1">
									<tree string="Go-down owner Details" editable="bottom">
										<field name="name" />
										<field name="phone" />
										<field name="email" />
										<field name="godown_owner_address" />
									</tree>
								</field>
							</group>
						</group>
					</sheet>
				</form>
			</field>

		</record>

		<record id="store_godown_view_tree" model="ir.ui.view">
			<field name="name">store.godown.tree</field>
			<field name="model">store.godown</field>
			<field name="arch" type="xml">
				<tree string="Go-down tree">
					<field name="name" />
					<field name="godown_shelf" />
					<field name="godown_area" />
				</tree>
			</field>
		</record>

		<record id="store_godown_view_search" model="ir.ui.view">
			<field name="name">store.godown.search</field>
			<field name="model">store.godown</field>
			<field name="arch" type="xml">
				<search string="Go-down search">
					<field name="name" />
					<field name="godown_shelf" />
					<field name="godown_area" />
				</search>
			</field>
		</record>

		<record id="store_godown_list_action" model="ir.actions.act_window">
			<field name="name">Go-down Lists</field>
			<field name="res_model">store.godown</field>
			<!-- <field name="view_type">form</field> -->
			<field name="view_mode">tree,form</field>
			<field name="help" type="html">
				<p class="o_view_nocontent_smiling_face">Create Go-down lists
				</p>
			</field>
		</record>
		<menuitem id="store_godown_menu" name="Go-down Lists" parent="custom_common_settings.root_planning_menu"
			action="store_godown_list_action" sequence="5" />
	</data>
</odoo>