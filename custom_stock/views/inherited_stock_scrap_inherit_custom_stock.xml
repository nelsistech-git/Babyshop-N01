<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="inherited_stock_scrap_view_search" model="ir.ui.view">
        <field name="name">stock.scrap.search</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_search_view"/>
        <field name="arch" type="xml">
             <xpath expr="//search" position="inside">
                 <field name="origin"/>
            </xpath>
        </field>
    </record>

    <record id="inherited_stock_scrap_view_form" model="ir.ui.view">
        <field name="name">stock.scrap.form</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='origin']" position="after">
                 <field name="order_by_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                 attrs="{'readonly': [('state', 'in', ('done'))]}"/>
                 <field name="approve_by_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"
                 attrs="{'readonly': [('state', 'in', ('done'))]}"/>
            </xpath>
             <xpath expr="//field[@name='origin']" position="attributes">
                 <attribute name="readonly">{'readonly':[('state','in',['done'])]}</attribute>
            </xpath>
             <xpath expr="//field[@name='product_id']" position="attributes">
                 <attribute name="options">{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
            </xpath>
             <xpath expr="//field[@name='owner_id']" position="attributes">
                 <attribute name="options">{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                 <attribute name="options">{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
            </xpath>
        </field>
    </record>

     <record id="inherited_stock_scrap_view_tree" model="ir.ui.view">
        <field name="name">stock.scrap.tree</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_tree_view"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='state']" position="before">
                 <field name="origin"/>
            </xpath>
        </field>
    </record>

</odoo>