        <record id="inherited_stock_location_inh_custom_stock_action" model="ir.actions.act_window">
            <field name="name">Store Location</field>
			<field name="res_model">stock.location</field>
			<field name="type">ir.actions.act_window</field>
			<field name="view_mode">tree,form</field>
			<field name="view_id" ref="custom_stock.inherited_stock_location_inh_custom_stock_view_form" />
			<field name="context">{'search_default_state': 'done','default_usage':'internal','default_is_work_loc':True}</field>
<!--			<field name="domain">[('is_work_loc','=',True)]</field>-->
			<field name="domain">[('usage', '=', 'internal')]</field>
			<field name="search_view_id" ref="custom_stock.inherited_stock_location_inh_custom_stock_search" />
			<field name="help" type="html">
				<p class="o_view_nocontent_smiling_face">Create Stock Locations</p>
			</field>
		</record>

        <record id="inherited_stock_location_inh_custom_stock_action_tree" model="ir.actions.act_window.view">
			<field name="sequence" eval="1" />
			<field name="view_mode">tree</field>
			<field name="view_id" ref="inherited_stock_location_inh_custom_stock_view_tree"/>
			<field name="act_window_id" ref="inherited_stock_location_inh_custom_stock_action"/>
		</record>

        <menuitem id="inherited_stock_location_menu" name="Store Location"
                  parent="stock.menu_stock_warehouse_mgmt"
                  groups="stock.group_stock_manager"
                  action="inherited_stock_location_inh_custom_stock_action" sequence="6"/>
    </data>
</odoo>