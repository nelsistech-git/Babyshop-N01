<odoo>
    <!-- Gateman Group for Inventory-->
    <record id="group_gateman" model="res.groups">
        <field name="name">Inventory / Gateman</field>
    </record>

    <record id="group_inventory_manage_root_menu_id" model="res.groups">
        <field name="name">Inventory and Warehouse</field>
        <field name="category_id" ref="custom_common_settings.root_menu_access_group_category"/>
    </record>

    <!-- Show the picking operations by user work location matched with picking source,destination location == for inventory user -->
    <record id="picking_view_rule_user" model="ir.rule">
        <field name="name">Picking View Rule User</field>
        <field name="model_id" search="[('model','=','stock.picking')]" model="ir.model"/>
        <field name="domain_force">['|',('location_dest_id.id','=', user.user_work_location_id.id), ('location_id.id','=', user.user_work_location_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
<!--    <record model="ir.rule" id="stock_picking_rule">-->
<!--        <field name="name">stock_picking multi-company</field>-->
<!--        <field name="model_id" search="[('model','=','stock.picking')]" model="ir.model"/>-->
<!--        <field name="domain_force">[('company_id', 'in', company_ids)]</field>-->
<!--    </record>-->
    <!-- Show the picking operations by user work location matched with picking source,destination location == for inventory admin -->
    <record id="picking_view_rule_manager" model="ir.rule">
        <field name="name">Picking View Rule Manager</field>
        <field name="model_id" search="[('model','=','stock.picking')]" model="ir.model"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>

    <!-- Inventory Adjustment POS-->
    <record id="group_pos_inventory_adjustment" model="res.groups">
        <field name="name">Inventory Adjustment POS</field>
    </record>

    <record id="group_inventory_product_sub_menu" model="res.groups">
        <field name="name">Sub - Inventory Products</field>
        <field name="category_id" ref="custom_common_settings.inventory_sub_menu_access_group_category"/>
    </record>

</odoo>