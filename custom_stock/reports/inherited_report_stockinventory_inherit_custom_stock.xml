<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="inherited_report_inventory_inherit_custom_stock" inherit_id="stock.report_inventory">
        <xpath expr="//h2" position="before">
            <style type="text/css">
                table, th, tr, td{
                    background: white !important;
                }
                h2 {
                    text-align:center !important;
                }
            </style>
        </xpath>
        <xpath expr="//table" position="after">
            <div class="row" style="margin: em auto 0 auto !important;">
                <div class="col-3 text-center">
                    <div>
                        <p style="padding-top: 120px;text-align:center;text-decoration: overline; margin-bottom:0 !important;"><strong>Prepared by</strong></p>
                    </div>
                    <div>
                        (<span t-field="o.create_uid"/>)
                    </div>
                </div>
                <div class="col-3 text-center">
                    <div>
                        <p style="padding-top: 120px;text-align:center;text-decoration: overline;"><strong>Ordered By</strong></p>
                    </div>
                </div>
                <div class="col-3 text-center">
                    <div>
                        <p style="padding-top: 120px;text-align:center;text-decoration:overline;margin-bottom:0 !important;"><strong>Approved By</strong></p>
                    </div>
                </div>
                <div class="col-3 text-center">
                    <div>
                        <p style="padding-top: 120px;text-align:center;text-decoration: overline;"><strong>Audited By</strong></p>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>