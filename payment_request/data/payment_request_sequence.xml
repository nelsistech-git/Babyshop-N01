<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_payment_request" model="ir.sequence">
            <field name="name">Payment Request</field>
            <field name="code">payment.request</field>
            <field name="prefix">PR-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Matches BBBL's real BEFTN letter Ref format, e.g. "BBBL/CBC Plc2026/342" -->
        <record id="seq_payment_request_beftn_ref" model="ir.sequence">
            <field name="name">Payment Request - BEFTN Reference No.</field>
            <field name="code">payment.request.beftn.ref</field>
            <field name="prefix">BBBL/CBC Plc%(year)s/</field>
            <field name="padding">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Mushak 6.6 VDS Certificate No. - a plain running number, e.g. "231",
             as issued by the deducting entity (matches the NBR example format). -->
        <record id="seq_payment_request_vds_certificate" model="ir.sequence">
            <field name="name">Payment Request - Mushak 6.6 VDS Certificate No.</field>
            <field name="code">payment.request.vds.certificate</field>
            <field name="padding">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
