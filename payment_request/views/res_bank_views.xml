<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_bank_form_pr_short_name" model="ir.ui.view">
        <field name="name">res.bank.form.pr.short.name</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="pr_short_name" placeholder="e.g. CBC"/>
            </xpath>
        </field>
    </record>
</odoo>
