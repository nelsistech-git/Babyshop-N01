<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Accounting > Vendors > Bills: Due Date (Calculated) stays visible even when a Payment Term
         hides the standard Due Date; VAT Challan No / Date (synced to the Payment Requisition +
         Mushak 6.6) -->
    <record id="view_move_form_vat_challan" model="ir.ui.view">
        <field name="name">account.move.form.vat.challan</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="x_due_date_calc"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
                <field name="x_vat_challan_no" invisible="move_type not in ('in_invoice', 'in_refund')"/>
                <field name="x_vat_challan_date" invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>