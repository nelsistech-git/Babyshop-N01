<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_payment_request_tree" model="ir.ui.view">
            <field name="name">payment.request.tree</field>
            <field name="model">payment.request</field>
            <field name="arch" type="xml">
                <tree decoration-success="state=='paid'" decoration-info="state=='approved'"
                      decoration-danger="state=='rejected'" decoration-muted="state=='cancelled'">
                    <field name="name"/>
                    <field name="request_date"/>
                    <field name="prepared_by_id"/>
                    <field name="total_bill_amount"/>
                    <field name="total_net_payment"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <record id="view_payment_request_form" model="ir.ui.view">
            <field name="name">payment.request.form</field>
            <field name="model">payment.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_lm_approve" type="object" string="Line Manager Approval"
                                class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_hof_approve" type="object" string="Head of Finance &amp; Accounts Approval"
                                class="oe_highlight"
                                invisible="state != 'lm_approved' or x_requires_exec_approval"/>
                        <button name="action_exec_approve" type="object" string="Executive (CEO/MD/Director) Approval"
                                class="oe_highlight"
                                invisible="state != 'lm_approved' or not x_requires_exec_approval"/>
                        <button name="action_print_requisition" type="object" string="Print Requisition"/>
                        <button name="action_print_rtgs" type="object" string="Print RTGS"
                                invisible="not has_rtgs_lines or state not in ('approved','bank_forwarded','paid')"/>
                        <button name="action_print_beftn" type="object" string="Print BEFTN"
                                invisible="not has_beftn_lines or state not in ('approved','bank_forwarded','paid')"/>
                        <button name="action_print_mushak66" type="object" string="Print Mushak 6.6 VDS"
                                invisible="not has_vat_lines or not vds_certificate_no"/>
                        <button name="action_issue_mushak66" type="object" string="Issue 6.6"
                                class="oe_highlight"
                                invisible="state != 'paid' or not has_vat_lines or vds_certificate_no"/>
                        <button name="action_mark_forwarded" type="object" string="Mark Forwarded to Bank"
                                class="oe_highlight" invisible="state != 'approved'"/>
                        <!-- the accounting payment is posted automatically by "Mark Paid" -->
                        <button name="action_create_vendor_payments" type="object" string="Create Vendor Payments"
                                invisible="1"/>
                        <button name="action_mark_paid" type="object" string="Mark Paid" class="oe_highlight"
                                invisible="state != 'bank_forwarded'"/>
                        <button name="action_reject" type="object" string="Reject"
                                invisible="state in ('draft','bank_forwarded','paid','rejected','cancelled')"/>
                        <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                                invisible="state in ('draft','bank_forwarded','paid')"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state in ('bank_forwarded','paid','cancelled')"/>
                        <field name="x_requires_exec_approval" invisible="1"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,lm_approved,approved,bank_forwarded,paid"/>
                    </header>
                    <sheet>
                        <field name="has_rtgs_lines" invisible="1"/>
                        <field name="has_beftn_lines" invisible="1"/>
                        <field name="has_vat_lines" invisible="1"/>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="request_date"/>
                                <field name="prepared_by_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="commercial_tt_id" invisible="not commercial_tt_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="beftn_ref" invisible="not beftn_ref"/>
                                <field name="challan_no" string="Treasury Challan No (printed inside the Mushak 6.6 paragraph)" invisible="state != 'paid'" readonly="vds_certificate_no"/>
                                <field name="challan_date" string="Treasury Challan Date" invisible="state != 'paid'" readonly="vds_certificate_no"/>
                                <field name="vds_certificate_no" invisible="not vds_certificate_no"/>
                                <field name="vds_certificate_date" invisible="not vds_certificate_no"/>
                            </group>
                        </group>
                        <field name="reject_reason" invisible="state != 'rejected'"/>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="partner_id" string="Beneficiary" width="180px" readonly="parent.state != 'draft'"/>
                                        <field name="vendor_bin" string="BIN" width="110px" readonly="parent.state != 'draft'"/>
                                        <field name="payment_description" string="Description of Payment" width="180px" readonly="parent.state != 'draft'"/>
                                        <field name="section_name" string="Section Name" width="110px" readonly="parent.state != 'draft'"/>
                                        <field name="invoice_id" string="Vendor Bill" optional="hide" width="120px" readonly="parent.state != 'draft'"/>
                                        <field name="due_date" string="Due Date" optional="show" width="100px" readonly="invoice_id or parent.state != 'draft'"/>
                                        <field name="vat_challan_no" string="VAT Challan No" optional="show" width="120px" readonly="invoice_id or parent.vds_certificate_no"/>
                                        <field name="vat_challan_date" string="VAT Challan Date" optional="show" width="105px" readonly="invoice_id or parent.vds_certificate_no"/>
                                        <field name="bill_amount" string="Bill Amt" width="95px" readonly="parent.state != 'draft'"/>
                                        <field name="deduction_amount" string="Deduction" width="95px" readonly="parent.state != 'draft'"/>
                                        <field name="wht_amount" string="WHT" width="85px" readonly="parent.state != 'draft'"/>
                                        <field name="whvat_amount" string="WHVAT" width="85px" readonly="parent.state != 'draft'"/>
                                        <field name="vat_amount" string="VAT Amt" optional="hide" width="85px" readonly="parent.state != 'draft'"/>
                                        <field name="net_payment" string="Net Payment" width="100px"/>
                                        <field name="payment_mode" string="Mode" width="110px" readonly="parent.state != 'draft'"/>
                                        <field name="own_bank_id" string="Debit A/C" width="140px" readonly="parent.state != 'draft'"
                                               context="{'default_partner_id': company_partner_id}"/>
                                        <field name="own_bank_branch_id" string="Debit Branch" width="120px" readonly="parent.state != 'draft'"
                                               context="{'default_bank_id': own_bank_bank_id}"/>
                                        <field name="company_partner_id" column_invisible="1"/>
                                        <field name="own_bank_bank_id" column_invisible="1"/>
                                        <field name="bank_id" string="Beneficiary A/C" optional="hide"/>
                                        <field name="instrument_no" string="Inst. No." optional="hide"/>
                                        <field name="value_date" string="Value Date" width="100px"/>
                                        <field name="purpose" optional="hide"/>
                                        <field name="is_paid" string="Paid" optional="show" width="45px"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </tree>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="partner_id" readonly="parent.state != 'draft'"/>
                                                <field name="vendor_bin" readonly="parent.state != 'draft'"/>
                                                <field name="invoice_id" readonly="parent.state != 'draft'"/>
                                                <field name="invoice_ref"/>
                                                <field name="invoice_date"/>
                                                <field name="due_date" readonly="invoice_id or parent.state != 'draft'"/>
                                                <field name="vat_challan_no" readonly="invoice_id or parent.vds_certificate_no"/>
                                                <field name="vat_challan_date" readonly="invoice_id or parent.vds_certificate_no"/>
                                                <field name="payment_mode" readonly="parent.state != 'draft'"/>
                                                <field name="value_date"/>
                                                <field name="purpose"/>
                                                <field name="payment_description" readonly="parent.state != 'draft'"/>
                                                <field name="section_name" readonly="parent.state != 'draft'"/>
                                            </group>
                                            <group>
                                                <field name="bill_amount" readonly="parent.state != 'draft'"/>
                                                <field name="deduction_amount" readonly="parent.state != 'draft'"/>
                                                <field name="wht_amount" readonly="parent.state != 'draft'"/>
                                                <field name="whvat_amount" readonly="parent.state != 'draft'"/>
                                                <field name="vat_amount" readonly="parent.state != 'draft'"/>
                                                <field name="net_payment"/>
                                                <field name="amount_in_words"/>
                                            </group>
                                        </group>
                                        <group string="Debit Account (Our Bank)">
                                            <group>
                                                <field name="company_partner_id" invisible="1"/>
                                                <field name="own_bank_bank_id" invisible="1"/>
                                                <field name="own_bank_id" readonly="parent.state != 'draft'"
                                                       context="{'default_partner_id': company_partner_id}"/>
                                            </group>
                                            <group>
                                                <field name="own_bank_branch_id" readonly="parent.state != 'draft'"
                                                       context="{'default_bank_id': own_bank_bank_id}"/>
                                            </group>
                                        </group>
                                        <group string="Beneficiary Bank Details">
                                            <group>
                                                <field name="bank_id"/>
                                                <field name="beneficiary_bank_name"/>
                                                <field name="beneficiary_bank_branch"/>
                                            </group>
                                            <group>
                                                <field name="beneficiary_bank_routing_no"/>
                                                <field name="beneficiary_account_number"/>
                                                <field name="beneficiary_address"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="instrument_no"/>
                                            <field name="payment_move_id" readonly="1"/>
                                        </group>
                                    </form>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="total_bill_amount"/>
                                    <field name="total_deduction"/>
                                    <field name="total_wht"/>
                                    <field name="total_whvat"/>
                                    <field name="total_net_payment" class="oe_subtotal_footer_separator"/>
                                </group>
                            </page>
                        </notebook>
                        <group string="Approval Chain">
                            <group>
                                <field name="lm_approved_by_id" readonly="1"/>
                                <field name="lm_approved_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="approved_by_id" readonly="1"/>
                                <field name="approved_date" readonly="1"/>
                                <field name="final_approver_role" readonly="1" invisible="not final_approver_role"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_payment_request_search" model="ir.ui.view">
            <field name="name">payment.request.search</field>
            <field name="model">payment.request</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="prepared_by_id"/>
                    <field name="line_ids" filter_domain="[('line_ids.partner_id', 'ilike', self)]" string="Beneficiary"/>
                    <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                    <filter string="Pending My Action" name="filter_pending" domain="[('state','in',('draft','lm_approved'))]"/>
                    <filter string="Approved" name="filter_approved" domain="[('state','=','approved')]"/>
                    <filter string="Forwarded to Bank" name="filter_forwarded" domain="[('state','=','bank_forwarded')]"/>
                    <filter string="Paid" name="filter_paid" domain="[('state','=','paid')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="groupby_state" context="{'group_by':'state'}"/>
                        <filter string="Prepared By" name="groupby_prepared" context="{'group_by':'prepared_by_id'}"/>
                        <filter string="Request Date" name="groupby_date" context="{'group_by':'request_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_payment_request" model="ir.actions.act_window">
            <field name="name">Payment Requests</field>
            <field name="res_model">payment.request</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_payment_request_search"/>
            <field name="help" type="html"><p class="o_view_nocontent_smart_action">Create your first Payment Request.</p></field>
        </record>

    </data>
</odoo>