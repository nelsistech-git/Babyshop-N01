<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_lead_source_tree" model="ir.ui.view">
        <field name="name">garment.lead.source.tree</field>
        <field name="model">garment.lead.source</field>
        <field name="arch" type="xml">
            <tree string="Lead Sources" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="priority"/>
                <field name="cost_amount"/>
                <field name="lead_count"/>
                <field name="won_count"/>
                <field name="conversion_rate" widget="percentage"/>
                <field name="roi" widget="percentage"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_lead_source" model="ir.actions.act_window">
        <field name="name">Lead Sources</field>
        <field name="res_model">garment.lead.source</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
