<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_buyer_document_tree" model="ir.ui.view">
        <field name="name">garment.buyer.document.tree</field>
        <field name="model">garment.buyer.document</field>
        <field name="arch" type="xml">
            <tree string="Buyer Documents" decoration-danger="is_expiring_soon">
                <field name="buyer_id"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="expiry_date"/>
                <field name="approval_status"/>
                <field name="is_expiring_soon"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_buyer_document" model="ir.actions.act_window">
        <field name="name">Buyer Documents</field>
        <field name="res_model">garment.buyer.document</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
