<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_buyer_complaint_tree" model="ir.ui.view">
        <field name="name">garment.buyer.complaint.tree</field>
        <field name="model">garment.buyer.complaint</field>
        <field name="arch" type="xml">
            <tree string="Complaints" decoration-danger="priority == '3'">
                <field name="complaint_number"/>
                <field name="buyer_id"/>
                <field name="complaint_date"/>
                <field name="complaint_category"/>
                <field name="assigned_department"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_buyer_complaint_kanban" model="ir.ui.view">
        <field name="name">garment.buyer.complaint.kanban</field>
        <field name="model">garment.buyer.complaint</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="complaint_number"/>
                <field name="complaint_category"/>
                <field name="priority"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <strong><field name="complaint_number"/></strong>
                            </div>
                            <div><field name="buyer_id"/></div>
                            <div class="text-muted"><field name="complaint_category"/></div>
                            <field name="priority" widget="priority"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_garment_buyer_complaint_form" model="ir.ui.view">
        <field name="name">garment.buyer.complaint.form</field>
        <field name="model">garment.buyer.complaint</field>
        <field name="arch" type="xml">
            <form string="Buyer Complaint">
                <header>
                    <button name="action_start_investigation" type="object" string="Start Investigation"
                            class="btn-primary" invisible="state != 'logged'"/>
                    <button name="action_capa_complete" type="object" string="CAPA Completed" class="btn-primary"
                            invisible="state != 'investigation'"/>
                    <button name="action_qa_verify" type="object" string="QA Verification" class="btn-primary"
                            invisible="state != 'capa_completed'"/>
                    <button name="action_send_for_management_approval" type="object" string="Send for Approval"
                            class="btn-primary" invisible="state != 'qa_verification'"/>
                    <button name="action_close" type="object" string="Close Complaint" class="btn-primary"
                            invisible="state != 'management_approval'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="logged,investigation,capa_completed,qa_verification,management_approval,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="complaint_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="complaint_date"/>
                            <field name="order_reference"/>
                            <field name="complaint_category"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="assigned_department"/>
                            <field name="responsible_user_id"/>
                            <field name="target_resolution_date"/>
                            <field name="actual_resolution_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <group>
                                <field name="description"/>
                                <field name="root_cause"/>
                            </group>
                        </page>
                        <page string="Corrective / Preventive Action">
                            <group>
                                <field name="corrective_action"/>
                                <field name="preventive_action"/>
                            </group>
                        </page>
                        <page string="Closure">
                            <group>
                                <field name="buyer_feedback"/>
                                <field name="closure_approved_by_id" readonly="1"/>
                                <field name="closure_approval_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_buyer_complaint_search" model="ir.ui.view">
        <field name="name">garment.buyer.complaint.search</field>
        <field name="model">garment.buyer.complaint</field>
        <field name="arch" type="xml">
            <search string="Search Complaints">
                <field name="complaint_number"/>
                <field name="buyer_id"/>
                <filter string="Open" name="filter_open" domain="[('state', '!=', 'closed')]"/>
                <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'complaint_category'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_buyer_complaint" model="ir.actions.act_window">
        <field name="name">Complaints</field>
        <field name="res_model">garment.buyer.complaint</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first buyer complaint.</p>
        </field>
    </record>

</odoo>
