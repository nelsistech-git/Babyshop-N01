<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_opportunity_kanban" model="ir.ui.view">
        <field name="name">garment.opportunity.kanban</field>
        <field name="model">garment.opportunity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="stage_id"/>
                <field name="priority"/>
                <field name="expected_revenue"/>
                <field name="currency_id"/>
                <progressbar field="is_lost" colors='{"false": "success", "true": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div><field name="buyer_id"/></div>
                            <div>
                                <field name="expected_revenue" widget="monetary"/>
                                (<field name="probability"/>%)
                            </div>
                            <div class="text-muted">
                                <field name="assigned_merchandiser_id"/> · <field name="expected_closing_date"/>
                            </div>
                            <field name="priority" widget="priority"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_garment_opportunity_tree" model="ir.ui.view">
        <field name="name">garment.opportunity.tree</field>
        <field name="model">garment.opportunity</field>
        <field name="arch" type="xml">
            <tree string="Opportunities" decoration-danger="is_lost">
                <field name="is_lost" column_invisible="1"/>
                <field name="opportunity_no"/>
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="stage_id"/>
                <field name="assigned_merchandiser_id"/>
                <field name="expected_closing_date"/>
                <field name="probability"/>
                <field name="expected_revenue" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_opportunity_form" model="ir.ui.view">
        <field name="name">garment.opportunity.form</field>
        <field name="model">garment.opportunity</field>
        <field name="arch" type="xml">
            <form string="Opportunity">
                <header>
                    <button name="action_mark_won" type="object" string="Mark Order Confirmed" class="btn-primary"
                            invisible="is_lost"/>
                    <button name="action_mark_lost" type="object" string="Mark Lost" class="btn-secondary"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="opportunity_no" readonly="1"/>
                            <field name="buyer_id"/>
                            <field name="buyer_contact_id"/>
                            <field name="lead_source_id"/>
                            <field name="department"/>
                        </group>
                        <group>
                            <field name="assigned_merchandiser_id"/>
                            <field name="sales_executive_id"/>
                            <field name="marketing_executive_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Forecast">
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="expected_closing_date"/>
                            <field name="expected_order_date"/>
                            <field name="probability"/>
                        </group>
                        <group>
                            <field name="estimated_quantity"/>
                            <field name="estimated_fob_price"/>
                            <field name="estimated_order_value" readonly="1"/>
                            <field name="expected_revenue"/>
                        </group>
                    </group>
                    <group string="Lost Reason" invisible="not is_lost">
                        <field name="is_lost" invisible="1"/>
                        <field name="lost_reason"/>
                    </group>
                    <notebook>
                        <page string="RFQs">
                            <field name="rfq_ids">
                                <tree>
                                    <field name="rfq_number"/>
                                    <field name="rfq_date"/>
                                    <field name="style_name"/>
                                    <field name="order_quantity"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Meetings">
                            <field name="meeting_ids">
                                <tree>
                                    <field name="meeting_number"/>
                                    <field name="date_start"/>
                                    <field name="meeting_type"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="AI Prediction">
                            <button name="action_run_ai_prediction" type="object" string="Run AI Prediction"
                                    class="btn-secondary" icon="fa-magic"/>
                            <group>
                                <group>
                                    <field name="ai_probability_win"/>
                                    <field name="ai_expected_margin"/>
                                    <field name="ai_buyer_response_time_days"/>
                                    <field name="ai_expected_po_date"/>
                                </group>
                                <group>
                                    <field name="ai_suggested_followup_date"/>
                                    <field name="ai_suggested_next_action"/>
                                    <field name="ai_recommended_sales_executive_id"/>
                                    <field name="ai_last_run"/>
                                </group>
                            </group>
                            <field name="ai_similar_historical_orders"/>
                            <field name="ai_last_insight"/>
                        </page>
                        <page string="Notes">
                            <group>
                                <field name="branch"/>
                            </group>
                            <field name="notes"/>
                            <field name="internal_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_opportunity_search" model="ir.ui.view">
        <field name="name">garment.opportunity.search</field>
        <field name="model">garment.opportunity</field>
        <field name="arch" type="xml">
            <search string="Search Opportunities">
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="assigned_merchandiser_id"/>
                <field name="tag_ids"/>
                <field name="currency_id"/>
                <filter string="Open" name="filter_open" domain="[('is_lost', '=', False)]"/>
                <filter string="Lost" name="filter_lost" domain="[('is_lost', '=', True)]"/>
                <filter string="High Priority" name="filter_high_priority" domain="[('priority', 'in', ['2','3'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Merchandiser" name="group_merchandiser" context="{'group_by': 'assigned_merchandiser_id'}"/>
                    <filter string="Lead Source" name="group_lead_source" context="{'group_by': 'lead_source_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_opportunity" model="ir.actions.act_window">
        <field name="name">Opportunities</field>
        <field name="res_model">garment.opportunity</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first opportunity.</p>
        </field>
    </record>

    <record id="view_garment_opportunity_stage_tree" model="ir.ui.view">
        <field name="name">garment.opportunity.stage.tree</field>
        <field name="model">garment.opportunity.stage</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_won_stage"/>
                <field name="is_lost_stage"/>
                <field name="fold"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_opportunity_stage" model="ir.actions.act_window">
        <field name="name">Opportunity Stages</field>
        <field name="res_model">garment.opportunity.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>