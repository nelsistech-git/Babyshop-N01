<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_crm_activity_tree" model="ir.ui.view">
        <field name="name">garment.crm.activity.tree</field>
        <field name="model">garment.crm.activity</field>
        <field name="arch" type="xml">
            <tree string="Activities" decoration-danger="status == 'overdue'" decoration-muted="status in ('completed','cancelled')">
                <field name="activity_number"/>
                <field name="subject"/>
                <field name="buyer_id"/>
                <field name="activity_type"/>
                <field name="assigned_user_id"/>
                <field name="start_date"/>
                <field name="priority" widget="priority"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_crm_activity_kanban" model="ir.ui.view">
        <field name="name">garment.crm.activity.kanban</field>
        <field name="model">garment.crm.activity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="subject"/>
                <field name="activity_type"/>
                <field name="priority"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <strong><field name="subject"/></strong>
                            </div>
                            <div><field name="buyer_id"/> · <field name="activity_type"/></div>
                            <div class="text-muted"><field name="assigned_user_id"/> · <field name="start_date"/></div>
                            <field name="priority" widget="priority"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_garment_crm_activity_form" model="ir.ui.view">
        <field name="name">garment.crm.activity.form</field>
        <field name="model">garment.crm.activity</field>
        <field name="arch" type="xml">
            <form string="Activity">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="status not in ('planned','scheduled')"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary"
                            invisible="status in ('completed','cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"
                            invisible="status in ('completed','cancelled')"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="planned,scheduled,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="subject" placeholder="Activity subject"/></h1>
                        <span class="text-muted"><field name="activity_number" readonly="1"/></span>
                    </div>
                    <group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="related_opportunity_id"/>
                            <field name="activity_type"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="priority" widget="priority"/>
                            <field name="reminder"/>
                            <field name="reminder_custom_minutes" invisible="reminder != 'custom'"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="completion_notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_crm_activity_search" model="ir.ui.view">
        <field name="name">garment.crm.activity.search</field>
        <field name="model">garment.crm.activity</field>
        <field name="arch" type="xml">
            <search string="Search Activities">
                <field name="subject"/>
                <field name="buyer_id"/>
                <field name="assigned_user_id"/>
                <filter string="Overdue" name="filter_overdue" domain="[('status', '=', 'overdue')]"/>
                <filter string="My Activities" name="filter_mine" domain="[('assigned_user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'activity_type'}"/>
                    <filter string="Assigned User" name="group_user" context="{'group_by': 'assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_crm_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">garment.crm.activity</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule your first buyer activity.</p>
        </field>
    </record>

</odoo>
