<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_buyer_contact_tree" model="ir.ui.view">
        <field name="name">garment.buyer.contact.tree</field>
        <field name="model">garment.buyer.contact</field>
        <field name="arch" type="xml">
            <tree string="Buyer Contacts">
                <field name="buyer_id"/>
                <field name="name"/>
                <field name="designation"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="is_decision_maker"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_buyer_contact" model="ir.actions.act_window">
        <field name="name">Buyer Contacts</field>
        <field name="res_model">garment.buyer.contact</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
