<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_crm_meeting_tree" model="ir.ui.view">
        <field name="name">garment.crm.meeting.tree</field>
        <field name="model">garment.crm.meeting</field>
        <field name="arch" type="xml">
            <tree string="Meetings">
                <field name="meeting_number"/>
                <field name="buyer_id"/>
                <field name="meeting_type"/>
                <field name="date_start"/>
                <field name="duration" widget="float_time"/>
                <field name="organizer_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_crm_meeting_calendar" model="ir.ui.view">
        <field name="name">garment.crm.meeting.calendar</field>
        <field name="model">garment.crm.meeting</field>
        <field name="arch" type="xml">
            <calendar string="Meetings" date_start="date_start" date_stop="date_end" color="meeting_type"
                      event_open_popup="true">
                <field name="buyer_id"/>
                <field name="meeting_type"/>
            </calendar>
        </field>
    </record>

    <record id="view_garment_crm_meeting_form" model="ir.ui.view">
        <field name="name">garment.crm.meeting.form</field>
        <field name="model">garment.crm.meeting</field>
        <field name="arch" type="xml">
            <form string="Meeting">
                <header>
                    <button name="action_mark_completed" type="object" string="Mark Completed" class="btn-primary"
                            invisible="state != 'planned'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"
                            invisible="state != 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="meeting_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="buyer_contact_ids" widget="many2many_tags"/>
                            <field name="internal_participant_ids" widget="many2many_tags"/>
                            <field name="meeting_type"/>
                            <field name="related_opportunity_id"/>
                        </group>
                        <group>
                            <field name="venue"/>
                            <field name="online_meeting_link" widget="url"/>
                            <field name="date_start"/>
                            <field name="duration" widget="float_time"/>
                            <field name="date_end" readonly="1"/>
                            <field name="follow_up_date"/>
                            <field name="organizer_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agenda &amp; Discussion">
                            <group>
                                <field name="agenda"/>
                                <field name="discussion"/>
                                <field name="decisions"/>
                                <field name="action_items"/>
                            </group>
                        </page>
                        <page string="Minutes of Meeting">
                            <field name="minutes_of_meeting" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_crm_meeting_search" model="ir.ui.view">
        <field name="name">garment.crm.meeting.search</field>
        <field name="model">garment.crm.meeting</field>
        <field name="arch" type="xml">
            <search string="Search Meetings">
                <field name="meeting_number"/>
                <field name="buyer_id"/>
                <filter string="Planned" name="filter_planned" domain="[('state', '=', 'planned')]"/>
                <group expand="0" string="Group By">
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Meeting Type" name="group_type" context="{'group_by': 'meeting_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_crm_meeting" model="ir.actions.act_window">
        <field name="name">Meetings</field>
        <field name="res_model">garment.crm.meeting</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule your first buyer meeting.</p>
        </field>
    </record>

</odoo>
