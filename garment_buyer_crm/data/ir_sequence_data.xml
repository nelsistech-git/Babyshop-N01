<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_buyer" model="ir.sequence">
        <field name="name">Garment Buyer Code</field>
        <field name="code">garment.buyer</field>
        <field name="prefix">BUY/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

