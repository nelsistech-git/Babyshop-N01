<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- WhatsApp Automation templates (SRS Buyer CRM section 25) -->
    <record id="whatsapp_tpl_rfq_received" model="garment.whatsapp.template">
        <field name="name">RFQ Received</field>
        <field name="sequence">10</field>
        <field name="trigger_event">rfq_received</field>
        <field name="message_body">Hello ${object.buyer_id.name}, we have received your RFQ ${object.rfq_number}. Our team will get back to you shortly.</field>
    </record>
    <record id="whatsapp_tpl_quotation_ready" model="garment.whatsapp.template">
        <field name="name">Quotation Ready</field>
        <field name="sequence">20</field>
        <field name="trigger_event">quotation_ready</field>
        <field name="message_body">Hello ${object.buyer_id.name}, your quotation for RFQ ${object.rfq_number} is ready. Please check your email/portal.</field>
    </record>
    <record id="whatsapp_tpl_sample_shipped" model="garment.whatsapp.template">
        <field name="name">Sample Shipped</field>
        <field name="sequence">30</field>
        <field name="trigger_event">sample_shipped</field>
        <field name="message_body">Hello, your sample has been shipped. Tracking details will follow shortly.</field>
    </record>
    <record id="whatsapp_tpl_production_started" model="garment.whatsapp.template">
        <field name="name">Production Started</field>
        <field name="sequence">40</field>
        <field name="trigger_event">production_started</field>
        <field name="message_body">Hello ${object.buyer_id.name}, production has started on your order. We will keep you updated.</field>
    </record>
    <record id="whatsapp_tpl_production_completed" model="garment.whatsapp.template">
        <field name="name">Production Completed</field>
        <field name="sequence">50</field>
        <field name="trigger_event">production_completed</field>
        <field name="message_body">Hello ${object.buyer_id.name}, production is complete and the order is ready for shipment.</field>
    </record>
    <record id="whatsapp_tpl_shipment_booked" model="garment.whatsapp.template">
        <field name="name">Shipment Booked</field>
        <field name="sequence">60</field>
        <field name="trigger_event">shipment_booked</field>
        <field name="message_body">Hello ${object.buyer_id.name}, shipment has been booked for your order. Details to follow.</field>
    </record>
    <record id="whatsapp_tpl_invoice_generated" model="garment.whatsapp.template">
        <field name="name">Invoice Generated</field>
        <field name="sequence">70</field>
        <field name="trigger_event">invoice_generated</field>
        <field name="message_body">Hello ${object.buyer_id.name}, an invoice has been generated for your order. Please check your email.</field>
    </record>
    <record id="whatsapp_tpl_payment_due" model="garment.whatsapp.template">
        <field name="name">Payment Due Reminder</field>
        <field name="sequence">80</field>
        <field name="trigger_event">payment_due</field>
        <field name="message_body">Hello ${object.buyer_id.name}, a payment is due on your account. Kindly arrange payment at your earliest convenience.</field>
    </record>
    <record id="whatsapp_tpl_birthday" model="garment.whatsapp.template">
        <field name="name">Birthday Greeting</field>
        <field name="sequence">90</field>
        <field name="trigger_event">birthday_greeting</field>
        <field name="message_body">Happy Birthday! Wishing you a wonderful year ahead from all of us.</field>
    </record>
    <record id="whatsapp_tpl_holiday" model="garment.whatsapp.template">
        <field name="name">Holiday Greeting</field>
        <field name="sequence">100</field>
        <field name="trigger_event">holiday_greeting</field>
        <field name="message_body">Warm wishes from our entire team this holiday season.</field>
    </record>
</odoo>
