<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Automation Rules (SRS Buyer CRM section 40) -->

    <record id="ir_cron_garment_crm_score_leads_nightly" model="ir.cron">
        <field name="name">Buyer CRM: Calculate AI Lead Scores Nightly</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="state">code</field>
        <field name="code">model._cron_score_all_active_leads()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

