<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Predefined Buyer CRM email templates (SRS Buyer CRM section 24) -->
    <record id="mail_template_buyer_introduction" model="mail.template">
        <field name="name">Buyer CRM: Introduction</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Introducing {{ object.env.company.name }}</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Thank you for your interest. We would like to introduce our company and product range.</p>
        </field>
    </record>
    <record id="mail_template_buyer_rfq_ack" model="mail.template">
        <field name="name">Buyer CRM: RFQ Acknowledgement</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">We have received your RFQ</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>We confirm receipt of your RFQ and will respond with costing/quotation shortly.</p>
        </field>
    </record>
    <record id="mail_template_buyer_quotation_submission" model="mail.template">
        <field name="name">Buyer CRM: Quotation Submission</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Your Quotation is Ready</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Please find attached our quotation for your review.</p>
        </field>
    </record>
    <record id="mail_template_buyer_sample_dispatch" model="mail.template">
        <field name="name">Buyer CRM: Sample Dispatch</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Sample Dispatched</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Your sample has been dispatched. Tracking details will follow.</p>
        </field>
    </record>
    <record id="mail_template_buyer_production_update" model="mail.template">
        <field name="name">Buyer CRM: Production Update</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Production Update</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Here is the latest production status update for your order.</p>
        </field>
    </record>
    <record id="mail_template_buyer_shipment_notice" model="mail.template">
        <field name="name">Buyer CRM: Shipment Notice</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Shipment Notice</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Your shipment has been booked/dispatched. Please find shipment details attached.</p>
        </field>
    </record>
    <record id="mail_template_buyer_payment_reminder" model="mail.template">
        <field name="name">Buyer CRM: Payment Reminder</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Payment Reminder</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>This is a friendly reminder regarding an outstanding payment on your account.</p>
        </field>
    </record>
    <record id="mail_template_buyer_holiday_greetings" model="mail.template">
        <field name="name">Buyer CRM: Holiday Greetings</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Season's Greetings</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Warm wishes from all of us this holiday season.</p>
        </field>
    </record>
    <record id="mail_template_buyer_birthday_wishes" model="mail.template">
        <field name="name">Buyer CRM: Birthday Wishes</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Happy Birthday!</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Wishing you a very Happy Birthday from our entire team.</p>
        </field>
    </record>
    <record id="mail_template_buyer_compliance_doc_request" model="mail.template">
        <field name="name">Buyer CRM: Compliance Document Request</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Compliance Document Request</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Could you kindly share the requested compliance certificate(s) at your earliest convenience?</p>
        </field>
    </record>
    <record id="mail_template_buyer_complaint_response" model="mail.template">
        <field name="name">Buyer CRM: Complaint Response</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Regarding Your Complaint</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Thank you for bringing this to our attention. Please find our response and corrective action below.</p>
        </field>
    </record>
    <record id="mail_template_buyer_thank_you" model="mail.template">
        <field name="name">Buyer CRM: Thank You Message</field>
        <field name="model_id" ref="model_garment_buyer"/>
        <field name="subject">Thank You</field>
        <field name="body_html" type="html">
            <p>Dear {{ object.name }},</p>
            <p>Thank you for your continued business and partnership.</p>
        </field>
    </record>
</odoo>
