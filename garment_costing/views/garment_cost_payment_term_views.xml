<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_cost_payment_term_tree" model="ir.ui.view">
        <field name="name">garment.cost.payment.term.tree</field>
        <field name="model">garment.cost.payment.term</field>
        <field name="arch" type="xml">
            <tree string="Payment Terms" editable="bottom">
                <field name="costing_id"/>
                <field name="payment_type"/>
                <field name="payment_percentage"/>
                <field name="due_date"/>
                <field name="bank_requirement"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_cost_payment_term" model="ir.actions.act_window">
        <field name="name">Payment Terms</field>
        <field name="res_model">garment.cost.payment.term</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
