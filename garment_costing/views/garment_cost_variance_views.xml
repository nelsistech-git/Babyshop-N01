<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_cost_variance_tree" model="ir.ui.view">
        <field name="name">garment.cost.variance.tree</field>
        <field name="model">garment.cost.variance</field>
        <field name="arch" type="xml">
            <tree string="Cost Variances" editable="bottom" decoration-danger="variance_pct &gt; 10" decoration-success="variance_pct &lt;= 0">
                <field name="costing_id"/>
                <field name="variance_type"/>
                <field name="cause"/>
                <field name="estimated_cost"/>
                <field name="actual_cost"/>
                <field name="variance_amount"/>
                <field name="variance_pct"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_cost_variance" model="ir.actions.act_window">
        <field name="name">Cost Variances</field>
        <field name="res_model">garment.cost.variance</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
