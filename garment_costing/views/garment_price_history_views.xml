<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_price_history_tree" model="ir.ui.view">
        <field name="name">garment.price.history.tree</field>
        <field name="model">garment.price.history</field>
        <field name="arch" type="xml">
            <tree string="Supplier Price History" editable="bottom" decoration-success="is_recommended == True">
                <field name="costing_id"/>
                <field name="material_reference"/>
                <field name="supplier_id"/>
                <field name="previous_price"/>
                <field name="current_price"/>
                <field name="quality_rating"/>
                <field name="delivery_rating"/>
                <field name="compliance_ok"/>
                <field name="is_recommended"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_price_history" model="ir.actions.act_window">
        <field name="name">Supplier Price History</field>
        <field name="res_model">garment.price.history</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
