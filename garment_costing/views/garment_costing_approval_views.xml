<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_costing_approval_tree" model="ir.ui.view">
        <field name="name">garment.costing.approval.tree</field>
        <field name="model">garment.costing.approval</field>
        <field name="arch" type="xml">
            <tree string="Costing Approvals" editable="bottom" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'">
                <field name="costing_id"/>
                <field name="approval_level"/>
                <field name="approver_id"/>
                <field name="status"/>
                <field name="approval_date"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_costing_approval" model="ir.actions.act_window">
        <field name="name">Costing Approvals</field>
        <field name="res_model">garment.costing.approval</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
