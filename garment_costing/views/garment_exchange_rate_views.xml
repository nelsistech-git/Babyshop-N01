<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_exchange_rate_tree" model="ir.ui.view">
        <field name="name">garment.exchange.rate.tree</field>
        <field name="model">garment.exchange.rate</field>
        <field name="arch" type="xml">
            <tree string="Exchange Rates" editable="bottom">
                <field name="currency_id"/>
                <field name="target_currency_id"/>
                <field name="rate"/>
                <field name="effective_date"/>
                <field name="source"/>
                <field name="approved_by_id"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_exchange_rate" model="ir.actions.act_window">
        <field name="name">Exchange Rates</field>
        <field name="res_model">garment.exchange.rate</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
