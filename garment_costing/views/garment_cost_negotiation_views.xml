<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_cost_negotiation_tree" model="ir.ui.view">
        <field name="name">garment.cost.negotiation.tree</field>
        <field name="model">garment.cost.negotiation</field>
        <field name="arch" type="xml">
            <tree string="Buyer Negotiations" editable="bottom" decoration-success="approval_status == 'approved'" decoration-danger="approval_status == 'rejected'">
                <field name="costing_id"/>
                <field name="negotiation_date"/>
                <field name="submitted_price"/>
                <field name="buyer_target_price"/>
                <field name="negotiated_price"/>
                <field name="final_price"/>
                <field name="approval_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_cost_negotiation_form" model="ir.ui.view">
        <field name="name">garment.cost.negotiation.form</field>
        <field name="model">garment.cost.negotiation</field>
        <field name="arch" type="xml">
            <form string="Buyer Negotiation">
                <header>
                    <field name="approval_status" widget="statusbar"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="approval_status == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary"
                            invisible="approval_status == 'rejected'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="costing_id"/>
                            <field name="negotiation_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="submitted_price"/>
                            <field name="buyer_target_price"/>
                            <field name="negotiated_price"/>
                            <field name="final_price"/>
                        </group>
                    </group>
                    <group string="Negotiation Notes">
                        <field name="negotiation_notes" nolabel="1"/>
                    </group>
                    <group>
                        <field name="approved_by_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_cost_negotiation" model="ir.actions.act_window">
        <field name="name">Buyer Negotiations</field>
        <field name="res_model">garment.cost.negotiation</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
