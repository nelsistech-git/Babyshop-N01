<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_asset_form" model="ir.ui.view">
        <field name="name">garment.asset.form</field>
        <field name="model">garment.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,installed,active,under_maintenance,disposed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_workorders" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="workorder_count" widget="statinfo" string="Work Orders"/>
                        </button>
                        <button name="action_view_plans" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="plan_count" widget="statinfo" string="PM Plans"/>
                        </button>
                        <button name="action_view_calibrations" type="object" class="oe_stat_button" icon="fa-thermometer-half">
                            <field name="calibration_count" widget="statinfo" string="Calibrations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Warranty Expiring" bg_color="text-bg-warning"
                            invisible="warranty_expiring_soon == False"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h3><field name="asset_code" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="brand"/>
                            <field name="model_reference"/>
                            <field name="serial_number"/>
                            <field name="supplier_id"/>
                        </group>
                        <group>
                            <field name="factory"/>
                            <field name="floor"/>
                            <field name="department_id"/>
                            <field name="line_position"/>
                            <field name="responsible_technician_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purchase &amp; Value">
                            <group>
                                <group>
                                    <field name="purchase_date"/>
                                    <field name="installation_date"/>
                                    <field name="purchase_value"/>
                                    <field name="currency_id" groups="base.group_multi_currency"/>
                                </group>
                                <group>
                                    <field name="current_value"/>
                                    <field name="maintenance_cost_total" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Technical Specification">
                            <group>
                                <group>
                                    <field name="motor_power"/>
                                    <field name="voltage"/>
                                    <field name="capacity"/>
                                    <field name="speed"/>
                                </group>
                                <group>
                                    <field name="manual_document" filename="manual_filename"/>
                                    <field name="manual_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Warranty">
                            <group>
                                <group>
                                    <field name="warranty_start_date"/>
                                    <field name="warranty_end_date"/>
                                    <field name="warranty_expiring_soon" readonly="1"/>
                                </group>
                                <group>
                                    <field name="warranty_terms"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_asset_tree" model="ir.ui.view">
        <field name="name">garment.asset.tree</field>
        <field name="model">garment.asset</field>
        <field name="arch" type="xml">
            <tree string="Assets" decoration-danger="state == 'breakdown'" decoration-warning="warranty_expiring_soon == True">
                <field name="asset_code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="factory"/>
                <field name="department_id"/>
                <field name="purchase_value" sum="Total Value"/>
                <field name="state" widget="badge"/>
                <field name="warranty_expiring_soon" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_asset_search" model="ir.ui.view">
        <field name="name">garment.asset.search</field>
        <field name="model">garment.asset</field>
        <field name="arch" type="xml">
            <search string="Search Assets">
                <field name="asset_code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="serial_number"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Under Maintenance" name="filter_maintenance" domain="[('state', '=', 'under_maintenance')]"/>
                <filter string="Breakdown" name="filter_breakdown" domain="[('state', '=', 'breakdown')]"/>
                <filter string="Warranty Expiring Soon" name="filter_warranty" domain="[('warranty_expiring_soon', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">garment.asset</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first non-production asset (generator, boiler, vehicle...).</p>
        </field>
    </record>

</odoo>
