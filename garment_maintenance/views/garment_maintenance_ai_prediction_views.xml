<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_maintenance_ai_prediction_form" model="ir.ui.view">
        <field name="name">garment.maintenance.ai.prediction.form</field>
        <field name="model">garment.maintenance.ai.prediction</field>
        <field name="arch" type="xml">
            <form string="AI Predictive Insight">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="new,reviewed,action_taken"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="prediction_type"/>
                            <field name="equipment_type" invisible="prediction_type == 'spare_forecast'"/>
                            <field name="machine_id" invisible="prediction_type == 'spare_forecast' or equipment_type != 'machine'"/>
                            <field name="asset_id" invisible="prediction_type == 'spare_forecast' or equipment_type != 'asset'"/>
                            <field name="material_id" invisible="prediction_type != 'spare_forecast'"/>
                        </group>
                        <group>
                            <field name="risk_level" invisible="prediction_type == 'spare_forecast'"/>
                            <field name="probability_pct" invisible="prediction_type == 'spare_forecast'"/>
                            <field name="predicted_demand_qty" invisible="prediction_type != 'spare_forecast'"/>
                            <field name="analysis_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="predicted_issue"/>
                        <field name="recommendation"/>
                        <field name="recommended_date"/>
                        <field name="workorder_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_maintenance_ai_prediction_tree" model="ir.ui.view">
        <field name="name">garment.maintenance.ai.prediction.tree</field>
        <field name="model">garment.maintenance.ai.prediction</field>
        <field name="arch" type="xml">
            <tree string="AI Predictive Insights" decoration-danger="risk_level == 'high'" decoration-warning="risk_level == 'medium'">
                <field name="name"/>
                <field name="prediction_type"/>
                <field name="machine_id"/>
                <field name="asset_id"/>
                <field name="material_id"/>
                <field name="risk_level"/>
                <field name="predicted_issue"/>
                <field name="analysis_date"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_maintenance_ai_prediction_search" model="ir.ui.view">
        <field name="name">garment.maintenance.ai.prediction.search</field>
        <field name="model">garment.maintenance.ai.prediction</field>
        <field name="arch" type="xml">
            <search string="Search AI Predictions">
                <field name="name"/>
                <field name="machine_id"/>
                <field name="material_id"/>
                <filter string="High Risk" name="filter_high_risk" domain="[('risk_level', '=', 'high')]"/>
                <filter string="New" name="filter_new" domain="[('status', '=', 'new')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'prediction_type'}"/>
                    <filter string="Risk Level" name="group_risk" context="{'group_by': 'risk_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_maintenance_ai_prediction" model="ir.actions.act_window">
        <field name="name">AI Predictive Maintenance</field>
        <field name="res_model">garment.maintenance.ai.prediction</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI predictive insights logged yet.</p>
        </field>
    </record>

</odoo>
