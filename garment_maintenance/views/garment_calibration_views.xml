<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_calibration_form" model="ir.ui.view">
        <field name="name">garment.calibration.form</field>
        <field name="model">garment.calibration</field>
        <field name="arch" type="xml">
            <form string="Calibration Record">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="result != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"
                            invisible="result != 'pending'"/>
                    <field name="result" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <!-- FIXED: Added hidden fields so the 'invisible' modifiers can evaluate them -->
                    <field name="is_overdue" invisible="1"/>
                    <field name="is_due_soon" invisible="1"/>

                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="is_overdue == False"/>
                    <widget name="web_ribbon" title="Due Soon" bg_color="text-bg-warning"
                            invisible="is_overdue == True or is_due_soon == False"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_type"/>
                            <field name="machine_id" invisible="equipment_type != 'machine'"/>
                            <field name="asset_id" invisible="equipment_type != 'asset'"/>
                            <field name="standard"/>
                            <field name="service_provider_id"/>
                        </group>
                        <group>
                            <field name="calibration_date"/>
                            <field name="validity_period_months"/>
                            <field name="next_due_date"/>
                        </group>
                    </group>
                    <group string="Certificate">
                        <group>
                            <field name="certificate_number"/>
                            <field name="certificate_file" filename="certificate_filename"/>
                            <field name="certificate_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="workorder_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_calibration_tree" model="ir.ui.view">
        <field name="name">garment.calibration.tree</field>
        <field name="model">garment.calibration</field>
        <field name="arch" type="xml">
            <tree string="Calibration Records" decoration-danger="is_overdue == True" decoration-warning="is_due_soon == True">
                <field name="name"/>
                <field name="equipment_name"/>
                <field name="service_provider_id"/>
                <field name="calibration_date"/>
                <field name="next_due_date"/>
                <field name="result" widget="badge"/>
                <field name="is_overdue" invisible="1"/>
                <field name="is_due_soon" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_calibration_search" model="ir.ui.view">
        <field name="name">garment.calibration.search</field>
        <field name="model">garment.calibration</field>
        <field name="arch" type="xml">
            <search string="Search Calibration Records">
                <field name="name"/>
                <field name="equipment_name"/>
                <field name="service_provider_id"/>
                <filter string="Overdue" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Due Soon" name="filter_due_soon" domain="[('is_due_soon', '=', True)]"/>
                <filter string="Approved" name="filter_approved" domain="[('result', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Result" name="group_result" context="{'group_by': 'result'}"/>
                    <filter string="Service Provider" name="group_provider" context="{'group_by': 'service_provider_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_calibration" model="ir.actions.act_window">
        <field name="name">Calibration Records</field>
        <field name="res_model">garment.calibration</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first equipment calibration.</p>
        </field>
    </record>

</odoo>