<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_maintenance_kpi_form" model="ir.ui.view">
        <field name="name">garment.maintenance.kpi.form</field>
        <field name="model">garment.maintenance.kpi</field>
        <field name="arch" type="xml">
            <form string="Maintenance KPI Snapshot">
                <header>
                    <button name="action_recompute" type="object" string="Recompute" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_type"/>
                            <field name="machine_id" invisible="equipment_type != 'machine'"/>
                            <field name="asset_id" invisible="equipment_type != 'asset'"/>
                            <field name="period_date"/>
                            <field name="planned_hours"/>
                        </group>
                        <group>
                            <field name="breakdown_count" readonly="1"/>
                            <field name="total_downtime_hours" readonly="1"/>
                            <field name="mtbf_hours" readonly="1"/>
                            <field name="mttr_hours" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="availability_pct" readonly="1"/>
                            <field name="breakdown_rate_pct" readonly="1"/>
                        </group>
                        <group>
                            <field name="pm_due_count" readonly="1"/>
                            <field name="pm_completed_count" readonly="1"/>
                            <field name="pm_compliance_pct" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="maintenance_cost" readonly="1"/>
                        <field name="currency_id" groups="base.group_multi_currency"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_maintenance_kpi_tree" model="ir.ui.view">
        <field name="name">garment.maintenance.kpi.tree</field>
        <field name="model">garment.maintenance.kpi</field>
        <field name="arch" type="xml">
            <tree string="Maintenance KPI Snapshots">
                <field name="equipment_name"/>
                <field name="period_date"/>
                <field name="availability_pct"/>
                <field name="mtbf_hours"/>
                <field name="mttr_hours"/>
                <field name="breakdown_rate_pct"/>
                <field name="pm_compliance_pct"/>
                <field name="maintenance_cost" sum="Total Cost"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_maintenance_kpi_search" model="ir.ui.view">
        <field name="name">garment.maintenance.kpi.search</field>
        <field name="model">garment.maintenance.kpi</field>
        <field name="arch" type="xml">
            <search string="Search KPI Snapshots">
                <field name="equipment_name"/>
                <group expand="0" string="Group By">
                    <filter string="Equipment" name="group_equipment" context="{'group_by': 'equipment_name'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'period_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_garment_maintenance_kpi_pivot" model="ir.ui.view">
        <field name="name">garment.maintenance.kpi.pivot</field>
        <field name="model">garment.maintenance.kpi</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance KPI Analysis">
                <field name="equipment_name" type="row"/>
                <field name="period_date" type="col" interval="month"/>
                <field name="availability_pct" type="measure"/>
                <field name="mtbf_hours" type="measure"/>
                <field name="mttr_hours" type="measure"/>
                <field name="pm_compliance_pct" type="measure"/>
                <field name="maintenance_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_garment_maintenance_kpi_graph" model="ir.ui.view">
        <field name="name">garment.maintenance.kpi.graph</field>
        <field name="model">garment.maintenance.kpi</field>
        <field name="arch" type="xml">
            <graph string="Availability Trend" type="line">
                <field name="period_date" type="row" interval="month"/>
                <field name="availability_pct" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_garment_maintenance_kpi" model="ir.actions.act_window">
        <field name="name">Maintenance KPIs (MTTR / MTBF)</field>
        <field name="res_model">garment.maintenance.kpi</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a KPI snapshot for a machine or asset and period.</p>
        </field>
    </record>

</odoo>
