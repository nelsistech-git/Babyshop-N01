<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_maintenance_workorder_form" model="ir.ui.view">
        <field name="name">garment.maintenance.workorder.form</field>
        <field name="model">garment.maintenance.workorder</field>
        <field name="arch" type="xml">
            <form string="Maintenance Work Order">
                <header>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start Repair" class="btn-primary"
                            invisible="state != 'assigned'"/>
                    <button name="action_submit_for_approval" type="object" string="Submit for Testing/Approval" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_approve" type="object" string="Approve Cost" class="btn-primary"
                            invisible="state != 'testing' or approval_status != 'pending'"
                            groups="garment_maintenance.group_maintenance_manager"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"
                            invisible="state != 'testing' or approval_status != 'pending'"
                            groups="garment_maintenance.group_maintenance_manager"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary"
                            invisible="state != 'testing'"/>
                    <button name="action_close" type="object" string="Close" class="btn-secondary"
                            invisible="state != 'completed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed', 'closed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,in_progress,testing,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_downtime" type="object" class="oe_stat_button" icon="fa-clock-o"
                                invisible="not downtime_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Downtime</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="wo_type"/>
                            <field name="equipment_type"/>
                            <field name="machine_id" invisible="equipment_type != 'machine'"
                                   required="equipment_type == 'machine'"/>
                            <field name="asset_id" invisible="equipment_type != 'asset'"
                                   required="equipment_type == 'asset'"/>
                            <field name="downtime_id" invisible="wo_type != 'breakdown' or equipment_type != 'machine'"/>
                            <field name="plan_id" invisible="wo_type != 'preventive'" readonly="1"/>
                            <field name="contract_id" invisible="wo_type != 'amc'"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="response_due_datetime" readonly="1"/>
                            <field name="reported_by_id"/>
                            <field name="reported_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="problem_description"/>
                    </group>
                    <group>
                        <group>
                            <field name="engineer_id"/>
                            <field name="technician_id"/>
                            <field name="checklist_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="downtime_hours" readonly="1"/>
                            <field name="production_loss_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="checklist_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="check_item"/>
                                    <field name="result"/>
                                    <field name="remark"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Spare Parts Used">
                            <field name="spare_line_ids">
                                <tree editable="bottom">
                                    <field name="material_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="issue_date"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Testing &amp; Resolution">
                            <group>
                                <group>
                                    <field name="test_result"/>
                                </group>
                            </group>
                            <field name="action_taken" nolabel="1" placeholder="Root cause / action taken..."/>
                        </page>
                        <page string="Cost">
                            <group>
                                <group>
                                    <field name="labor_hours"/>
                                    <field name="labor_rate"/>
                                    <field name="labor_cost" readonly="1"/>
                                    <field name="spare_cost" readonly="1"/>
                                </group>
                                <group>
                                    <field name="external_provider_id" invisible="wo_type not in ('amc',)"/>
                                    <field name="external_service_cost"/>
                                    <field name="total_cost" readonly="1"/>
                                    <field name="currency_id" groups="base.group_multi_currency"/>
                                </group>
                            </group>
                        </page>
                        <page string="Approval">
                            <group>
                                <group>
                                    <field name="cost_estimate"/>
                                    <field name="approval_status" readonly="1"/>
                                </group>
                                <group>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approval_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_maintenance_workorder_tree" model="ir.ui.view">
        <field name="name">garment.maintenance.workorder.tree</field>
        <field name="model">garment.maintenance.workorder</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Work Orders"
                  decoration-danger="priority == 'critical' and state not in ('completed', 'closed', 'cancelled')"
                  decoration-warning="priority == 'high' and state not in ('completed', 'closed', 'cancelled')"
                  decoration-success="state in ('completed', 'closed')"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="wo_type"/>
                <field name="equipment_name"/>
                <field name="priority" widget="badge"/>
                <field name="technician_id"/>
                <field name="reported_date"/>
                <field name="downtime_hours" sum="Total Downtime"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_maintenance_workorder_kanban" model="ir.ui.view">
        <field name="name">garment.maintenance.workorder.kanban</field>
        <field name="model">garment.maintenance.workorder</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="priority"/>
                <field name="equipment_name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div><field name="equipment_name"/></div>
                            <div class="text-muted">Priority: <field name="priority"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_garment_maintenance_workorder_search" model="ir.ui.view">
        <field name="name">garment.maintenance.workorder.search</field>
        <field name="model">garment.maintenance.workorder</field>
        <field name="arch" type="xml">
            <search string="Search Work Orders">
                <field name="name"/>
                <field name="equipment_name"/>
                <field name="technician_id"/>
                <field name="machine_id"/>
                <field name="asset_id"/>
                <field name="plan_id"/>
                <filter string="My Work Orders" name="filter_my"
                        domain="[('technician_id.user_id', '=', uid)]"/>
                <filter string="Breakdown" name="filter_breakdown" domain="[('wo_type', '=', 'breakdown')]"/>
                <filter string="Preventive" name="filter_preventive" domain="[('wo_type', '=', 'preventive')]"/>
                <filter string="Calibration" name="filter_calibration" domain="[('wo_type', '=', 'calibration')]"/>
                <separator/>
                <filter string="Open" name="filter_open" domain="[('state', 'not in', ('completed', 'closed', 'cancelled'))]"/>
                <filter string="Pending Approval" name="filter_pending_approval" domain="[('approval_status', '=', 'pending')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', 'in', ('completed', 'closed'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'wo_type'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Technician" name="group_technician" context="{'group_by': 'technician_id'}"/>
                    <filter string="Equipment" name="group_equipment" context="{'group_by': 'equipment_name'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'reported_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_garment_maintenance_workorder_pivot" model="ir.ui.view">
        <field name="name">garment.maintenance.workorder.pivot</field>
        <field name="model">garment.maintenance.workorder</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Cost Analysis">
                <field name="equipment_name" type="row"/>
                <field name="wo_type" type="col"/>
                <field name="labor_cost" type="measure"/>
                <field name="spare_cost" type="measure"/>
                <field name="external_service_cost" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="downtime_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_garment_maintenance_workorder_graph" model="ir.ui.view">
        <field name="name">garment.maintenance.workorder.graph</field>
        <field name="model">garment.maintenance.workorder</field>
        <field name="arch" type="xml">
            <graph string="Maintenance Cost Trend" type="bar">
                <field name="reported_date" type="row" interval="month"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_garment_maintenance_workorder" model="ir.actions.act_window">
        <field name="name">Maintenance Work Orders</field>
        <field name="res_model">garment.maintenance.workorder</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first maintenance work order.</p>
        </field>
    </record>

    <record id="action_garment_maintenance_workorder_breakdown" model="ir.actions.act_window">
        <field name="name">Breakdown Work Orders</field>
        <field name="res_model">garment.maintenance.workorder</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
        <field name="domain">[('wo_type', '=', 'breakdown')]</field>
        <field name="context">{'default_wo_type': 'breakdown', 'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Report your first machine breakdown.</p>
        </field>
    </record>

    <record id="action_garment_maintenance_workorder_preventive" model="ir.actions.act_window">
        <field name="name">Preventive Work Orders</field>
        <field name="res_model">garment.maintenance.workorder</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
        <field name="domain">[('wo_type', '=', 'preventive')]</field>
        <field name="context">{'default_wo_type': 'preventive', 'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No preventive work orders yet.</p>
        </field>
    </record>

</odoo>
