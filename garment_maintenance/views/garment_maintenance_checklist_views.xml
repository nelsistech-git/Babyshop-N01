<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_maintenance_checklist_form" model="ir.ui.view">
        <field name="name">garment.maintenance.checklist.form</field>
        <field name="model">garment.maintenance.checklist</field>
        <field name="arch" type="xml">
            <form string="Maintenance Checklist">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_type"/>
                            <field name="machine_type" invisible="equipment_type == 'asset'"/>
                        </group>
                        <group>
                            <field name="asset_category" invisible="equipment_type == 'machine'"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist Items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="check_item"/>
                                    <field name="is_mandatory"/>
                                    <field name="instructions"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_maintenance_checklist_tree" model="ir.ui.view">
        <field name="name">garment.maintenance.checklist.tree</field>
        <field name="model">garment.maintenance.checklist</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Checklists">
                <field name="name"/>
                <field name="equipment_type"/>
                <field name="machine_type"/>
                <field name="asset_category"/>
                <field name="line_count"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_maintenance_checklist_search" model="ir.ui.view">
        <field name="name">garment.maintenance.checklist.search</field>
        <field name="model">garment.maintenance.checklist</field>
        <field name="arch" type="xml">
            <search string="Search Checklists">
                <field name="name"/>
                <field name="machine_type"/>
                <group expand="0" string="Group By">
                    <filter string="Equipment Type" name="group_equipment_type" context="{'group_by': 'equipment_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_maintenance_checklist" model="ir.actions.act_window">
        <field name="name">Maintenance Checklists</field>
        <field name="res_model">garment.maintenance.checklist</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first maintenance checklist template.</p>
        </field>
    </record>

</odoo>
