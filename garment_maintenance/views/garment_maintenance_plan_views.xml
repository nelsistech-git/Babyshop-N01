<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_maintenance_plan_form" model="ir.ui.view">
        <field name="name">garment.maintenance.plan.form</field>
        <field name="model">garment.maintenance.plan</field>
        <field name="arch" type="xml">
            <form string="Preventive Maintenance Plan">
                <header>
                    <button name="action_generate_workorder" type="object" string="Generate Work Order" class="btn-primary"
                            invisible="status != 'scheduled'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"
                            invisible="status != 'scheduled'"/>
                    <button name="action_reschedule" type="object" string="Reschedule" class="btn-secondary"
                            invisible="status != 'cancelled'"/>
                    <field name="status" widget="statusbar" statusbar_visible="scheduled,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_workorders" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="workorder_count" widget="statinfo" string="Work Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_type"/>
                            <field name="machine_id" invisible="equipment_type != 'machine'"
                                   required="equipment_type == 'machine'"/>
                            <field name="asset_id" invisible="equipment_type != 'asset'"
                                   required="equipment_type == 'asset'"/>
                            <field name="task_description"/>
                            <field name="checklist_id"/>
                        </group>
                        <group>
                            <field name="maintenance_type"/>
                            <field name="custom_interval_days" invisible="maintenance_type != 'custom'"/>
                            <field name="technician_id"/>
                            <field name="start_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="last_done_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="next_due_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_maintenance_plan_tree" model="ir.ui.view">
        <field name="name">garment.maintenance.plan.tree</field>
        <field name="model">garment.maintenance.plan</field>
        <field name="arch" type="xml">
            <tree string="Preventive Maintenance Plans" decoration-muted="status == 'cancelled'">
                <field name="name"/>
                <field name="equipment_name"/>
                <field name="task_description"/>
                <field name="maintenance_type"/>
                <field name="technician_id"/>
                <field name="next_due_date"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_maintenance_plan_calendar" model="ir.ui.view">
        <field name="name">garment.maintenance.plan.calendar</field>
        <field name="model">garment.maintenance.plan</field>
        <field name="arch" type="xml">
            <!-- FIXED for Odoo 17:
                 1. Added date_stop="next_due_date" (Mandatory in Odoo 17)
                 2. Changed quick_add to quick_create="false" (Odoo 17 syntax)
            -->
            <calendar string="Maintenance Calendar" date_start="next_due_date" date_stop="next_due_date" color="maintenance_type" quick_create="false" mode="month">
                <field name="equipment_name"/>
                <field name="task_description"/>
            </calendar>
        </field>
    </record>

    <record id="view_garment_maintenance_plan_search" model="ir.ui.view">
        <field name="name">garment.maintenance.plan.search</field>
        <field name="model">garment.maintenance.plan</field>
        <field name="arch" type="xml">
            <search string="Search PM Plans">
                <field name="name"/>
                <field name="equipment_name"/>
                <field name="technician_id"/>
                <filter string="Scheduled" name="filter_scheduled" domain="[('status', '=', 'scheduled')]"/>
                <filter string="Overdue" name="filter_overdue"
                        domain="[('status', '=', 'scheduled'), ('next_due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Completed" name="filter_completed" domain="[('status', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Frequency" name="group_frequency" context="{'group_by': 'maintenance_type'}"/>
                    <filter string="Technician" name="group_technician" context="{'group_by': 'technician_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_maintenance_plan" model="ir.actions.act_window">
        <field name="name">Preventive Maintenance Plans</field>
        <field name="res_model">garment.maintenance.plan</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="context">{'search_default_filter_scheduled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first preventive maintenance schedule.</p>
        </field>
    </record>

</odoo>