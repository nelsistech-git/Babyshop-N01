<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_asset" model="ir.sequence">
        <field name="name">Garment Asset Code</field>
        <field name="code">garment.asset</field>
        <field name="prefix">AST/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_maintenance_plan" model="ir.sequence">
        <field name="name">Garment Preventive Maintenance Plan Number</field>
        <field name="code">garment.maintenance.plan</field>
        <field name="prefix">PM/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_maintenance_workorder" model="ir.sequence">
        <field name="name">Garment Maintenance Work Order Number</field>
        <field name="code">garment.maintenance.workorder</field>
        <field name="prefix">MWO/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_maintenance_spare_request" model="ir.sequence">
        <field name="name">Garment Maintenance Spare Parts Request Number</field>
        <field name="code">garment.maintenance.spare.request</field>
        <field name="prefix">SPR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_maintenance_contract" model="ir.sequence">
        <field name="name">Garment Maintenance AMC / Contract Number</field>
        <field name="code">garment.maintenance.contract</field>
        <field name="prefix">AMC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_calibration" model="ir.sequence">
        <field name="name">Garment Calibration Number</field>
        <field name="code">garment.calibration</field>
        <field name="prefix">CAL/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_maintenance_ai_prediction" model="ir.sequence">
        <field name="name">Garment Maintenance AI Prediction Reference</field>
        <field name="code">garment.maintenance.ai.prediction</field>
        <field name="prefix">AIP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
