<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_maintenance" model="ir.module.category">
            <field name="name">Smart Garment ERP - Maintenance &amp; Asset Management</field>
            <field name="sequence">70</field>
        </record>

        <record id="group_maintenance_store_officer" model="res.groups">
            <field name="name">Store Officer (Spare Parts Issue)</field>
            <field name="category_id" ref="module_category_garment_maintenance"/>
        </record>

        <record id="group_maintenance_technician" model="res.groups">
            <field name="name">Technician (Assigned Work Orders Only)</field>
            <field name="category_id" ref="module_category_garment_maintenance"/>
        </record>

        <record id="group_maintenance_engineer" model="res.groups">
            <field name="name">Maintenance Engineer (Inspection &amp; Repair Update)</field>
            <field name="category_id" ref="module_category_garment_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('group_maintenance_technician'))]"/>
        </record>

        <record id="group_maintenance_manager" model="res.groups">
            <field name="name">Maintenance Manager (Work Order, Schedule &amp; Approval)</field>
            <field name="category_id" ref="module_category_garment_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('group_maintenance_engineer')), (4, ref('group_maintenance_store_officer'))]"/>
        </record>

        <record id="group_maintenance_director" model="res.groups">
            <field name="name">Maintenance Director (Full Access + Configuration)</field>
            <field name="category_id" ref="module_category_garment_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('group_maintenance_manager'))]"/>
        </record>

        <record id="group_maintenance_finance_view" model="res.groups">
            <field name="name">Finance (Cost View Only)</field>
            <field name="category_id" ref="module_category_garment_maintenance"/>
        </record>

    </data>
</odoo>
