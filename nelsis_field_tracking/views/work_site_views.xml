<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nelsis_work_site_tree" model="ir.ui.view">
        <field name="name">nelsis.work.site.tree</field>
        <field name="model">nelsis.work.site</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/><field name="address"/>
                <field name="latitude"/><field name="longitude"/><field name="radius_m"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    <record id="nelsis_work_site_form" model="ir.ui.view">
        <field name="name">nelsis.work.site.form</field>
        <field name="model">nelsis.work.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/><field name="address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="latitude"/><field name="longitude"/><field name="radius_m"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Employees" name="emps">
                            <field name="employee_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="nelsis_work_site_action" model="ir.actions.act_window">
        <field name="name">Work Sites (Geofence)</field>
        <field name="res_model">nelsis.work.site</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
