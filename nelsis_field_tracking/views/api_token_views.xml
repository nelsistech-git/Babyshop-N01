<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nelsis_api_token_tree" model="ir.ui.view">
        <field name="name">nelsis.api.token.tree</field>
        <field name="model">nelsis.api.token</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" decoration-muted="revoked">
                <field name="user_id"/><field name="device_name"/><field name="platform"/>
                <field name="app_version"/><field name="last_ip"/><field name="last_used"/>
                <field name="expires_at"/><field name="revoked"/>
                <button name="action_revoke" type="object" string="Revoke" icon="fa-ban" invisible="revoked"/>
            </tree>
        </field>
    </record>
    <record id="nelsis_api_token_action" model="ir.actions.act_window">
        <field name="name">App Devices &amp; Sessions</field>
        <field name="res_model">nelsis.api.token</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
