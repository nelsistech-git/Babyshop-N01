<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nelsis" model="ir.module.category">
        <field name="name">Field Force</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_nelsis_user" model="res.groups">
        <field name="name">Employee (mobile app)</field>
        <field name="category_id" ref="module_category_nelsis"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_nelsis_manager" model="res.groups">
        <field name="name">Administrator (map &amp; analysis)</field>
        <field name="category_id" ref="module_category_nelsis"/>
        <field name="implied_ids" eval="[(4, ref('group_nelsis_user')), (4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Own records for employees -->
    <record id="rule_location_log_own" model="ir.rule">
        <field name="name">Location log: own</field>
        <field name="model_id" ref="model_nelsis_location_log"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_nelsis_user'))]"/>
    </record>
    <record id="rule_location_log_all" model="ir.rule">
        <field name="name">Location log: administrator sees all</field>
        <field name="model_id" ref="model_nelsis_location_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_nelsis_manager'))]"/>
    </record>
    <record id="rule_presence_log_own" model="ir.rule">
        <field name="name">Presence log: own</field>
        <field name="model_id" ref="model_nelsis_presence_log"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_nelsis_user'))]"/>
    </record>
    <record id="rule_presence_log_all" model="ir.rule">
        <field name="name">Presence log: administrator sees all</field>
        <field name="model_id" ref="model_nelsis_presence_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_nelsis_manager'))]"/>
    </record>
    <!-- Multi company -->
    <record id="rule_location_log_company" model="ir.rule">
        <field name="name">Location log: multi-company</field>
        <field name="model_id" ref="model_nelsis_location_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_presence_log_company" model="ir.rule">
        <field name="name">Presence log: multi-company</field>
        <field name="model_id" ref="model_nelsis_presence_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_work_site_company" model="ir.rule">
        <field name="name">Work site: multi-company</field>
        <field name="model_id" ref="model_nelsis_work_site"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!-- Announcements: employees only ever read sent ones, administrators everything -->
    <record id="rule_announcement_user" model="ir.rule">
        <field name="name">Announcement: employees read sent only</field>
        <field name="model_id" ref="model_nelsis_announcement"/>
        <field name="domain_force">[('state', '=', 'sent')]</field>
        <field name="groups" eval="[(4, ref('group_nelsis_user'))]"/>
    </record>
    <record id="rule_announcement_all" model="ir.rule">
        <field name="name">Announcement: administrator sees all</field>
        <field name="model_id" ref="model_nelsis_announcement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_nelsis_manager'))]"/>
    </record>
    <record id="rule_announcement_company" model="ir.rule">
        <field name="name">Announcement: multi-company</field>
        <field name="model_id" ref="model_nelsis_announcement"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>