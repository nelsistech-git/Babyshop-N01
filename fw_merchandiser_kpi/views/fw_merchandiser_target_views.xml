<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_merchandiser_target_tree" model="ir.ui.view">
        <field name="name">fw.merchandiser.target.tree</field>
        <field name="model">fw.merchandiser.target</field>
        <field name="arch" type="xml">
            <tree string="Merchandiser Targets" decoration-success="value_achievement_percent &gt;= 100"
                  decoration-warning="value_achievement_percent &gt;= 60 and value_achievement_percent &lt; 100"
                  decoration-danger="value_achievement_percent &lt; 60">
                <field name="merchandiser_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="target_order_value" widget="monetary"/>
                <field name="achieved_order_value" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="value_achievement_percent"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_merchandiser_target_form" model="ir.ui.view">
        <field name="name">fw.merchandiser.target.form</field>
        <field name="model">fw.merchandiser.target</field>
        <field name="arch" type="xml">
            <form string="Merchandiser Target">
                <header>
                    <button name="action_compute_achievement" type="object"
                            string="Compute Achievement" class="btn-primary"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="merchandiser_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="target_order_value"/>
                            <field name="target_order_qty"/>
                        </group>
                    </group>
                    <group string="Achievement (Computed from Confirmed Buyer Orders)">
                        <group>
                            <field name="achieved_order_value" readonly="1"/>
                            <field name="achieved_order_qty" readonly="1"/>
                            <field name="order_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="value_achievement_percent" readonly="1"/>
                            <field name="qty_achievement_percent" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_merchandiser_target_search" model="ir.ui.view">
        <field name="name">fw.merchandiser.target.search</field>
        <field name="model">fw.merchandiser.target</field>
        <field name="arch" type="xml">
            <search string="Search Merchandiser Targets">
                <field name="merchandiser_id"/>
                <group expand="0" string="Group By">
                    <filter string="Merchandiser" name="group_merch" context="{'group_by': 'merchandiser_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_merchandiser_target" model="ir.actions.act_window">
        <field name="name">Merchandiser Targets</field>
        <field name="res_model">fw.merchandiser.target</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_merchandiser_target_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set your first merchandiser target</p>
        </field>
    </record>
</odoo>
