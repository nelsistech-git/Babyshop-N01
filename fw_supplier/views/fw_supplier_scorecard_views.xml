<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_supplier_scorecard_tree" model="ir.ui.view">
        <field name="name">fw.supplier.scorecard.tree</field>
        <field name="model">fw.supplier.scorecard</field>
        <field name="arch" type="xml">
            <tree string="Supplier Scorecards" decoration-danger="grade=='d'"
                  decoration-warning="grade=='c'" decoration-success="grade in ('a','b')">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="quality_score"/>
                <field name="delivery_score"/>
                <field name="overall_score"/>
                <field name="grade" widget="badge"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_supplier_scorecard_form" model="ir.ui.view">
        <field name="name">fw.supplier.scorecard.form</field>
        <field name="model">fw.supplier.scorecard</field>
        <field name="arch" type="xml">
            <form string="Supplier Scorecard">
                <header>
                    <button name="action_compute_scores" type="object"
                            string="Compute Scores from Records" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3>
                            <field name="grade" widget="badge"
                                   decoration-success="grade in ('a','b')"
                                   decoration-warning="grade=='c'"
                                   decoration-danger="grade=='d'"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="supplier_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="quality_weight"/>
                            <field name="delivery_weight"/>
                        </group>
                    </group>
                    <group string="Quality">
                        <group>
                            <field name="grn_count" readonly="1"/>
                            <field name="quality_score" readonly="1"/>
                        </group>
                    </group>
                    <group string="Delivery">
                        <group>
                            <field name="delivery_count" readonly="1"/>
                            <field name="delivery_score" readonly="1"/>
                        </group>
                    </group>
                    <group string="Overall">
                        <field name="overall_score" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_supplier_scorecard_search" model="ir.ui.view">
        <field name="name">fw.supplier.scorecard.search</field>
        <field name="model">fw.supplier.scorecard</field>
        <field name="arch" type="xml">
            <search string="Search Scorecards">
                <field name="name"/>
                <field name="supplier_id"/>
                <group expand="0" string="Group By">
                    <filter string="Supplier" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Grade" name="group_grade" context="{'group_by': 'grade'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_supplier_scorecard" model="ir.actions.act_window">
        <field name="name">Supplier Scorecards</field>
        <field name="res_model">fw.supplier.scorecard</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_supplier_scorecard_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first supplier scorecard</p>
        </field>
    </record>
</odoo>
