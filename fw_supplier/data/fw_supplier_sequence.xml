<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fw_material_grn" model="ir.sequence">
        <field name="name">FW Material GRN</field>
        <field name="code">fw.material.grn</field>
        <field name="prefix">GRN/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_supplier_delivery" model="ir.sequence">
        <field name="name">FW Supplier Delivery</field>
        <field name="code">fw.supplier.delivery</field>
        <field name="prefix">DEL/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_supplier_scorecard" model="ir.sequence">
        <field name="name">FW Supplier Scorecard</field>
        <field name="code">fw.supplier.scorecard</field>
        <field name="prefix">SCR/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
