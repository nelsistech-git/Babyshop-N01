    <!-- =================================================================
         Portal messages (garment.portal.message) — buyer asks about the
         tee order status, factory responds.
         ================================================================= -->

    <record id="portal_message_northwind_tee_status_inquiry" model="garment.portal.message">
        <field name="buyer_id" ref="buyer_northwind"/>
        <field name="partner_id" ref="portal_partner_northwind_merch"/>
        <field name="direction">inbound</field>
        <field name="order_id" ref="order_tee"/>
        <field name="subject">Status update on order NSG-TS-2601 (Men's Crew Neck T-Shirt)</field>
        <field name="body"><![CDATA[<p>Hi team,</p><p>Could you share the latest production status for order
NSG-TS-2601? We need an update for our retail partner meeting this Friday — in particular
whether cutting/sewing is on track for the confirmed ship window.</p><p>Thanks,<br/>Emma</p>]]></field>
        <field name="responsible_department">merchandising</field>
        <field name="assigned_user_id" ref="base.user_admin"/>
        <field name="completion_status">action_taken</field>
        <field name="message_date">2026-06-10 08:15:00</field>
        <field name="is_read" eval="True"/>
    </record>

    <record id="portal_message_northwind_tee_status_response" model="garment.portal.message">
        <field name="buyer_id" ref="buyer_northwind"/>
        <field name="author_user_id" ref="base.user_admin"/>
        <field name="direction">outbound</field>
        <field name="order_id" ref="order_tee"/>
        <field name="parent_id" ref="portal_message_northwind_tee_status_inquiry"/>
        <field name="subject">Re: Status update on order NSG-TS-2601 (Men's Crew Neck T-Shirt)</field>
        <field name="body"><![CDATA[<p>Hi Emma,</p><p>Cutting is complete for both colorways and Sewing Line 1
is running the White colorway at plan efficiency; Navy starts on Line 2 tomorrow. We remain on track
for the confirmed ship window — will send the daily production summary and updated TNA milestones
by end of week.</p><p>Best regards,<br/>Merchandising Team</p>]]></field>
        <field name="responsible_department">merchandising</field>
        <field name="assigned_user_id" ref="base.user_admin"/>
        <field name="completion_status">response_submitted</field>
        <field name="message_date">2026-06-11 14:40:00</field>
