<!--
     Buyer Portal demo data (garment_buyer_portal) — SRS sections 6-7, 13, 16, 21-22, 46.

     One garment.portal.access.request per buyer contact created in 01_buyer_crm_demo.xml,
     already approved (portal access granted). Since demo XML writes final field values
     directly rather than invoking the request's workflow methods (action_approve() also
     creates/writes a res.users via portal.wizard, which is not appropriate for a data
     load), a matching res.partner "portal login" contact is created for each buyer contact
     and linked as `partner_id` on the approved request — mirroring what action_approve()
     would have produced.
-->
<odoo>
<data noupdate="1">

