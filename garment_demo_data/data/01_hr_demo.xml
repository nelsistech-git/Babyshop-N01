    <!-- ================================================================ -->
    <!-- Designations (garment.hr.designation)                            -->
    <!-- ================================================================ -->

    <record id="desig_senior_merchandiser" model="garment.hr.designation">
        <field name="name">Senior Merchandiser</field>
        <field name="grade">M1</field>
        <field name="employee_category">executive</field>
        <field name="is_piece_rate_eligible">False</field>
        <field name="responsibilities">Owns buyer relationship, order costing sign-off and end-to-end order execution for assigned accounts.</field>
    </record>

    <record id="desig_pattern_master" model="garment.hr.designation">
        <field name="name">Pattern Master</field>
        <field name="grade">S1</field>
        <field name="employee_category">staff</field>
        <field name="is_piece_rate_eligible">False</field>
        <field name="responsibilities">Develops and grades patterns, approves markers, and signs off first pattern for sample development.</field>
    </record>

    <record id="desig_qc_inspector" model="garment.hr.designation">
        <field name="name">QC Inspector</field>
        <field name="grade">O1</field>
        <field name="employee_category">officer</field>
        <field name="is_piece_rate_eligible">False</field>
        <field name="responsibilities">Performs in-line and end-line AQL inspections and records defects against the quality standards.</field>
    </record>

    <record id="desig_sewing_operator" model="garment.hr.designation">
        <field name="name">Sewing Machine Operator</field>
        <field name="grade">W1</field>
        <field name="employee_category">worker</field>
        <field name="is_piece_rate_eligible">True</field>
        <field name="responsibilities">Operates single-needle, overlock and flatlock machines on the sewing line per the operation routing.</field>
    </record>

    <record id="desig_line_supervisor" model="garment.hr.designation">
        <field name="name">Line Supervisor</field>
        <field name="grade">S2</field>
        <field name="employee_category">supervisor</field>
        <field name="is_piece_rate_eligible">False</field>
        <field name="responsibilities">Runs the daily line target, balances operators against the routing, and reports line output/OEE.</field>
    </record>

    <record id="desig_ie_officer" model="garment.hr.designation">
        <field name="name">IE Officer</field>
        <field name="grade">O2</field>
        <field name="employee_category">officer</field>
        <field name="is_piece_rate_eligible">False</field>
        <field name="responsibilities">Conducts time and motion studies, sets SMV and line balancing for new styles.</field>
    </record>

    <record id="desig_maintenance_technician" model="garment.hr.designation">
        <field name="name">Maintenance Technician</field>
        <field name="grade">S1</field>
        <field name="employee_category">staff</field>
        <field name="is_piece_rate_eligible">False</field>
        <field name="responsibilities">Executes preventive and breakdown maintenance work orders on sewing and cutting machinery.</field>
    </record>

    <record id="desig_warehouse_keeper" model="garment.hr.designation">
        <field name="name">Warehouse Keeper</field>
        <field name="grade">S1</field>
        <field name="employee_category">staff</field>
        <field name="is_piece_rate_eligible">False</field>
        <field name="responsibilities">Receives GRNs, maintains fabric/trim bin locations and issues materials against production requisitions.</field>
    </record>

    <record id="desig_accountant" model="garment.hr.designation">
        <field name="name">Accountant</field>
        <field name="grade">S1</field>
        <field name="employee_category">staff</field>
        <field name="is_piece_rate_eligible">False</field>
        <field name="responsibilities">Handles LC documentation, supplier payments and cost-center bookkeeping.</field>
    </record>

    <record id="desig_hr_officer" model="garment.hr.designation">
        <field name="name">HR Officer</field>
        <field name="grade">O1</field>
        <field name="employee_category">officer</field>
        <field name="is_piece_rate_eligible">False</field>
        <field name="responsibilities">Manages recruitment, attendance, leave and disciplinary records for the factory floor.</field>
    </record>

