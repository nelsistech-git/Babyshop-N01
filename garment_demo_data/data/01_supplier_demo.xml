        <field name="color_fastness_rating">Grade 4</field>
        <field name="test_report_ref">DK-TR-2026-0122</field>
    </record>

    <record id="supplier_product_brighttrim_wovenlabel" model="garment.supplier.product">
        <field name="supplier_id" ref="supplier_brighttrim"/>
        <field name="sequence">10</field>
        <field name="product_name">Woven Main Label</field>
        <field name="product_category">accessory</field>
        <field name="specification">Damask woven main label, 4-color, folded</field>
        <field name="uom">PCS</field>
        <field name="unit_price">0.018</field>
        <field name="effective_date">2026-01-10</field>
        <field name="validity_date">2026-12-31</field>
        <field name="lead_time_days">10</field>
        <field name="moq">10000</field>
        <field name="material_type">Woven Polyester</field>
        <field name="size_specification">3cm x 5cm folded</field>
        <field name="color_matching_status">matched</field>
        <field name="sample_approval_status">approved</field>
    </record>

    <record id="supplier_product_brighttrim_polybag" model="garment.supplier.product">
        <field name="supplier_id" ref="supplier_brighttrim"/>
        <field name="sequence">20</field>
        <field name="product_name">Printed LDPE Poly Bag</field>
        <field name="product_category">other</field>
        <field name="specification">Printed poly bag with self-adhesive strip, buyer logo</field>
