        <field name="unit_price">0.012</field>
        <field name="effective_date">2026-01-10</field>
        <field name="validity_date">2026-12-31</field>
        <field name="lead_time_days">7</field>
        <field name="moq">20000</field>
        <field name="material_type">LDPE Poly</field>
        <field name="size_specification">30cm x 40cm</field>
        <field name="color_matching_status">matched</field>
        <field name="sample_approval_status">approved</field>
    </record>

    <!-- ================================================================ -->
    <!-- Supplier performance ratings (garment.supplier.rating)           -->
    <!-- ================================================================ -->

    <record id="supplier_rating_deltaknit_2026q1" model="garment.supplier.rating">
        <field name="supplier_id" ref="supplier_deltaknit"/>
        <field name="rating_date">2026-03-15</field>
        <field name="rejection_rate_pct">1.8</field>
        <field name="defect_rate_pct">2.1</field>
        <field name="quality_score">92.0</field>
