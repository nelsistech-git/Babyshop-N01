        <field name="validity_date">2026-12-31</field>
        <field name="lead_time_days">25</field>
        <field name="moq">400</field>
        <field name="fabric_composition">100% Cotton</field>
        <field name="gsm">220</field>
        <field name="width">58 inch tubular</field>
