<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ================================================================ -->
    <!-- Contact partners (res.partner) — also used by garment_warehouse's -->
    <!-- garment.material.supplier_id (Many2one res.partner) so the        -->
    <!-- garment.supplier record and the material master point at the     -->
    <!-- same underlying company contact.                                 -->
    <!-- ================================================================ -->

    <record id="partner_deltaknit" model="res.partner">
        <field name="name">Delta Knit Fabrics Ltd</field>
        <field name="is_company">1</field>
        <field name="supplier_rank">1</field>
        <field name="street">BSCIC Industrial Area</field>
        <field name="city">Narayanganj</field>
        <field name="country_id" ref="base.bd"/>
        <field name="email">sales@deltaknitfabrics.example.com</field>
        <field name="phone">+880 1711-223344</field>
    </record>

    <record id="partner_brighttrim" model="res.partner">
        <field name="name">Bright Trims &amp; Accessories</field>
        <field name="is_company">1</field>
        <field name="supplier_rank">1</field>
        <field name="street">Konabari Industrial Area</field>
        <field name="city">Gazipur</field>
        <field name="country_id" ref="base.bd"/>
        <field name="email">sales@brighttrims.example.com</field>
        <field name="phone">+880 1811-556677</field>
    </record>

    <!-- ================================================================ -->
    <!-- Supplier categories (garment.supplier.category)                  -->
    <!-- ================================================================ -->

    <record id="supplier_category_fabric" model="garment.supplier.category">
        <field name="name">Fabric Mill</field>
        <field name="sequence">10</field>
        <field name="group">material</field>
        <field name="sub_type">fabric</field>
    </record>

    <record id="supplier_category_trim" model="garment.supplier.category">
        <field name="name">Trims &amp; Packaging</field>
        <field name="sequence">20</field>
        <field name="group">material</field>
        <field name="sub_type">trim</field>
    </record>

    <!-- ================================================================ -->
    <!-- Suppliers (garment.supplier)                                     -->
    <!-- ================================================================ -->

    <record id="supplier_deltaknit" model="garment.supplier">
        <field name="name">Delta Knit Fabrics Ltd</field>
        <field name="partner_id" ref="partner_deltaknit"/>
        <field name="supplier_type">material</field>
        <field name="category_id" ref="supplier_category_fabric"/>
        <field name="registration_source">internal</field>
        <field name="classification">strategic</field>
        <field name="country_id" ref="base.bd"/>
        <field name="address">Plot 45, BSCIC Industrial Area, Narayanganj</field>
        <field name="contact_person">Mostafizur Rahman</field>
        <field name="email">sales@deltaknitfabrics.example.bd</field>
        <field name="phone">+880 2-7690123</field>
        <field name="website">https://www.deltaknitfabrics.example</field>
        <field name="tax_id">BIN-004512378-0104</field>
        <field name="registration_number">RJSC-C-98765</field>
        <field name="year_established">2004</field>
        <field name="factory_location">Narayanganj, Bangladesh</field>
        <field name="production_capacity">40 tons/day knit fabric</field>
        <field name="employee_count">650</field>
        <field name="monthly_capacity">1,200,000 kg/month</field>
        <field name="export_experience">18 years, EU/UK/US knit exporters</field>
        <field name="major_customers">Northwind Apparel Sourcing, BalticHaus Fashion, other EU buying houses</field>
        <field name="status">active</field>
        <field name="compliance_status">compliant</field>
        <field name="cert_bsci">True</field>
        <field name="cert_oeko_tex">True</field>
        <field name="cert_iso">True</field>
    </record>

    <record id="supplier_brighttrim" model="garment.supplier">
        <field name="name">Bright Trims &amp; Accessories</field>
        <field name="partner_id" ref="partner_brighttrim"/>
        <field name="supplier_type">material</field>
        <field name="category_id" ref="supplier_category_trim"/>
        <field name="registration_source">internal</field>
        <field name="classification">approved</field>
        <field name="country_id" ref="base.bd"/>
        <field name="address">Plot 12, Konabari BSCIC, Gazipur</field>
        <field name="contact_person">Shahida Yeasmin</field>
        <field name="email">info@brighttrims.example.bd</field>
        <field name="phone">+880 2-9251456</field>
        <field name="website">https://www.brighttrims.example</field>
        <field name="tax_id">BIN-006678211-0107</field>
        <field name="registration_number">RJSC-C-56421</field>
        <field name="year_established">2010</field>
        <field name="factory_location">Gazipur, Bangladesh</field>
        <field name="production_capacity">2,000,000 pcs/month trims &amp; packaging</field>
        <field name="employee_count">210</field>
        <field name="monthly_capacity">2,000,000 pcs/month</field>
        <field name="export_experience">12 years, RMG trims/packaging for EU buying houses</field>
        <field name="major_customers">Northwind Apparel Sourcing, BalticHaus Fashion</field>
        <field name="status">active</field>
        <field name="compliance_status">compliant</field>
        <field name="cert_bsci">True</field>
        <field name="cert_sedex">True</field>
    </record>

    <!-- ================================================================ -->
    <!-- Supplier product catalog (garment.supplier.product)              -->
    <!-- ================================================================ -->

    <record id="supplier_product_deltaknit_singlejersey" model="garment.supplier.product">
        <field name="supplier_id" ref="supplier_deltaknit"/>
        <field name="sequence">10</field>
        <field name="product_name">100% Cotton Single Jersey 180 GSM</field>
        <field name="product_category">fabric</field>
        <field name="specification">30s combed cotton, single jersey knit</field>
        <field name="uom">KG</field>
        <field name="unit_price">4.85</field>
        <field name="effective_date">2026-01-05</field>
        <field name="validity_date">2026-12-31</field>
        <field name="lead_time_days">21</field>
        <field name="moq">500</field>
        <field name="fabric_composition">100% Cotton</field>
        <field name="gsm">180</field>
        <field name="width">60 inch tubular</field>
        <field name="dyeing_process">piece_dyed</field>
        <field name="color_fastness_rating">Grade 4-5</field>
        <field name="test_report_ref">DK-TR-2026-0114</field>
    </record>

    <record id="supplier_product_deltaknit_pique" model="garment.supplier.product">
        <field name="supplier_id" ref="supplier_deltaknit"/>
