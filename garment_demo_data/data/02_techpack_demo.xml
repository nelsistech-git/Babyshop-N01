<!--
     Tech Packs (garment.techpack) — garment_techpack. One tech pack per
     style, taken all the way to 'approved' (production-ready) so the
     downstream BOM/Sample/Costing/PLM batches can reference an approved
     tech pack. technical_owner_id / assigned_merchandiser_id are res.users
     Many2one fields (not garment.hr.employee), so they point at the seed
     Administrator user; the human "owner" of record for pattern/technical
     work is still Mizanur Rahman (emp_pattern_master) per the HR batch —
     captured here in free-text fields (department) and, for style_tee,
     in the construction-detail notes.
-->
<odoo>
<data noupdate="1">

    <!-- =================================================================
         Tech Packs (garment.techpack)
         ================================================================= -->

    <record id="techpack_tee" model="garment.techpack">
        <field name="name">Men's Crew Neck T-Shirt — Tech Pack</field>
        <field name="version">1.2</field>
        <field name="style_id" ref="style_tee"/>
        <field name="product_type">T-Shirt</field>
        <field name="department">Pattern &amp; Design</field>
        <field name="assigned_merchandiser_id" ref="base.user_admin"/>
        <field name="technical_owner_id" ref="base.user_admin"/>
        <field name="product_name">Crew Neck Tee</field>
        <field name="product_description">Men's regular-fit single jersey crew neck tee, short sleeve, left chest
screen print, for Northwind Apparel Sourcing — Spring/Summer 2026 Core Basics collection.</field>
        <field name="fabric_category">knit</field>
        <field name="garment_type">tshirt</field>
        <field name="construction_method">Single Jersey Knit, cut and sew</field>
        <field name="fit_type">Regular Fit</field>
        <field name="usage_purpose">Everyday casual wear</field>
        <field name="target_market">UK / Northwind Apparel Sourcing Ltd</field>
        <field name="country_id" ref="base.bd"/>
        <field name="factory">Nelsis Main Factory, Ashulia</field>
        <field name="production_unit">Sewing Line 1</field>
        <field name="state">approved</field>
        <field name="is_locked" eval="True"/>
        <field name="approval_date">2026-02-10</field>
        <field name="review_deadline">2026-01-25</field>
        <field name="buyer_submission_deadline">2026-02-02</field>
        <field name="approval_deadline">2026-02-10</field>
        <field name="planned_start_date">2026-01-15</field>
        <field name="planned_end_date">2026-02-10</field>
    </record>

    <record id="techpack_polo" model="garment.techpack">
        <field name="name">Classic Pique Polo — Tech Pack</field>
        <field name="version">1.1</field>
        <field name="style_id" ref="style_polo"/>
        <field name="product_type">Polo Shirt</field>
        <field name="department">Pattern &amp; Design</field>
        <field name="assigned_merchandiser_id" ref="base.user_admin"/>
        <field name="technical_owner_id" ref="base.user_admin"/>
        <field name="product_name">Pique Polo Shirt</field>
        <field name="product_description">Men's regular-fit pique knit polo, rib knit collar, 3-button placket,
left chest embroidered logo, for Northwind Apparel Sourcing — Spring/Summer 2026 Core Basics collection.</field>
        <field name="fabric_category">knit</field>
        <field name="garment_type">polo</field>
        <field name="construction_method">Pique Knit, cut and sew</field>
        <field name="fit_type">Regular Fit</field>
        <field name="usage_purpose">Smart-casual wear</field>
        <field name="target_market">UK / Northwind Apparel Sourcing Ltd</field>
        <field name="country_id" ref="base.bd"/>
        <field name="factory">Nelsis Main Factory, Ashulia</field>
        <field name="production_unit">Sewing Line 1</field>
        <field name="state">approved</field>
        <field name="is_locked" eval="True"/>
        <field name="approval_date">2026-02-17</field>
        <field name="review_deadline">2026-02-01</field>
        <field name="buyer_submission_deadline">2026-02-09</field>
        <field name="approval_deadline">2026-02-17</field>
        <field name="planned_start_date">2026-01-20</field>
        <field name="planned_end_date">2026-02-17</field>
    </record>

    <record id="techpack_hoodie" model="garment.techpack">
        <field name="name">Fleece Zip Hoodie — Tech Pack</field>
        <field name="version">1.0</field>
        <field name="style_id" ref="style_hoodie"/>
        <field name="product_type">Zip Hoodie</field>
        <field name="department">Pattern &amp; Design</field>
        <field name="assigned_merchandiser_id" ref="base.user_admin"/>
        <field name="technical_owner_id" ref="base.user_admin"/>
        <field name="product_name">Full-Zip Fleece Hoodie</field>
        <field name="product_description">Unisex regular-fit brushed fleece full-zip hoodie with 3-panel drawcord
hood and kangaroo pocket, for BalticHaus Fashion — Autumn/Winter 2026 Urban Fleece collection.</field>
        <field name="fabric_category">knit</field>
        <field name="garment_type">hoodie</field>
        <field name="construction_method">Brushed Fleece Knit (French Terry Backing), cut and sew</field>
        <field name="fit_type">Regular Fit</field>
        <field name="usage_purpose">Cold-weather outerwear layer</field>
        <field name="target_market">Germany / BalticHaus Fashion GmbH</field>
        <field name="country_id" ref="base.bd"/>
        <field name="factory">Nelsis Main Factory, Ashulia</field>
        <field name="production_unit">Sewing Line 2</field>
        <field name="state">approved</field>
        <field name="is_locked" eval="True"/>
        <field name="approval_date">2026-02-26</field>
        <field name="review_deadline">2026-02-10</field>
        <field name="buyer_submission_deadline">2026-02-18</field>
        <field name="approval_deadline">2026-02-26</field>
        <field name="planned_start_date">2026-01-28</field>
        <field name="planned_end_date">2026-02-26</field>
    </record>

    <!-- =================================================================
         Depth records for techpack_tee only
         ================================================================= -->

    <!-- Measurement Sheets (garment.measurement.sheet) -->

    <record id="techpack_tee_msheet_base" model="garment.measurement.sheet">
        <field name="techpack_id" ref="techpack_tee"/>
        <field name="sequence">10</field>
        <field name="measurement_chart_id" ref="mchart_style_tee"/>
        <field name="style_id" ref="style_tee"/>
        <field name="size_set_id" ref="garment_style_library.size_set_international"/>
        <field name="pattern_id" ref="pattern_style_tee"/>
        <field name="imported_date">2026-01-18</field>
        <field name="tolerance_tracked" eval="True"/>
        <field name="status">approved</field>
        <field name="notes">Base measurement sheet imported from Measurement Chart v1.0 (mchart_style_tee),
graded against the international size set XXS-5XL. Approved by Pattern &amp; Design (Mizanur Rahman).</field>
    </record>

    <record id="techpack_tee_msheet_grading" model="garment.measurement.sheet">
        <field name="techpack_id" ref="techpack_tee"/>
        <field name="sequence">20</field>
        <field name="measurement_chart_id" ref="mchart_style_tee"/>
        <field name="style_id" ref="style_tee"/>
        <field name="size_set_id" ref="garment_style_library.size_set_international"/>
        <field name="pattern_id" ref="pattern_style_tee"/>
        <field name="imported_date">2026-02-05</field>
        <field name="tolerance_tracked" eval="True"/>
        <field name="status">under_review</field>
        <field name="notes">Grading verification pass across full size run ahead of PP sample cutting; pending
final sign-off after the fit sample measurement report comes back.</field>
    </record>

    <!-- Construction Detail (garment.construction.detail) -->

    <record id="techpack_tee_construction_hem" model="garment.construction.detail">
        <field name="techpack_id" ref="techpack_tee"/>
        <field name="sequence">10</field>
        <field name="component">hem</field>
        <field name="construction_notes">Straight bottom hem, 3/4" double-needle topstitch, 1cm turn-up.
Reviewed and signed off by Pattern Master Mizanur Rahman during technical review.</field>
    </record>

    <!-- Label Spec (garment.label.spec) -->

    <record id="techpack_tee_label_main" model="garment.label.spec">
        <field name="techpack_id" ref="techpack_tee"/>
        <field name="sequence">10</field>
        <field name="label_type">main</field>
        <field name="label_code">NW-LBL-TEE-01</field>
        <field name="material">Woven Damask, 100% Polyester</field>
        <field name="size">4cm x 3cm</field>
        <field name="color">White base, navy print</field>
        <field name="position">Center back neck</field>
        <field name="sewing_method">Folded and topstitched into neck binding seam</field>
        <field name="supplier_id" ref="partner_brighttrim"/>
        <field name="approval_status">approved</field>
    </record>

    <!-- Packaging Spec (garment.packaging.spec) -->

    <record id="techpack_tee_packaging" model="garment.packaging.spec">
        <field name="techpack_id" ref="techpack_tee"/>
        <field name="sequence">10</field>
        <field name="poly_bag_type">Individual clear poly bag, self-adhesive flap</field>
        <field name="poly_bag_size">30cm x 40cm</field>
        <field name="thickness">0.04mm LDPE</field>
        <field name="carton_type">5-ply export master carton</field>
        <field name="carton_dimension">60cm x 40cm x 35cm</field>
        <field name="carton_marking">Style NSG-TS-2601, PO number, size/color assortment, carton number,
country of origin "Made in Bangladesh", Northwind Apparel Sourcing Ltd consignee mark.</field>
        <field name="folding_method">Standard flat fold with tissue-free single poly, 1 dozen per inner poly,
6 dozen per export master carton with size/color assortment sticker</field>
        <field name="hanger_requirement" eval="False"/>
        <field name="tissue_requirement" eval="False"/>
        <field name="barcode_requirement" eval="True"/>
        <field name="approval_status">approved</field>
    </record>

</data>
</odoo>
