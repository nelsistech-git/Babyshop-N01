<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_material_form" model="ir.ui.view">
        <field name="name">garment.material.form</field>
        <field name="model">garment.material</field>
        <field name="arch" type="xml">
            <form string="Material">
                <header>
                    <button name="action_run_ai_analysis" type="object" string="Run AI Analysis" class="btn-secondary" icon="fa-magic"/>
                    <button name="action_create_purchase_requisition" type="object" string="Create Purchase Requisition"
                            class="btn-secondary"
                            invisible="stock_status not in ('low_stock', 'out_of_stock')"/>
                    <button name="action_classify_abc" type="object" string="Run ABC Classification" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="material_code" readonly="1"/>
                            <field name="category"/>
                            <field name="uom"/>
                            <field name="specification"/>
                            <field name="color"/>
                            <field name="size"/>
                            <field name="supplier_id"/>
                            <field name="default_warehouse_id"/>
                        </group>
                        <group>
                            <field name="minimum_stock"/>
                            <field name="maximum_stock"/>
                            <field name="reorder_level"/>
                            <field name="valuation_method"/>
                            <field name="standard_cost"/>
                            <field name="currency_id"/>
                            <field name="abc_classification"/>
                        </group>
                    </group>
                    <group string="Live Stock">
                        <group>
                            <field name="on_hand_qty" readonly="1"/>
                            <field name="reserved_qty" readonly="1"/>
                            <field name="available_qty" readonly="1"/>
                        </group>
                        <group>
                            <field name="stock_status" widget="badge"
                                   decoration-danger="stock_status in ('low_stock','out_of_stock')"
                                   decoration-warning="stock_status == 'excess_stock'"/>
                            <field name="inventory_value" readonly="1"/>
                            <field name="last_movement_date" readonly="1"/>
                            <field name="stock_age_days" readonly="1"/>
                            <field name="aging_bucket" readonly="1"/>
                            <field name="is_slow_moving" readonly="1"/>
                            <field name="is_dead_stock" readonly="1"/>
                        </group>
                    </group>
                    <group string="Batch / Chemical Safety" invisible="category not in ('chemical', 'fabric', 'yarn')">
                        <group>
                            <field name="batch_number"/>
                            <field name="expiry_date"/>
                            <field name="expiry_alert" readonly="1"/>
                        </group>
                        <group>
                            <field name="hazard_category"/>
                            <field name="storage_condition"/>
                        </group>
                    </group>
                    <group string="Buyer Approval" invisible="category != 'accessories'">
                        <field name="buyer_approval_status"/>
                    </group>
                    <notebook>
                        <page string="Stock Moves">
                            <field name="move_ids">
                                <tree>
                                    <field name="move_number"/>
                                    <field name="move_type"/>
                                    <field name="quantity"/>
                                    <field name="move_date"/>
                                    <field name="warehouse_id"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="AI Assistant">
                            <field name="ai_last_run" readonly="1"/>
                            <group string="Reorder Suggestion"><field name="ai_reorder_note" readonly="1" nolabel="1"/></group>
                            <group string="Slow-Moving Analysis"><field name="ai_slow_moving_note" readonly="1" nolabel="1"/></group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_material_tree" model="ir.ui.view">
        <field name="name">garment.material.tree</field>
        <field name="model">garment.material</field>
        <field name="arch" type="xml">
            <!-- FIXED: Added is_slow_moving with column_invisible="1" so decoration can evaluate it -->
            <tree string="Materials" decoration-danger="stock_status in ('low_stock','out_of_stock')" decoration-warning="stock_status == 'excess_stock' or is_slow_moving">
                <field name="is_slow_moving" column_invisible="1"/>
                <field name="material_code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="abc_classification"/>
                <field name="uom"/>
                <field name="on_hand_qty"/>
                <field name="available_qty"/>
                <field name="stock_age_days"/>
                <field name="stock_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_material_search" model="ir.ui.view">
        <field name="name">garment.material.search</field>
        <field name="model">garment.material</field>
        <field name="arch" type="xml">
            <search string="Search Materials">
                <field name="name"/>
                <field name="material_code"/>
                <filter string="Low/Out of Stock" name="filter_low" domain="[('stock_status', 'in', ('low_stock','out_of_stock'))]"/>
                <filter string="Slow Moving" name="filter_slow_moving" domain="[('is_slow_moving', '=', True)]"/>
                <filter string="Dead Stock" name="filter_dead_stock" domain="[('is_dead_stock', '=', True)]"/>
                <filter string="Expiry Risk" name="filter_expiry" domain="[('expiry_alert', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Stock Status" name="group_status" context="{'group_by': 'stock_status'}"/>
                    <filter string="ABC Classification" name="group_abc" context="{'group_by': 'abc_classification'}"/>
                    <filter string="Aging Bucket" name="group_aging" context="{'group_by': 'aging_bucket'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_material" model="ir.actions.act_window">
        <field name="name">Materials</field>
        <field name="res_model">garment.material</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first material.</p>
        </field>
    </record>

</odoo>