<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_grn_form" model="ir.ui.view">
        <field name="name">garment.grn.form</field>
        <field name="model">garment.grn</field>
        <field name="arch" type="xml">
            <form string="GRN">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_approve_gate" type="object" string="Approve Gate Entry" class="btn-secondary"
                            invisible="gate_status != 'pending'"/>
                    <button name="action_complete_putaway" type="object" string="Complete Putaway" class="btn-primary"
                            invisible="status == 'completed'"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="grn_number" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="purchase_order_id"/>
                            <field name="purchase_delivery_id"/>
                            <field name="supplier_id"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="vehicle_number"/>
                            <field name="driver_name"/>
                            <field name="arrival_datetime"/>
                            <field name="gate_status" widget="badge"/>
                            <field name="completed_date" readonly="1"/>
                            <field name="processing_hours" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="material_id"/>
                            <field name="received_qty"/>
                            <field name="accepted_qty"/>
                            <field name="rejected_qty"/>
                            <field name="quality_status"/>
                            <field name="hold_reason" invisible="quality_status != 'on_hold'"/>
                            <field name="putaway_location_id"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_grn_tree" model="ir.ui.view">
        <field name="name">garment.grn.tree</field>
        <field name="model">garment.grn</field>
        <field name="arch" type="xml">
            <tree string="GRNs" decoration-success="status == 'completed'">
                <field name="grn_number"/>
                <field name="supplier_id"/>
                <field name="warehouse_id"/>
                <field name="arrival_datetime"/>
                <field name="processing_hours"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_grn_search" model="ir.ui.view">
        <field name="name">garment.grn.search</field>
        <field name="model">garment.grn</field>
        <field name="arch" type="xml">
            <search string="Search GRNs">
                <field name="grn_number"/>
                <field name="supplier_id"/>
                <field name="warehouse_id"/>
                <filter string="Pending" name="filter_pending" domain="[('status', '!=', 'completed')]"/>
                <filter string="Completed" name="filter_completed" domain="[('status', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_grn" model="ir.actions.act_window">
        <field name="name">GRNs</field>
        <field name="res_model">garment.grn</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_garment_grn_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first GRN.</p>
        </field>
    </record>

</odoo>
