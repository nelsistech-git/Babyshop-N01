<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_warehouse" model="ir.module.category">
            <field name="name">Smart Garment ERP - Warehouse</field>
            <field name="sequence">60</field>
        </record>

        <record id="group_warehouse_store_keeper" model="res.groups">
            <field name="name">Store Keeper (GRN, Stock Moves)</field>
            <field name="category_id" ref="module_category_garment_warehouse"/>
        </record>

        <record id="group_warehouse_qc" model="res.groups">
            <field name="name">Quality Inspector (GRN Quality Status)</field>
            <field name="category_id" ref="module_category_garment_warehouse"/>
        </record>

        <record id="group_warehouse_manager" model="res.groups">
            <field name="name">Warehouse Manager (Full Access)</field>
            <field name="category_id" ref="module_category_garment_warehouse"/>
            <field name="implied_ids" eval="[(4, ref('group_warehouse_store_keeper')),
                                              (4, ref('group_warehouse_qc'))]"/>
        </record>

        <record id="group_warehouse_top_management" model="res.groups">
            <field name="name">Top Management (MD - Dashboard &amp; Reports)</field>
            <field name="category_id" ref="module_category_garment_warehouse"/>
            <field name="implied_ids" eval="[(4, ref('group_warehouse_manager'))]"/>
        </record>

        <record id="rule_garment_material_manager_full" model="ir.rule">
            <field name="name">Warehouse Manager+: All Materials</field>
            <field name="model_id" ref="model_garment_material"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_warehouse_manager'))]"/>
        </record>

    </data>
</odoo>
