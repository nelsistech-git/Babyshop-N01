<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_material" model="ir.sequence">
        <field name="name">Garment Material Code</field>
        <field name="code">garment.material</field>
        <field name="prefix">MAT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_grn" model="ir.sequence">
        <field name="name">Garment GRN Number</field>
        <field name="code">garment.grn</field>
        <field name="prefix">GRN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_stock_move" model="ir.sequence">
        <field name="name">Garment Stock Move Number</field>
        <field name="code">garment.stock.move</field>
        <field name="prefix">MOV/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_fabric_roll" model="ir.sequence">
        <field name="name">Garment Fabric Roll Number</field>
        <field name="code">garment.fabric.roll</field>
        <field name="prefix">R-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_stock_count" model="ir.sequence">
        <field name="name">Garment Stock Count Reference</field>
        <field name="code">garment.stock.count</field>
        <field name="prefix">SC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_stock_transfer" model="ir.sequence">
        <field name="name">Garment Stock Transfer Reference</field>
        <field name="code">garment.stock.transfer</field>
        <field name="prefix">TRF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
