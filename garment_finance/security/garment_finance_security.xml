<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_finance" model="ir.module.category">
            <field name="name">Smart Garment ERP - Finance</field>
            <field name="sequence">65</field>
        </record>

        <record id="group_finance_officer" model="res.groups">
            <field name="name">Finance Officer (Expenses, Payments)</field>
            <field name="category_id" ref="module_category_garment_finance"/>
        </record>

        <record id="group_commercial_officer" model="res.groups">
            <field name="name">Commercial Officer (LC, Export Documentation)</field>
            <field name="category_id" ref="module_category_garment_finance"/>
        </record>

        <record id="group_finance_manager" model="res.groups">
            <field name="name">Finance Manager (Approve Budgets/Payments)</field>
            <field name="category_id" ref="module_category_garment_finance"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_officer')),
                                              (4, ref('group_commercial_officer'))]"/>
        </record>

        <record id="group_finance_director" model="res.groups">
            <field name="name">Finance Director / MD (Full Access)</field>
            <field name="category_id" ref="module_category_garment_finance"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_manager'))]"/>
        </record>

        <record id="rule_garment_budget_manager_full" model="ir.rule">
            <field name="name">Finance Manager+: All Budgets</field>
            <field name="model_id" ref="model_garment_budget"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_finance_manager'))]"/>
        </record>

    </data>
</odoo>
