<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_bank_account_tree" model="ir.ui.view">
        <field name="name">garment.bank.account.tree</field>
        <field name="model">garment.bank.account</field>
        <field name="arch" type="xml">
            <tree string="Bank Accounts">
                <field name="bank_name"/>
                <field name="branch"/>
                <field name="account_number"/>
                <field name="account_type"/>
                <field name="current_balance"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_bank_account_form" model="ir.ui.view">
        <field name="name">garment.bank.account.form</field>
        <field name="model">garment.bank.account</field>
        <field name="arch" type="xml">
            <form string="Bank Account">
                <sheet>
                    <div class="oe_title"><h1><field name="bank_name"/></h1></div>
                    <group>
                        <group>
                            <field name="branch"/>
                            <field name="account_number"/>
                            <field name="account_type"/>
                            <field name="swift_code"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="current_balance"/>
                        </group>
                    </group>
                    <field name="transaction_ids">
                        <tree>
                            <field name="transaction_date"/>
                            <field name="transaction_type"/>
                            <field name="amount"/>
                            <field name="reconciliation_status"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_bank_account" model="ir.actions.act_window">
        <field name="name">Bank Accounts</field>
        <field name="res_model">garment.bank.account</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
