<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_finance_statement_tree" model="ir.ui.view">
        <field name="name">garment.finance.statement.tree</field>
        <field name="model">garment.finance.statement</field>
        <field name="arch" type="xml">
            <tree string="Financial Statements">
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_revenue"/>
                <field name="gross_profit"/>
                <field name="net_profit"/>
                <field name="working_capital"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_finance_statement_form" model="ir.ui.view">
        <field name="name">garment.finance.statement.form</field>
        <field name="model">garment.finance.statement</field>
        <field name="arch" type="xml">
            <form string="Finance Statement">
                <header>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Profit &amp; Loss (Simplified)">
                            <group>
                                <group>
                                    <field name="total_revenue" readonly="1"/>
                                    <field name="total_production_cost" readonly="1"/>
                                    <field name="gross_profit" readonly="1"/>
                                    <field name="net_profit" readonly="1"/>
                                </group>
                                <group>
                                    <field name="gross_margin_pct" readonly="1"/>
                                    <field name="net_margin_pct" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Position Snapshot">
                            <group>
                                <group>
                                    <field name="cash_bank_balance" readonly="1"/>
                                    <field name="total_receivable" readonly="1"/>
                                    <field name="total_payable" readonly="1"/>
                                    <field name="working_capital" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Budget Status">
                            <group>
                                <group>
                                    <field name="budget_allocated" readonly="1"/>
                                    <field name="budget_actual" readonly="1"/>
                                    <field name="budget_variance_pct" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_finance_statement" model="ir.actions.act_window">
        <field name="name">Financial Statements</field>
        <field name="res_model">garment.finance.statement</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate a Finance Executive Statement for a period.</p>
        </field>
    </record>

</odoo>
