<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_receivable_tree" model="ir.ui.view">
        <field name="name">garment.receivable.tree</field>
        <field name="model">garment.receivable</field>
        <field name="arch" type="xml">
            <tree string="Buyer Receivables" decoration-danger="aging_bucket in ('90','90_plus')" decoration-success="status == 'received'">
                <field name="buyer_id"/>
                <field name="export_invoice_reference"/>
                <field name="amount"/>
                <field name="received_amount"/>
                <field name="outstanding_amount"/>
                <field name="due_date"/>
                <field name="aging_bucket"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_receivable_form" model="ir.ui.view">
        <field name="name">garment.receivable.form</field>
        <field name="model">garment.receivable</field>
        <field name="arch" type="xml">
            <form string="Buyer Receivable">
                <sheet>
                    <group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="export_invoice_reference"/>
                            <field name="shipment_id"/>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="received_amount"/>
                            <field name="outstanding_amount" readonly="1"/>
                            <field name="aging_days" readonly="1"/>
                            <field name="aging_bucket" readonly="1"/>
                            <field name="status" widget="badge" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_receivable" model="ir.actions.act_window">
        <field name="name">Buyer Receivables</field>
        <field name="res_model">garment.receivable</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track your first buyer receivable.</p>
        </field>
    </record>
</odoo>
