<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_lc_document_tree" model="ir.ui.view">
        <field name="name">garment.lc.document.tree</field>
        <field name="model">garment.lc.document</field>
        <field name="arch" type="xml">
            <tree string="LC Documents" editable="bottom">
                <field name="lc_id"/>
                <field name="document_type"/>
                <field name="file" filename="filename"/>
                <field name="filename" invisible="1"/>
                <field name="is_submitted"/>
                <field name="submitted_date"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_lc_document" model="ir.actions.act_window">
        <field name="name">LC Documents</field>
        <field name="res_model">garment.lc.document</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
