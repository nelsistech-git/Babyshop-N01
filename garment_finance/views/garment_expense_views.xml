<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_expense_tree" model="ir.ui.view">
        <field name="name">garment.expense.tree</field>
        <field name="model">garment.expense</field>
        <field name="arch" type="xml">
            <tree string="Expenses" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'">
                <field name="expense_date"/>
                <field name="expense_category"/>
                <field name="cost_center_id"/>
                <field name="description"/>
                <field name="amount"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_expense_form" model="ir.ui.view">
        <field name="name">garment.expense.form</field>
        <field name="model">garment.expense</field>
        <field name="arch" type="xml">
            <form string="Expense">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="status == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="expense_category"/>
                            <field name="description"/>
                            <field name="cost_center_id"/>
                            <field name="requested_by_id"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="expense_date"/>
                            <field name="attachment" filename="'Receipt'"/>
                            <field name="required_approver_group_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">garment.expense</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first expense.</p>
        </field>
    </record>
</odoo>
