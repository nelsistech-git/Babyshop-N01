<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_cost_center_tree" model="ir.ui.view">
        <field name="name">garment.cost.center.tree</field>
        <field name="model">garment.cost.center</field>
        <field name="arch" type="xml">
            <tree string="Cost Centers">
                <field name="name"/>
                <field name="department"/>
                <field name="factory"/>
                <field name="monthly_cost"/>
                <field name="cost_per_piece"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_cost_center_form" model="ir.ui.view">
        <field name="name">garment.cost.center.form</field>
        <field name="model">garment.cost.center</field>
        <field name="arch" type="xml">
            <form string="Cost Center">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="department"/>
                            <field name="factory"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="monthly_output"/>
                            <field name="monthly_cost" readonly="1"/>
                            <field name="cost_per_piece" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budgets">
                            <field name="budget_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="budgeted_amount"/>
                                    <field name="actual_amount"/>
                                    <field name="utilization_pct"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Expenses">
                            <field name="expense_ids">
                                <tree>
                                    <field name="expense_date"/>
                                    <field name="expense_category"/>
                                    <field name="amount"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_cost_center" model="ir.actions.act_window">
        <field name="name">Cost Centers</field>
        <field name="res_model">garment.cost.center</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
