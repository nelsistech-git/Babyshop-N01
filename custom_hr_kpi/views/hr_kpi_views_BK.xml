<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Corporate KPI line tree (for inline display) -->
    <record id="view_hr_kpi_corporate_line_tree_ghl" model="ir.ui.view">
        <field name="name">hr.kpi.corporate.performance.tree.ghl</field>
        <field name="model">hr.kpi.corporate.performance</field>
        <field name="arch" type="xml">
            <tree string="Corporate KPIs" class="kpi_tree_view">
                <field name="kpi_type_id" />
                <field name="kpi_name_id" />
                <field name="kpi_name_description" />
                <field name="kpi_name_weight" />
                <field name="kpi_name_timeframe" />
                <field name="target_l1" />
                <field name="target_l2" />
                <field name="target_l3" />
                <field name="target_l4" />
                <field name="target_l5" />
                <field name="achieved_value" />
                <field name="achieved_level" />
                <field name="kpi_weightage_incentive_payout" string="Incentive Payout (KPI)" sum="Total"/>
                <field name="kpi_weightage_performace_rating" string="Performace Rating (KPI)" sum="Total"/>
                <field name="weighted_achivement_incentive_payout" string="Incentive Payout (Achivement)" sum="Total" />
                <field name="weighted_achivement_performace_rating" string="Performace Rating (Achivement)" sum="Total"/>
            </tree>
        </field>
    </record>


    <!-- Corporate KPI line form -->
    <record id="view_hr_kpi_corporate_line_form_ghl" model="ir.ui.view">
        <field name="name">hr.kpi.corporate.performance.form.ghl</field>
        <field name="model">hr.kpi.corporate.performance</field>
        <field name="arch" type="xml">
            <form string="Corporate KPI Performance">
                <style>
                .kpi_form_sheet {
                    background-color: #f8f9fa;
                    font-family: 'Inter', sans-serif;
                }
                .kpi_header {
                    padding: 12px;
                    background: linear-gradient(135deg, #6f42c1, #007bff);
                    border-radius: 6px;
                    margin-bottom: 12px;
                    color: white;
                    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
                }
                .kpi_header h1 {
                    font-size: 18px;
                    font-weight: 600;
                    margin: 0;
                    padding: 0;
                    color: white !important;
                }
                .kpi_header .kpi_type {
                    font-size: 12px;
                    opacity: 1;
                    margin-top: 2px;
                }
                .kpi_card {
                    background-color: #ffffff;
                    border-radius: 6px;
                    padding: 10px;
                    margin-bottom: 12px;
                    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.03);
                    border: 1px solid #e9ecef;
                }
                .kpi_card h2 {
                    font-size: 14px;
                    font-weight: 500;
                    color: #495057;
                    border-bottom: 1px solid #dee2e6;
                    padding-bottom: 6px;
                    margin-top: 0;
                    margin-bottom: 10px;
                }
                .kpi_field_group {
                    display: flex;
                    flex-direction: column;
                    margin-bottom: 10px;
                }
                .kpi_label {
                    font-size: 10px;
                    font-weight: 500;
                    color: #6c757d;
                    margin-bottom: 3px;
                    text-transform: uppercase;
                }
                .kpi_value {
                    font-size: 13px;
                    color: #212529;
                }
                .kpi_description {
                    font-style: italic;
                    color: #495057;
                    background-color: #f8f9fa;
                    padding: 6px;
                    border-radius: 5px;
                    border-left: 3px solid #007bff;
                }
                .kpi_targets_container {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
                    gap: 10px;
                    text-align: center;
                }
                .kpi_target_box {
                    background-color: #f8f9fa;
                    padding: 10px;
                    border-radius: 5px;
                    border: 1px solid #e9ecef;
                    transition: all 0.18s ease;
                }
                .kpi_target_box:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
                }
                .kpi_achievement_panel {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 10px;
                    background-color: #e8f5e9;
                    border-left: 3px solid #4caf50;
                    padding: 10px;
                    border-radius: 8px;
                }
                .kpi_achievement_panel .kpi_label {
                    color: #2e7d32;
                }
                .kpi_achievement_panel .kpi_value {
                    font-size: 16px;
                    font-weight: 700;
                    color: #1b5e20;
                }
                .kpi_results_grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
                    gap: 10px;
                }
                .kpi_result_item {
                    padding: 10px;
                    border-radius: 5px;
                    background-color: #f8f9fa;
                }
                .kpi_result_item .kpi_label {
                    color: #007bff;
                }
                .kpi_result_item.rating .kpi_label {
                    color: #6f42c1;
                }
                .kpi_result_item .kpi_value {
                    font-size: 14px;
                    font-weight: 600;
                }

                @media (max-width: 768px) {
                    .kpi_header h1 { font-size: 16px; }
                    .kpi_card { padding: 8px; }
                    .kpi_achievement_panel { grid-template-columns: 1fr; }
                    .kpi_results_grid { grid-template-columns: 1fr; }
                }
                </style>

                <sheet class="kpi_form_sheet">
                    <div class="kpi_header">
                        <h1>
                            <field name="kpi_type_id" placeholder="KPI Type" class="oe_inline"/>
                        </h1>
                        <div class="kpi_type">
                            <field name="kpi_name_id" placeholder="KPI Name" class="oe_inline"/>
                        </div>
                    </div>

                    <div class="oe_form_sheet_bg">
                        <div class="row">
                            <div class="col-lg-7">
                                <div class="kpi_card">
                                    <h2>KPI Details</h2>
                                    <div class="kpi_field_group">
                                        <span class="kpi_label">Description</span>
                                        <div class="kpi_value kpi_description">
                                            <field name="kpi_name_description" nolabel="1"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="kpi_field_group">
                                                <span class="kpi_label">Weight</span>
                                                <div class="kpi_value">
                                                    <field name="kpi_name_weight" nolabel="1"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="kpi_field_group">
                                                <span class="kpi_label">Timeframe</span>
                                                <div class="kpi_value">
                                                    <field name="kpi_name_timeframe" nolabel="1"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="kpi_card">
                                    <h2>Target Levels</h2>
                                    <div class="kpi_targets_container">
                                        <div class="kpi_target_box">
                                            <span class="kpi_label">Level 1</span>
                                            <div class="kpi_value">
                                                <field name="target_l1" nolabel="1"/>
                                            </div>
                                        </div>
                                        <div class="kpi_target_box">
                                            <span class="kpi_label">Level 2</span>
                                            <div class="kpi_value">
                                                <field name="target_l2" nolabel="1"/>
                                            </div>
                                        </div>
                                        <div class="kpi_target_box">
                                            <span class="kpi_label">Level 3</span>
                                            <div class="kpi_value">
                                                <field name="target_l3" nolabel="1"/>
                                            </div>
                                        </div>
                                        <div class="kpi_target_box">
                                            <span class="kpi_label">Level 4</span>
                                            <div class="kpi_value">
                                                <field name="target_l4" nolabel="1"/>
                                            </div>
                                        </div>
                                        <div class="kpi_target_box">
                                            <span class="kpi_label">Level 5</span>
                                            <div class="kpi_value">
                                                <field name="target_l5" nolabel="1"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="kpi_card">
                                    <h2>Actual Achievement</h2>
                                    <div class="kpi_achievement_panel">
                                        <div class="kpi_field_group">
                                            <span class="kpi_label">Achieved Value</span>
                                            <div class="kpi_value">
                                                <field name="achieved_value" nolabel="1"/>
                                            </div>
                                        </div>
                                        <div class="kpi_field_group">
                                            <span class="kpi_label">Achieved Level</span>
                                            <div class="kpi_value">
                                                <field name="achieved_level" nolabel="1"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="kpi_card">
                                    <h2>Calculated Results</h2>
                                    <div class="kpi_results_grid">
                                        <div class="kpi_result_item incentive">
                                            <div class="kpi_field_group">
                                                <span class="kpi_label">Incentive Payout (KPI)</span>
                                                <div class="kpi_value">
                                                    <field name="kpi_weightage_incentive_payout" nolabel="1"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="kpi_result_item rating">
                                            <div class="kpi_field_group">
                                                <span class="kpi_label">Performance Rating (KPI)</span>
                                                <div class="kpi_value">
                                                    <field name="kpi_weightage_performace_rating" nolabel="1"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="kpi_result_item incentive">
                                            <div class="kpi_field_group">
                                                <span class="kpi_label">Incentive Payout (Achieved)</span>
                                                <div class="kpi_value">
                                                    <field name="weighted_achivement_incentive_payout" nolabel="1"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="kpi_result_item rating">
                                            <div class="kpi_field_group">
                                                <span class="kpi_label">Performance Rating (Achieved)</span>
                                                <div class="kpi_value">
                                                    <field name="weighted_achivement_performace_rating" nolabel="1"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>


