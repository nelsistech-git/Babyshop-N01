    <!-- Main tree view for hr.kpi (simple list) -->
    <record id="view_hr_kpi_tree_ghl" model="ir.ui.view">
        <field name="name">hr.kpi.tree.ghl</field>
        <field name="model">hr.kpi</field>
        <field name="arch" type="xml">
            <tree string="GHL KPIs">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="staff_id"/>
            </tree>
        </field>
    </record>

    <!-- Main form view for hr.kpi -->
    <record id="view_hr_kpi_form_ghl" model="ir.ui.view">
        <field name="name">hr.kpi.form.ghl</field>
        <field name="model">hr.kpi</field>
        <field name="arch" type="xml">
            <form string="GHL KPI">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_review,approved,rejected"/>
                    <button name="action_submit_for_review" type="object" string="Submit" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state != 'in_review'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'in_review'"/>
                    <button name="action_set_draft" type="object" string="Reset to Draft" invisible="state not in ('rejected','approved')"/>
                </header>
                <sheet>
                    <h1 style="font-size: 34px; font-weight: bold; margin-bottom: 20px;">
                        <field name="name" readonly="1" required="0" />
                    </h1>
                    <div class="oe_inline">
                        <label for='period_start'>Period Start</label>
                        <field name="period_start"/>
                        <label for='period_end'>Period End</label>
                        <field name="period_end"/>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"></field>
                            <field name="staff_id"></field>
                            <field name="supervisor_id" />
                            <field name="next_level_supervisor_id" />
                        </group>
                        <group>
                            <field name="job_id" />
                            <field name="department_id" />
                            <field name="supervisor_position" />
                            <field name="next_level_supervisor_position" />
                        </group>
                    </group>

                    <!-- <group string="KPI Details" colspan="4">

                    </group> -->
                    <notebook>
                        <page string="Corporate KPI Lines">
                            <field name="corporate_performance_ids" nolabel="1">
                                <tree ref="view_hr_kpi_corporate_line_tree_ghl"/>
                            </field>
                            <div style="display: flex; justify-content: flex-end; margin-top: 20px;">
                                <!-- <div style="font-weight:bold;">Incentive Payout (Achivement):&amp;nbsp;</div> -->
                                <label style="font-weight:bold;" string="Rounded Incentive Payout (Achivement)" for='mapped_weighted_achievement_incentive_payout'></label>
                                <field style="font-weight:bold;" name="mapped_weighted_achievement_incentive_payout" readonly="1"/>
                            </div>
                        </page>
                        <page string="Individual KPI Lines">
                            <field name="individual_performance_ids" nolabel="1">
                                <tree ref="view_hr_kpi_individual_line_tree_ghl"/>
                            </field>
                            <div style="display: flex; justify-content: flex-end; margin-top: 20px;">
                                <!-- <div style="font-weight:bold;">Incentive Payout (Achivement):&amp;nbsp;</div> -->
                                <label style="font-weight:bold;" string="Rounded Incentive Payout (Achivement)" for='mapped_weighted_achievement_incentive_payout_individuals'></label>
                                <field style="font-weight:bold;" name="mapped_weighted_achievement_incentive_payout_individuals" readonly="1"/>
                            </div>
                        </page>
                        <page string="Additional">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped table-hover">
                                    <tbody>
                                        <tr>
                                            <th>Area</th>
                                            <th>Weighted Achievement for Incentive payout</th>
                                            <th>Weighted Achievement for Performance Appraisal</th>
                                        </tr>
                                        <tr>
                                            <td>Company Performance Score</td>
                                            <td>
                                                <field name="mapped_weighted_achievement_incentive_payout"/>
                                            </td>
                                            <td>
                                                <field name="total_weighted_achivement_performace_rating" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Individual Performance Score</td>
                                            <td>
                                                <field name="mapped_weighted_achievement_incentive_payout_individuals"/>
                                            </td>
                                            <td>
                                                <field name="total_weighted_achivement_performace_rating_individuals" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Individual Performance Score after Alignment with Company Performance Score</td>
                                            <td>N/A</td>
                                            <td>
                                                <field name="individual_performance_score_after_alignment" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <h1 style="margin-top:40px;">Consolidated Performance Rating</h1>
                            <field name="evaluation_line_ids" nolabel="1">
                                <tree editable="bottom" string="Behaviour / Competency Lines">
                                    <field name="evaluation_area"/>
                                    <field name="code" column_invisible='1'/>
                                    <field name="rating" readonly="code == '2A'" />
                                    <field name="weight"/>
                                    <field name="weighted_rating" readonly="1"/>
                                </tree>
                            </field>
                            <div style="display: flex; justify-content: flex-end; align-items:baseline; margin-top: 20px;">
                                <label for='final_individual_performance_rating'></label>&amp;nbsp;&amp;nbsp;&amp;nbsp;
                                <field name="final_individual_performance_rating" readonly="1"/>
                            </div>
                            <h1>Summary of Achievements</h1>
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Company Performance Score for Incentive</th>
                                            <th>Individual Performance Score for Incentive</th>
                                            <th>Final Individual Performance Rating</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <field name="mapped_weighted_achievement_incentive_payout" />
                                            </td>
                                            <td>
                                                <field name="mapped_weighted_achievement_incentive_payout_individuals" />
                                            </td>
                                            <td>
                                                <field name="final_individual_performance_rating" readonly="1" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <h1 style="margin-top:40px;">Development Plans - An indicative plan needs to be documented and detail will be captured &amp; 
                                                            linked with performance review during "Career Development Review (CDR)"</h1>
                            <field name="development_plan_ids" nolabel="1">
                                <tree editable="bottom" string="Development Plans">
                                    <field name="development_objectives"/>
                                    <field name="development_initiatives"/>
                                    <field name="development_initiative_description"/>
                                    <field name="priority" widget="selection"/>
                                    <field name="due_date"/>
                                </tree>
                            </field>
                            <h1 style="margin-top:40px;">Ambitions/Job Expectation/Career Aspiration</h1>
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped">
                                    <thead>
                                        <tr>
                                            <th>Action Item</th>
                                            <th colspan="8">Appraise Feedback</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                5.a - Where would you like to be in a 1-3 years:<br style="display:block; margin-top:5px;"/>
                                                (Maximum 300 characters) involving with broader scope of work
                                            </td>
                                            <td colspan="8">
                                                <field name="five_a_career_1_3yrs" placeholder="e.g. Senior Software Engineer, Team Lead, etc."/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                5.b - What support will you require from the organization<br style="display:block; margin-top:5px;"/>
                                                to help you to fulfill your aspiration
                                            </td>
                                            <td colspan="8">
                                                <field name="five_b_org_support" placeholder="e.g. Training, Mentorship, Resources, etc."/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>5.c - Expected Job Position in 1-3 years (Mark option)	</td>
                                            <td colspan="8">
                                                <field name="five_c_expected_job" widget="radio" options="{'horizontal': true}" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <label for="five_c_expected_job_specify" string="Please specify" invisible="five_c_expected_job != 'other'">

                                                </label>
                                            </td>
                                            <td colspan="8">
                                                <field name="five_c_expected_job_specify" placeholder="e.g. Senior Software Engineer, Team Lead, etc." invisible="five_c_expected_job != 'other'" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                5.d - International Mobility:<br style="display:block; margin-top:5px;"/>
                                                Are you willing to be relocated to another country?<br style="display:block; margin-top:5px;"/>
                                                Remarks (If any issues, challenges, concern that need attention)
                                        </td>
                                        <td colspan="8">
                                            <field name="five_d_international_mobility" widget="radio" options="{'horizontal': true}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

