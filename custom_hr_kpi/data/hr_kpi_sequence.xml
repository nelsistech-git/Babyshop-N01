<odoo>
  <data noupdate="0">
    <record id="seq_hr_kpi" model="ir.sequence">
      <field name="name">HR KPI</field>
      <field name="code">hr.kpi</field>
      <!-- Example: KPI/2025/0001 -->
      <field name="prefix">KPI/%(year)s/</field>
      <field name="padding">4</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>
