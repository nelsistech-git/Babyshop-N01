<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_ai_scan_tree" model="ir.ui.view">
        <field name="name">fw.ai.scan.tree</field>
        <field name="model">fw.ai.scan</field>
        <field name="arch" type="xml">
            <tree string="Risk Detection Scans">
                <field name="name"/>
                <field name="scan_datetime"/>
                <field name="alert_count"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_ai_scan_form" model="ir.ui.view">
        <field name="name">fw.ai.scan.form</field>
        <field name="model">fw.ai.scan</field>
        <field name="arch" type="xml">
            <form string="Risk Detection Scan">
                <header>
                    <button name="action_run_scan" type="object" string="Run Scan"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="scan_datetime" readonly="1"/>
                        <field name="alert_count" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Alerts Raised">
                            <field name="alert_ids">
                                <tree decoration-danger="severity=='high'"
                                      decoration-warning="severity=='medium'">
                                    <field name="name"/>
                                    <field name="risk_type"/>
                                    <field name="severity"/>
                                    <field name="description"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fw_ai_scan" model="ir.actions.act_window">
        <field name="name">Risk Detection Scans</field>
        <field name="res_model">fw.ai.scan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run your first risk detection scan</p>
        </field>
    </record>
</odoo>
