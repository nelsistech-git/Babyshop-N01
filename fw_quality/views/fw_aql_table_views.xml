<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_aql_table_tree" model="ir.ui.view">
        <field name="name">fw.aql.table.tree</field>
        <field name="model">fw.aql.table</field>
        <field name="arch" type="xml">
            <tree string="AQL Sampling Table" editable="bottom">
                <field name="code_letter"/>
                <field name="inspection_level"/>
                <field name="lot_size_min"/>
                <field name="lot_size_max"/>
                <field name="sample_size"/>
                <field name="aql_major_percent"/>
                <field name="ac_major"/>
                <field name="re_major"/>
                <field name="aql_minor_percent"/>
                <field name="ac_minor"/>
                <field name="re_minor"/>
                <field name="ac_critical"/>
                <field name="re_critical"/>
            </tree>
        </field>
    </record>

    <record id="action_fw_aql_table" model="ir.actions.act_window">
        <field name="name">AQL Sampling Table</field>
        <field name="res_model">fw.aql.table</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Reference sample-size table. Verify against your buyer's official AQL
                chart before relying on it for compliance decisions.
            </p>
        </field>
    </record>
</odoo>
