<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_defect_code_tree" model="ir.ui.view">
        <field name="name">fw.defect.code.tree</field>
        <field name="model">fw.defect.code</field>
        <field name="arch" type="xml">
            <tree string="Defect Codes" editable="bottom"
                  decoration-danger="severity=='critical'"
                  decoration-warning="severity=='major'">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="severity"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="action_fw_defect_code" model="ir.actions.act_window">
        <field name="name">Defect Codes</field>
        <field name="res_model">fw.defect.code</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
