<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_inline_qc_tree" model="ir.ui.view">
        <field name="name">fw.inline.qc.tree</field>
        <field name="model">fw.inline.qc</field>
        <field name="arch" type="xml">
            <tree string="Inline QC" decoration-danger="dhu_percent &gt; 10"
                  decoration-warning="dhu_percent &gt; 5 and dhu_percent &lt;= 10">
                <field name="name"/>
                <field name="production_order_id"/>
                <field name="stage"/>
                <field name="date"/>
                <field name="inspector_id"/>
                <field name="checked_qty"/>
                <field name="total_defect_qty"/>
                <field name="dhu_percent"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_inline_qc_form" model="ir.ui.view">
        <field name="name">fw.inline.qc.form</field>
        <field name="model">fw.inline.qc</field>
        <field name="arch" type="xml">
            <form string="Inline QC">
                <header>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_order_id"/>
                            <field name="stage_line_id"/>
                            <field name="stage" readonly="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="inspector_id"/>
                            <field name="checked_qty"/>
                        </group>
                    </group>
                    <group string="Result">
                        <group>
                            <field name="total_defect_qty" readonly="1"/>
                            <field name="passed_qty" readonly="1"/>
                        </group>
                        <group>
                            <field name="dhu_percent" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Defects Found">
                            <field name="defect_line_ids">
                                <tree editable="bottom" decoration-danger="severity=='critical'"
                                      decoration-warning="severity=='major'">
                                    <field name="defect_code_id"/>
                                    <field name="severity" readonly="1"/>
                                    <field name="qty"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_inline_qc_search" model="ir.ui.view">
        <field name="name">fw.inline.qc.search</field>
        <field name="model">fw.inline.qc</field>
        <field name="arch" type="xml">
            <search string="Search Inline QC">
                <field name="name"/>
                <field name="production_order_id"/>
                <group expand="0" string="Group By">
                    <filter string="Production Order" name="group_order"
                            context="{'group_by': 'production_order_id'}"/>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_inline_qc" model="ir.actions.act_window">
        <field name="name">Inline QC</field>
        <field name="res_model">fw.inline.qc</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_inline_qc_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first inline QC check</p>
        </field>
    </record>
</odoo>
