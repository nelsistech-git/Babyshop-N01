<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_cctv" model="ir.module.category">
            <field name="name">Smart CCTV</field>
        </record>

        <!-- Groups: from least to most privileged, each implying the previous -->
        <record id="group_cctv_read_only" model="res.groups">
            <field name="name">Read Only User</field>
            <field name="category_id" ref="module_category_cctv"/>
        </record>
        <record id="group_cctv_auditor" model="res.groups">
            <field name="name">Auditor</field>
            <field name="category_id" ref="module_category_cctv"/>
            <field name="implied_ids" eval="[(4, ref('group_cctv_read_only'))]"/>
        </record>
        <record id="group_cctv_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="category_id" ref="module_category_cctv"/>
        </record>
        <record id="group_cctv_hr_manager" model="res.groups">
            <field name="name">HR Manager</field>
            <field name="category_id" ref="module_category_cctv"/>
        </record>
        <record id="group_cctv_branch_manager" model="res.groups">
            <field name="name">Branch Manager</field>
            <field name="category_id" ref="module_category_cctv"/>
        </record>
        <record id="group_cctv_factory_manager" model="res.groups">
            <field name="name">Factory Manager</field>
            <field name="category_id" ref="module_category_cctv"/>
        </record>
        <record id="group_cctv_operator" model="res.groups">
            <field name="name">CCTV Operator</field>
            <field name="category_id" ref="module_category_cctv"/>
            <field name="implied_ids" eval="[(4, ref('group_cctv_read_only'))]"/>
        </record>
        <record id="group_cctv_security_manager" model="res.groups">
            <field name="name">Security Manager</field>
            <field name="category_id" ref="module_category_cctv"/>
            <field name="implied_ids" eval="[(4, ref('group_cctv_operator'))]"/>
        </record>
        <record id="group_cctv_security_director" model="res.groups">
            <field name="name">Security Director</field>
            <field name="category_id" ref="module_category_cctv"/>
            <field name="implied_ids" eval="[(4, ref('group_cctv_security_manager'))]"/>
        </record>
        <record id="group_cctv_admin" model="res.groups">
            <field name="name">Super Administrator</field>
            <field name="category_id" ref="module_category_cctv"/>
            <field name="implied_ids" eval="[(4, ref('group_cctv_security_director'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record rule: non-admin roles only see cameras/events for their own offices.
             Assign users to specific cctv.office records via this rule's domain by
             extending res.users with allowed_office_ids in a follow-up phase if needed.
             For phase 1, Security Director/Admin see everything; others see all offices
             too but write access is restricted by group on the model access CSV. -->
        <record id="rule_cctv_camera_admin_all" model="ir.rule">
            <field name="name">CCTV Camera: Admin/Director see all</field>
            <field name="model_id" ref="model_cctv_camera"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cctv_security_director'))]"/>
        </record>
    </data>
</odoo>
