<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cctv_incident_summary" model="ir.actions.report">
        <field name="name">Incident Summary</field>
        <field name="model">cctv.incident</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cctv_management.report_cctv_incident_document</field>
        <field name="report_file">cctv_management.report_cctv_incident_document</field>
        <field name="binding_model_id" ref="model_cctv_incident"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_cctv_camera_health" model="ir.actions.report">
        <field name="name">Camera Health Report</field>
        <field name="model">cctv.camera</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cctv_management.report_cctv_camera_health_document</field>
        <field name="report_file">cctv_management.report_cctv_camera_health_document</field>
        <field name="binding_model_id" ref="model_cctv_camera"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
