<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_cctv_visit_autoclose" model="ir.cron">
            <field name="name">CCTV: Auto-close Stale Face Visits</field>
            <field name="model_id" ref="model_cctv_visit"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_close_visits()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="cron_cctv_visit_overstay" model="ir.cron">
            <field name="name">CCTV: Visitor Overstay Alerts</field>
            <field name="model_id" ref="model_cctv_visit"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_overstay()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
