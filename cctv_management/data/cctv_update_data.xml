<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_cctv_camera_sync" model="ir.cron">
            <field name="name">CCTV: Sync Camera Device Settings (bitrate / FPS / resolution)</field>
            <field name="model_id" ref="model_cctv_camera"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_devices()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="cron_cctv_drive_queue" model="ir.cron">
            <field name="name">CCTV: Upload Snapshots / Clips to Google Drive</field>
            <field name="model_id" ref="model_cctv_drive_upload"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_queue()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="cron_cctv_drive_retention" model="ir.cron">
            <field name="name">CCTV: Remove Expired Files from Google Drive (retention)</field>
            <field name="model_id" ref="model_cctv_drive_upload"/>
            <field name="state">code</field>
            <field name="code">model.cron_apply_retention()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="cron_cctv_drive_daily" model="ir.cron">
            <field name="name">CCTV: Daily Event Log + Backup to Google Drive</field>
            <field name="model_id" ref="model_cctv_drive_upload"/>
            <field name="state">code</field>
            <field name="code">model.cron_daily_log_and_backup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 21:00:00')"/>
            <field name="active">True</field>
        </record>

        <record id="ai_model_general_default" model="cctv.ai.model">
            <field name="name">YOLOv8n (general, pre-trained)</field>
            <field name="kind">general</field>
            <field name="weights_file">yolov8n.pt</field>
            <field name="classes">person, car, motorcycle, bus, truck, backpack, handbag, suitcase</field>
            <field name="state">active</field>
        </record>
    </data>
</odoo>
