<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cctv_vehicle_log_tree" model="ir.ui.view">
        <field name="name">cctv.vehicle.log.tree</field>
        <field name="model">cctv.vehicle.log</field>
        <field name="arch" type="xml">
            <tree decoration-danger="not is_authorized" class="cctv-ui">
                <field name="entry_time"/>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="camera_id"/>
                <field name="office_id"/>
                <field name="exit_time"/>
                <field name="parking_minutes"/>
                <field name="is_authorized"/>
            </tree>
        </field>
    </record>

    <record id="action_cctv_vehicle_log" model="ir.actions.act_window">
        <field name="name">Vehicle Logs (ANPR)</field>
        <field name="res_model">cctv.vehicle.log</field>
        <field name="view_mode">tree,form,graph</field>
    </record>
</odoo>
