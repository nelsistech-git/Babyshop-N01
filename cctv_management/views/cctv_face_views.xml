<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cctv_face_log_tree" model="ir.ui.view">
        <field name="name">cctv.face.log.tree</field>
        <field name="model">cctv.face.log</field>
        <field name="arch" type="xml">
            <tree decoration-warning="is_unknown" class="cctv-ui">
                <field name="detected_at"/>
                <field name="camera_id"/>
                <field name="office_id"/>
                <field name="person_id"/>
                <field name="is_unknown"/>
                <field name="match_confidence"/>
            </tree>
        </field>
    </record>

    <record id="action_cctv_face_log" model="ir.actions.act_window">
        <field name="name">Face Recognition Log</field>
        <field name="res_model">cctv.face.log</field>
        <field name="view_mode">tree,form,graph</field>
    </record>
</odoo>
