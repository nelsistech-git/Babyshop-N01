<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cctv_alert_tree" model="ir.ui.view">
        <field name="name">cctv.alert.tree</field>
        <field name="model">cctv.alert</field>
        <field name="arch" type="xml">
            <tree decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" class="cctv-ui">
                <field name="create_date"/>
                <field name="name"/>
                <field name="alert_type"/>
                <field name="severity" widget="badge"/>
                <field name="camera_id"/>
                <field name="office_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_cctv_alert_form" model="ir.ui.view">
        <field name="name">cctv.alert.form</field>
        <field name="model">cctv.alert</field>
        <field name="arch" type="xml">
            <form class="cctv-ui">
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-secondary"
                            invisible="state == 'resolved'"/>
                    <button name="action_ignore" type="object" string="Ignore"
                            invisible="state in ('resolved','ignored')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,acknowledged,resolved"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="alert_type"/>
                        <field name="severity"/>
                        <field name="camera_id"/>
                        <field name="office_id"/>
                        <field name="event_id"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cctv_alert_search" model="ir.ui.view">
        <field name="name">cctv.alert.search</field>
        <field name="model">cctv.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="camera_id"/>
                <field name="office_id"/>
                <field name="alert_type"/>
                <filter string="New" name="new" domain="[('state','=','new')]"/>
                <filter string="Unresolved" name="unresolved" domain="[('state','in',['new','acknowledged'])]"/>
                <separator/>
                <filter string="Critical / High" name="severe" domain="[('severity','in',['critical','high'])]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('create_date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="Last 7 Days" name="last_7_days"
                        domain="[('create_date','&gt;=', datetime.datetime.combine(context_today() + relativedelta(days=-6), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Group By">
                    <filter string="Severity" name="group_severity" context="{'group_by':'severity'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'alert_type'}"/>
                    <filter string="Camera" name="group_camera" context="{'group_by':'camera_id'}"/>
                    <filter string="Site" name="group_office" context="{'group_by':'office_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Day" name="group_day" context="{'group_by':'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_cctv_alert_graph" model="ir.ui.view">
        <field name="name">cctv.alert.graph</field>
        <field name="model">cctv.alert</field>
        <field name="arch" type="xml">
            <graph string="Alerts" type="bar">
                <field name="alert_type"/>
                <field name="severity"/>
            </graph>
        </field>
    </record>

    <record id="action_cctv_alert" model="ir.actions.act_window">
        <field name="name">Smart Alerts</field>
        <field name="res_model">cctv.alert</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_new': 1}</field>
    </record>
</odoo>
