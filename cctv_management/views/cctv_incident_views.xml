<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cctv_incident_tree" model="ir.ui.view">
        <field name="name">cctv.incident.tree</field>
        <field name="model">cctv.incident</field>
        <field name="arch" type="xml">
            <tree class="cctv-ui">
                <field name="create_date"/>
                <field name="name"/>
                <field name="incident_type"/>
                <field name="office_id"/>
                <field name="assigned_to"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_cctv_incident_kanban" model="ir.ui.view">
        <field name="name">cctv.incident.kanban</field>
        <field name="model">cctv.incident</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="cctv-ui">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div><field name="incident_type"/> - <field name="office_id"/></div>
                            <div><field name="assigned_to"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cctv_incident_form" model="ir.ui.view">
        <field name="name">cctv.incident.form</field>
        <field name="model">cctv.incident</field>
        <field name="arch" type="xml">
            <form class="cctv-ui">
                <header>
                    <button name="action_start_investigation" type="object" string="Start Investigation"
                            invisible="state != 'open'" class="btn-primary"/>
                    <button name="action_take_action" type="object" string="Take Action"
                            invisible="state != 'investigation'" class="btn-primary"/>
                    <button name="action_close" type="object" string="Close Incident"
                            invisible="state == 'closed'" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,investigation,action,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="incident_type"/>
                            <field name="office_id"/>
                            <field name="camera_id"/>
                            <field name="event_id"/>
                        </group>
                        <group>
                            <field name="assigned_to"/>
                            <field name="closed_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What happened..."/>
                    <field name="resolution_notes" placeholder="How it was resolved..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cctv_incident" model="ir.actions.act_window">
        <field name="name">Security Incidents</field>
        <field name="res_model">cctv.incident</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>
