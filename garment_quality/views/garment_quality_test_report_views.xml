<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_quality_test_report_form" model="ir.ui.view">
        <field name="name">garment.quality.test.report.form</field>
        <field name="model">garment.quality.test.report</field>
        <field name="arch" type="xml">
            <form string="Quality Test Report">
                <header>
                    <field name="result" widget="statusbar" statusbar_visible="pass,fail"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="report_no"/>
                        <h1><field name="report_no" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="test_type"/>
                            <field name="inspection_id"/>
                            <field name="material_id"/>
                            <field name="style_id"/>
                            <field name="supplier_id"/>
                        </group>
                        <group>
                            <field name="test_date"/>
                            <field name="tested_by_id"/>
                            <field name="spec_value"/>
                            <field name="actual_value"/>
                            <field name="tolerance"/>
                        </group>
                    </group>
                    <group string="Report File">
                        <field name="report_file" filename="report_filename"/>
                        <field name="report_filename" invisible="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_quality_test_report_tree" model="ir.ui.view">
        <field name="name">garment.quality.test.report.tree</field>
        <field name="model">garment.quality.test.report</field>
        <field name="arch" type="xml">
            <tree string="Test Reports" decoration-danger="result == 'fail'">
                <field name="report_no"/>
                <field name="test_type"/>
                <field name="test_date"/>
                <field name="material_id"/>
                <field name="style_id"/>
                <field name="actual_value"/>
                <field name="result" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_quality_test_report_search" model="ir.ui.view">
        <field name="name">garment.quality.test.report.search</field>
        <field name="model">garment.quality.test.report</field>
        <field name="arch" type="xml">
            <search string="Search Test Reports">
                <field name="report_no"/>
                <field name="material_id"/>
                <field name="style_id"/>
                <filter string="Fail" name="filter_fail" domain="[('result', '=', 'fail')]"/>
                <group expand="0" string="Group By">
                    <filter string="Test Type" name="group_type" context="{'group_by': 'test_type'}"/>
                    <filter string="Result" name="group_result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_quality_test_report" model="ir.actions.act_window">
        <field name="name">Test Reports</field>
        <field name="res_model">garment.quality.test.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first quality test report.</p>
        </field>
    </record>

</odoo>
