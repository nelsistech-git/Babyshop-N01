<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_quality_inspection_form" model="ir.ui.view">
        <field name="name">garment.quality.inspection.form</field>
        <field name="model">garment.quality.inspection</field>
        <field name="arch" type="xml">
            <form string="Quality Inspection">
                <header>
                    <button name="action_start" type="object" string="Start Inspection" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state not in ('in_progress', 'hold')"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"
                            invisible="state not in ('in_progress', 'hold')"/>
                    <button name="action_hold" type="object" string="Hold" class="btn-secondary"
                            invisible="state not in ('in_progress',)"/>
                    <button name="action_release" type="object" string="Release" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_create_capa" type="object" string="Raise CAPA" class="btn-secondary"
                            invisible="state not in ('rejected', 'hold')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,approved,released"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_defects" type="object" class="oe_stat_button" icon="fa-bug">
                            <field name="defect_count" widget="statinfo" string="Defects"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="inspection_no"/>
                        <h1><field name="inspection_no" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="inspection_type"/>
                            <field name="inspection_source"/>
                            <field name="style_id"/>
                            <field name="buyer_id"/>
                            <field name="checkpoint_id"
                                   domain="[('stage', '=', inspection_type)]"/>
                            <field name="standard_id"/>
                        </group>
                        <group>
                            <field name="inspector_id"/>
                            <field name="inspection_date"/>
                            <field name="inspection_method"/>
                            <field name="disposition"/>
                        </group>
                    </group>
                    <group string="Incoming Material" invisible="inspection_type not in ('incoming_material', 'fabric', 'accessory')">
                        <group>
                            <field name="grn_id"/>
                            <field name="grn_line_id"/>
                            <field name="material_id"/>
                            <field name="supplier_id"/>
                        </group>
                        <group>
                            <field name="roll_number"/>
                            <field name="fabric_type"/>
                            <field name="total_meter"/>
                            <field name="four_point_defect_points"/>
                        </group>
                    </group>
                    <group string="Production Floor" invisible="inspection_type not in ('cutting', 'sewing_inline', 'endline', 'washing', 'finishing')">
                        <group>
                            <field name="production_order_id"/>
                            <field name="cutting_batch_no"/>
                        </group>
                        <group>
                            <field name="sewing_line"/>
                            <field name="work_center"/>
                            <field name="operation"/>
                        </group>
                    </group>
                    <group string="Quantities">
                        <group>
                            <field name="quantity"/>
                            <field name="defect_qty" readonly="1"/>
                        </group>
                        <group>
                            <field name="passed_qty" readonly="1"/>
                            <field name="quality_score" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="checklist_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="check_item"/>
                                    <field name="result"/>
                                    <field name="remark"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Measurement Checks">
                            <field name="measurement_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="measurement_point"/>
                                    <field name="size"/>
                                    <field name="spec_value"/>
                                    <field name="tolerance"/>
                                    <field name="actual_value"/>
                                    <field name="result"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Defects">
                            <field name="defect_ids">
                                <tree editable="bottom">
                                    <field name="defect_code_id"/>
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="department"/>
                                    <field name="location"/>
                                    <field name="quantity"/>
                                    <field name="responsible_user_id"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Evidence &amp; Remarks">
                            <group>
                                <field name="photo" widget="image" class="oe_avatar"/>
                            </group>
                            <field name="remarks" nolabel="1" placeholder="Remarks..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_quality_inspection_tree" model="ir.ui.view">
        <field name="name">garment.quality.inspection.tree</field>
        <field name="model">garment.quality.inspection</field>
        <field name="arch" type="xml">
            <tree string="Quality Inspections" decoration-danger="state == 'rejected'" decoration-success="state in ('approved', 'released')" decoration-warning="state == 'hold'">
                <field name="inspection_no"/>
                <field name="inspection_date"/>
                <field name="inspection_type"/>
                <field name="style_id"/>
                <field name="inspector_id"/>
                <field name="quantity"/>
                <field name="defect_qty"/>
                <field name="quality_score"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_quality_inspection_kanban" model="ir.ui.view">
        <field name="name">garment.quality.inspection.kanban</field>
        <field name="model">garment.quality.inspection</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="inspection_no"/>
                <field name="quality_score"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <strong><field name="inspection_no"/></strong>
                            </div>
                            <div><field name="inspection_type"/></div>
                            <div><field name="style_id"/></div>
                            <div class="text-muted">Score: <field name="quality_score"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_garment_quality_inspection_search" model="ir.ui.view">
        <field name="name">garment.quality.inspection.search</field>
        <field name="model">garment.quality.inspection</field>
        <field name="arch" type="xml">
            <search string="Search Inspections">
                <field name="inspection_no"/>
                <field name="style_id"/>
                <field name="inspector_id"/>
                <field name="supplier_id"/>
                <filter string="My Inspections" name="filter_my" domain="[('inspector_id', '=', uid)]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="On Hold" name="filter_hold" domain="[('state', '=', 'hold')]"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('inspection_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Inspection Type" name="group_type" context="{'group_by': 'inspection_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Style" name="group_style" context="{'group_by': 'style_id'}"/>
                    <filter string="Inspector" name="group_inspector" context="{'group_by': 'inspector_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'inspection_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_garment_quality_inspection_pivot" model="ir.ui.view">
        <field name="name">garment.quality.inspection.pivot</field>
        <field name="model">garment.quality.inspection</field>
        <field name="arch" type="xml">
            <pivot string="Inspection Analysis">
                <field name="inspection_type" type="row"/>
                <field name="state" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="defect_qty" type="measure"/>
                <field name="quality_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_garment_quality_inspection_graph" model="ir.ui.view">
        <field name="name">garment.quality.inspection.graph</field>
        <field name="model">garment.quality.inspection</field>
        <field name="arch" type="xml">
            <graph string="Quality Trend" type="line">
                <field name="inspection_date" type="row" interval="week"/>
                <field name="quality_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_garment_quality_inspection" model="ir.actions.act_window">
        <field name="name">Quality Inspections</field>
        <field name="res_model">garment.quality.inspection</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first quality inspection.</p>
        </field>
    </record>

    <record id="action_garment_quality_inspection_incoming" model="ir.actions.act_window">
        <field name="name">Incoming Material Inspections</field>
        <field name="res_model">garment.quality.inspection</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('inspection_type', 'in', ['incoming_material', 'fabric', 'accessory'])]</field>
        <field name="context">{'default_inspection_type': 'incoming_material'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first incoming material inspection.</p>
        </field>
    </record>

    <record id="action_garment_quality_inspection_process" model="ir.actions.act_window">
        <field name="name">In-Process Inspections</field>
        <field name="res_model">garment.quality.inspection</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('inspection_type', 'in', ['cutting', 'sewing_inline', 'endline', 'washing', 'finishing'])]</field>
        <field name="context">{'default_inspection_type': 'sewing_inline'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first in-process inspection.</p>
        </field>
    </record>

</odoo>
