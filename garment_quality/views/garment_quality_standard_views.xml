<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_quality_standard_form" model="ir.ui.view">
        <field name="name">garment.quality.standard.form</field>
        <field name="model">garment.quality.standard</field>
        <field name="arch" type="xml">
            <form string="Quality Standard">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="standard_type"/>
                            <field name="buyer_id"/>
                            <field name="style_id"/>
                        </group>
                        <group>
                            <field name="aql_level"/>
                            <field name="inspection_level"/>
                            <field name="inspection_method"/>
                            <field name="measurement_tolerance"/>
                        </group>
                    </group>
                    <group string="Defect Limits">
                        <field name="defect_limit_critical"/>
                        <field name="defect_limit_major"/>
                        <field name="defect_limit_minor"/>
                    </group>
                    <group string="Packaging &amp; Notes">
                        <field name="packaging_rules" nolabel="1"/>
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_quality_standard_tree" model="ir.ui.view">
        <field name="name">garment.quality.standard.tree</field>
        <field name="model">garment.quality.standard</field>
        <field name="arch" type="xml">
            <tree string="Quality Standards">
                <field name="name"/>
                <field name="standard_type"/>
                <field name="buyer_id"/>
                <field name="aql_level"/>
                <field name="inspection_method"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_quality_standard_search" model="ir.ui.view">
        <field name="name">garment.quality.standard.search</field>
        <field name="model">garment.quality.standard</field>
        <field name="arch" type="xml">
            <search string="Search Quality Standards">
                <field name="name"/>
                <field name="buyer_id"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Standard Type" name="group_type" context="{'group_by': 'standard_type'}"/>
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_quality_standard" model="ir.actions.act_window">
        <field name="name">Quality Standards</field>
        <field name="res_model">garment.quality.standard</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first quality standard.</p>
        </field>
    </record>

</odoo>
