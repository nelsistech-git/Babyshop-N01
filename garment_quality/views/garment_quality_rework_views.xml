<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_quality_rework_form" model="ir.ui.view">
        <field name="name">garment.quality.rework.form</field>
        <field name="model">garment.quality.rework</field>
        <field name="arch" type="xml">
            <form string="Repair / Rework">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,in_repair,completed,re_inspection,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="defect_id"/>
                            <field name="inspection_id"/>
                            <field name="defect_code_id"/>
                            <field name="style_id"/>
                            <field name="garment_ref"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="repair_person_id"/>
                            <field name="repair_start"/>
                            <field name="repair_end"/>
                            <field name="reinspection_result"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_quality_rework_tree" model="ir.ui.view">
        <field name="name">garment.quality.rework.tree</field>
        <field name="model">garment.quality.rework</field>
        <field name="arch" type="xml">
            <tree string="Repair / Rework">
                <field name="name"/>
                <field name="garment_ref"/>
                <field name="defect_code_id"/>
                <field name="quantity"/>
                <field name="repair_person_id"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_quality_rework_search" model="ir.ui.view">
        <field name="name">garment.quality.rework.search</field>
        <field name="model">garment.quality.rework</field>
        <field name="arch" type="xml">
            <search string="Search Rework">
                <field name="name"/>
                <field name="garment_ref"/>
                <field name="repair_person_id"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Repair Person" name="group_repair" context="{'group_by': 'repair_person_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_quality_rework" model="ir.actions.act_window">
        <field name="name">Repair / Rework</field>
        <field name="res_model">garment.quality.rework</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first repair / rework record.</p>
        </field>
    </record>

</odoo>
