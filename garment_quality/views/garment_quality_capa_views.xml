<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_quality_capa_form" model="ir.ui.view">
        <field name="name">garment.quality.capa.form</field>
        <field name="model">garment.quality.capa</field>
        <field name="arch" type="xml">
            <form string="CAPA">
                <header>
                    <button name="action_close" type="object" string="Close CAPA" class="btn-primary"
                            invisible="status == 'closed'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="open,root_cause,action_planned,in_progress,verification,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="capa_no"/>
                        <h1><field name="capa_no" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source"/>
                            <field name="defect_id"/>
                            <field name="inspection_id"/>
                            <field name="complaint_id"/>
                            <field name="audit_id"/>
                        </group>
                        <group>
                            <field name="style_id"/>
                            <field name="supplier_id"/>
                            <field name="department"/>
                            <field name="responsible_id"/>
                            <field name="target_date"/>
                        </group>
                    </group>
                    <group string="Problem Description">
                        <field name="problem_description" nolabel="1"/>
                    </group>
                    <group string="Root Cause Analysis">
                        <field name="root_cause_method"/>
                        <field name="root_cause" nolabel="1"/>
                    </group>
                    <group string="Actions">
                        <field name="corrective_action" nolabel="1" placeholder="Corrective Action..."/>
                        <field name="preventive_action" nolabel="1" placeholder="Preventive Action..."/>
                    </group>
                    <group string="Verification">
                        <group>
                            <field name="verification_date"/>
                            <field name="verified_by_id"/>
                        </group>
                        <group>
                            <field name="verification_result"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Related Root Cause Analyses">
                            <field name="rca_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="method"/>
                                    <field name="root_cause"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_quality_capa_tree" model="ir.ui.view">
        <field name="name">garment.quality.capa.tree</field>
        <field name="model">garment.quality.capa</field>
        <field name="arch" type="xml">
            <tree string="CAPA" decoration-success="status == 'closed'">
                <field name="capa_no"/>
                <field name="source"/>
                <field name="style_id"/>
                <field name="department"/>
                <field name="responsible_id"/>
                <field name="target_date"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_quality_capa_search" model="ir.ui.view">
        <field name="name">garment.quality.capa.search</field>
        <field name="model">garment.quality.capa</field>
        <field name="arch" type="xml">
            <search string="Search CAPA">
                <field name="capa_no"/>
                <field name="style_id"/>
                <field name="responsible_id"/>
                <filter string="Open" name="filter_open" domain="[('status', '!=', 'closed')]"/>
                <filter string="Closed" name="filter_closed" domain="[('status', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_quality_capa" model="ir.actions.act_window">
        <field name="name">CAPA</field>
        <field name="res_model">garment.quality.capa</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first CAPA.</p>
        </field>
    </record>

</odoo>
