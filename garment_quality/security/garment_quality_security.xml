<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_quality" model="ir.module.category">
            <field name="name">Smart Garment ERP - Quality Management</field>
            <field name="sequence">55</field>
        </record>

        <record id="group_quality_production_view" model="res.groups">
            <field name="name">Production Supervisor (View Defects &amp; Actions)</field>
            <field name="category_id" ref="module_category_garment_quality"/>
        </record>

        <record id="group_quality_inspector" model="res.groups">
            <field name="name">QC Inspector (Inspection Entry)</field>
            <field name="category_id" ref="module_category_garment_quality"/>
        </record>

        <record id="group_quality_supervisor" model="res.groups">
            <field name="name">Quality Supervisor (Line Supervision &amp; Defect Action)</field>
            <field name="category_id" ref="module_category_garment_quality"/>
            <field name="implied_ids" eval="[(4, ref('group_quality_inspector'))]"/>
        </record>

        <record id="group_quality_manager" model="res.groups">
            <field name="name">QA Manager (Inspection Planning &amp; Reports)</field>
            <field name="category_id" ref="module_category_garment_quality"/>
            <field name="implied_ids" eval="[(4, ref('group_quality_supervisor'))]"/>
        </record>

        <record id="group_quality_director" model="res.groups">
            <field name="name">Quality Director / Head (Full Access + Configuration)</field>
            <field name="category_id" ref="module_category_garment_quality"/>
            <field name="implied_ids" eval="[(4, ref('group_quality_manager'))]"/>
        </record>

        <!-- Buyers can only view AQL / Final inspections and complaints tied to their own account -->
        <record id="rule_garment_aql_inspection_portal_buyer" model="ir.rule">
            <field name="name">Portal Buyer: Own Buyer AQL Inspections Only</field>
            <field name="model_id" ref="model_garment_aql_inspection"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_quality_complaint_portal_buyer" model="ir.rule">
            <field name="name">Portal Buyer: Own Buyer Complaints Only</field>
            <field name="model_id" ref="model_garment_quality_complaint"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
