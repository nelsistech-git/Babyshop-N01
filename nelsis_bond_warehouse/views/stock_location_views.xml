<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The movement and reconciliation classification fields follow Bond Status
         (Bond Inventory): keep them visible but never editable. -->
    <record id="view_location_form_bond_movement_suite" model="ir.ui.view">
        <field name="name">stock.location.form.bond.movement.suite</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="nelsis_bond_movement.view_location_form_bond"/>
        <field name="arch" type="xml">
            <field name="bond_classification" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>
    <record id="view_location_form_bond_recon_suite" model="ir.ui.view">
        <field name="name">stock.location.form.bond.recon.suite</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="nelsis_bond_reconciliation.view_location_form_bond"/>
        <field name="arch" type="xml">
            <field name="bond_scope" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>
</odoo>
