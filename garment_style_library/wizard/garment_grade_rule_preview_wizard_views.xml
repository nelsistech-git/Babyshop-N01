<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_grade_rule_preview_wizard_form" model="ir.ui.view">
        <field name="name">garment.grade.rule.preview.wizard.form</field>
        <field name="model">garment.grade.rule.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Grade Rule Preview">
                <group>
                    <group>
                        <field name="grade_rule_id" readonly="1"/>
                        <field name="size_set_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="unit" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <tree decoration-bf="is_base_size">
                        <field name="measurement_point"/>
                        <field name="size_code"/>
                        <field name="is_base_size"/>
                        <field name="computed_value"/>
                    </tree>
                </field>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
