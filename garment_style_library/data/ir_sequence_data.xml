<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_style" model="ir.sequence">
        <field name="name">Garment Style Number</field>
        <field name="code">garment.style</field>
        <!-- No prefix/suffix here: the running number is combined in Python with
             Company/Year/Product-Category components to build the configurable
             SRS section 7 format, e.g. ST-2026-KN-000001 (see garment_style.py). -->
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_style_development_request" model="ir.sequence">
        <field name="name">Garment Style Development Request Number</field>
        <field name="code">garment.style.development.request</field>
        <field name="prefix">PDR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_measurement_chart" model="ir.sequence">
        <field name="name">Garment Measurement Chart Number</field>
        <field name="code">garment.measurement.chart</field>
        <field name="prefix">MC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_pattern" model="ir.sequence">
        <field name="name">Garment Pattern Number</field>
        <field name="code">garment.pattern</field>
        <field name="prefix">PAT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_cad_file" model="ir.sequence">
        <field name="name">Garment CAD File Number</field>
        <field name="code">garment.cad.file</field>
        <field name="prefix">CAD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_ecr" model="ir.sequence">
        <field name="name">Garment ECR Number</field>
        <field name="code">garment.ecr</field>
        <field name="prefix">ECR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
