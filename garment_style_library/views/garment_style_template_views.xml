<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_style_template_tree" model="ir.ui.view">
        <field name="name">garment.style.template.tree</field>
        <field name="model">garment.style.template</field>
        <field name="arch" type="xml">
            <tree string="Style Templates">
                <field name="name"/>
                <field name="style_category_id"/>
                <field name="size_set_id"/>
                <field name="grade_rule_id"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_style_template_form" model="ir.ui.view">
        <field name="name">garment.style.template.form</field>
        <field name="model">garment.style.template</field>
        <field name="arch" type="xml">
            <form string="Style Template">
                <header>
                    <button name="action_apply_to_new_style" type="object" string="Create Style From Template"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="style_category_id"/>
                        <field name="size_set_id"/>
                        <field name="grade_rule_id"/>
                    </group>
                    <group>
                        <field name="default_bom_note"/>
                        <field name="packaging_rule_note"/>
                        <field name="label_note"/>
                        <field name="default_tna_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_style_template" model="ir.actions.act_window">
        <field name="name">Style Templates</field>
        <field name="res_model">garment.style.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
