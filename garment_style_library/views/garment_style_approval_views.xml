<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone Approvals list (SRS section 35 Menu Structure > Approvals).
         garment.style.approval already existed as an inline notebook tab on
         the Style form; this adds the cross-style management view. -->
    <record id="view_garment_style_approval_tree" model="ir.ui.view">
        <field name="name">garment.style.approval.tree</field>
        <field name="model">garment.style.approval</field>
        <field name="arch" type="xml">
            <tree string="Style Approvals" decoration-success="status == 'approved'"
                  decoration-danger="status == 'rejected'" decoration-muted="status == 'pending'">
                <field name="style_id"/>
                <field name="approval_step"/>
                <field name="approver_id"/>
                <field name="status" widget="badge"/>
                <field name="signed_date"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_style_approval_form" model="ir.ui.view">
        <field name="name">garment.style.approval.form</field>
        <field name="model">garment.style.approval</field>
        <field name="arch" type="xml">
            <form string="Style Approval">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="status == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary"
                            invisible="status == 'rejected'"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="style_id"/>
                            <field name="approval_step"/>
                            <field name="approver_id"/>
                        </group>
                        <group>
                            <field name="signed_date"/>
                            <field name="electronic_signature" widget="image"/>
                        </group>
                    </group>
                    <field name="comments" placeholder="Comments..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_style_approval_search" model="ir.ui.view">
        <field name="name">garment.style.approval.search</field>
        <field name="model">garment.style.approval</field>
        <field name="arch" type="xml">
            <search string="Search Approvals">
                <field name="style_id"/>
                <field name="approver_id"/>
                <filter string="Pending" name="filter_pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Approved" name="filter_approved" domain="[('status', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('status', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Approval Step" name="group_step" context="{'group_by': 'approval_step'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Style" name="group_style" context="{'group_by': 'style_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_style_approval" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">garment.style.approval</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

</odoo>
