<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_style_color_tree" model="ir.ui.view">
        <field name="name">garment.style.color.tree</field>
        <field name="model">garment.style.color</field>
        <field name="arch" type="xml">
            <tree string="Colorways">
                <field name="style_id"/>
                <field name="colorway_code"/>
                <field name="colorway_name"/>
                <field name="pantone_number"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_style_color" model="ir.actions.act_window">
        <field name="name">Colorways</field>
        <field name="res_model">garment.style.color</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
