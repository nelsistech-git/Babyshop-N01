<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_pattern_tree" model="ir.ui.view">
        <field name="name">garment.pattern.tree</field>
        <field name="model">garment.pattern</field>
        <field name="arch" type="xml">
            <tree string="Patterns">
                <field name="pattern_number"/>
                <field name="pattern_name"/>
                <field name="style_id"/>
                <field name="version"/>
                <field name="pattern_type"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_pattern_form" model="ir.ui.view">
        <field name="name">garment.pattern.form</field>
        <field name="model">garment.pattern</field>
        <field name="arch" type="xml">
            <form string="Pattern">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="pattern_name"/></h1></div>
                    <group>
                        <group>
                            <field name="pattern_number" readonly="1"/>
                            <field name="style_id"/>
                            <field name="version"/>
                            <field name="pattern_type"/>
                            <field name="cad_software"/>
                        </group>
                        <group>
                            <field name="created_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="component_ids"/>
                            <field name="pattern_size"/>
                        </group>
                    </group>
                    <group string="Pattern Properties">
                        <group>
                            <field name="seam_allowance"/>
                            <field name="fabric_grain"/>
                            <field name="notches"/>
                            <field name="drill_marks"/>
                        </group>
                        <group>
                            <field name="piece_quantity"/>
                            <field name="fabric_consumption"/>
                            <field name="marker_efficiency"/>
                        </group>
                    </group>
                    <separator string="Pattern Components Included"/>
                    <group col="4">
                        <field name="comp_front_panel"/>
                        <field name="comp_back_panel"/>
                        <field name="comp_sleeve"/>
                        <field name="comp_collar"/>
                        <field name="comp_cuff"/>
                        <field name="comp_pocket"/>
                        <field name="comp_hood"/>
                        <field name="comp_waistband"/>
                        <field name="comp_rib"/>
                        <field name="comp_facing"/>
                        <field name="comp_placket"/>
                        <field name="comp_belt_loop"/>
                    </group>
                    <field name="component_notes"/>
                    <field name="pattern_file" filename="pattern_filename"/>
                    <field name="pattern_filename" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_pattern" model="ir.actions.act_window">
        <field name="name">Patterns</field>
        <field name="res_model">garment.pattern</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_garment_cad_file_tree" model="ir.ui.view">
        <field name="name">garment.cad.file.tree</field>
        <field name="model">garment.cad.file</field>
        <field name="arch" type="xml">
            <tree string="CAD Files">
                <field name="cad_number"/>
                <field name="style_id"/>
                <field name="marker_type"/>
                <field name="marker_length"/>
                <field name="marker_width"/>
                <field name="marker_efficiency"/>
                <field name="wastage_percent"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_cad_file_form" model="ir.ui.view">
        <field name="name">garment.cad.file.form</field>
        <field name="model">garment.cad.file</field>
        <field name="arch" type="xml">
            <form string="CAD File">
                <sheet>
                    <div class="oe_title"><h1><field name="cad_number" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="style_id"/>
                            <field name="pattern_id"/>
                            <field name="pattern_version"/>
                            <field name="marker_version"/>
                            <field name="marker_type"/>
                        </group>
                        <group>
                            <field name="marker_length"/>
                            <field name="marker_width"/>
                            <field name="fabric_width"/>
                            <field name="marker_efficiency"/>
                            <field name="wastage_percent" readonly="1"/>
                            <field name="total_consumption"/>
                            <field name="cost_impact"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="cad_file" filename="cad_filename"/>
                    <field name="cad_filename" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_cad_file" model="ir.actions.act_window">
        <field name="name">CAD Files</field>
        <field name="res_model">garment.cad.file</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
