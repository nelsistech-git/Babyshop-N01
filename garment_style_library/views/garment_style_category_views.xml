<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_style_category_tree" model="ir.ui.view">
        <field name="name">garment.style.category.tree</field>
        <field name="model">garment.style.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="classification"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_style_category" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">garment.style.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
