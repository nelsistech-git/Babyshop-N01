<odoo>

    <!-- ════════════════════════════════ FORM VIEW ══════════════════════ -->
    <record id="view_purchase_requisition_custom_form" model="ir.ui.view">
        <field name="name">purchase.requisition.custom.form</field>
        <field name="model">purchase.requisition.custom</field>
        <field name="arch" type="xml">
            <form string="Purchase Requisition">

                <header>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Are you sure you want to submit?"/>

                    <button name="action_manager_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="purchase_requisition_custom.group_purchase_requisition_manager"/>

                    <button name="action_done"
                            string="Mark Done"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'approved'"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ('submitted', 'approved')"
                            groups="purchase_requisition_custom.group_purchase_requisition_manager"
                            confirm="Reject this requisition?"/>

                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('rejected', 'submitted')"/>

                    <button name="action_print_report"
                            string="🖨 Print"
                            type="object"
                            class="btn-secondary"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,done"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="PO"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Requisition Info">
                            <field name="requester_id"
                                   string="Requested By"
                                   readonly="state != 'draft'"/>
                            <field name="designation"
                                   string="Designation"
                                   readonly="state != 'draft'"/>
                            <field name="date"
                                   string="Date"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="vendor_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Product Lines" name="lines">
                            <field name="line_ids"
                                   nolabel="1"
                                   readonly="state not in ('draft', 'submitted')">
                                <tree string="Product Lines" editable="bottom">
                                    <field name="product_id"
                                           string="Product Name"
                                           options="{'no_create': True}"/>
                                    <field name="uom_id"
                                           string="Product Type"
                                           readonly="1"/>
                                    <field name="vendor_id"
                                           string="Vendor"
                                           options="{'no_create': True}"/>
                                    <field name="product_code"
                                           string="Product Code"
                                           readonly="1"/>
                                    <field name="present_stock"
                                           string="Product Stock"
                                           readonly="1"
                                           decoration-danger="present_stock == 0"
                                           decoration-warning="present_stock &gt; 0 and present_stock &lt; quantity"
                                           decoration-success="present_stock &gt;= quantity"/>
                                    <field name="last_purchase_price"
                                           string="Last Product Price"
                                           readonly="1"/>
                                    <field name="last_purchase_qty"
                                           string="Last Purchase Qty"
                                           readonly="1"/>
                                    <field name="last_receive_date"
                                           string="Last Purchase Date"
                                           readonly="1"/>
                                    <field name="quantity"
                                           string="Request Quantity"/>
                                    <field name="rate" string="Rate"/>
                                    <field name="amount" string="Amount" readonly="1"/>
                                    <field name="notes" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>

                            <group class="oe_subtotal_footer">
                                <field name="total_amount"
                                       string="Total Amount"
                                       widget="monetary"/>
                            </group>
                        </page>

                        <page string="Notes" name="notes_tab">
                            <field name="notes" placeholder="Internal notes..."/>
                            <field name="rejection_reason"
                                   string="Rejection Reason"
                                   readonly="1"
                                   invisible="state != 'rejected'"/>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════ LIST VIEW ═══════════════════════ -->
    <record id="view_purchase_requisition_custom_list" model="ir.ui.view">
        <field name="name">purchase.requisition.custom.list</field>
        <field name="model">purchase.requisition.custom</field>
        <field name="arch" type="xml">
            <tree string="Purchase Requisitions"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state in ['approved', 'done']"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="date"/>
                <field name="requester_id"/>
                <field name="designation" string="Designation"/>
                <field name="total_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ['approved', 'done']"
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <!-- ════════════════════════════════ SEARCH VIEW ════════════════════ -->
    <record id="view_purchase_requisition_custom_search" model="ir.ui.view">
        <field name="name">purchase.requisition.custom.search</field>
        <field name="model">purchase.requisition.custom</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Requisitions">
                <field name="name" string="PR Number"/>
                <field name="requester_id" string="Requested By"/>
                <filter string="My Requisitions" name="my_requisitions"
                        domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft"     name="draft"     domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved"  name="approved"  domain="[('state','=','approved')]"/>
                <filter string="Done"      name="done"      domain="[('state','=','done')]"/>
                <filter string="Rejected"  name="rejected"  domain="[('state','=','rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status"    name="group_state"     context="{'group_by': 'state'}"/>
                    <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Month"     name="group_month"     context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════ ACTION: ALL ═════════════════════ -->
    <record id="action_purchase_requisition_custom" model="ir.actions.act_window">
        <field name="name">All Purchase Requisitions</field>
        <field name="res_model">purchase.requisition.custom</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_purchase_requisition_custom_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Purchase Requisition
            </p>
        </field>
    </record>

    <!-- ════════════════════════════════ ACTION: MY ══════════════════════ -->
    <record id="action_purchase_requisition_my" model="ir.actions.act_window">
        <field name="name">My Requisitions</field>
        <field name="res_model">purchase.requisition.custom</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_purchase_requisition_custom_search"/>
        <field name="context">{'search_default_my_requisitions': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Purchase Requisition
            </p>
        </field>
    </record>

</odoo>