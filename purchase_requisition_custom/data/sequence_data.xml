<odoo>

    <record id="seq_purchase_requisition_custom" model="ir.sequence">
        <field name="name">Purchase Requisition Sequence</field>
        <field name="code">purchase.requisition.custom</field>
        <field name="prefix">PR-%(year)s-</field>
        <field name="padding">4</field>
