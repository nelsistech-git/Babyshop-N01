<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bond_status_wizard_form" model="ir.ui.view">
        <field name="name">bond.warehouse.status.wizard.form</field>
        <field name="model">bond.warehouse.status.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Action" class="nl-ui">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="action_code" invisible="1"/>
                    <field name="action_label"/>
                    <field name="change_date"/>
                    <field name="reason" placeholder="Reason / authority reference (recorded in the audit trail)"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary nl-btn nl-success" icon="fa-check-circle"/>
                    <button string="Cancel" class="btn-secondary nl-btn nl-ghost" special="cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
