<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_bond_license" model="ir.sequence">
        <field name="name">Bond License</field>
        <field name="code">bond.warehouse.license</field>
        <field name="prefix">BWL/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_license_renewal" model="ir.sequence">
        <field name="name">Bond License Renewal</field>
        <field name="code">bond.warehouse.license.renewal</field>
        <field name="prefix">BWR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_security" model="ir.sequence">
        <field name="name">Bond Security</field>
        <field name="code">bond.warehouse.security</field>
        <field name="prefix">BWS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_entitlement" model="ir.sequence">
        <field name="name">Bond Entitlement</field>
        <field name="code">bond.warehouse.entitlement</field>
        <field name="prefix">BWE/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_amendment" model="ir.sequence">
        <field name="name">Bond Entitlement Amendment</field>
        <field name="code">bond.warehouse.entitlement.amendment</field>
        <field name="prefix">BWA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_utilization" model="ir.sequence">
        <field name="name">Bond Entitlement Utilization</field>
        <field name="code">bond.warehouse.entitlement.utilization</field>
        <field name="prefix">BWU/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
