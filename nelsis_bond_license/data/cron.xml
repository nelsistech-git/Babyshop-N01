<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_bond_license_expiry" model="ir.cron">
        <field name="name">Bond License: expiry check and reminders</field>
        <field name="model_id" ref="model_bond_warehouse_license"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
