<odoo>
    <record id="module_category_bond_warehouse" model="ir.module.category">
        <field name="name">Bond Warehouse</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_bond_license_user" model="res.groups">
        <field name="name">License &amp; Entitlement: Reader</field>
        <field name="category_id" ref="module_category_bond_warehouse"/>
    </record>

    <record id="group_bond_license_officer" model="res.groups">
        <field name="name">License &amp; Entitlement: Officer</field>
        <field name="category_id" ref="module_category_bond_warehouse"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_license_user'))]"/>
    </record>

    <record id="group_bond_license_manager" model="res.groups">
        <field name="name">License &amp; Entitlement: Manager</field>
        <field name="category_id" ref="module_category_bond_warehouse"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_license_officer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
