<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bond_license_tree" model="ir.ui.view">
        <field name="name">bond.warehouse.license.tree</field>
        <field name="model">bond.warehouse.license</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'expired'" decoration-warning="state == 'suspended'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="license_number"/>
                <field name="license_type_id"/>
                <field name="factory_name"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="responsible_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_bond_license_form" model="ir.ui.view">
        <field name="name">bond.warehouse.license.form</field>
        <field name="model">bond.warehouse.license</field>
        <field name="arch" type="xml">
            <form class="nl-ui">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary nl-btn nl-success"
                            invisible="state != 'draft'" groups="nelsis_bond_license.group_bond_license_officer" icon="fa-play-circle"/>
                    <button name="action_new_renewal" string="Apply Renewal" type="object"
                            invisible="state not in ('active', 'expired')" groups="nelsis_bond_license.group_bond_license_officer" class="nl-btn nl-violet" icon="fa-plus-circle"/>
                    <button name="action_suspend" string="Suspend" type="object"
                            invisible="state != 'active'" groups="nelsis_bond_license.group_bond_license_manager" class="nl-btn nl-warning" icon="fa-pause"/>
                    <button name="action_reinstate" string="Reinstate" type="object"
                            invisible="state != 'suspended'" groups="nelsis_bond_license.group_bond_license_manager" class="nl-btn nl-success" icon="fa-play-circle"/>
                    <button name="action_cancel" string="Cancel License" type="object"
                            invisible="state in ('cancelled',)" groups="nelsis_bond_license.group_bond_license_manager" class="nl-btn nl-danger" icon="fa-ban"/>
                    <button name="action_verify_rule" string="Verify Rule Basis" type="object"
                            invisible="rule_verification_status == 'verified'" groups="nelsis_bond_license.group_bond_license_manager" class="nl-btn nl-success" icon="fa-check-circle"/>
                    <button name="action_flag_rule_review" string="Flag for Review" type="object"
                            invisible="rule_verification_status != 'verified'" groups="nelsis_bond_license.group_bond_license_manager" class="nl-btn nl-warning" icon="fa-flag"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired" class="nl-statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button nl-stat" icon="fa-refresh" type="object" name="action_view_renewals">
                            <field name="renewal_count" widget="statinfo" string="Renewals"/>
                        </button>
                        <button class="oe_stat_button nl-stat" icon="fa-shield" type="object" name="action_view_securities">
                            <field name="security_count" widget="statinfo" string="Securities"/>
                        </button>
                        <button class="oe_stat_button nl-stat" icon="fa-balance-scale" type="object" name="action_view_entitlements">
                            <field name="entitlement_count" widget="statinfo" string="Entitlements"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="License">
                            <field name="license_number" readonly="state != 'draft'"/>
                            <field name="license_type_id" readonly="state != 'draft'"/>
                            <field name="factory_category_id" readonly="state not in ('draft', 'active')"/>
                            <field name="company_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Factory and Authority">
                            <field name="factory_name"/>
                            <field name="factory_partner_id"/>
                            <field name="issuing_authority"/>
                            <field name="customs_office"/>
                        </group>
                        <group string="Validity">
                            <field name="issue_date" readonly="state != 'draft'"/>
                            <field name="effective_date" readonly="state != 'draft'"/>
                            <field name="expiry_date" readonly="state != 'draft'"/>
                            <field name="days_to_expiry"/>
                            <field name="renewal_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Authorized Locations" name="locations">
                            <field name="location_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Regulatory Basis" name="rule">
                            <group>
                                <group>
                                    <field name="rule_reference"/>
                                    <field name="rule_source_url" widget="url"/>
                                    <field name="rule_published_date"/>
                                    <field name="rule_effective_date"/>
                                </group>
                                <group>
                                    <field name="rule_verification_status"/>
                                    <field name="rule_verified_by_id"/>
                                    <field name="rule_verified_date"/>
                                </group>
                            </group>
                            <group>
                                <field name="rule_applicability"/>
                                <field name="rule_required_document"/>
                                <field name="rule_reviewer_note"/>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Renewals" name="renewals">
                            <field name="renewal_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="application_date"/>
                                    <field name="previous_expiry_date"/>
                                    <field name="requested_expiry_date"/>
                                    <field name="approval_reference"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Audit Trail" name="history">
                            <field name="history_ids" readonly="1">
                                <tree>
                                    <field name="timestamp"/>
                                    <field name="user_id"/>
                                    <field name="event"/>
                                    <field name="from_state"/>
                                    <field name="to_state"/>
                                    <field name="event_date"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_bond_license_search" model="ir.ui.view">
        <field name="name">bond.warehouse.license.search</field>
        <field name="model">bond.warehouse.license</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="license_number"/>
                <field name="factory_name"/>
                <field name="license_type_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="suspended" string="Suspended" domain="[('state', '=', 'suspended')]"/>
                <filter name="expiring" string="Expiring in 60 days"
                        domain="[('state', '=', 'active'), ('expiry_date', '&lt;=', (context_today() + datetime.timedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="License Type" context="{'group_by': 'license_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bond_license" model="ir.actions.act_window">
        <field name="name">Bond Licenses</field>
        <field name="res_model">bond.warehouse.license</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Renewals -->
    <record id="view_bond_renewal_tree" model="ir.ui.view">
        <field name="name">bond.warehouse.license.renewal.tree</field>
        <field name="model">bond.warehouse.license.renewal</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="license_id"/>
                <field name="application_date"/>
                <field name="previous_expiry_date"/>
                <field name="requested_expiry_date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_bond_renewal_form" model="ir.ui.view">
        <field name="name">bond.warehouse.license.renewal.form</field>
        <field name="model">bond.warehouse.license.renewal</field>
        <field name="arch" type="xml">
            <form class="nl-ui">
                <header>
                    <button name="action_submit" string="Submit Application" type="object" class="btn-primary nl-btn nl-primary"
                            invisible="state != 'draft'" groups="nelsis_bond_license.group_bond_license_officer" icon="fa-paper-plane"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary nl-btn nl-success"
                            invisible="state != 'applied'" groups="nelsis_bond_license.group_bond_license_manager" icon="fa-thumbs-up"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'applied'" groups="nelsis_bond_license.group_bond_license_manager" class="nl-btn nl-danger" icon="fa-times-circle"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,applied,approved" class="nl-statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="license_id" readonly="state != 'draft'"/>
                            <field name="application_date" readonly="state != 'draft'"/>
                            <field name="application_reference" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="previous_expiry_date"/>
                            <field name="requested_expiry_date" readonly="state != 'draft'"/>
                            <field name="approval_reference" readonly="state in ('approved', 'rejected')"/>
                            <field name="decision_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents"><field name="attachment_ids" widget="many2many_binary"/></page>
                        <page string="Audit Trail">
                            <field name="history_ids" readonly="1">
                                <tree>
                                    <field name="timestamp"/><field name="user_id"/><field name="event"/>
                                    <field name="from_state"/><field name="to_state"/><field name="note"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_bond_renewal" model="ir.actions.act_window">
        <field name="name">License Renewals</field>
        <field name="res_model">bond.warehouse.license.renewal</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
