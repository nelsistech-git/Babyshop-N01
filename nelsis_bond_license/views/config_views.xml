<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bond_license_type_tree" model="ir.ui.view">
        <field name="name">bond.license.type.tree</field>
        <field name="model">bond.license.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_bond_license_type" model="ir.actions.act_window">
        <field name="name">License Types</field>
        <field name="res_model">bond.license.type</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="view_bond_factory_category_tree" model="ir.ui.view">
        <field name="name">bond.factory.category.tree</field>
        <field name="model">bond.factory.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_bond_factory_category" model="ir.actions.act_window">
        <field name="name">Factory Categories</field>
        <field name="res_model">bond.factory.category</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
