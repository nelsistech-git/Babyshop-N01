<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_bond_license" model="ir.ui.view">
        <field name="name">res.company.form.bond.license</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Bond Warehouse" name="bond_warehouse">
                    <group>
                        <field name="bond_reminder_days"/>
                        <field name="bond_require_verified_rule"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
