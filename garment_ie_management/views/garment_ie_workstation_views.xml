<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_ie_workstation_form" model="ir.ui.view">
        <field name="name">garment.ie.workstation.form</field>
        <field name="model">garment.ie.workstation</field>
        <field name="arch" type="xml">
            <form string="Workstation">
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code" placeholder="e.g. Line-05-OP-10"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="line_id"/>
                            <field name="operation_id"/>
                            <field name="machine_type"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="table_position"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Setup">
                        <field name="tools"/>
                        <field name="attachments"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_ie_workstation_tree" model="ir.ui.view">
        <field name="name">garment.ie.workstation.tree</field>
        <field name="model">garment.ie.workstation</field>
        <field name="arch" type="xml">
            <tree string="Workstations">
                <field name="code"/>
                <field name="line_id"/>
                <field name="operation_id"/>
                <field name="machine_type"/>
                <field name="employee_id"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_ie_workstation" model="ir.actions.act_window">
        <field name="name">Workstations</field>
        <field name="res_model">garment.ie.workstation</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up your first workstation.</p>
        </field>
    </record>

</odoo>
