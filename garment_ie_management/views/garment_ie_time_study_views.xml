<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_ie_time_study_form" model="ir.ui.view">
        <field name="name">garment.ie.time.study.form</field>
        <field name="model">garment.ie.time.study</field>
        <field name="arch" type="xml">
            <form string="Time Study">
                <header>
                    <button name="action_mark_completed" type="object" string="Mark Completed"
                            class="btn-primary" invisible="status not in ('draft', 'in_progress')"/>
                    <button name="action_update_smv" type="object" string="Update SMV"
                            class="btn-primary" invisible="status != 'completed'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,in_progress,completed,smv_updated"/>
                </header>
                <sheet>
                    <!-- FIXED: Added smv_id with invisible="1" so the button's invisible modifier can evaluate it -->
                    <field name="smv_id" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_smv" type="object"
                                class="oe_stat_button" icon="fa-calculator"
                                invisible="not smv_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Linked SMV</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="study_number"/>
                        <h1><field name="study_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="style_id"/>
                            <field name="operation_id"/>
                            <field name="routing_line_id"/>
                            <field name="work_order_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="line_id"/>
                            <field name="machine_type"/>
                            <field name="date"/>
                            <field name="study_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observations">
                            <field name="observation_ids">
                                <tree editable="bottom">
                                    <field name="cycle_no"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="cycle_time" readonly="1"/>
                                    <field name="rating_factor"/>
                                    <field name="normal_time" readonly="1"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="observation_count" readonly="1"/>
                                <field name="avg_cycle_time" readonly="1"/>
                                <field name="avg_rating_pct" readonly="1"/>
                                <field name="normal_time" readonly="1"/>
                            </group>
                        </page>
                        <page string="Allowances">
                            <field name="allowance_line_ids">
                                <tree editable="bottom">
                                    <field name="allowance_type_id"/>
                                    <field name="percentage"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="allowance_pct" readonly="1"/>
                                <field name="standard_time" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_ie_time_study_tree" model="ir.ui.view">
        <field name="name">garment.ie.time.study.tree</field>
        <field name="model">garment.ie.time.study</field>
        <field name="arch" type="xml">
            <tree string="Time Studies">
                <field name="study_number"/>
                <field name="style_id"/>
                <field name="operation_id"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="observation_count"/>
                <field name="avg_cycle_time"/>
                <field name="standard_time"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_ie_time_study_search" model="ir.ui.view">
        <field name="name">garment.ie.time.study.search</field>
        <field name="model">garment.ie.time.study</field>
        <field name="arch" type="xml">
            <search string="Search Time Studies">
                <field name="study_number"/>
                <field name="style_id"/>
                <field name="operation_id"/>
                <field name="employee_id"/>
                <field name="smv_id"/>
                <group expand="0" string="Group By">
                    <filter string="Style" name="group_style" context="{'group_by': 'style_id'}"/>
                    <filter string="Operation" name="group_operation" context="{'group_by': 'operation_id'}"/>
                    <filter string="Operator" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_ie_time_study" model="ir.actions.act_window">
        <field name="name">Time Studies</field>
        <field name="res_model">garment.ie.time.study</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start your first stopwatch time study.</p>
        </field>
    </record>

</odoo>