<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_ie_allowance_type_form" model="ir.ui.view">
        <field name="name">garment.ie.allowance.type.form</field>
        <field name="model">garment.ie.allowance.type</field>
        <field name="arch" type="xml">
            <form string="Allowance Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="default_pct"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_ie_allowance_type_tree" model="ir.ui.view">
        <field name="name">garment.ie.allowance.type.tree</field>
        <field name="model">garment.ie.allowance.type</field>
        <field name="arch" type="xml">
            <tree string="Allowance Types">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="default_pct"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_ie_allowance_type" model="ir.actions.act_window">
        <field name="name">Allowance Types</field>
        <field name="res_model">garment.ie.allowance.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a Personal / Fatigue / Delay / Machine Delay allowance type.</p>
        </field>
    </record>

</odoo>
