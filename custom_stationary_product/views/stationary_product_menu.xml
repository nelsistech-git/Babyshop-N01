<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Menu Structure (standalone app):
         Accessories  (new top-level app, separate icon on dashboard)
           └─ Products  (leaf menu → action)
    ============================================================ -->

    <!-- Root app menu: NO parent → shows as its own icon -->
    <menuitem
        id="menu_stationary_product_root"
        name="Accessories"
        web_icon="custom_stationary_product,static/description/icon.png"
        sequence="25"
        groups="base.group_user"
    />

    <!-- Child menu: "Products" under Accessories -->
    <menuitem
        id="menu_stationary_products_list"
        name="Products"
        parent="menu_stationary_product_root"
        action="action_stationary_products"
        sequence="10"
        groups="base.group_user"
    />
</odoo>
