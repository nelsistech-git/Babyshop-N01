<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div style="margin-top: 80px; page-break-inside: avoid;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td style="width: 33%; text-align: center; padding: 10px 20px;">
                            <div style="border-top: 1px solid black; padding-top: 8px; margin-top: 50px;">
                                <strong>Submitted By</strong>
                            </div>
                        </td>
                        <td style="width: 33%; text-align: center; padding: 10px 20px;">
                            <div style="border-top: 1px solid black; padding-top: 8px; margin-top: 50px;">
                                <strong>Checked By</strong>
                            </div>
                        </td>
                        <td style="width: 33%; text-align: center; padding: 10px 20px;">
                            <div style="border-top: 1px solid black; padding-top: 8px; margin-top: 50px;">
                                <strong>Approved By</strong>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
