<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="inherited_view_stock_quant_tree_editable_inherit_cus_product_common" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="edit">0</attribute>
            </xpath>
        </field>
    </record>
    <record id="inherited_quant_search_view" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='owner_id']" position="after">
                <field name="brand_id"/>
                <field name="item_group_id"/>
                <field name="categ_id"/>
            </xpath>
            <xpath expr="//filter[@name='internal_loc']" position="attributes">
                <attribute name="domain">[('location_id.usage','=', 'internal'),('location_id.type','!=', 'project')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>