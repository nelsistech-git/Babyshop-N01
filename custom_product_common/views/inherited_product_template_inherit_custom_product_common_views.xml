<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <data>
        <record model="ir.actions.act_window" id="action_view_quantity">
            <field name="name">Update Quantity</field>
            <field name="res_model">stock.quant</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('product_id.product_tmpl_id','=',context.get('active_id'))]</field>
            <field name="context">{'search_default_internal_loc': 1}</field>
            <field name="view_id" ref="stock.view_stock_quant_tree"/>
        </record>

        <record id='product_template_inherit_custom_product_common_form_view' model='ir.ui.view'>
            <field name='name'>product.template.inherit.custom.product.common.form.view</field>
            <field name='model'>product.template</field>
            <field name='inherit_id' ref='product.product_template_form_view'/>
            <field name='arch' type='xml'>
                <xpath expr="//form/header" position="inside">
                    <!--<button name="action_confirm_pro" id="action_confirm_pro" class="btn-primary" type="object" string="Confirm" attrs="{'invisible': ['|', ('is_product_variant', '!=', False), ('state', 'in', ['confirm', 'approve'])]}" groups="custom_product_common.group_user, custom_product_common.group_manager"/>-->
                    <button name="action_confirm" invisible="state not in ('draft')" id="action_confirm" class="btn-primary" type="object" string="Confirm"  groups="custom_product_common.group_user, custom_product_common.group_manager"/>
                    <button name="action_approve" invisible="state not in ('confirm')" id="action_approve" class="btn-primary" type="object" string="Approve" groups="custom_product_common.group_manager"/>
                    <button name="action_draft" type="object" string="Set to Draft" invisible="state not in ('confirm')"  groups="custom_product_common.group_product_controller"/>
                    <button name="action_regen_barcode" type="object" string="Barcode Regenerate"  groups="custom_product_common.group_user, custom_product_common.group_manager"/>
                    <button name="action_get_cat_code" type="object" string="Get Category Code"  groups="custom_product_common.group_product_controller"/>
                    <button name="action_get_product_code" type="object" string="Get Product Code" groups="custom_product_common.group_product_controller"/>
                    <button name="%(custom_product_common.action_view_quantity)d" class="btn-primary" type="action" string="View Quantity"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,approve"/>
                </xpath>

                <xpath expr="//field[@name='detailed_type']" position="after">
                    <group>
                        <field name="product_group"/>
                        <field name="product_code" readonly="1" force_save="1"/>
                        <field name="vendor_product_code" readonly="1" force_save="1"/>
                        <field name="is_old_product" invisible="1"/>
                        <field name="product_old_code" invisible="1"/>
                    </group>
                </xpath>

                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="product_common_name_id" invisible="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                    <field name="default_qty" invisible="1" readonly="1" force_save="1"/>
                    <field name="parent_categ_id" invisible="1" readonly="1" force_save="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                    <field name="category_code" readonly="1" force_save="1" string="Product Category Code"/>
                    <field name="ratio_type"/>
                    <field name="is_default_discount_product"/>
                    <field name="is_default_product" invisible="1"/>
                    <field name="roll_no"/>
                    <field name="gsm_id" options="{'no_open':True,'no_create_edit':1}"/>
                    <field name="width"/>
                    <field name="composition"/>
                </xpath>

                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="fabric_code"/>
                </xpath>

                <xpath expr="//field[@name='type']" position="after">
                    <field name="country_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                </xpath>

                <xpath expr="//field[@name='uom_id']" position="attributes">
<!--                    <attribute name="attrs">{'readonly': [('state', '=', 'approve')]}</attribute>-->
                    <attribute name="options">{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
                </xpath>

<!--                <xpath expr="//form/sheet/notebook/page[1]/group[1]/group[@name='group_general']/field[@name='categ_id']" position="after">-->
<!--                    <field name="category_code" readonly="1" force_save="1" string="Product Category Code"/>-->
<!--                </xpath>-->

<!--                <xpath expr="//form/sheet/notebook/page[1]/group[1]/group[@name='group_standard_price']/div[1]/field[@name='list_price']" position="attributes">-->
<!--                    <attribute name="readonly">1</attribute>-->
<!--                </xpath>-->

<!--                <xpath expr="//form/sheet/notebook/page[@name='general_information']/group[1]/group[1]/field[@name='type']" position="attributes">-->
<!--                    <attribute name="attrs">{'readonly':[('state','not in',['draft'])]}</attribute>-->
<!--                </xpath>-->

<!--                <xpath expr="//form/sheet/notebook/page[@name='general_information']/group[1]/group[1]/field[@name='categ_id']" position="attributes">-->
<!--                    <attribute name="attrs">{'readonly':[('state','not in',['draft'])]}</attribute>-->
<!--                    <attribute name="options">{'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>-->
<!--                </xpath>-->

<!--                <xpath expr="//form/sheet/notebook/page[1]/group[1]/group[@name='group_general']/field[@name='type']" position="after">-->
<!--&lt;!&ndash;                    <field name="product_group" attrs="{'readonly':[('state','=','approve')]}" required="1"/>&ndash;&gt;-->
<!--                    <field name="product_item_group_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>-->
<!--                    <field name="product_item_group_type_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>-->
<!--&lt;!&ndash;                    <field name="material_type" attrs="{'readonly':[('state','=','approve')]}"/>&ndash;&gt;-->
<!--                </xpath>-->

            </field>
        </record>

		<record id='product_template_tree_view_inherit_custom_product_common' model='ir.ui.view'>
            <field name='name'>product.template.product.tree.inherit.custom_product_common</field>
            <field name='model'>product.template</field>
            <field name='inherit_id' ref='product.product_template_tree_view'/>
            <field name='arch' type='xml'>
                <xpath expr="//tree/field[@name='barcode']" position="before">
                        <field name="product_code"/>
                        <field name="product_old_code" invisible="1"/>
                        <field name="is_old_product" invisible="1"/>
                </xpath>
                <xpath expr="//tree/field[@name='uom_id']" position="after">
                        <field name="state" string="Status"/>
                </xpath>
                <xpath expr="//tree/field[@name='uom_id']" position="before">
                        <field name="default_qty" invisible="1"/>
                </xpath>
                <xpath expr="//tree/field[@name='name']" position="after">
                    <field name="categ_id" string="Category"/>
                    <field name="type" string="Type"/>
                    <field name="product_group" string="Group"/>
                </xpath>
                <xpath expr="//tree/field[@name='state']" position="after">
                    <!-- View Quantity Button in Tree View -->
                    <button name="%(custom_product_common.action_view_quantity)d" class="btn-primary" type="action" string="View Quantity"/>
                </xpath>
            </field>
        </record>

		<record id='product_product_tree_view_inherit_custom_product_common' model='ir.ui.view'>
            <field name='name'>product.product.tree.inherit.custom_product_common</field>
            <field name='model'>product.product</field>
            <field name='inherit_id' ref='product.product_product_tree_view'/>
            <field name='arch' type='xml'>
                <xpath expr="//tree/field[@name='uom_id']" position="before">
                    <field name="default_qty" invisible="1"/>
                </xpath>
                <xpath expr="//tree/field[@name='name']" position="after">
                    <field name="product_group"/>
                </xpath>
            </field>
        </record>

        <record id='product_template_product_variants_view_inherit_custom_product_common' model='ir.ui.view'>
            <field name='name'>product.template.product.variants.view.inherit.custom.product.common</field>
            <field name='model'>product.template</field>
            <field name='inherit_id' ref='product.product_template_only_form_view'/>
            <field name='arch' type='xml'>
                <xpath expr="//field[@name='attribute_id']" position="attributes">
                        <attribute name="options">{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
                </xpath>
            </field>
        </record>

        <record id='product_template_inherit_custom_product_common_kanban_view' model='ir.ui.view'>
            <field name='name'>product.template.inherit.custom.product.common.kanban.view</field>
            <field name='model'>product.template</field>
            <field name='inherit_id' ref='product.product_template_kanban_view'/>
            <field name='arch' type='xml'>
                <xpath expr="//kanban/templates/t/div[1]/div[2]/div[1]" position="before">
                    <ul>
                        <li>Product Name: <field name="name"/></li>
                        <li>Product Category: <field name="categ_id"/></li>
                        <li>Color: <field name="color_id"/></li>
                    </ul>
                </xpath>
            </field>
        </record>

        <record id="product_template_inherit_custom_prod_common_search_view" model="ir.ui.view">
	        <field name="name">product.template.custom.product.common.search.view</field>
	        <field name="model">product.template</field>
	        <field name="inherit_id" ref="product.product_template_search_view"/>
	        <field name="arch" type="xml">
	            <xpath expr="//field[@name='name']" position="replace">
                    <field name="name" string="Single Product" filter_domain="['|', '|', '|', ('default_code', '=', self), ('product_variant_ids.default_code', '=', self),('name', '=', self), ('barcode', '=', self)]"/>
                    <field name="name" string="Product" filter_domain="['|', '|', '|', ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self),('name', 'ilike', self), ('barcode', 'ilike', self)]"/>
                    <field name="product_code" string="Product Code"/>
                    <field name="product_old_code" string="Product Old Code"/>
                    <field name="vendor_product_code" string="Vendor Product Code"/>
                    <field name="list_price" string="Sale Price" filter_domain="[('list_price', '=', self)]"/>
	            </xpath>
	            <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="color_id"/>
<!--                    <field name="size_id"/>-->
                     <field name="product_item_group_id"/>
                    <field name="product_item_group_type_id"/>
	            </xpath>
                <xpath expr="//search/filter[@name='filter_to_sell']" position="before">
                    <filter string="Parts/Materials" name="parts" domain="[('product_group','=','parts')]"/>
                    <filter string="Products (Group)" name="products" domain="[('product_group','=','product')]"/>
<!--                    <separator/>-->
<!--                    <filter string="No Variants" name="filter_no_variants" domain="[('product_variant_count','=' ,1 )]"/>-->
                    <separator/>
                    <filter string="Is Old Product" name="filter_old_product" domain="[('is_old_product','=',True)]"/>
<!--                    <filter string="No Variants" name="filter_no_variants" domain="[('product_variant_count','=' ,1 )]"/>-->
                    </xpath>
                <xpath expr="//search/filter[@name='filter_to_sell']" position="after">
                        <filter string="Cannot be Sold" name="filter_to_not_sell" domain="[('sale_ok','=',False)]"/>
                    </xpath>
                </field>
            </record>
    </data>
</odoo>