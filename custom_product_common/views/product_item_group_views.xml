<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_item_group_form" model="ir.ui.view">
            <field name="name">product.item.group.form</field>
            <field name="model">product.item.group</field>
            <field name="arch" type="xml">
                <form string="Product Item Group Form">
                    <sheet>
                        <group>
                        	<group>
	                            <field name="name" string = "Name"/>
	                            <field name="code" string = "Code"/>
	                            <field name="description" string = "Description"/>
	                            <field name="active" string = "Status"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_product_item_group_tree" model="ir.ui.view">
            <field name="name">product.item.group.tree</field>
            <field name="model">product.item.group</field>
            <field name="arch" type="xml">
                <tree string="Product Item Group">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_product_item_group" model="ir.actions.act_window">
            <field name="name">Product Item Group</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.item.group</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Product Item Group!
              </p><p>
                The Product Item Group contains the Product's Group!
              </p>
            </field>
        </record>

        <menuitem id="menu_product_item_group" name="Product Item Group"
        parent="purchase.menu_purchase_products" groups="base.group_erp_manager"
        action="action_product_item_group" sequence="39"/>


        <!--Item group Common Type-->
        <record id="view_product_item_group_type_form" model="ir.ui.view">
            <field name="name">product.item.group.type.form</field>
            <field name="model">product.item.group.type</field>
            <field name="arch" type="xml">
                <form string="Product Item Common type Form">
                    <sheet>
                        <group>
                        	<group>
	                            <field name="name" string = "Name"/>
	                            <field name="code" string = "Code"/>
	                            <field name="description" string = "Description"/>
	                            <field name="active" string = "Status"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_product_item_group_type_tree" model="ir.ui.view">
            <field name="name">product.item.group.type.tree</field>
            <field name="model">product.item.group.type</field>
            <field name="arch" type="xml">
                <tree string="Product Item Common type">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_product_item_group_type" model="ir.actions.act_window">
            <field name="name">Product Item Common Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.item.group.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Product Item Common type!
              </p><p>
                The Product Item Common type contains the Product's Common type!
              </p>
            </field>
        </record>

        <menuitem id="menu_product_item_group_type" name="Product Item Common Type"
        parent="purchase.menu_purchase_products" groups="base.group_erp_manager"
        action="action_product_item_group_type" sequence="40"/>
    </data>
</odoo>

