<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_size_from_view" model="ir.ui.view">
            <field name="name">product.size.from</field>
            <field name="model">product.size</field>
            <field name="arch" type="xml">
                <form string="Product size Form">
                    <sheet>
                        <group>
	                        <group>
	                            <field name="name" string = "Name"/>
	                            <field name="code" string = "Code"/>
	                            <field name="description" string = "Description"/>
	                            <field name="active" string = "Status"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
		
        <record id="product_size_tree_view" model="ir.ui.view">
            <field name="name">product.size.tree</field>
            <field name="model">product.size</field>
            <field name="arch" type="xml">
                <tree string="Product size">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="product_size_action" model="ir.actions.act_window">
            <field name="name">Product size</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.size</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Product size!
              </p><p>
                The Product size contains the Product's size.
              </p>
            </field>
        </record>

        <menuitem id="product_size_menu" name="Product Size"
        parent="purchase.menu_purchase_products" groups="base.group_erp_manager"
        action="product_size_action" sequence="36"/>
    </data>
</odoo>

