<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_brand_common_from_view" model="ir.ui.view">
        <field name="name">product.brand.from</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
                <form string="Product Brand Form">
                    <sheet>
                    	<group>
	                        <group>
	                            <field name="name" string = "Name"/>
	                            <field name="code" string = "Code"/>
	                            <field name="detail" string="Description"/>
	                    		<field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
	                            <field name="active" string = "Status"/>
	                        </group>
	                        <group>
	                        </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
		
        <record id="product_brand_common_tree_view" model="ir.ui.view">
            <field name="name">product.brand.tree</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <tree string="Product Brand" delete="0">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="detail" />
                    <field name="image_1920" />
                    <field name="active"/>
                </tree>
            </field>
        </record>
        <record id="product_brand_common_action" model="ir.actions.act_window">
            <field name="name">Product Brand</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.brand</field>
            <field name="view_mode">tree,form,graph</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Product Brand!
              </p><p>
                The Product Brand contains the Product's Style.
              </p>
            </field>
        </record>
		
<!--        <menuitem id="product_brand_common_menu" name="Product Brand"-->
<!--        parent="purchase.menu_purchase_products"-->
<!--        action="custom_product_common.product_brand_common_action" sequence="30"/>-->
    </data>
</odoo>