<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_color_from_view" model="ir.ui.view">
            <field name="name">product.color.from</field>
            <field name="model">product.color</field>
            <field name="arch" type="xml">
                <form string="Product Color Form">
                    <sheet>
                        <group>
                        	<group>
	                            <field name="name" string = "Name"/>
	                            <field name="code" string = "Code"/>
	                            <field name="description" string = "Description"/>
	                            <field name="active" string = "Status"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
		
        <record id="product_color_tree_view" model="ir.ui.view">
            <field name="name">product.color.tree</field>
            <field name="model">product.color</field>
            <field name="arch" type="xml">
                <tree string="Product Color">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="product_color_action" model="ir.actions.act_window">
            <field name="name">Product Color</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.color</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Product Color!
              </p><p>
                The Product Color contains the Product's Color.
              </p>
            </field>
        </record>

        <menuitem id="product_color_menu" name="Product Color"
        parent="purchase.menu_purchase_products" groups="base.group_erp_manager"
        action="product_color_action" sequence="34"/>
    </data>
</odoo>

