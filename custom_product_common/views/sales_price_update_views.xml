<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Price Update Form View -->
    <record id="view_sales_price_update_form" model="ir.ui.view">
        <field name="name">sales.price.update.form</field>
        <field name="model">sales.price.update</field>
        <field name="arch" type="xml">
            <form string="Sales Price Update Form" create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="currency_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="rate" attrs="{'invisible':['|', ('currency','=', False), ('currency','=', 'BDT')]}"/>
                            <field name="foreign_sales_price" attrs="{'invisible':['|', ('currency','=', False), ('currency','=', 'BDT')]}"/>
                            <field name="currency" invisible="1"/>
                            <field name="old_sales_price"/>
                            <field name="new_sales_price"/>
                        </group>
                        <group>
                            <field name="cost_price" readonly="1" force_save="1"/>
                            <field name="other_cost_price" readonly="1" force_save="1"/>
                            <field name="total_cost_price" readonly="1" force_save="1"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <!-- Sales Price Update Tree View -->
    <record id="view_sales_price_update_tree" model="ir.ui.view">
        <field name="name">sales.price.update.tree</field>
        <field name="model">sales.price.update</field>
        <field name="arch" type="xml">
            <tree string="Updated Product Sales Price" create="false" delete="false">
                <field name="product_id" readonly="1" string="Product Name"/>
                <field name="old_sales_price" readonly="1" string="Old Sales Price"/>
                <field name="new_sales_price" readonly="1" string="New Sales Price"/>
                <field name="cost_price" readonly="1" string="Cost Price"/>
                <field name="other_cost_price" readonly="1" string="Other Cost Price"/>
                <field name="total_cost_price" readonly="1" string="Total Cost Price"/>
                <field name="currency_id" readonly="1"/>
                <field name="create_uid" readonly="1" string="Created By"/>
                <field name="create_date" readonly="1" string="Created Date"/>
                <field name="approved_by_id" readonly="1" string="Approved By"/>
            </tree>
        </field>
    </record>

    <record id="view_sales_price_update_filter" model="ir.ui.view">
        <field name="name">sales.price.update.filter</field>
        <field name="model">sales.price.update</field>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <search string="Search Product Name">
                <field name="product_id" string="Product Name" filter_domain="[('product_id', 'ilike', self)]"/>
           </search>
        </field>
    </record>

    <record id="sales_price_update_action" model="ir.actions.act_window">
        <field name="name">Sales Price Update</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sales.price.update</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set an updated price for a product!
            </p>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_product_sale_price_update">
            <field name="name">Product Sales Price Update</field>
            <field name="res_model">sales.price.update.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_product_id': active_id}</field>
    </record>

    <record id='product_product_form_view_inherited_iuo' model='ir.ui.view'>
        <field name='name'>product.template.form.inherit</field>
        <field name='model'>product.template</field>
        <field name='inherit_id' ref='product.product_template_only_form_view'/>
        <field name='arch' type='xml'>
            <xpath expr="//field[@name='list_price']" position="after">
                <span style="padding-left: 10px;" name="product_sale_price_update">
                  <button name="%(action_product_sale_price_update)d" string="Updates" type="action" class="btn-primary"/>
                </span>
            </xpath>
        </field>
    </record>

</odoo>