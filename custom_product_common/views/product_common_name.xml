<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_common_name_tree_view" model="ir.ui.view">
            <field name="name">product.common.name.tree</field>
            <field name="model">product.common.name</field>
            <field name="arch" type="xml">
                <tree editable="bottom" string="Product Common Name" delete="0">
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>
        <record id="product_common_name_action" model="ir.actions.act_window">
            <field name="name">Product Common Name</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.common.name</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Product Common Name!
              </p>
            </field>
        </record>
		
        <menuitem id="product_common_name_po_menu_id" name="Product Common Name" sequence="90" parent="purchase.menu_purchase_products" action="product_common_name_action"/>
    </data>
</odoo>