<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="product_gsm_tree_view" model="ir.ui.view">
            <field name="name">product.gsm.tree.view</field>
            <field name="model">product.gsm</field>
            <field name="arch" type="xml">
                <tree string="GSM Values" editable="bottom">
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_product_gsm" model="ir.actions.act_window">
            <field name="name">GSM Values</field>
            <field name="res_model">product.gsm</field>
            <field name="view_mode">tree</field>
        </record>
    </data>
</odoo>