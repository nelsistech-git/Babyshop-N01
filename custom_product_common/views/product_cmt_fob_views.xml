<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_cmt_fob_from_view" model="ir.ui.view">
            <field name="name">product.cmt.fob.from</field>
            <field name="model">product.cmt.fob</field>
            <field name="arch" type="xml">
                <form string="Product CMT-FOB Form">
                    <sheet>
                        <group>
                        	<group>
	                            <field name="name" string = "Name"/>
	                            <field name="code" string = "Code"/>
	                            <field name="description" string = "Description"/>
	                            <field name="active" string = "Status"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
		
        <record id="product_cmt_fob_tree_view" model="ir.ui.view">
            <field name="name">product.cmt.fob.tree</field>
            <field name="model">product.cmt.fob</field>
            <field name="arch" type="xml">
                <tree string="Product cmt_fob">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="product_cmt_fob_action" model="ir.actions.act_window">
            <field name="name">Product CMT/FOB</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.cmt.fob</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Product cmt_fob!
              </p><p>
                The Product cmt_fob contains the Product's cmt_fob.
              </p>
            </field>
        </record>

        <menuitem id="product_cmt_fob_menu" name="Product CMT/FOB"
        parent="purchase.menu_purchase_products" groups="base.group_erp_manager"
        action="product_cmt_fob_action" sequence="38"/>
    </data>
</odoo>

