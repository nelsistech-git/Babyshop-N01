<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <data>
        <record id='view_inherited_product_uom_inherit_custom_product_common_form' model='ir.ui.view'>
            <field name='name'>inherited.product.uom.inherit.custom.product.common.form</field>
            <field name='model'>uom.uom</field>
            <field name='inherit_id' ref='uom.product_uom_form_view'/>
            <field name='arch' type='xml'>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="uom_code"/>
                </xpath>
                <xpath expr="//field[@name='category_id']" position="attributes">
                    <attribute name="options">{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>