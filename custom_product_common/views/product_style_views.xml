<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_style_from_view" model="ir.ui.view">
            <field name="name">product.style.from</field>
            <field name="model">product.style</field>
            <field name="arch" type="xml">
                <form string="Product Style Form">
                    <sheet>
                        <group>
                        	<group>
	                            <field name="name" string = "Name"/>
	                            <field name="code" string = "Code"/>
	                            <field name="description" string = "Description"/>
	                            <field name="active" string = "Status"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_style_tree_view" model="ir.ui.view">
            <field name="name">product.style.tree</field>
            <field name="model">product.style</field>
            <field name="arch" type="xml">
                <tree string="Product Model">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="product_style_action" model="ir.actions.act_window">
            <field name="name">Product Model</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.style</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Product Style!
              </p><p>
                The Product Style contains the Product's Style.
              </p>
            </field>
        </record>

        <menuitem id="product_style_menu" name="Product Style"
        parent="purchase.menu_purchase_products"
        action="product_style_action" sequence="32"/>
    </data>
</odoo>