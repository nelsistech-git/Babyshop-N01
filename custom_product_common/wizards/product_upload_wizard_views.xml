<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_upload_wizard_form" model="ir.ui.view">
        <field name="name">view.product.upload.wizard.form</field>
        <field name="model">product.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Upload">
                <group>
                    <group>
                        <field name="upload_csv_file" help="CSV format with columns(Category, Barcode, Product Name, UoM, Cost Price, Sale Price)"/>
                        <field name="upload_des" attrs="{'invisible':[('upload_des','=',False)]}" readonly="1"/>
                    </group>
                    <group>
                        <field name="state" required="1"/>
                        <field name="is_old_product"/>
                    </group>
                </group>
                <footer>
                    <button name="action_product_upload" type="object" string=" Upload"
                        class="oe_highlight fa fa-upload" confirm="Are you sure you want to upload?"/>
                    <button name="action_sample_download" class="oe_highlight fa fa-download" type="object" string=" Sample"/>
                    <button string="Cancel" special="cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Product Upload Wizard Action -->
    <record id="action_product_upload_wizard" model="ir.actions.act_window">
        <field name="name">Product Upload</field>
        <field name="res_model">product.upload.wizard</field>
        <field name="view_mode">form</field>
<!--        <field name="view_id" ref="custom_product_common.view_product_upload_wizard_form"/>-->
        <field name="target">new</field>
    </record>

    <!-- Product Upload Wizard menu -->
    <menuitem id="menu_product_upload_wizard" name="Product Upload" parent="purchase.menu_purchase_products" action="action_product_upload_wizard" sequence="50"/>
</odoo>