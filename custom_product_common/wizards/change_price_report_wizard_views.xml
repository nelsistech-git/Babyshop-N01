<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_change_price_report_wizard_form" model="ir.ui.view">
            <field name="name">change.price.report.wizard.form</field>
            <field name="model">change.price.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Sale Price Change Report">
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <footer>
                        <button name="change_price_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="change_price_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Sale Price Change Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">change.price.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_change_price_report_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>