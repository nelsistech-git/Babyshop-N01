<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Price Update Form View -->
    <record id="view_sales_price_update_wizard_form" model="ir.ui.view">
        <field name="name">sales.price.update.wizard.form</field>
        <field name="model">sales.price.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Price Update Form">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" domain="[('sale_ok', '=', True), ('state', '=', 'approve')]" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="currency_id" required="1" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                            <field name="currency" invisible="1"/>
                            <field name="rate" required="1" attrs="{'invisible':['|', ('currency','=', False), ('currency','=', 'BDT')]}"/>
                            <field name="foreign_sales_price" attrs="{'invisible':[('currency','=', 'BDT')], 'required':[('currency','!=', 'BDT')]}"/>
                            <field name="old_sales_price" readonly="1" force_save="1"/>
                            <field name="new_sales_price" attrs="{'readonly':[('currency','!=', 'BDT')]}" force_save="1"/>
                        </group>
                        <group>
                            <field name="cost_price" readonly="1" force_save="1"/>
                            <field name="other_cost_price" readonly="1" force_save="1"/>
                            <field name="total_cost_price" readonly="1" force_save="1"/>
                            <field name="approved_by_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}"/>
                        </group>
                    </group>
                    <h4 class="text-center" attrs="{'invisible': [('warning_msg', '=', False)]}">
                        <strong><field name="warning_msg" style="color:red ! important;" readonly="1"/></strong>
                    </h4>
                    <h4 class="text-center" attrs="{'invisible': [('success_msg', '=', False)]}">
                        <strong><field name="success_msg" style="color:green ! important;" readonly="1"/></strong>
                    </h4>
                </sheet>
                <footer>
                    <button name="action_confirm" id="action_confirm_save" class="btn-primary" type="object" string="Confirm &amp; Save" confirm="Are you sure you want to confirm and save? Before confirming you need to check your stock." context="{'is_confirmed': True}"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>