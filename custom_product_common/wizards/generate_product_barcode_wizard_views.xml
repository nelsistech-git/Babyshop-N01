<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_generate_product_barcode_wizard_form" model="ir.ui.view">
            <field name="name">generate.product.barcode.wizard.form</field>
            <field name="model">generate.product.barcode.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate Product Barcode">
                    <sheet>
                        <group>
                            <group col="2">
                                <field name="report_type" widget="radio"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_generate" string="Generate" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="generate_product_barcode_wizard_action" model="ir.actions.act_window">
            <field name="name">Generate Product Code/Barcode</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">generate.product.barcode.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_generate_product_barcode_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!-- Generate Product Barcode menu -->
        <menuitem id="menu_generate_product_barcode_wizard" name="Generate Product Code/Barcode" parent="purchase.menu_purchase_products" action="generate_product_barcode_wizard_action" sequence="50" groups="custom_product_common.group_manager"/>
    </data>
</odoo>