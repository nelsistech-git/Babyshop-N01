<odoo>
    <record id="module_category_bond_movement" model="ir.module.category">
        <field name="name">Bond Warehouse Movements</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_bond_movement_user" model="res.groups">
        <field name="name">Preparer</field>
        <field name="category_id" ref="module_category_bond_movement"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Prepares, submits and cancels bond movement documents.</field>
    </record>

    <record id="group_bond_movement_manager" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_bond_movement"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_movement_user'))]"/>
        <field name="comment">Approves, validates and reverses documents (cannot approve own documents).</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_bond_movement_controller" model="res.groups">
        <field name="name">Bond Classification Controller</field>
        <field name="category_id" ref="module_category_bond_movement"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_movement_manager'))]"/>
        <field name="comment">Authorizes reclassification, over-return exceptions and location bond settings.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_bond_movement_company" model="ir.rule">
        <field name="name">Bond Movement: multi-company</field>
        <field name="model_id" ref="model_bond_warehouse_movement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
