<odoo>
    <record id="view_location_form_bond" model="ir.ui.view">
        <field name="name">stock.location.form.bond</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='usage']" position="after">
                <field name="bond_classification"/>
                <field name="bond_movement_allowed"/>
            </xpath>
        </field>
    </record>
</odoo>
