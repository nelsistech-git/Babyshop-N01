<odoo noupdate="1">
    <record id="seq_bond_movement_transfer" model="ir.sequence">
        <field name="name">Bond Transfer</field>
        <field name="code">bond.warehouse.movement.transfer</field>
        <field name="prefix">BTR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_movement_issue" model="ir.sequence">
        <field name="name">Bond Material Issue</field>
        <field name="code">bond.warehouse.movement.issue</field>
        <field name="prefix">BIS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_movement_return" model="ir.sequence">
        <field name="name">Bond Material Return</field>
        <field name="code">bond.warehouse.movement.return</field>
        <field name="prefix">BRT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_movement_adjustment" model="ir.sequence">
        <field name="name">Bond Stock Adjustment</field>
        <field name="code">bond.warehouse.movement.adjustment</field>
        <field name="prefix">BAD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="location_bond_consumption" model="stock.location">
        <field name="name">Bond Consumption</field>
        <field name="usage">production</field>
        <field name="location_id" ref="stock.stock_location_locations_virtual"/>
        <field name="company_id" eval="False"/>
    </record>

    <record id="param_require_customs_reference" model="ir.config_parameter">
        <field name="key">nelsis_bond_movement.require_customs_reference</field>
        <field name="value">True</field>
    </record>
</odoo>
