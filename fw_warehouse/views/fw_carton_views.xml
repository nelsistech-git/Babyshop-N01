<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_carton_tree" model="ir.ui.view">
        <field name="name">fw.carton.tree</field>
        <field name="model">fw.carton</field>
        <field name="arch" type="xml">
            <tree string="Packing Cartons" decoration-success="state=='shipped'">
                <field name="name"/>
                <field name="barcode"/>
                <field name="carton_no"/>
                <field name="style_id"/>
                <field name="color_id"/>
                <field name="shipment_id"/>
                <field name="total_qty"/>
                <field name="gross_weight"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_carton_form" model="ir.ui.view">
        <field name="name">fw.carton.form</field>
        <field name="model">fw.carton</field>
        <field name="arch" type="xml">
            <form string="Packing Carton">
                <header>
                    <button name="action_mark_shipped" type="object" string="Mark Shipped"
                            class="btn-primary" invisible="state != 'packed'"/>
                    <button name="action_reset_packed" type="object" string="Reset to Packed"
                            invisible="state == 'packed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="packed,shipped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="barcode" widget="barcode"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="carton_no"/>
                            <field name="order_line_id"/>
                            <field name="style_id" readonly="1"/>
                            <field name="color_id" readonly="1"/>
                            <field name="shipment_id"/>
                        </group>
                        <group>
                            <field name="total_qty" readonly="1"/>
                            <field name="gross_weight"/>
                            <field name="net_weight"/>
                            <field name="length_cm"/>
                            <field name="width_cm"/>
                            <field name="height_cm"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Size Content">
                            <field name="size_line_ids">
                                <tree editable="bottom">
                                    <field name="size_id"/>
                                    <field name="qty"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_carton_search" model="ir.ui.view">
        <field name="name">fw.carton.search</field>
        <field name="model">fw.carton</field>
        <field name="arch" type="xml">
            <search string="Search Cartons">
                <field name="name"/>
                <field name="barcode"/>
                <field name="shipment_id"/>
                <group expand="0" string="Group By">
                    <filter string="Shipment" name="group_shipment" context="{'group_by': 'shipment_id'}"/>
                    <filter string="Style" name="group_style" context="{'group_by': 'style_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_carton" model="ir.actions.act_window">
        <field name="name">Packing Cartons</field>
        <field name="res_model">fw.carton</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_carton_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first packing carton</p>
        </field>
    </record>
</odoo>
