<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_mobile_session_form" model="ir.ui.view">
        <field name="name">garment.mobile.session.form</field>
        <field name="model">garment.mobile.session</field>
        <field name="arch" type="xml">
            <form string="Mobile Session">
                <header>
                    <button name="action_close_session" type="object" string="Remote Logout"
                            class="btn-secondary" invisible="status != 'active'"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="session_number"/>
                        <h1><field name="session_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="device_id"/>
                            <field name="user_id"/>
                            <field name="app_type"/>
                            <field name="login_method"/>
                        </group>
                        <group>
                            <field name="login_datetime"/>
                            <field name="logout_datetime"/>
                            <field name="duration_minutes"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_mobile_session_tree" model="ir.ui.view">
        <field name="name">garment.mobile.session.tree</field>
        <field name="model">garment.mobile.session</field>
        <field name="arch" type="xml">
            <tree string="Mobile Sessions" decoration-success="status == 'active'">
                <field name="session_number"/>
                <field name="user_id"/>
                <field name="device_id"/>
                <field name="login_method"/>
                <field name="login_datetime"/>
                <field name="logout_datetime"/>
                <field name="duration_minutes"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_mobile_session_search" model="ir.ui.view">
        <field name="name">garment.mobile.session.search</field>
        <field name="model">garment.mobile.session</field>
        <field name="arch" type="xml">
            <search string="Search Sessions">
                <field name="session_number"/>
                <field name="user_id"/>
                <field name="device_id"/>
                <filter name="filter_active" string="Active" domain="[('status', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_login_method" string="Login Method" context="{'group_by': 'login_method'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_mobile_session" model="ir.actions.act_window">
        <field name="name">Mobile Sessions</field>
        <field name="res_model">garment.mobile.session</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_garment_mobile_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No mobile sessions yet.</p>
            <p>A session is created automatically by POST /api/mobile/auth/login.</p>
        </field>
    </record>

</odoo>
