<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_mobile_device" model="ir.sequence">
        <field name="name">Garment Mobile Device Code</field>
        <field name="code">garment.mobile.device</field>
        <field name="prefix">MDEV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_mobile_push_notification" model="ir.sequence">
        <field name="name">Garment Mobile Push Notification Number</field>
        <field name="code">garment.mobile.push.notification</field>
        <field name="prefix">MPN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_mobile_session" model="ir.sequence">
        <field name="name">Garment Mobile Session Number</field>
        <field name="code">garment.mobile.session</field>
        <field name="prefix">MSES/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_mobile_offline_sync_log" model="ir.sequence">
        <field name="name">Garment Mobile Offline Sync Log Number</field>
        <field name="code">garment.mobile.offline.sync.log</field>
        <field name="prefix">MSYNC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
