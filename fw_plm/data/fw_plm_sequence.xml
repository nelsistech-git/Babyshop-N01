<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fw_bom_version" model="ir.sequence">
        <field name="name">FW BOM Version</field>
        <field name="code">fw.bom.version</field>
        <field name="prefix">BOM/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_sample" model="ir.sequence">
        <field name="name">FW Sample</field>
        <field name="code">fw.sample</field>
        <field name="prefix">SMP/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_ecn" model="ir.sequence">
        <field name="name">FW Engineering Change Notice</field>
        <field name="code">fw.ecn</field>
        <field name="prefix">ECN/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
