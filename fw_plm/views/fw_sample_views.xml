<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_sample_tree" model="ir.ui.view">
        <field name="name">fw.sample.tree</field>
        <field name="model">fw.sample</field>
        <field name="arch" type="xml">
            <tree string="Samples" decoration-danger="state=='rejected'"
                  decoration-success="state=='approved'"
                  decoration-warning="state=='revise'">
                <field name="name"/>
                <field name="style_id"/>
                <field name="sample_type"/>
                <field name="request_date"/>
                <field name="due_date"/>
                <field name="responsible_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_sample_form" model="ir.ui.view">
        <field name="name">fw.sample.form</field>
        <field name="model">fw.sample</field>
        <field name="arch" type="xml">
            <form string="Sample">
                <header>
                    <button name="action_start_progress" type="object" string="Start Progress"
                            class="btn-primary" invisible="state != 'requested'"/>
                    <button name="action_submit_buyer" type="object" string="Submit to Buyer"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_revise" type="object" string="Revise &amp; Resubmit"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,in_progress,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="style_id"/>
                            <field name="sample_type"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="due_date"/>
                            <field name="approved_date" readonly="1" invisible="not approved_date"/>
                        </group>
                    </group>
                    <group string="Comments">
                        <field name="internal_comments" placeholder="Internal notes..."/>
                        <field name="buyer_comments" placeholder="Buyer feedback..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_sample_search" model="ir.ui.view">
        <field name="name">fw.sample.search</field>
        <field name="model">fw.sample</field>
        <field name="arch" type="xml">
            <search string="Search Samples">
                <field name="name"/>
                <field name="style_id"/>
                <filter string="Pending Approval" name="pending" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Style" name="group_style" context="{'group_by': 'style_id'}"/>
                    <filter string="Sample Type" name="group_type" context="{'group_by': 'sample_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_sample" model="ir.actions.act_window">
        <field name="name">Samples</field>
        <field name="res_model">fw.sample</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_sample_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first sample request</p>
        </field>
    </record>
</odoo>
