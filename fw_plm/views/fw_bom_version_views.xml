<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_bom_version_tree" model="ir.ui.view">
        <field name="name">fw.bom.version.tree</field>
        <field name="model">fw.bom.version</field>
        <field name="arch" type="xml">
            <tree string="BOM Versions" decoration-muted="state=='obsolete'"
                  decoration-success="state=='confirmed'">
                <field name="name"/>
                <field name="style_id"/>
                <field name="version_no"/>
                <field name="date_effective"/>
                <field name="total_cost" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_bom_version_form" model="ir.ui.view">
        <field name="name">fw.bom.version.form</field>
        <field name="model">fw.bom.version</field>
        <field name="arch" type="xml">
            <form string="BOM Version">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_obsolete" type="object" string="Mark Obsolete"
                            invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="style_id"/>
                            <field name="version_no"/>
                            <field name="date_effective"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_cost" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Components">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="part_name"/>
                                    <field name="component_id"/>
                                    <field name="uom_id"/>
                                    <field name="qty_per_pair"/>
                                    <field name="wastage_percent"/>
                                    <field name="unit_cost"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="line_cost" widget="monetary"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fw_bom_version_search" model="ir.ui.view">
        <field name="name">fw.bom.version.search</field>
        <field name="model">fw.bom.version</field>
        <field name="arch" type="xml">
            <search string="Search BOM Versions">
                <field name="name"/>
                <field name="style_id"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Style" name="group_style" context="{'group_by': 'style_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_bom_version" model="ir.actions.act_window">
        <field name="name">BOM Versions</field>
        <field name="res_model">fw.bom.version</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_bom_version_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first BOM version</p>
        </field>
    </record>
</odoo>
