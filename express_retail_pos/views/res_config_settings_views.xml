<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_express_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.express.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="priority" eval="60"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Express Retail Sales" string="Express Retail Sales"
                     data-key="express_retail_pos" groups="express_retail_pos.group_express_pos_manager">
                    <h2>Express Retail Sales</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="express_pos_walkin_partner_id" string="Walk-in Customer"/>
                                <div class="text-muted">Default contact selected automatically when the checkout console
                                    opens.
                                </div>
                                <field name="express_pos_walkin_partner_id"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="express_pos_block_on_negative_stock"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="express_pos_block_on_negative_stock"
                                       string="Block Sale on Insufficient Stock"/>
                                <div class="text-muted">Prevent adding a product to the cart once stock on hand reaches
                                    zero.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="express_pos_loyalty_point_rate" string="Loyalty Point Rate"/>
                                <div class="text-muted">Currency amount spent to earn 1 loyalty point.</div>
                                <field name="express_pos_loyalty_point_rate"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="express_pos_gift_card_journal_id" string="Gift Card Journal"/>
                                <div class="text-muted">Optional journal to record gift-card-redeemed amounts as
                                    payments.
                                </div>
                                <field name="express_pos_gift_card_journal_id"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="express_pos_default_receipt_format" string="Default Receipt Format"/>
                                <div class="text-muted">Billing/receipt layout used for any branch that does not set its
                                    own Receipt Format (Configuration > Showrooms / Branches). Choose the Dubai/UAE VAT
                                    layout or the Bangladesh cash-memo layout.
                                </div>
                                <field name="express_pos_default_receipt_format"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>