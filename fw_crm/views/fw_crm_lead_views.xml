<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_crm_lead_kanban" model="ir.ui.view">
        <field name="name">fw.crm.lead.kanban</field>
        <field name="model">fw.crm.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column"
                    records_draggable="1">
                <field name="stage_id"/>
                <field name="name"/>
                <field name="expected_revenue"/>
                <field name="currency_id"/>
                <field name="probability"/>
                <field name="country_id"/>
                <field name="assigned_to"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong><field name="name"/></strong>
                                <div>
                                    <field name="country_id"/>
                                </div>
                                <div>
                                    <field name="expected_revenue" widget="monetary"/>
                                </div>
                                <div>
                                    <field name="probability"/>%
                                </div>
                                <div class="text-muted">
                                    <field name="assigned_to"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_fw_crm_lead_tree" model="ir.ui.view">
        <field name="name">fw.crm.lead.tree</field>
        <field name="model">fw.crm.lead</field>
        <field name="arch" type="xml">
            <tree string="Buyer Leads" decoration-success="state=='won'"
                  decoration-danger="state=='lost'">
                <field name="name"/>
                <field name="country_id"/>
                <field name="source"/>
                <field name="expected_category"/>
                <field name="stage_id"/>
                <field name="expected_revenue" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="assigned_to"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_crm_lead_form" model="ir.ui.view">
        <field name="name">fw.crm.lead.form</field>
        <field name="model">fw.crm.lead</field>
        <field name="arch" type="xml">
            <form string="Buyer Lead">
                <header>
                    <button name="action_convert_to_buyer" type="object"
                            string="Convert to Buyer" class="btn-primary"
                            invisible="state == 'won' or converted_buyer_id"/>
                    <button name="action_mark_lost" type="object" string="Mark Lost"
                            invisible="state != 'open'"/>
                    <button name="action_reset_open" type="object" string="Reopen"
                            invisible="state == 'open'"/>
                    <field name="stage_id" widget="statusbar" invisible="state == 'lost'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Lead / Company Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contact_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="expected_category"/>
                            <field name="expected_annual_volume"/>
                            <field name="assigned_to"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="expected_revenue"/>
                            <field name="probability"/>
                        </group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="lost_reason" invisible="state != 'lost'"/>
                            <field name="converted_buyer_id" readonly="1"
                                   invisible="not converted_buyer_id"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_crm_lead_search" model="ir.ui.view">
        <field name="name">fw.crm.lead.search</field>
        <field name="model">fw.crm.lead</field>
        <field name="arch" type="xml">
            <search string="Search Buyer Leads">
                <field name="name"/>
                <field name="country_id"/>
                <field name="assigned_to"/>
                <filter string="Open" name="open" domain="[('state','=','open')]"/>
                <filter string="Won" name="won" domain="[('state','=','won')]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Assigned To" name="group_assigned" context="{'group_by': 'assigned_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_crm_lead" model="ir.actions.act_window">
        <field name="name">Buyer Pipeline</field>
        <field name="res_model">fw.crm.lead</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_fw_crm_lead_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first buyer lead</p>
        </field>
    </record>
</odoo>
