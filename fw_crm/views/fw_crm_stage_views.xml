<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_crm_stage_tree" model="ir.ui.view">
        <field name="name">fw.crm.stage.tree</field>
        <field name="model">fw.crm.stage</field>
        <field name="arch" type="xml">
            <tree string="Pipeline Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_won"/>
                <field name="fold"/>
            </tree>
        </field>
    </record>

    <record id="action_fw_crm_stage" model="ir.actions.act_window">
        <field name="name">Pipeline Stages</field>
        <field name="res_model">fw.crm.stage</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
