<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem id="menu_account_reporting_new"
              name="Reporting"
              sequence="20"
              parent="account.menu_finance"
              groups="account.group_account_manager"/>

        <record id="submenu_accounting_reporting" model="ir.ui.menu" >
            <field name="name">Accounting</field>
            <field name="sequence" eval="4"/>
            <field name="parent_id" ref="menu_account_reporting_new" />
            <field name="groups_id" eval="[(6,0,[ref('base_accounting_kit.group_financial_report_analyzer')])]"/>
        </record>

        <!-- Reporting is now Analytic Reporting -->
        <record id="account.menu_finance_reports" model="ir.ui.menu" >
            <field name="name">Analytic Reporting</field>
            <field name="sequence" eval="21"/>
            <field name="groups_id" eval="[(6,0,[ref('base_accounting_kit.group_financial_report_analyzer')])]"/>
        </record>

        <menuitem id="submenu_sales_reporting"
              name="Sales"
              sequence="1"
              parent="base_accounting_kit.menu_account_reporting_new"
              groups="account.group_account_manager"/>

        <menuitem id="submenu_purchase_reporting"
              name="Purchase"
              sequence="2"
              parent="base_accounting_kit.menu_account_reporting_new"
              groups="account.group_account_manager"/>

        <menuitem id="submenu_inventory_reporting"
              name="Inventory"
              sequence="3"
              parent="base_accounting_kit.menu_account_reporting_new"
              groups="account.group_account_manager"/>




    </data>
</odoo>