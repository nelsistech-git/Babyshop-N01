<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="acc_cost_center_view_form" model="ir.ui.view">
            <field name="name">acc.cost.center.form</field>
            <field name="model">acc.cost.center</field>
            <field name="arch" type="xml">
                <form string="Cost center Form">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="active" />
                            </group>
                            <group></group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="acc_cost_center_view_tree" model="ir.ui.view">
            <field name="name">acc.cost.center.tree</field>
            <field name="model">acc.cost.center</field>
            <field name="arch" type="xml">
                <tree string="Cost center Tree">
                    <field name="name"/>
                    <field name="active" />
                </tree>
            </field>
        </record>


        <record id="acc_cost_center_view_search" model="ir.ui.view">
            <field name="name">acc.cost.center.search</field>
            <field name="model">acc.cost.center</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="active" />
                </search>
            </field>
        </record>
		

        <record id="acc_cost_center_list_action" model="ir.actions.act_window">
            <field name="name">Accounts cost center</field>
            <field name="res_model">acc.cost.center</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create Cost center
                </p>
            </field>
        </record>

        <!--<menuitem id="acc_cost_center_menu" name="Accounts Cost center" parent="account.account_account_menu" groups="account.group_account_manager"
                  action="acc_cost_center_list_action" sequence="100"/>-->
        <menuitem id="acc_cost_center_menu2" name="Accounts Cost center"
			parent="account.menu_finance_entries" action="acc_cost_center_list_action"
			groups="account.group_account_manager" sequence="23" />

    </data>
</odoo>