<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bond_reopen_wizard_form" model="ir.ui.view">
        <field name="name">bond.reconciliation.reopen.wizard.form</field>
        <field name="model">bond.reconciliation.reopen.wizard</field>
        <field name="arch" type="xml">
            <form string="Reopen Reconciliation" class="nl-ui">
                <div class="alert alert-warning" role="alert">
                    Reopening clears the approval and returns the record to <strong>In Progress</strong>.
                    The reason, user and time are recorded permanently.
                </div>
                <group>
                    <field name="reconciliation_id"/>
                    <field name="reason" placeholder="Why must this reconciliation be reopened?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reopen" icon="fa-unlock"
                            class="btn-warning nl-btn nl-neutral"/>
                    <button string="Cancel" class="btn-secondary nl-btn nl-ghost" special="cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
