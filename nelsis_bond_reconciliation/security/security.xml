<odoo>
    <record id="module_category_bond_reconciliation" model="ir.module.category">
        <field name="name">Bond Reconciliation</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_bond_recon_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_bond_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Can view the bond register and ledger, prepare reconciliations and print reports.</field>
    </record>

    <record id="group_bond_recon_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_bond_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_recon_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can verify bond transactions, approve adjustments and reconciliations, close and reopen.</field>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_bond_ledger_company" model="ir.rule">
        <field name="name">Bond Ledger: multi-company</field>
        <field name="model_id" ref="model_bond_warehouse_ledger"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_register_company" model="ir.rule">
        <field name="name">Bond Register: multi-company</field>
        <field name="model_id" ref="model_bond_warehouse_register"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_reconciliation_company" model="ir.rule">
        <field name="name">Bond Reconciliation: multi-company</field>
        <field name="model_id" ref="model_bond_warehouse_reconciliation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_reconciliation_line_company" model="ir.rule">
        <field name="name">Bond Reconciliation Line: multi-company</field>
        <field name="model_id" ref="model_bond_warehouse_reconciliation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_reconciliation_reopen_company" model="ir.rule">
        <field name="name">Bond Reconciliation Reopen Log: multi-company</field>
        <field name="model_id" ref="model_bond_warehouse_reconciliation_reopen"/>
        <field name="domain_force">[('reconciliation_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
