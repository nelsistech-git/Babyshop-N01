<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form_bond" model="ir.ui.view">
        <field name="name">stock.location.form.bond</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Bond Classification" name="bond_group">
                    <field name="bond_scope"/>
                    <field name="bond_scope_effective" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
