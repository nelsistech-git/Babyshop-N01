<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_bond" model="ir.ui.view">
        <field name="name">stock.lot.form.bond</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Bond Traceability" name="bond_group">
                    <field name="bond_license_ref"/>
                    <field name="bond_lc_ref"/>
                    <field name="bond_boe_ref"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_bond" model="ir.ui.view">
        <field name="name">product.template.form.bond</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Bond" name="bond_group">
                    <field name="bond_hs_code" placeholder="e.g. 4107.xx.xx (as per tariff)"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Server action: approve adjustments from Moves History -->
    <record id="action_bond_approve_adjustment_sml" model="ir.actions.server">
        <field name="name">Approve Bond Adjustment</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="binding_model_id" ref="stock.model_stock_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('nelsis_bond_reconciliation.group_bond_recon_manager'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_bond_approve_adjustment()</field>
    </record>
</odoo>
