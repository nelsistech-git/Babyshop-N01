<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_compliance_certificate_tree" model="ir.ui.view">
        <field name="name">garment.compliance.certificate.tree</field>
        <field name="model">garment.compliance.certificate</field>
        <field name="arch" type="xml">
            <tree string="Certificates &amp; Licenses" decoration-danger="status == 'expired'" decoration-warning="status == 'expiring_soon'">
                <field name="reference"/>
                <field name="name"/>
                <field name="category"/>
                <field name="issuing_authority"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="responsible_user_id"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status == 'expiring_soon'" decoration-danger="status == 'expired'"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_compliance_certificate_form" model="ir.ui.view">
        <field name="name">garment.compliance.certificate.form</field>
        <field name="model">garment.compliance.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificate / License">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="active,expiring_soon,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="status != 'expired'"/>
                    <widget name="web_ribbon" title="Expiring Soon" bg_color="text-bg-warning" invisible="status != 'expiring_soon'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="reference" readonly="1"/></h1>
                        <field name="name" placeholder="e.g. ISO 14001"/>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="standard_id"/>
                            <field name="certificate_number"/>
                            <field name="issuing_authority"/>
                            <field name="buyer_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="responsible_user_id"/>
                            <field name="renewal_status"/>
                            <field name="is_suspended"/>
                        </group>
                    </group>
                    <group>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_compliance_certificate_search" model="ir.ui.view">
        <field name="name">garment.compliance.certificate.search</field>
        <field name="model">garment.compliance.certificate</field>
        <field name="arch" type="xml">
            <search string="Search Certificates">
                <field name="name"/>
                <field name="certificate_number"/>
                <field name="issuing_authority"/>
                <field name="buyer_id"/>
                <filter string="Active" name="filter_active" domain="[('status', '=', 'active')]"/>
                <filter string="Expiring Soon" name="filter_expiring" domain="[('status', '=', 'expiring_soon')]"/>
                <filter string="Expired" name="filter_expired" domain="[('status', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_compliance_certificate" model="ir.actions.act_window">
        <field name="name">Certificates &amp; Licenses</field>
        <field name="res_model">garment.compliance.certificate</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
