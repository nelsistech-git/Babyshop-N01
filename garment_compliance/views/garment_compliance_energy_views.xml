<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_compliance_energy_tree" model="ir.ui.view">
        <field name="name">garment.compliance.energy.tree</field>
        <field name="model">garment.compliance.energy</field>
        <field name="arch" type="xml">
            <tree string="Energy / Carbon Records">
                <field name="record_date"/>
                <field name="electricity_kwh"/>
                <field name="solar_kwh"/>
                <field name="total_energy_kwh"/>
                <field name="renewable_percentage" widget="percentage"/>
                <field name="carbon_emission_ton"/>
                <field name="energy_cost"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_compliance_energy_form" model="ir.ui.view">
        <field name="name">garment.compliance.energy.form</field>
        <field name="model">garment.compliance.energy</field>
        <field name="arch" type="xml">
            <form string="Energy / Carbon Record">
                <sheet>
                    <group>
                        <group>
                            <field name="record_date"/>
                            <field name="electricity_kwh"/>
                            <field name="gas_usage"/>
                            <field name="generator_fuel_liters"/>
                            <field name="solar_kwh"/>
                            <field name="energy_cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_energy_kwh" readonly="1"/>
                            <field name="renewable_percentage" readonly="1" widget="percentage"/>
                            <field name="emission_factor"/>
                            <field name="carbon_emission_ton" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_compliance_energy_graph" model="ir.ui.view">
        <field name="name">garment.compliance.energy.graph</field>
        <field name="model">garment.compliance.energy</field>
        <field name="arch" type="xml">
            <graph string="Carbon Emission Trend" type="line">
                <field name="record_date" type="row" interval="month"/>
                <field name="carbon_emission_ton" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_garment_compliance_energy" model="ir.actions.act_window">
        <field name="name">Energy / Carbon Records</field>
        <field name="res_model">garment.compliance.energy</field>
        <field name="view_mode">tree,graph,form</field>
    </record>
</odoo>
