<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_compliance_requirement_tree" model="ir.ui.view">
        <field name="name">garment.compliance.requirement.tree</field>
        <field name="model">garment.compliance.requirement</field>
        <field name="arch" type="xml">
            <tree string="Compliance Requirements" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="standard_id"/>
                <field name="applicable_department_id"/>
                <field name="required_frequency"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'critical'" decoration-warning="priority == 'high'"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_compliance_requirement_form" model="ir.ui.view">
        <field name="name">garment.compliance.requirement.form</field>
        <field name="model">garment.compliance.requirement</field>
        <field name="arch" type="xml">
            <form string="Compliance Requirement">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Emergency Exit Inspection"/></h1></div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="standard_id"/>
                            <field name="applicable_department_id"/>
                        </group>
                        <group>
                            <field name="required_frequency"/>
                            <field name="priority"/>
                            <field name="responsible_user_id"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_compliance_requirement_search" model="ir.ui.view">
        <field name="name">garment.compliance.requirement.search</field>
        <field name="model">garment.compliance.requirement</field>
        <field name="arch" type="xml">
            <search string="Search Requirements">
                <field name="name"/>
                <field name="applicable_department_id"/>
                <field name="standard_id"/>
                <filter string="Active" name="filter_active" domain="[('status', '=', 'active')]"/>
                <filter string="Critical/High Priority" name="filter_priority" domain="[('priority', 'in', ('critical', 'high'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'applicable_department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_compliance_requirement" model="ir.actions.act_window">
        <field name="name">Compliance Requirements</field>
        <field name="res_model">garment.compliance.requirement</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
