<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_compliance_chemical_tree" model="ir.ui.view">
        <field name="name">garment.compliance.chemical.tree</field>
        <field name="model">garment.compliance.chemical</field>
        <field name="arch" type="xml">
            <tree string="Chemical Register" decoration-danger="zdhc_mrsl_status == 'banned'" decoration-warning="zdhc_mrsl_status == 'restricted'">
                <field name="name"/>
                <field name="material_id"/>
                <field name="supplier_id"/>
                <field name="storage_location_id"/>
                <field name="quantity"/>
                <field name="uom"/>
                <field name="sds_available"/>
                <field name="zdhc_mrsl_status" widget="badge"/>
                <field name="approval_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_compliance_chemical_form" model="ir.ui.view">
        <field name="name">garment.compliance.chemical.form</field>
        <field name="model">garment.compliance.chemical</field>
        <field name="arch" type="xml">
            <form string="Chemical Register">
                <header>
                    <button name="action_next_approval_stage" type="object" string="Move to Next Approval Stage" class="btn-primary"
                            invisible="approval_status in ('usage_allowed', 'rejected')"/>
                    <field name="approval_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="material_id"/>
                            <field name="supplier_id"/>
                            <field name="storage_location_id"/>
                            <field name="quantity"/>
                            <field name="uom"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="hazard_class"/>
                            <field name="zdhc_mrsl_status"/>
                            <field name="sds_available"/>
                            <field name="sds_attachment" filename="sds_attachment_filename"/>
                            <field name="sds_attachment_filename" invisible="1"/>
                            <field name="ppe_requirement"/>
                        </group>
                    </group>
                    <field name="emergency_procedure"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_compliance_chemical" model="ir.actions.act_window">
        <field name="name">Chemical Register</field>
        <field name="res_model">garment.compliance.chemical</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
