<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_compliance_water_tree" model="ir.ui.view">
        <field name="name">garment.compliance.water.tree</field>
        <field name="model">garment.compliance.water</field>
        <field name="arch" type="xml">
            <tree string="Water / ETP Records">
                <field name="record_date"/>
                <field name="department_id"/>
                <field name="source"/>
                <field name="consumption_m3"/>
                <field name="recycled_percentage"/>
                <field name="is_etp_test"/>
                <field name="quality_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_compliance_water_form" model="ir.ui.view">
        <field name="name">garment.compliance.water.form</field>
        <field name="model">garment.compliance.water</field>
        <field name="arch" type="xml">
            <form string="Water / ETP Record">
                <sheet>
                    <group>
                        <group>
                            <field name="record_date"/>
                            <field name="department_id"/>
                            <field name="source"/>
                            <field name="consumption_m3"/>
                            <field name="recycled_percentage"/>
                            <field name="discharge_m3"/>
                        </group>
                        <group string="ETP Water Quality Test">
                            <field name="is_etp_test"/>
                            <field name="etp_ph_level"/>
                            <field name="etp_cod"/>
                            <field name="etp_bod"/>
                            <field name="etp_tds"/>
                            <field name="tested_by"/>
                            <field name="quality_status"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_compliance_water" model="ir.actions.act_window">
        <field name="name">Water / ETP Records</field>
        <field name="res_model">garment.compliance.water</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
