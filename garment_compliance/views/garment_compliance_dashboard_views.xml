<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compliance Dashboard (SRS1 sec. 6, SRS2 secs. 18, 70): Overall Score,
         Open/Closed Findings, Safety Status, Certification Status — built as
         graph/pivot/kanban on the Finding and Certificate models, matching
         the dashboard pattern already used by garment_supplier. -->

    <record id="view_garment_compliance_finding_kanban" model="ir.ui.view">
        <field name="name">garment.compliance.finding.kanban</field>
        <field name="model">garment.compliance.finding</field>
        <field name="arch" type="xml">
            <kanban default_group_by="severity">
                <field name="finding_no"/>
                <field name="description"/>
                <field name="status"/>
                <field name="due_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <strong><field name="finding_no"/></strong>
                            <div><field name="description"/></div>
                            <div>
                                <field name="status" widget="label_selection"
                                       options="{'classes': {'open': 'danger', 'in_progress': 'warning', 'closed': 'success'}}"/>
                            </div>
                            <div><field name="due_date"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_garment_compliance_finding_pivot" model="ir.ui.view">
        <field name="name">garment.compliance.finding.pivot</field>
        <field name="model">garment.compliance.finding</field>
        <field name="arch" type="xml">
            <pivot string="Findings Analysis">
                <field name="category" type="row"/>
                <field name="severity" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_garment_compliance_finding_graph" model="ir.ui.view">
        <field name="name">garment.compliance.finding.graph</field>
        <field name="model">garment.compliance.finding</field>
        <field name="arch" type="xml">
            <graph string="Open vs Closed Findings" type="bar">
                <field name="severity" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_garment_compliance_dashboard" model="ir.actions.act_window">
        <field name="name">Compliance Dashboard</field>
        <field name="res_model">garment.compliance.finding</field>
        <field name="view_mode">kanban,graph,pivot,tree</field>
    </record>
</odoo>
