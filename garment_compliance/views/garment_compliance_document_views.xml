<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_compliance_document_tree" model="ir.ui.view">
        <field name="name">garment.compliance.document.tree</field>
        <field name="model">garment.compliance.document</field>
        <field name="arch" type="xml">
            <tree string="Compliance Documents">
                <field name="name"/>
                <field name="document_type"/>
                <field name="department_id"/>
                <field name="version"/>
                <field name="upload_date"/>
                <field name="approval_status" widget="badge" decoration-success="approval_status == 'approved'" decoration-danger="approval_status == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_compliance_document_form" model="ir.ui.view">
        <field name="name">garment.compliance.document.form</field>
        <field name="model">garment.compliance.document</field>
        <field name="arch" type="xml">
            <form string="Compliance Document">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="approval_status == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="approval_status == 'rejected'"/>
                    <field name="approval_status" widget="statusbar" statusbar_visible="draft,pending_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="standard_id"/>
                            <field name="department_id"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="upload_date"/>
                            <field name="attachment" filename="attachment_filename"/>
                            <field name="attachment_filename" invisible="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_compliance_document_search" model="ir.ui.view">
        <field name="name">garment.compliance.document.search</field>
        <field name="model">garment.compliance.document</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name"/>
                <field name="department_id"/>
                <filter string="Pending Approval" name="filter_pending" domain="[('approval_status', '=', 'pending_approval')]"/>
                <group expand="0" string="Group By">
                    <filter string="Document Type" name="group_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Approval Status" name="group_status" context="{'group_by': 'approval_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_compliance_document" model="ir.actions.act_window">
        <field name="name">Compliance Documents</field>
        <field name="res_model">garment.compliance.document</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
