<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_compliance_calendar_tree" model="ir.ui.view">
        <field name="name">garment.compliance.calendar.tree</field>
        <field name="model">garment.compliance.calendar</field>
        <field name="arch" type="xml">
            <tree string="Compliance Calendar" decoration-danger="status == 'overdue'" decoration-warning="days_remaining &lt;= 30 and status != 'overdue'">
                <field name="name"/>
                <field name="event_type"/>
                <field name="department_id"/>
                <field name="responsible_user_id"/>
                <field name="due_date"/>
                <field name="days_remaining"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_compliance_calendar_form" model="ir.ui.view">
        <field name="name">garment.compliance.calendar.form</field>
        <field name="model">garment.compliance.calendar</field>
        <field name="arch" type="xml">
            <form string="Compliance Calendar Reminder">
                <header>
                    <button name="action_mark_completed" type="object" string="Mark Completed" class="btn-primary" invisible="status == 'completed'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="certificate_id"/>
                            <field name="audit_id"/>
                            <field name="requirement_id"/>
                            <field name="fire_equipment_id"/>
                            <field name="building_inspection_id"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="responsible_user_id"/>
                            <field name="due_date"/>
                            <field name="days_remaining"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_compliance_calendar_search" model="ir.ui.view">
        <field name="name">garment.compliance.calendar.search</field>
        <field name="model">garment.compliance.calendar</field>
        <field name="arch" type="xml">
            <search string="Search Compliance Calendar">
                <field name="name"/>
                <field name="department_id"/>
                <field name="responsible_user_id"/>
                <filter string="Pending" name="filter_pending" domain="[('status', 'in', ('pending', 'reminded'))]"/>
                <filter string="Overdue" name="filter_overdue" domain="[('status', '=', 'overdue')]"/>
                <group expand="0" string="Group By">
                    <filter string="Event Type" name="group_type" context="{'group_by': 'event_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_compliance_calendar" model="ir.actions.act_window">
        <field name="name">Compliance Calendar</field>
        <field name="res_model">garment.compliance.calendar</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>
</odoo>
