<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_compliance_audit" model="ir.sequence">
        <field name="name">Garment Compliance Audit Number</field>
        <field name="code">garment.compliance.audit</field>
        <field name="prefix">CAUD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_compliance_finding" model="ir.sequence">
        <field name="name">Garment Compliance Finding Number</field>
        <field name="code">garment.compliance.finding</field>
        <field name="prefix">CFND/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_compliance_capa" model="ir.sequence">
        <field name="name">Garment Compliance CAPA Number</field>
        <field name="code">garment.compliance.capa</field>
        <field name="prefix">CCAPA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_compliance_certificate" model="ir.sequence">
        <field name="name">Garment Compliance Certificate Reference</field>
        <field name="code">garment.compliance.certificate</field>
        <field name="prefix">CERT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_compliance_incident" model="ir.sequence">
        <field name="name">Garment Compliance Incident Number</field>
        <field name="code">garment.compliance.incident</field>
        <field name="prefix">CINC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
