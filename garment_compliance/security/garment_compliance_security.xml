<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_compliance" model="ir.module.category">
            <field name="name">Smart Garment ERP - Compliance</field>
            <field name="sequence">73</field>
        </record>

        <record id="group_compliance_officer" model="res.groups">
            <field name="name">Compliance Officer (Social/HR Compliance, Checklists, Findings)</field>
            <field name="category_id" ref="module_category_garment_compliance"/>
        </record>

        <record id="group_compliance_safety_officer" model="res.groups">
            <field name="name">Safety / Fire Safety Officer (Fire, Building, Incidents)</field>
            <field name="category_id" ref="module_category_garment_compliance"/>
        </record>

        <record id="group_compliance_environment_officer" model="res.groups">
            <field name="name">Environmental / Sustainability Officer (Chemical, Waste, Water, Energy, ESG)</field>
            <field name="category_id" ref="module_category_garment_compliance"/>
        </record>

        <record id="group_compliance_auditor" model="res.groups">
            <field name="name">Auditor (Audit Access)</field>
            <field name="category_id" ref="module_category_garment_compliance"/>
        </record>

        <record id="group_compliance_manager" model="res.groups">
            <field name="name">Compliance Manager (Approval, Full Data Access)</field>
            <field name="category_id" ref="module_category_garment_compliance"/>
            <field name="implied_ids" eval="[(4, ref('group_compliance_officer')),
                                              (4, ref('group_compliance_safety_officer')),
                                              (4, ref('group_compliance_environment_officer')),
                                              (4, ref('group_compliance_auditor'))]"/>
        </record>

        <record id="group_compliance_director" model="res.groups">
            <field name="name">Compliance Director (Full Control)</field>
            <field name="category_id" ref="module_category_garment_compliance"/>
            <field name="implied_ids" eval="[(4, ref('group_compliance_manager'))]"/>
        </record>

        <!-- Buyer portal: read-only access to their own certificates and audits -->
        <record id="rule_garment_compliance_certificate_portal_own" model="ir.rule">
            <field name="name">Buyer Portal: Own Buyer's Certificates Only</field>
            <field name="model_id" ref="model_garment_compliance_certificate"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_compliance_audit_portal_own" model="ir.rule">
            <field name="name">Buyer Portal: Own Buyer's Audits Only</field>
            <field name="model_id" ref="model_garment_compliance_audit"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
