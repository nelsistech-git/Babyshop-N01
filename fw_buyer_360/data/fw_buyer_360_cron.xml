<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_fw_buyer_compliance_expiry" model="ir.cron">
        <field name="name">FW Buyer 360: Notify Expiring Compliance Certificates</field>
        <field name="model_id" ref="model_fw_buyer_compliance"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_expiring_certificates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="cron_fw_buyer_price_agreement_expiry" model="ir.cron">
        <field name="name">FW Buyer 360: Auto-Expire Price Agreements</field>
        <field name="model_id" ref="model_fw_buyer_price_agreement"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_agreements()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
