<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_buyer_form_360_inherit" model="ir.ui.view">
        <field name="name">fw.buyer.form.360.inherit</field>
        <field name="model">fw.buyer</field>
        <field name="inherit_id" ref="fw_core_master.view_fw_buyer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_compliance" type="object"
                        class="oe_stat_button" icon="fa-certificate"
                        invisible="compliance_count == 0">
                    <field name="compliance_count" widget="statinfo" string="Certificates"/>
                </button>
                <button name="action_view_audits" type="object"
                        class="oe_stat_button" icon="fa-clipboard"
                        invisible="audit_count == 0">
                    <field name="audit_count" widget="statinfo" string="Audits"/>
                </button>
                <button name="action_view_price_agreements" type="object"
                        class="oe_stat_button" icon="fa-usd"
                        invisible="price_agreement_count == 0">
                    <field name="price_agreement_count" widget="statinfo" string="Price Agreements"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
