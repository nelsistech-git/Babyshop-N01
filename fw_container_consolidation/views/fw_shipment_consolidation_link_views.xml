<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_shipment_form_consolidation_inherit" model="ir.ui.view">
        <field name="name">fw.shipment.form.consolidation.inherit</field>
        <field name="model">fw.shipment</field>
        <field name="inherit_id" ref="fw_merchandising.view_fw_shipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='container_no']" position="after">
                <field name="consolidation_id"/>
            </xpath>
        </field>
    </record>
</odoo>
