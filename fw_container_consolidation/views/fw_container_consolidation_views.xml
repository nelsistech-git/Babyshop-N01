<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_container_consolidation_tree" model="ir.ui.view">
        <field name="name">fw.container.consolidation.tree</field>
        <field name="model">fw.container.consolidation</field>
        <field name="arch" type="xml">
            <tree string="Container Consolidations" decoration-success="state=='arrived'"
                  decoration-muted="state=='closed'">
                <field name="name"/>
                <field name="mode"/>
                <field name="container_no"/>
                <field name="etd"/>
                <field name="eta"/>
                <field name="shipment_count"/>
                <field name="total_qty_shipped"/>
                <field name="total_gross_weight"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_container_consolidation_form" model="ir.ui.view">
        <field name="name">fw.container.consolidation.form</field>
        <field name="model">fw.container.consolidation</field>
        <field name="arch" type="xml">
            <form string="Container Consolidation">
                <header>
                    <button name="action_book" type="object" string="Book"
                            class="btn-primary" invisible="state != 'planning'"/>
                    <button name="action_in_transit" type="object" string="Mark In Transit"
                            invisible="state != 'booked'"/>
                    <button name="action_arrived" type="object" string="Mark Arrived"
                            invisible="state != 'in_transit'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'arrived'"/>
                    <button name="action_reset_planning" type="object" string="Reset"
                            invisible="state == 'planning'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planning,booked,in_transit,arrived,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="mode"/>
                            <field name="container_no"/>
                            <field name="vessel_flight_no"/>
                            <field name="booking_ref"/>
                        </group>
                        <group>
                            <field name="port_of_loading"/>
                            <field name="port_of_discharge"/>
                            <field name="etd"/>
                            <field name="eta"/>
                            <field name="container_capacity_cbm"/>
                        </group>
                    </group>
                    <group string="Aggregated Totals">
                        <group>
                            <field name="shipment_count" readonly="1"/>
                            <field name="total_qty_shipped" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_carton_count" readonly="1"/>
                            <field name="total_gross_weight" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shipments in this Container">
                            <field name="shipment_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="order_id"/>
                                    <field name="buyer_id"/>
                                    <field name="total_qty_shipped"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Remarks">
                            <field name="remarks"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_container_consolidation_search" model="ir.ui.view">
        <field name="name">fw.container.consolidation.search</field>
        <field name="model">fw.container.consolidation</field>
        <field name="arch" type="xml">
            <search string="Search Container Consolidations">
                <field name="name"/>
                <field name="container_no"/>
                <group expand="0" string="Group By">
                    <filter string="Mode" name="group_mode" context="{'group_by': 'mode'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_container_consolidation" model="ir.actions.act_window">
        <field name="name">Container Consolidations</field>
        <field name="res_model">fw.container.consolidation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_container_consolidation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first container consolidation</p>
        </field>
    </record>
</odoo>
