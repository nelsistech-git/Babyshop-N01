<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_login_theme_config_form" model="ir.ui.view">
        <field name="name">login.theme.config.form</field>
        <field name="model">login.theme.config</field>
        <field name="arch" type="xml">
            <form string="Login Page Theme">
                <sheet>
                    <div class="oe_title">
                        <h1>Login Page Theme</h1>
                        <p class="text-muted">
                            Customize the public login page shown at /web/login.
                            Changes appear immediately - no restart required.
                        </p>
                    </div>
                    <notebook>
                        <page string="Branding">
                            <group>
                                <group string="Logo">
                                    <field name="company_logo" widget="image" filename="company_logo_filename"/>
                                    <field name="company_logo_filename" invisible="1"/>
                                </group>
                                <group string="Welcome Text">
                                    <field name="welcome_title" placeholder="Welcome Back"/>
                                    <field name="welcome_subtitle" placeholder="Enter your credentials to get in"/>
                                </group>
                            </group>
                        </page>
                        <page string="Side Panel Media">
                            <group>
                                <field name="media_type" widget="radio"/>
                                <field name="media_image" widget="image" filename="media_image_filename"
                                       invisible="media_type != 'image'"/>
                                <field name="media_image_filename" invisible="1"/>
                                <field name="media_video" filename="media_video_filename"
                                       invisible="media_type != 'video'"/>
                                <field name="media_video_filename" invisible="1"/>
                                <field name="media_caption" placeholder="Be a part of something beautiful"/>
                            </group>
                        </page>
                        <page string="Background">
                            <group>
                                <field name="background_image" widget="image" filename="background_image_filename"/>
                                <field name="background_image_filename" invisible="1"/>
                                <div class="text-muted">
                                    Optional. Used as the blurred glassy background behind the login
                                    card. If left empty, the Side Panel Image above is reused instead.
                                    The background is always a static image, even when the side panel
                                    shows a video.
                                </div>
                            </group>
                        </page>
                        <page string="Footer">
                            <group>
                                <field name="copyright_text" placeholder="© 2026 Your Company. All rights reserved."/>
                                <field name="powered_by_text" placeholder="Powered by Your Company"/>
                                <field name="powered_by_image" widget="image" filename="powered_by_image_filename"/>
                                <field name="powered_by_image_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--
        Bound to a server action (instead of a plain ir.actions.act_window)
        so the menu always opens the single existing configuration record -
        creating it on the fly via get_config() if it was ever removed -
        and never offers a blank "create new" form that could lead to
        duplicate configuration records.
    -->
    <record id="action_open_login_theme_config" model="ir.actions.server">
        <field name="name">Login Page Theme</field>
        <field name="model_id" ref="model_login_theme_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_config()</field>
    </record>

    <menuitem id="menu_login_theme_config"
              name="Login Page Theme"
              parent="base.menu_administration"
              action="action_open_login_theme_config"
              groups="base.group_system"
              sequence="60"/>

</odoo>
