<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_purchase_requisition" model="ir.sequence">
        <field name="name">Garment Purchase Requisition Number</field>
        <field name="code">garment.purchase.requisition</field>
        <field name="prefix">PR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_purchase_rfq" model="ir.sequence">
        <field name="name">Garment Purchase RFQ Number</field>
        <field name="code">garment.purchase.rfq</field>
        <field name="prefix">PRFQ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_purchase_order" model="ir.sequence">
        <field name="name">Garment Purchase Order Number</field>
        <field name="code">garment.purchase.order</field>
        <field name="prefix">PO/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_purchase_contract" model="ir.sequence">
        <field name="name">Garment Purchase Contract Number</field>
        <field name="code">garment.purchase.contract</field>
        <field name="prefix">PC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_purchase_delivery" model="ir.sequence">
        <field name="name">Garment Purchase GRN Number</field>
        <field name="code">garment.purchase.delivery</field>
        <field name="prefix">GRN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_purchase_fabric_booking" model="ir.sequence">
        <field name="name">Garment Fabric Booking Number</field>
        <field name="code">garment.purchase.fabric.booking</field>
        <field name="prefix">FB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
