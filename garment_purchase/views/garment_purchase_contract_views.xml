<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_purchase_contract_tree" model="ir.ui.view">
        <field name="name">garment.purchase.contract.tree</field>
        <field name="model">garment.purchase.contract</field>
        <field name="arch" type="xml">
            <tree string="Purchase Contracts">
                <field name="contract_number"/>
                <field name="contract_type"/>
                <field name="supplier_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="remaining_qty"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_purchase_contract_form" model="ir.ui.view">
        <field name="name">garment.purchase.contract.form</field>
        <field name="model">garment.purchase.contract</field>
        <field name="arch" type="xml">
            <form string="Purchase Contract">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="contract_number" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="contract_type"/>
                            <field name="supplier_id"/>
                            <field name="material_category"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="payment_term_id"/>
                        </group>
                    </group>
                    <group string="Blanket Agreement Volume" invisible="contract_type != 'blanket'">
                        <field name="total_committed_qty"/>
                        <field name="consumed_qty" readonly="1"/>
                        <field name="remaining_qty" readonly="1"/>
                    </group>
                    <field name="price_terms"/>
                    <field name="order_ids">
                        <tree>
                            <field name="po_number"/>
                            <field name="order_date"/>
                            <field name="total_value"/>
                            <field name="status"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_purchase_contract" model="ir.actions.act_window">
        <field name="name">Purchase Contracts</field>
        <field name="res_model">garment.purchase.contract</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
