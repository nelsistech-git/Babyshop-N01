<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_purchase_delivery_tree" model="ir.ui.view">
        <field name="name">garment.purchase.delivery.tree</field>
        <field name="model">garment.purchase.delivery</field>
        <field name="arch" type="xml">
            <tree string="Deliveries" editable="bottom" decoration-danger="delay_days &gt; 0" decoration-warning="pending_qty &gt; 0">
                <field name="grn_number"/>
                <field name="order_id"/>
                <field name="supplier_id"/>
                <field name="challan_number" optional="hide"/>
                <field name="ordered_qty"/>
                <field name="delivered_qty"/>
                <field name="pending_qty"/>
                <field name="expected_date"/>
                <field name="actual_date"/>
                <field name="delay_days"/>
                <field name="on_time" optional="hide"/>
                <field name="quality_status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_purchase_delivery_form" model="ir.ui.view">
        <field name="name">garment.purchase.delivery.form</field>
        <field name="model">garment.purchase.delivery</field>
        <field name="arch" type="xml">
            <form string="Delivery">
                <sheet>
                    <div class="oe_title"><h1><field name="grn_number" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="supplier_id" readonly="1"/>
                            <field name="challan_number"/>
                            <field name="material_category"/>
                            <field name="ordered_qty"/>
                            <field name="delivered_qty"/>
                            <field name="pending_qty" readonly="1"/>
                        </group>
                        <group>
                            <field name="expected_date"/>
                            <field name="actual_date"/>
                            <field name="delay_days" readonly="1"/>
                            <field name="on_time" readonly="1"/>
                            <field name="quality_status"/>
                        </group>
                    </group>
                    <group string="Purchase Quality Integration — Fabric Checks (SRS section 34)"
                           invisible="material_category != 'fabric'">
                        <field name="gsm_test_result"/>
                        <field name="shade_test_result"/>
                        <field name="shrinkage_test_result"/>
                        <field name="color_fastness_result"/>
                    </group>
                    <group string="Purchase Quality Integration — Accessory Checks (SRS section 34)"
                           invisible="material_category not in ('trim', 'packaging')">
                        <field name="size_check_result"/>
                        <field name="color_match_result"/>
                        <field name="quantity_check_result"/>
                    </group>
                    <group string="Return Management" invisible="return_status == 'none'">
                        <field name="return_qty"/>
                        <field name="return_reason"/>
                        <field name="return_status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_purchase_delivery_search" model="ir.ui.view">
        <field name="name">garment.purchase.delivery.search</field>
        <field name="model">garment.purchase.delivery</field>
        <field name="arch" type="xml">
            <search string="Search Deliveries">
                <field name="grn_number"/>
                <field name="order_id"/>
                <field name="supplier_id"/>
                <filter string="Delayed" name="filter_delayed" domain="[('delay_days', '&gt;', 0)]"/>
                <filter string="On-Time" name="filter_on_time" domain="[('on_time', '=', True)]"/>
                <filter string="Pending Receipt" name="filter_pending" domain="[('pending_qty', '&gt;', 0)]"/>
                <filter string="Has Return" name="filter_return" domain="[('return_status', '!=', 'none')]"/>
                <group expand="0" string="Group By">
                    <filter string="Supplier" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Quality Status" name="group_quality" context="{'group_by': 'quality_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_garment_purchase_delivery_performance_pivot" model="ir.ui.view">
        <field name="name">garment.purchase.delivery.performance.pivot</field>
        <field name="model">garment.purchase.delivery</field>
        <field name="arch" type="xml">
            <pivot string="Delivery Performance Report">
                <field name="supplier_id" type="row"/>
                <field name="on_time" type="col"/>
                <field name="delay_days" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_garment_purchase_delivery" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">garment.purchase.delivery</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_garment_purchase_delivery_performance" model="ir.actions.act_window">
        <field name="name">Delivery Performance Report</field>
        <field name="res_model">garment.purchase.delivery</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_id" ref="view_garment_purchase_delivery_performance_pivot"/>
    </record>
</odoo>
