<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_purchase_fabric_booking_tree" model="ir.ui.view">
        <field name="name">garment.purchase.fabric.booking.tree</field>
        <field name="model">garment.purchase.fabric.booking</field>
        <field name="arch" type="xml">
            <tree string="Fabric Bookings" decoration-muted="status == 'cancelled'">
                <field name="booking_number"/>
                <field name="buyer_id"/>
                <field name="style_id"/>
                <field name="order_id"/>
                <field name="fabric_type"/>
                <field name="quantity"/>
                <field name="supplier_id"/>
                <field name="delivery_date"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_purchase_fabric_booking_form" model="ir.ui.view">
        <field name="name">garment.purchase.fabric.booking.form</field>
        <field name="model">garment.purchase.fabric.booking</field>
        <field name="arch" type="xml">
            <form string="Fabric Booking">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,booked,confirmed"/>
                    <button name="action_confirm_booking" type="object" string="Confirm Booking" class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_cancel_booking" type="object" string="Cancel" class="btn-secondary"
                            invisible="status in ('cancelled', 'confirmed')"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="booking_number" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="style_id"/>
                            <field name="order_id"/>
                            <field name="requisition_id"/>
                        </group>
                        <group>
                            <field name="fabric_type"/>
                            <field name="composition"/>
                            <field name="gsm"/>
                            <field name="width"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="quantity"/>
                            <field name="uom"/>
                        </group>
                        <group>
                            <field name="supplier_id"/>
                            <field name="delivery_date"/>
                            <field name="order_ref_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_purchase_fabric_booking_search" model="ir.ui.view">
        <field name="name">garment.purchase.fabric.booking.search</field>
        <field name="model">garment.purchase.fabric.booking</field>
        <field name="arch" type="xml">
            <search string="Search Fabric Bookings">
                <field name="booking_number"/>
                <field name="buyer_id"/>
                <field name="style_id"/>
                <field name="supplier_id"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_purchase_fabric_booking" model="ir.actions.act_window">
        <field name="name">Fabric Bookings</field>
        <field name="res_model">garment.purchase.fabric.booking</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first fabric booking.</p>
        </field>
    </record>
</odoo>
