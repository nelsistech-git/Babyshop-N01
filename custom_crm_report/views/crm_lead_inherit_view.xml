<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_form_inherit_custom_fields" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.custom.fields</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Notebook er last page er pore notun "Brand & Category" page -->
            <xpath expr="//notebook/page[last()]" position="after">
                <page string="Brand &amp; Category" name="brand_category_page">
                    <group>
                        <group string="Brand Info">
                            <field name="x_brand_name"/>
                            <field name="x_category"/>
                        </group>
                        <group string="Link">
                            <field name="x_page_link"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>