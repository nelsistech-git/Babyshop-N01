<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Custom A4 Landscape paper format -->
    <record id="paperformat_crm_report_landscape" model="report.paperformat">
        <field name="name">CRM Report A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_crm_report_pdf" model="ir.actions.report">
        <field name="name">CRM Report</field>
        <field name="model">crm.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_crm_report.report_crm_report_template</field>
        <field name="report_file">custom_crm_report.report_crm_report_template</field>
        <field name="print_report_name">'CRM Report'</field>
        <field name="paperformat_id" ref="paperformat_crm_report_landscape"/>
    </record>

</odoo>
