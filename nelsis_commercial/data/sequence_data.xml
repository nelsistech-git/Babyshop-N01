<odoo noupdate="1">
    <record id="seq_commercial_file" model="ir.sequence">
        <field name="name">Commercial File</field>
        <field name="code">nelsis.commercial.file</field>
        <field name="prefix">NCF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_commercial_shipment" model="ir.sequence">
        <field name="name">Commercial Shipment</field>
        <field name="code">nelsis.commercial.shipment</field>
        <field name="prefix">NSH/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
