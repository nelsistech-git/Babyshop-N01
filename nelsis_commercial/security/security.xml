<odoo>
    <record id="module_category_nelsis_commercial" model="ir.module.category">
        <field name="name">Nelsis Commercial</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_commercial_user" model="res.groups">
        <field name="name">Commercial User</field>
        <field name="category_id" ref="module_category_nelsis_commercial"/>
    </record>
    <record id="group_commercial_officer" model="res.groups">
        <field name="name">Commercial Officer</field>
        <field name="category_id" ref="module_category_nelsis_commercial"/>
        <field name="implied_ids" eval="[(4, ref('group_commercial_user'))]"/>
    </record>
    <record id="group_commercial_manager" model="res.groups">
        <field name="name">Commercial Manager</field>
        <field name="category_id" ref="module_category_nelsis_commercial"/>
        <field name="implied_ids" eval="[(4, ref('group_commercial_officer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_lc_officer" model="res.groups">
        <field name="name">LC Officer (read-only)</field>
        <field name="category_id" ref="module_category_nelsis_commercial"/>
    </record>
    <record id="group_bond_warehouse_officer" model="res.groups">
        <field name="name">Bond Warehouse Officer (read-only)</field>
        <field name="category_id" ref="module_category_nelsis_commercial"/>
    </record>
    <record id="group_compliance_audit" model="res.groups">
        <field name="name">Compliance / Audit (read-only)</field>
        <field name="category_id" ref="module_category_nelsis_commercial"/>
    </record>

    <!-- Multi-company record rules -->
    <record id="rule_file_company" model="ir.rule">
        <field name="name">Commercial File: multi-company</field>
        <field name="model_id" ref="model_nelsis_commercial_file"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_document_company" model="ir.rule">
        <field name="name">Commercial Document: multi-company</field>
        <field name="model_id" ref="model_nelsis_commercial_document"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shipment_company" model="ir.rule">
        <field name="name">Commercial Shipment: multi-company</field>
        <field name="model_id" ref="model_nelsis_commercial_shipment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_boe_company" model="ir.rule">
        <field name="name">Bill of Entry: multi-company</field>
        <field name="model_id" ref="model_nelsis_commercial_boe"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_line_company" model="ir.rule">
        <field name="name">Documented Line: multi-company</field>
        <field name="model_id" ref="model_nelsis_commercial_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_discrepancy_company" model="ir.rule">
        <field name="name">Discrepancy: multi-company</field>
        <field name="model_id" ref="model_nelsis_commercial_discrepancy"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_setting_company" model="ir.rule">
        <field name="name">Commercial Settings: multi-company</field>
        <field name="model_id" ref="model_nelsis_commercial_setting"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
