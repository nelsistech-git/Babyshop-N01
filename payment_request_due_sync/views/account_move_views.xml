<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vendor bills are paid only from a Payment Request: no "Register Payment" on the bill.
         Priority 400 so this runs after the Post / Due-for-Payment form changes (priority 300). -->
    <record id="view_move_form_no_direct_bill_payment" model="ir.ui.view">
        <field name="name">account.move.form.no.direct.bill.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">400</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_register_payment']" position="attributes">
                <attribute name="invisible" add="move_type in ('in_invoice', 'in_receipt')" separator=" or "/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="bill_stage" invisible="1"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert"
                     invisible="move_type not in ('in_invoice', 'in_receipt') or state != 'posted' or bill_stage != 'due_for_payment' or payment_state not in ('not_paid', 'partial')">
                    Pay this bill from <strong>Payment Requests</strong> (Due for Payment). When the request is
                    marked <em>Paid</em> this bill becomes Paid here automatically.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
