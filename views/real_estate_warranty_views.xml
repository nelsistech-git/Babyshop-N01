<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_real_estate_warranty_tree" model="ir.ui.view">
        <field name="name">real.estate.warranty.tree</field>
        <field name="model">real.estate.warranty</field>
        <field name="arch" type="xml">
            <tree string="Warranty / Snag Claims" decoration-success="status=='closed'" decoration-danger="not is_under_warranty and status != 'closed'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="unit_id"/>
                <field name="category"/>
                <field name="reported_date"/>
                <field name="is_under_warranty" widget="boolean_toggle" readonly="1"/>
                <field name="assigned_user_id"/>
                <field name="status" widget="badge"
                       decoration-success="status=='closed'"
                       decoration-info="status in ('repair','qc')"
                       decoration-warning="status in ('reported','inspection','assigned')"/>
            </tree>
        </field>
    </record>

    <record id="view_real_estate_warranty_form" model="ir.ui.view">
        <field name="name">real.estate.warranty.form</field>
        <field name="model">real.estate.warranty</field>
        <field name="arch" type="xml">
            <form string="Warranty / Snag Claim">
                <header>
                    <button name="action_start_inspection" type="object" string="Start Inspection" class="oe_highlight"
                            invisible="status != 'reported'"/>
                    <button name="action_assign" type="object" string="Assign" class="oe_highlight"
                            invisible="status != 'inspection'"/>
                    <button name="action_start_repair" type="object" string="Start Repair" class="oe_highlight"
                            invisible="status != 'assigned'"/>
                    <button name="action_send_qc" type="object" string="Send to QC" class="oe_highlight"
                            invisible="status != 'repair'"/>
                    <button name="action_close" type="object" string="Close" class="oe_highlight"
                            invisible="status != 'qc'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="status != 'closed'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="reported,inspection,assigned,repair,qc,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="is_under_warranty or not warranty_expiry_date">
                        This claim was reported after the unit's warranty expiry date
                        (<field name="warranty_expiry_date" readonly="1" class="d-inline"/>). It
                        may still be handled as goodwill or a paid service call.
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" required="1"/>
                            <field name="unit_id" required="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="handover_id"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="reported_date"/>
                            <field name="warranty_expiry_date" readonly="1"/>
                            <field name="is_under_warranty" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="contractor_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resolution">
                            <field name="resolution_notes"/>
                        </page>
                        <page string="Photos / Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_real_estate_warranty_search" model="ir.ui.view">
        <field name="name">real.estate.warranty.search</field>
        <field name="model">real.estate.warranty</field>
        <field name="arch" type="xml">
            <search string="Search Warranty Claims">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="unit_id"/>
                <filter string="Open" name="filter_open" domain="[('status','!=','closed')]"/>
                <filter string="Out of Warranty" name="filter_expired" domain="[('is_under_warranty','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_real_estate_warranty" model="ir.actions.act_window">
        <field name="name">Warranty / Snag Claims</field>
        <field name="res_model">real.estate.warranty</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_real_estate_warranty_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Warranty / Snag Claim</p>
        </field>
    </record>

</odoo>
