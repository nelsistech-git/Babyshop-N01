<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_real_estate_qc_checklist_template_tree" model="ir.ui.view">
        <field name="name">real.estate.qc.checklist.template.tree</field>
        <field name="model">real.estate.qc.checklist.template</field>
        <field name="arch" type="xml">
            <tree string="QC Checklist Templates">
                <field name="name"/>
                <field name="category"/>
                <field name="line_count"/>
            </tree>
        </field>
    </record>

    <record id="view_real_estate_qc_checklist_template_form" model="ir.ui.view">
        <field name="name">real.estate.qc.checklist.template.form</field>
        <field name="model">real.estate.qc.checklist.template</field>
        <field name="arch" type="xml">
            <form string="QC Checklist Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Civil - Foundation Stage"/></h1>
                    </div>
                    <group>
                        <field name="category"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="item_name"/>
                            <field name="description"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_real_estate_qc_checklist_template" model="ir.actions.act_window">
        <field name="name">QC Checklist Templates</field>
        <field name="res_model">real.estate.qc.checklist.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first QC Checklist Template</p>
            <p>Reusable checklists (e.g. Civil, Electrical, Plumbing, Finishing) that auto-populate a QC Inspection's items.</p>
        </field>
    </record>

</odoo>
