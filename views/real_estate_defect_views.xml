<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_real_estate_defect_tree" model="ir.ui.view">
        <field name="name">real.estate.defect.tree</field>
        <field name="model">real.estate.defect</field>
        <field name="arch" type="xml">
            <tree string="Defects / NCR" decoration-danger="severity=='critical'" decoration-success="status=='closed'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="unit_id"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity in ('high','critical')"
                       decoration-warning="severity=='medium'"
                       decoration-muted="severity=='low'"/>
                <field name="assigned_user_id"/>
                <field name="due_date"/>
                <field name="status" widget="badge"
                       decoration-success="status=='closed'"
                       decoration-info="status in ('fixed','reinspection')"
                       decoration-warning="status in ('open','assigned','in_progress')"/>
            </tree>
        </field>
    </record>

    <record id="view_real_estate_defect_form" model="ir.ui.view">
        <field name="name">real.estate.defect.form</field>
        <field name="model">real.estate.defect</field>
        <field name="arch" type="xml">
            <form string="Defect / NCR">
                <header>
                    <button name="action_assign" type="object" string="Assign" class="oe_highlight"
                            invisible="status != 'open'"/>
                    <button name="action_start_progress" type="object" string="Start Progress" class="oe_highlight"
                            invisible="status != 'assigned'"/>
                    <button name="action_mark_fixed" type="object" string="Mark Fixed" class="oe_highlight"
                            invisible="status != 'in_progress'"/>
                    <button name="action_send_reinspection" type="object" string="Send for Reinspection" class="oe_highlight"
                            invisible="status != 'fixed'"/>
                    <button name="action_close" type="object" string="Close" class="oe_highlight"
                            invisible="status != 'reinspection'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="status == 'open'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="open,assigned,in_progress,fixed,reinspection,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" required="1"/>
                            <field name="building_id"/>
                            <field name="unit_id"/>
                            <field name="work_package_id"/>
                            <field name="qc_inspection_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="severity"/>
                            <field name="contractor_id"/>
                            <field name="assigned_user_id"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="corrective_action"/>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_real_estate_defect_search" model="ir.ui.view">
        <field name="name">real.estate.defect.search</field>
        <field name="model">real.estate.defect</field>
        <field name="arch" type="xml">
            <search string="Search Defects">
                <field name="name"/>
                <field name="project_id"/>
                <field name="assigned_user_id"/>
                <filter string="Open" name="filter_open" domain="[('status','!=','closed')]"/>
                <filter string="Critical" name="filter_critical" domain="[('severity','=','critical')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_real_estate_defect" model="ir.actions.act_window">
        <field name="name">Defects / NCR</field>
        <field name="res_model">real.estate.defect</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_real_estate_defect_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Defect / NCR</p>
        </field>
    </record>

</odoo>
