<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_real_estate_building_tree" model="ir.ui.view">
        <field name="name">real.estate.building.tree</field>
        <field name="model">real.estate.building</field>
        <field name="arch" type="xml">
            <tree string="Buildings">
                <field name="name"/>
                <field name="building_name"/>
                <field name="project_id"/>
                <field name="building_type"/>
                <field name="total_floors"/>
                <field name="unit_count"/>
            </tree>
        </field>
    </record>

    <record id="view_real_estate_building_form" model="ir.ui.view">
        <field name="name">real.estate.building.form</field>
        <field name="model">real.estate.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_floors" type="object" class="oe_stat_button" icon="fa-list-ol">
                            <field name="floor_count" widget="statinfo" string="Floors"/>
                        </button>
                        <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-home">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="building_name"/>
                        <h1><field name="building_name" placeholder="e.g. Tower A"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. BLD-A"/>
                            <field name="project_id" required="1"/>
                            <field name="building_type"/>
                        </group>
                        <group>
                            <field name="total_floors"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Blocks">
                            <field name="block_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="block_name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_real_estate_building_search" model="ir.ui.view">
        <field name="name">real.estate.building.search</field>
        <field name="model">real.estate.building</field>
        <field name="arch" type="xml">
            <search string="Search Buildings">
                <field name="name"/>
                <field name="building_name"/>
                <field name="project_id"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Building Type" name="group_type" context="{'group_by': 'building_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_real_estate_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">real.estate.building</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_real_estate_building_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Building</p>
        </field>
    </record>

</odoo>
