<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_real_estate_sale_agreement_tree" model="ir.ui.view">
        <field name="name">real.estate.sale.agreement.tree</field>
        <field name="model">real.estate.sale.agreement</field>
        <field name="arch" type="xml">
            <tree string="Sale Agreements" decoration-success="state in ('active','completed')" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="unit_id"/>
                <field name="agreement_date"/>
                <field name="net_price"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('active','completed')"
                       decoration-warning="state=='draft'"
                       decoration-muted="state=='cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_real_estate_sale_agreement_form" model="ir.ui.view">
        <field name="name">real.estate.sale.agreement.form</field>
        <field name="model">real.estate.sale.agreement</field>
        <field name="arch" type="xml">
            <form string="Sale Agreement">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_complete" type="object" string="Complete" class="oe_highlight"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state in ('draft','completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" required="1"/>
                            <field name="unit_id" required="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="booking_id"/>
                            <field name="agreement_date"/>
                        </group>
                        <group>
                            <field name="total_price" required="1"/>
                            <field name="discount"/>
                            <field name="net_price" readonly="1" class="fw-bold"/>
                            <field name="booking_amount"/>
                            <field name="down_payment"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installment Plan (Indicative)">
                            <div class="text-muted mb-2">
                                These fields are indicative; the actual installment
                                schedule is generated by the Installment Plan module
                                in a later phase.
                            </div>
                            <group>
                                <group>
                                    <field name="installment_amount"/>
                                    <field name="number_of_installments"/>
                                    <field name="frequency"/>
                                </group>
                                <group>
                                    <field name="handover_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Terms">
                            <field name="terms"/>
                        </page>
                        <page string="Documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_real_estate_sale_agreement_search" model="ir.ui.view">
        <field name="name">real.estate.sale.agreement.search</field>
        <field name="model">real.estate.sale.agreement</field>
        <field name="arch" type="xml">
            <search string="Search Sale Agreements">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="unit_id"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_real_estate_sale_agreement" model="ir.actions.act_window">
        <field name="name">Sale Agreements</field>
        <field name="res_model">real.estate.sale.agreement</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_real_estate_sale_agreement_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Sale Agreement</p>
        </field>
    </record>

</odoo>
