<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_real_estate_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.real.estate.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_real_estate_customer" invisible="1"/>
                <button name="action_view_bookings" type="object" class="oe_stat_button"
                        icon="fa-bookmark" invisible="booking_count == 0">
                    <field name="booking_count" widget="statinfo" string="Bookings"/>
                </button>
                <button name="action_view_sale_agreements" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" invisible="sale_agreement_count == 0">
                    <field name="sale_agreement_count" widget="statinfo" string="Sale Agreements"/>
                </button>
                <button name="action_view_collections" type="object" class="oe_stat_button"
                        icon="fa-money" invisible="collection_count == 0">
                    <field name="collection_count" widget="statinfo" string="Payments"/>
                </button>
                <button name="action_view_warranty_claims" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="warranty_count == 0">
                    <field name="warranty_count" widget="statinfo" string="Warranty Claims"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Real Estate" name="real_estate_customer">
                    <group>
                        <group>
                            <field name="customer_type"/>
                            <field name="nid_passport"/>
                            <field name="profession"/>
                        </group>
                        <group>
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone"/>
                        </group>
                    </group>
                </page>
                <page string="Customer Ledger" name="real_estate_ledger"
                      invisible="not is_real_estate_customer">
                    <group>
                        <group>
                            <field name="ledger_total_agreement_value"/>
                            <field name="ledger_total_paid"/>
                            <field name="ledger_total_due"/>
                        </group>
                        <group>
                            <field name="ledger_overdue_amount"/>
                            <field name="ledger_next_due_date"/>
                        </group>
                    </group>
                    <field name="installment_ids" readonly="1">
                        <tree decoration-danger="status=='overdue'" decoration-success="status=='paid'">
                            <field name="display_name"/>
                            <field name="due_date"/>
                            <field name="amount"/>
                            <field name="paid_amount"/>
                            <field name="due_amount"/>
                            <field name="status" widget="badge"
                                   decoration-success="status=='paid'"
                                   decoration-danger="status=='overdue'"
                                   decoration-warning="status in ('due_today','partially_paid')"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_real_estate_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('is_real_estate_customer', '=', True)]</field>
        <field name="context">{'default_is_real_estate_customer': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customers yet
            </p>
            <p>Customers appear here automatically once they have a Booking or Sale Agreement. This reuses the standard Contacts app - no duplicate customer records are created.</p>
        </field>
    </record>

</odoo>
