<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_kpi_config" model="ir.sequence">
            <field name="name">KPI Configuration Sequence</field>
            <field name="code">kpi.config</field>
            <field name="prefix">KPICFG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_daily_kpi" model="ir.sequence">
            <field name="name">Daily KPI Sequence</field>
            <field name="code">daily.kpi</field>
            <field name="prefix">DKPI/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_monthly_kpi" model="ir.sequence">
            <field name="name">Monthly KPI Summary Sequence</field>
            <field name="code">monthly.kpi.summary</field>
            <field name="prefix">MKPI/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_yearly_kpi" model="ir.sequence">
            <field name="name">Yearly KPI Summary Sequence</field>
            <field name="code">yearly.kpi.summary</field>
            <field name="prefix">YKPI/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>