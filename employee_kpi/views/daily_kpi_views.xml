<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════════════ -->
<!-- DAILY KPI VIEWS                                        -->
<!-- ══════════════════════════════════════════════════════ -->

    <record id="view_daily_kpi_tree" model="ir.ui.view">
        <field name="name">daily.kpi.tree</field>
        <field name="model">daily.kpi</field>
        <field name="arch" type="xml">
            <tree string="Daily KPI"
                  decoration-success="state == 'approved'"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <field name="total_target"/>
                <field name="total_achieved"/>
                <field name="achievement_percent" widget="percentage"/>
                <field name="kpi_level"/>
                <field name="incentive_percent" string="Incentive %"/>
                <field name="total_incentive" string="Incentive Amount"/>
                <field name="total_time_spent" string="Time (hrs)"/>
                <field name="overall_rating"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'submitted'"
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_daily_kpi_form" model="ir.ui.view">
        <field name="name">daily.kpi.form</field>
        <field name="model">daily.kpi</field>
        <field name="arch" type="xml">
            <form string="Daily KPI">
                <header>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Submit this Daily KPI for review?"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="employee_kpi.group_kpi_manager"
                            confirm="Approve this Daily KPI?"/>
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="employee_kpi.group_kpi_manager"
                            confirm="Reject this Daily KPI?"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'rejected'"
                            confirm="Reset to Draft?"/>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Employee Information">
                            <field name="employee_id"
                                   readonly="state in ('approved', 'submitted')"/>
                            <field name="designation" readonly="1"/>
                            <field name="staff_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="date"
                                   readonly="state in ('approved', 'submitted')"/>
                        </group>
                        <group string="Summary">
                            <field name="total_target" readonly="1"/>
                            <field name="total_achieved" readonly="1"/>
                            <field name="achievement_percent" widget="percentage"/>
                            <field name="kpi_level" readonly="1"/>
                            <field name="incentive_percent" readonly="1"/>
                            <field name="total_incentive" readonly="1"/>
                            <field name="total_time_spent" readonly="1"/>
                            <field name="overall_rating" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="KPI Tasks">
                            <field name="line_ids"
                                   readonly="state == 'approved'"
                                   context="{'default_daily_kpi_id': id, 'active_id': id}">
                                <tree editable="bottom" string="Tasks">
                                    <field name="task_name"/>
                                    <field name="description" optional="show"/>
                                    <field name="target_value"/>
                                    <field name="achieved_value"/>
                                    <field name="achievement_percent" widget="percentage"/>
                                    <field name="kpi_level" readonly="1"/>
                                    <field name="incentive_percent" readonly="1"/>
                                    <field name="incentive_amount" readonly="1"/>
                                    <field name="time_spent"/>
                                    <field name="performance_rating" readonly="1"/>
                                    <field name="remarks" optional="show"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Manager Remarks"
                              groups="employee_kpi.group_kpi_manager">
                            <field name="manager_remarks"
                                   placeholder="Add manager remarks here..."/>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_daily_kpi_search" model="ir.ui.view">
        <field name="name">daily.kpi.search</field>
        <field name="model">daily.kpi</field>
        <field name="arch" type="xml">
            <search string="Search Daily KPI">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <filter string="Today" name="today"
                        domain="[('date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date','&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted"
                        domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state','=','approved')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="My KPIs" name="my_kpis"
                        domain="[('employee_id.user_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_dept"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by': 'date:day'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_daily_kpi" model="ir.actions.act_window">
        <field name="name">Daily KPI</field>
        <field name="res_model">daily.kpi</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_daily_kpi_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Daily KPI entry!
            </p>
            <p>
                Track daily tasks with targets and achievements.
                KPI Level and Incentive % auto-fill from KPI Configuration.
            </p>
        </field>
    </record>

<!-- ══════════════════════════════════════════════════════ -->
<!-- MONTHLY KPI SUMMARY VIEWS                              -->
<!-- ══════════════════════════════════════════════════════ -->

    <record id="view_monthly_kpi_tree" model="ir.ui.view">
        <field name="name">monthly.kpi.summary.tree</field>
        <field name="model">monthly.kpi.summary</field>
        <field name="arch" type="xml">
            <tree string="Monthly KPI Summary"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="total_working_days"/>
                <field name="total_tasks"/>
                <field name="total_target"/>
                <field name="total_achieved"/>
                <field name="achievement_percent" widget="percentage"/>
                <field name="kpi_level"/>
                <field name="incentive_percent" string="Incentive %"/>
                <field name="total_incentive" string="Total Incentive"/>
                <field name="overall_rating"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"/>
            </tree>
        </field>
    </record>

    <record id="view_monthly_kpi_form" model="ir.ui.view">
        <field name="name">monthly.kpi.summary.form</field>
        <field name="model">monthly.kpi.summary</field>
        <field name="arch" type="xml">
            <form string="Monthly KPI Summary">
                <header>
                    <button name="action_compute"
                            string="Compute from Daily KPIs"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'draft'"
                            groups="employee_kpi.group_kpi_manager"
                            confirm="Approve this Monthly KPI Summary?"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'approved'"
                            groups="employee_kpi.group_kpi_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Employee Information">
                            <field name="employee_id"/>
                            <field name="designation" readonly="1"/>
                            <field name="staff_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="month"/>
                            <field name="year"/>
                        </group>
                        <group string="Auto-Computed (from Daily KPIs)">
                            <field name="daily_kpi_count" readonly="1"/>
                            <field name="total_working_days" readonly="1"/>
                            <field name="total_tasks" readonly="1"/>
                            <field name="total_target" readonly="1"/>
                            <field name="total_achieved" readonly="1"/>
                            <field name="total_time_spent" readonly="1"/>
                            <field name="achievement_percent" widget="percentage"/>
                            <field name="kpi_level" readonly="1"/>
                            <field name="incentive_percent" readonly="1"/>
                            <field name="total_incentive" readonly="1"/>
                        </group>
                    </group>

                    <group string="Manager Assessment">
                        <group>
                            <field name="manager_achievement_percent"/>
                            <field name="overall_rating"/>
                        </group>
                        <group>
                            <field name="manager_remarks"
                                   placeholder="Manager remarks..."/>
                        </group>
                    </group>

                    <div class="text-center mt8">
                        <button name="action_view_daily_kpis"
                                string="View Daily KPI Entries"
                                type="object"
                                class="btn-secondary"/>
                    </div>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_monthly_kpi_summary" model="ir.actions.act_window">
        <field name="name">Monthly KPI Summary</field>
        <field name="res_model">monthly.kpi.summary</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Monthly KPI Summary!
            </p>
            <p>
                Select employee and month, then click
                "Compute from Daily KPIs" to auto-fill.
            </p>
        </field>
    </record>

