                    <group>
                        <group string="Employee Information">
                            <field name="employee_id"/>
                            <field name="designation" readonly="1"/>
                            <field name="staff_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="year"/>
                            <field name="monthly_count" readonly="1"/>
                        </group>
                        <group string="Yearly Totals (Auto-Computed)">
                            <field name="total_working_days" readonly="1"/>
                            <field name="total_tasks" readonly="1"/>
                            <field name="total_target" readonly="1"/>
                            <field name="total_achieved" readonly="1"/>
                            <field name="total_time_spent" readonly="1"/>
                            <field name="achievement_percent" widget="percentage"/>
