<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_worker_incentive_tree" model="ir.ui.view">
        <field name="name">fw.worker.incentive.tree</field>
        <field name="model">fw.worker.incentive</field>
        <field name="arch" type="xml">
            <tree string="Worker Incentives" decoration-success="state=='paid'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="scheme_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="incentive_amount" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_worker_incentive_form" model="ir.ui.view">
        <field name="name">fw.worker.incentive.form</field>
        <field name="model">fw.worker.incentive</field>
        <field name="arch" type="xml">
            <form string="Worker Incentive">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="scheme_id"/>
                            <field name="scheme_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Piece Rate Basis" invisible="scheme_type != 'piece_rate'">
                        <group>
                            <field name="total_qty_produced" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_pull_qty_produced" type="object"
                                    string="Pull Qty from Worker Output" class="btn-secondary"/>
                        </group>
                    </group>
                    <group string="Efficiency Bonus Basis" invisible="scheme_type != 'efficiency_bonus'">
                        <field name="efficiency_percent"/>
                    </group>
                    <group string="Result">
                        <field name="incentive_amount" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fw_worker_incentive_search" model="ir.ui.view">
        <field name="name">fw.worker.incentive.search</field>
        <field name="model">fw.worker.incentive</field>
        <field name="arch" type="xml">
            <search string="Search Worker Incentives">
                <field name="employee_id"/>
                <field name="scheme_id"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Scheme" name="group_scheme" context="{'group_by': 'scheme_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_worker_incentive" model="ir.actions.act_window">
        <field name="name">Worker Incentives</field>
        <field name="res_model">fw.worker.incentive</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_worker_incentive_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first worker incentive calculation</p>
        </field>
    </record>
</odoo>
