<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_hs_code_tree" model="ir.ui.view">
        <field name="name">garment.hs.code.tree</field>
        <field name="model">garment.hs.code</field>
        <field name="arch" type="xml">
            <tree string="HS Codes" editable="bottom">
                <field name="code"/>
                <field name="description"/>
                <field name="style_id"/>
                <field name="product_category_id"/>
                <field name="duty_rate"/>
                <field name="country_id"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_hs_code_form" model="ir.ui.view">
        <field name="name">garment.hs.code.form</field>
        <field name="model">garment.hs.code</field>
        <field name="arch" type="xml">
            <form string="HS Code">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="description"/>
                            <field name="style_id"/>
                            <field name="product_category_id"/>
                        </group>
                        <group>
                            <field name="duty_rate"/>
                            <field name="country_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Country-Specific Rules / Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_hs_code" model="ir.actions.act_window">
        <field name="name">HS Codes</field>
        <field name="res_model">garment.hs.code</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first HS Code.</p>
        </field>
    </record>

</odoo>
