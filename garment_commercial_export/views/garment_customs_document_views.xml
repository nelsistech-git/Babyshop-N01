<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_customs_document_form" model="ir.ui.view">
        <field name="name">garment.customs.document.form</field>
        <field name="model">garment.customs.document</field>
        <field name="arch" type="xml">
            <form string="Customs Document">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,submitted,under_assessment,cleared"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="document_number" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="shipment_id"/>
                            <field name="import_permission_id"/>
                            <field name="hs_code_id"/>
                            <field name="customs_office"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="declared_value"/>
                            <field name="duty_amount"/>
                            <field name="submission_date"/>
                            <field name="clearance_date"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_customs_document_tree" model="ir.ui.view">
        <field name="name">garment.customs.document.tree</field>
        <field name="model">garment.customs.document</field>
        <field name="arch" type="xml">
            <tree string="Customs Documents" decoration-success="status == 'cleared'">
                <field name="document_number"/>
                <field name="document_type"/>
                <field name="shipment_id"/>
                <field name="declared_value"/>
                <field name="submission_date"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_customs_document" model="ir.actions.act_window">
        <field name="name">Customs Documents</field>
        <field name="res_model">garment.customs.document</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Customs Document.</p>
        </field>
    </record>

</odoo>
