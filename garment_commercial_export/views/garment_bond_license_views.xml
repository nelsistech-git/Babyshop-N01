<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_bond_license_form" model="ir.ui.view">
        <field name="name">garment.bond.license.form</field>
        <field name="model">garment.bond.license</field>
        <field name="arch" type="xml">
            <form string="Bond License">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,renewal_due,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_register" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="register_count" widget="statinfo" string="Register Lines"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="license_number" required="1"/></h1></div>
                    <group>
                        <group>
                            <field name="license_type"/>
                            <field name="issuing_authority"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="bond_value"/>
                            <field name="total_imported_qty" readonly="1"/>
                            <field name="total_balance_qty" readonly="1"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_bond_license_tree" model="ir.ui.view">
        <field name="name">garment.bond.license.tree</field>
        <field name="model">garment.bond.license</field>
        <field name="arch" type="xml">
            <tree string="Bond Licenses" decoration-danger="days_to_expiry &lt; 30 and status == 'active'">
                <field name="license_number"/>
                <field name="license_type"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_bond_license" model="ir.actions.act_window">
        <field name="name">Bond Licenses</field>
        <field name="res_model">garment.bond.license</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Bond License.</p>
        </field>
    </record>

</odoo>
