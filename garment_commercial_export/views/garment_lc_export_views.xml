<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_lc_form_export_inherit" model="ir.ui.view">
        <field name="name">garment.lc.form.export.inherit</field>
        <field name="model">garment.lc</field>
        <field name="inherit_id" ref="garment_finance.view_garment_lc_form"/>
        <field name="arch" type="xml">
            <field name="bank_id" position="after">
                <field name="lc_type"/>
                <field name="master_lc_id" invisible="lc_type != 'back_to_back'"
                       required="lc_type == 'back_to_back'"/>
                <field name="supplier_id" invisible="lc_type != 'back_to_back'"/>
            </field>
            <field name="amendment_count" position="after">
                <field name="issuing_bank_id"/>
                <field name="advising_bank_id"/>
                <field name="buyer_bank_id"/>
                <field name="utilized_amount" readonly="1"/>
                <field name="balance_amount" readonly="1"/>
                <field name="utilization_pct" readonly="1" widget="percentage"/>
            </field>

            <!-- FIXED: Target the notebook directly and add pages at the end to avoid selector errors -->
            <xpath expr="//notebook" position="inside">
                <page string="Amendments" name="amendments">
                    <field name="amendment_ids">
                        <tree editable="bottom">
                            <field name="amendment_number"/>
                            <field name="amendment_date"/>
                            <field name="change_summary"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="reason"/>
                            <field name="approval_date"/>
                            <field name="status"/>
                        </tree>
                    </field>
                </page>
                <page string="Back-to-Back LCs" name="btb_lcs" invisible="lc_type not in ('master', 'export')">
                    <field name="btb_lc_ids">
                        <tree>
                            <field name="lc_number"/>
                            <field name="supplier_id"/>
                            <field name="lc_amount"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="status"/>
                        </tree>
                    </field>
                </page>
                <page string="Utilization" name="utilization">
                    <group>
                        <field name="export_documentation_ids" invisible="lc_type == 'back_to_back'">
                            <tree>
                                <field name="document_number"/>
                                <field name="document_type"/>
                                <field name="document_date"/>
                                <field name="total_value"/>
                                <field name="status"/>
                            </tree>
                        </field>
                        <field name="import_permission_ids" invisible="lc_type != 'back_to_back'">
                            <tree>
                                <field name="ip_number"/>
                                <field name="import_category"/>
                                <field name="value"/>
                                <field name="status"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_garment_lc_tree_export_inherit" model="ir.ui.view">
        <field name="name">garment.lc.tree.export.inherit</field>
        <field name="model">garment.lc</field>
        <field name="inherit_id" ref="garment_finance.view_garment_lc_tree"/>
        <field name="arch" type="xml">
            <field name="lc_amount" position="after">
                <field name="lc_type"/>
                <field name="utilization_pct" widget="percentage" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_garment_lc_search_export_inherit" model="ir.ui.view">
        <field name="name">garment.lc.search.export.inherit</field>
        <field name="model">garment.lc</field>
        <field name="inherit_id" ref="garment_finance.view_garment_lc_search"/>
        <field name="arch" type="xml">
            <filter name="filter_active" position="after">
                <filter string="Back-to-Back LC" name="filter_btb" domain="[('lc_type', '=', 'back_to_back')]"/>
                <filter string="Master / Export LC" name="filter_master"
                        domain="[('lc_type', 'in', ('master', 'export'))]"/>
            </filter>
            <filter name="group_stage" position="after">
                <filter string="LC Type" name="group_lc_type" context="{'group_by': 'lc_type'}"/>
            </filter>
        </field>
    </record>

    <record id="action_garment_lc_btb" model="ir.actions.act_window">
        <field name="name">Back-to-Back LC</field>
        <field name="res_model">garment.lc</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('lc_type', '=', 'back_to_back')]</field>
        <field name="context">{'default_lc_type': 'back_to_back'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Open your first Back-to-Back LC against a Master LC.</p>
        </field>
    </record>

</odoo>