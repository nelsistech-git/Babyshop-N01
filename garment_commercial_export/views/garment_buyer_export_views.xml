<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_buyer_form_commercial_export_inherit" model="ir.ui.view">
        <field name="name">garment.buyer.form.commercial.export.inherit</field>
        <field name="model">garment.buyer</field>
        <field name="inherit_id" ref="garment_buyer_crm.view_garment_buyer_form"/>
        <field name="arch" type="xml">
            <field name="ai_last_insight" position="after">
                <field name="ai_commercial_risk_last_run" readonly="1"/>
                <field name="ai_commercial_risk_note" readonly="1" nolabel="1"/>
                <button name="action_run_ai_commercial_risk" type="object" string="Run AI Commercial Risk Analysis"
                        class="btn-secondary" icon="fa-magic"/>
            </field>
        </field>
    </record>

</odoo>
