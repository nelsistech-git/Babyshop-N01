<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_commercial_doc_requirement_tree" model="ir.ui.view">
        <field name="name">garment.commercial.doc.requirement.tree</field>
        <field name="model">garment.commercial.doc.requirement</field>
        <field name="arch" type="xml">
            <tree string="Buyer Document Requirements" editable="bottom">
                <field name="buyer_id"/>
                <field name="sequence" widget="handle"/>
                <field name="document_type"/>
                <field name="is_mandatory"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_commercial_doc_requirement" model="ir.actions.act_window">
        <field name="name">Buyer Document Requirements</field>
        <field name="res_model">garment.commercial.doc.requirement</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first buyer document requirement.</p>
        </field>
    </record>

</odoo>
