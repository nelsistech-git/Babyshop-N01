<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_garment_exp_form" model="ir.actions.report">
        <field name="name">EXP Form</field>
        <field name="model">garment.exp.form</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">garment_commercial_export.report_garment_exp_form</field>
        <field name="report_file">garment_commercial_export.report_garment_exp_form</field>
        <field name="binding_model_id" ref="model_garment_exp_form"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'EXP Form - %s' % (object.exp_number)</field>
    </record>

    <template id="report_garment_exp_form">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Export Registration Form (EXP) <span t-field="o.exp_number"/></h2>
                        <table class="table table-sm">
                            <tr><td><strong>Exporter</strong></td><td><span t-field="o.exporter"/></td></tr>
                            <tr><td><strong>Buyer</strong></td><td><span t-field="o.buyer_id.name"/></td></tr>
                            <tr><td><strong>Invoice Reference</strong></td>
                                <td><span t-field="o.export_documentation_id.document_number"/></td></tr>
                            <tr><td><strong>Shipment Date</strong></td><td><span t-field="o.shipment_date"/></td></tr>
                            <tr><td><strong>Export Value</strong></td>
                                <td><span t-field="o.export_value"/> <span t-field="o.currency_id.name"/></td></tr>
                            <tr><td><strong>Bank</strong></td><td><span t-field="o.bank_id.bank_name"/></td></tr>
                            <tr><td><strong>Workflow Stage</strong></td><td><span t-field="o.workflow_stage"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><span t-field="o.status"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
