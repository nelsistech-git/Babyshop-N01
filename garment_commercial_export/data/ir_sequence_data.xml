<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_import_permission" model="ir.sequence">
        <field name="name">Garment Import Permission Number</field>
        <field name="code">garment.import.permission</field>
        <field name="prefix">IP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_utilization_declaration" model="ir.sequence">
        <field name="name">Garment Utilization Declaration Number</field>
        <field name="code">garment.utilization.declaration</field>
        <field name="prefix">UD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_customs_document" model="ir.sequence">
        <field name="name">Garment Customs Document Number</field>
        <field name="code">garment.customs.document</field>
        <field name="prefix">CUS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_export_incentive" model="ir.sequence">
        <field name="name">Garment Export Incentive Claim Number</field>
        <field name="code">garment.export.incentive</field>
        <field name="prefix">INC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_exp_form" model="ir.sequence">
        <field name="name">Garment EXP Form Number</field>
        <field name="code">garment.exp.form</field>
        <field name="prefix">EXP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
