<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_commercial_export" model="ir.module.category">
            <field name="name">Smart Garment ERP - Commercial &amp; Export</field>
            <field name="sequence">66</field>
        </record>

        <record id="group_commercial_documentation_officer" model="res.groups">
            <field name="name">Documentation Officer (Prepare Export Documents)</field>
            <field name="category_id" ref="module_category_garment_commercial_export"/>
        </record>

        <record id="group_commercial_export_officer" model="res.groups">
            <field name="name">Export Officer (EXP, Customs, Incentive)</field>
            <field name="category_id" ref="module_category_garment_commercial_export"/>
        </record>

        <record id="group_commercial_import_officer" model="res.groups">
            <field name="name">Import Officer (IP, UD, Bond)</field>
            <field name="category_id" ref="module_category_garment_commercial_export"/>
        </record>

        <record id="group_commercial_lc_officer" model="res.groups">
            <field name="name">LC Officer (LC, Back-to-Back LC, Amendments)</field>
            <field name="category_id" ref="module_category_garment_commercial_export"/>
        </record>

        <record id="group_commercial_export_manager" model="res.groups">
            <field name="name">Commercial Manager (Approve)</field>
            <field name="category_id" ref="module_category_garment_commercial_export"/>
            <field name="implied_ids" eval="[(4, ref('group_commercial_documentation_officer')),
                                              (4, ref('group_commercial_export_officer')),
                                              (4, ref('group_commercial_import_officer')),
                                              (4, ref('group_commercial_lc_officer'))]"/>
        </record>

        <record id="group_commercial_export_director" model="res.groups">
            <field name="name">Commercial Director (Full Access)</field>
            <field name="category_id" ref="module_category_garment_commercial_export"/>
            <field name="implied_ids" eval="[(4, ref('group_commercial_export_manager'))]"/>
        </record>

        <record id="rule_garment_bond_license_manager_full" model="ir.rule">
            <field name="name">Commercial Manager+: All Bond Licenses</field>
            <field name="model_id" ref="model_garment_bond_license"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_commercial_export_manager'))]"/>
        </record>

        <record id="rule_garment_lc_amendment_manager_full" model="ir.rule">
            <field name="name">Commercial Manager+: All LC Amendments</field>
            <field name="model_id" ref="model_garment_lc_amendment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_commercial_export_manager'))]"/>
        </record>

    </data>
</odoo>
