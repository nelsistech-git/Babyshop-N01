<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="param_bill_approval_limit" model="ir.config_parameter">
            <field name="key">custom_account_day_book.approval_limit</field>
            <field name="value">250000</field>
        </record>
    </data>

    <record id="paperformat_mtailor" model="report.paperformat">
        <field name="name">MTAILOR Letterhead A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">33</field>
        <field name="dpi">90</field>
    </record>

    <record id="paperformat_mtailor_landscape" model="report.paperformat">
        <field name="name">MTAILOR Letterhead A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">33</field>
        <field name="dpi">90</field>
    </record>

</odoo>