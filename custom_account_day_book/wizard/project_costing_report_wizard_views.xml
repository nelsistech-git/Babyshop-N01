<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_project_costing_report_wizard_form" model="ir.ui.view">
            <field name="name">project.costing.report.wizard.form</field>
            <field name="model">project.costing.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Project Costing Report">
                    <group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                        <group>
                            <field name="src_location_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" />
                            <field name="dest_location_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" />
                            <field name="rpt_type" required="1"/>

                        </group>
                    </group>
                    <footer>
                        <button name="project_costing_report_pdf" string="Download (PDF)" type="object" class="btn-primary"/>
                        <button name="project_costing_report_excel" string="Download (Excel)" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_project_costing_report" model="ir.actions.act_window">
            <field name="name">Project Costing Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.costing.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_project_costing_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_project_costing_report_wizard"
              name="Project Costing Report"
              sequence="160"
              action="action_project_costing_report"
              parent="base_accounting_kit.submenu_inventory_reporting"
			  groups="account.group_account_manager"
        />
    </data>
</odoo>