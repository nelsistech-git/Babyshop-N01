<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vendor_bill_workflow" model="ir.ui.view">
        <field name="name">account.move.form.vendor.bill.workflow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">300</field>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <field name="bill_stage" invisible="1"/>
                <field name="can_user_post_bill" invisible="1"/>
                <field name="bill_required_step" invisible="1"/>
                <field name="company_currency_id" invisible="1"/>
            </xpath>

            <!-- Vendor bills: the original "Register Payment" is only available after "Post" (Due for Payment) -->
            <xpath expr="//button[@name='action_register_payment']" position="attributes">
                <attribute name="invisible">state != 'posted' or payment_state not in ('not_paid', 'partial') or move_type == 'entry' or (move_type in ('in_invoice', 'in_receipt') and bill_stage != 'due_for_payment')</attribute>
            </xpath>

            <!-- "Register Payment" -> "Post" on vendor bills (approval matrix + Due for Payment) -->
            <xpath expr="//button[@name='action_register_payment']" position="after">
                <button name="action_post_for_payment" id="vendor_bill_post_btn" type="object"
                        string="Post" class="oe_highlight" data-hotkey="g"
                        groups="account.group_account_invoice"
                        invisible="not can_user_post_bill"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="move_type not in ('in_invoice', 'in_receipt') or state != 'posted' or bill_stage != 'pending' or can_user_post_bill or payment_state not in ('not_paid', 'partial')">
                    <field name="bill_approval_note" readonly="1" nolabel="1" class="oe_inline"/>
                    You cannot post this bill with your current approval rights.
                </div>
                <div class="alert alert-success mb-0" role="alert"
                     invisible="move_type not in ('in_invoice', 'in_receipt') or state != 'posted' or bill_stage != 'due_for_payment' or payment_state not in ('not_paid', 'partial')">
                    This bill is <strong>Due for Payment</strong>.
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Supporting Documents" name="support_docs"
                      invisible="move_type not in ('in_invoice', 'in_receipt')">
                    <group>
                        <group string="Posting / Approval">
                            <field name="bill_stage" readonly="1"/>
                            <field name="bill_gross_amount" readonly="1"/>
                            <field name="bill_required_step" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Mandatory documents: Invoice, PO, GRN, Work Order and other necessary papers"/>
                    <field name="support_doc_ids" readonly="state == 'cancel'">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="doc_type"/>
                            <field name="reference"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" column_invisible="1"/>
                            <field name="note"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Bills list: stage column -->
    <record id="view_in_invoice_bill_tree_stage" model="ir.ui.view">
        <field name="name">account.move.bill.tree.stage</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="bill_stage" optional="show" widget="badge"
                       decoration-success="bill_stage == 'due_for_payment'"
                       decoration-warning="bill_stage == 'pending'"/>
            </xpath>
        </field>
    </record>

    <!-- Due for Payment / Pending Approval lists -->
    <record id="action_bills_due_for_payment" model="ir.actions.act_window">
        <field name="name">Due for Payment</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_receipt')), ('state', '=', 'posted'), ('bill_stage', '=', 'due_for_payment'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bill is due for payment</p>
            <p>Posted vendor bills appear here and in Payment Requests &gt; Due for Payment. Pay them from the Payment Request.</p>
        </field>
    </record>
    <record id="action_bills_due_for_payment_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="act_window_id" ref="action_bills_due_for_payment"/>
    </record>
    <record id="action_bills_due_for_payment_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account.view_move_form"/>
        <field name="act_window_id" ref="action_bills_due_for_payment"/>
    </record>

    <record id="action_bills_pending_approval" model="ir.actions.act_window">
        <field name="name">Pending Approval (to Post)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_receipt')), ('state', '=', 'posted'), ('bill_stage', '=', 'pending'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>
    <record id="action_bills_pending_approval_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="act_window_id" ref="action_bills_pending_approval"/>
    </record>
    <record id="action_bills_pending_approval_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account.view_move_form"/>
        <field name="act_window_id" ref="action_bills_pending_approval"/>
    </record>
</odoo>
