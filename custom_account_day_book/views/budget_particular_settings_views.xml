<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Budget Particular Settings Form View -->
        <record id="view_budget_particular_settings_form" model="ir.ui.view">
            <field name="name">budget.particular.settings.form</field>
            <field name="model">budget.particular.settings</field>
            <field name="arch" type="xml">
                <form string="Budget Particular Settings">
                    <sheet>
                        <group>
                            <group>
                            	<field name="particular_type" required="1"/>
                                <field name="name" required="1"/>
                                <field name="code" required="1" readonly="1" force_save="1"/>                                
                                <field name="parent_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" 
                                required="particular_type in ['sub_parent','child']"/>
                                <field name="account_id" options="{'no_open':True,'no_create':1,'no_create_edit':1, 'no_quick_create': True}" 
                                invisible="particular_type != 'child'" required="particular_type == 'child'"/>
                                <field name="report_type" required="1"/>
                                <field name="active"/>
                            </group>
                            <group></group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
		
        <!-- Budget Particular Settings Tree View -->
        <record id="view_budget_particular_settings_tree" model="ir.ui.view">
            <field name="name">budget.particular.settings.tree</field>
            <field name="model">budget.particular.settings</field>
            <field name="arch" type="xml">
                <tree string="Budget Particular Settings">
                    <field name="name" readonly="1"/>
                    <field name="code" readonly="1"/>
                    <field name="particular_type" readonly="1"/>
                    <field name="parent_id" readonly="1"/>
                    <field name="account_id" readonly="1"/>
                    <field name="report_type" readonly="1"/>
                    <field name="active" readonly="1"/>
                </tree>
            </field>
        </record>

