        <!-- Budget Particular Settings Action -->
        <record id="action_budget_particular_settings" model="ir.actions.act_window">
            <field name="type">ir.actions.act_window</field>
            <field name="name">Budget Particular Settings</field>
            <field name="res_model">budget.particular.settings</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create Budget Particular Settings
                </p>
            </field>
        </record>

        <menuitem id="menu_budget_particular_root" name="Budget" parent="account.menu_finance" sequence="15"/>

        <menuitem id="menu_budget_particular_settings" name="Budget Particular Settings" parent="custom_account_day_book.menu_budget_particular_root" action="action_budget_particular_settings" groups="account.group_account_manager" sequence="8"/>
    </data>
</odoo>