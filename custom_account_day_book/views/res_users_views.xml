<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_bill_approval" model="ir.ui.view">
        <field name="name">res.users.form.bill.approval</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Bill Approval" name="bill_approval">
                    <group string="Vendor Bill Approval Authority (tick the steps this user may approve)">
                        <field name="bill_approval_step1"/>
                        <field name="bill_approval_step2"/>
                        <field name="bill_approval_step3"/>
                    </group>
                    <div class="text-muted">
                        Step 1: bills up to BDT 250,000 &#8226; Step 2: bills above BDT 250,000 (CEO approval)
                        &#8226; Step 3: reserved. The limit is the system parameter
                        <code>custom_account_day_book.approval_limit</code>.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
