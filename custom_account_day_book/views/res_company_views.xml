<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_letterhead" model="ir.ui.view">
        <field name="name">res.company.form.letterhead</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Letterhead" name="letterhead">
                    <group>
                        <group string="Header">
                            <field name="letterhead_name"/>
                            <field name="letterhead_logo" widget="image" options="{'size': [0, 90]}"/>
                        </group>
                        <group string="Footer">
                            <field name="letterhead_registered_office"/>
                            <field name="letterhead_corporate_office"/>
                            <field name="letterhead_phone"/>
                            <field name="letterhead_email"/>
                            <field name="letterhead_website"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
