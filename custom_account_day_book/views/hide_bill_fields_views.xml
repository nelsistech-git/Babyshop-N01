<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_hide_bill_fields" model="ir.ui.view">
        <field name="name">account.move.form.hide.bill.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">

            <xpath expr="(//field[@name='location_id'])[1]" position="attributes">
                <attribute name="invisible">move_type in ('in_invoice', 'in_refund', 'in_receipt')</attribute>
            </xpath>

            <xpath expr="(//field[@name='account_tag_ids'])[1]" position="attributes">
                <attribute name="invisible">move_type in ('in_invoice', 'in_refund', 'in_receipt')</attribute>
            </xpath>

            <xpath expr="(//field[@name='partner_bank_id'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="(//field[@name='payment_reference'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Invoice Lines: Taxes -> VAT -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">
                <attribute name="string">VAT</attribute>
            </xpath>

            <!-- Invoice Lines: Tax excl. -> VAT Excl. -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="attributes">
                <attribute name="string">VAT Excl.</attribute>
            </xpath>

        </field>
    </record>
</odoo>