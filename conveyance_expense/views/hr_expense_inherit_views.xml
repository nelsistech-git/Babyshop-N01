<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_expense_view_form_conveyance_button" model="ir.ui.view">
        <field name="name">hr.expense.form.conveyance.button</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">

            <!-- ============ SIMPLE & USER-FRIENDLY FORM ============ -->

            <!-- Hide: "What is this expense for?" (label + field). The name is filled automatically
                 (see hr.expense.create) so no input is needed. -->
            <xpath expr="//label[@for='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </field>

            <!-- Hide: Split Expense button -->
            <xpath expr="//button[@name='action_split_wizard']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide: Included taxes (label + value row). Taxes still compute automatically from the Category -->
            <xpath expr="//label[@for='tax_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_ids']/parent::div" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide: Currency selector (company currency is used) -->
            <xpath expr="//field[@name='currency_id'][@groups='base.group_multi_currency']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide: Expense Account (comes from the Category) -->
            <field name="account_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Hide: Analytic Distribution -->
            <field name="analytic_distribution" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Hide: Company (visible field only; the technical one stays) -->
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide: Notes -->
            <field name="description" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Employee and Paid By are intentionally kept visible. Category, Expense Date and Total are hidden
                 by hr.expense._get_view() (they are columns of the Expense Details lines below). -->

            <!-- Balance the layout: Employee moves to the right column above Date.
                 Left: Category, Total, Paid By  |  Right: Employee, Date -->
            <xpath expr="//field[@name='date']" position="before">
                <xpath expr="//t[@groups='hr_expense.group_hr_expense_team_approver']" position="move"/>
            </xpath>

            <!-- Designation: right column, directly under Employee (read-only, comes from the Employee) -->
            <xpath expr="//field[@name='date']" position="before">
                <field name="employee_designation_id" options="{'no_open': True}"/>
            </xpath>

            <!-- ============ CONVEYANCE ============ -->

            <!-- Details button (opens full Conveyance Sheet with approval workflow) -->
            <xpath expr="//button[@name='action_split_wizard']" position="after">
                <button
                    name="action_open_conveyance_sheet"
                    string="Details"
                    type="object"
                    class="btn-secondary"
                    icon="fa-list-alt"
                />
            </xpath>

            <!-- Conveyance lines directly inside the Expense form (short, simple columns) -->
            <xpath expr="//sheet" position="inside">
                <separator string="Expense Details"/>
                <field name="conveyance_line_ids"
                       context="{'default_date': context_today().strftime('%Y-%m-%d')}">
                    <tree editable="bottom" string="Expense Lines">
                        <field name="date"/>
                        <field name="from_location" optional="hide"/>
                        <field name="to_location" optional="hide"/>
                        <field name="purpose"/>
                        <field name="transport" optional="hide"/>
                        <field name="category_id" string="Category" required="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="amount" string="Amount" sum="Total"/>
                        <field name="x_receipt_reference" string="Reference No"/>
                        <field name="x_receipt_attachment" string="Receipt" widget="binary"
                               filename="x_receipt_filename"
                               options="{'accepted_file_extensions': '.pdf,.jpg,.jpeg'}"/>
                        <field name="x_receipt_filename" column_invisible="1"/>
                        <!-- Rarely needed: hidden by default, can be shown from the column selector -->
                        <field name="customer_id" optional="hide"/>
                        <field name="others_cost" optional="hide"/>
                        <field name="remarks" optional="hide"/>
                    </tree>
                </field>
            </xpath>

        </field>
    </record>

    <record id="view_hr_expense_sheet_form_number" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.number</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='employee_id'])[1]" position="before">
                <field name="sheet_number"/>
                <field name="submission_date"/>
            </xpath>
        </field>
    </record>

</odoo>