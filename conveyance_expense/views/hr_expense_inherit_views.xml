<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_expense_view_form_conveyance_button" model="ir.ui.view">
        <field name="name">hr.expense.form.conveyance.button</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">

            <!-- Odoo 17: button placed after Split Expense button -->
            <xpath expr="//button[@name='action_split_wizard']" position="after">
                <button
                    name="action_open_conveyance_sheet"
                    string="Details"
                    type="object"
                    class="btn-secondary"
                    icon="fa-list-alt"
                />
            </xpath>

        </field>
    </record>

</odoo>
