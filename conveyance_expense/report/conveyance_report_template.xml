<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_conveyance_sheet_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page">

                    <div style="text-align:center; margin-bottom:16px;">
                        <h2 style="text-transform:uppercase; font-weight:bold;">Conveyance Bill</h2>
                        <p>Reference: <strong><span t-esc="doc.name"/></strong></p>
                    </div>

                    <table style="width:100%; border-collapse:collapse; margin-bottom:12px;">
                        <tr>
                            <td style="width:50%; padding:4px;"><strong>Employee: </strong><span t-esc="doc.employee_id.name"/></td>
                            <td style="width:50%; padding:4px;"><strong>Designation: </strong><span t-esc="doc.designation.name or ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding:4px;"><strong>Date From: </strong><span t-esc="str(doc.date_from) if doc.date_from else ''"/></td>
                            <td style="padding:4px;"><strong>Date To: </strong><span t-esc="str(doc.date_to) if doc.date_to else ''"/></td>
                        </tr>
                        <tr>
                            <td colspan="2" style="padding:4px;"><strong>Status: </strong><span t-esc="dict(doc._fields['state'].selection).get(doc.state, '')"/></td>
                        </tr>
                    </table>

                    <table style="width:100%; border-collapse:collapse; font-size:10px;">
                        <thead>
                            <tr style="background-color:#6C7E7F; color:white;">
                                <th style="width:4%; padding:5px; border:1px solid #999; text-align:center;">SL</th>
                                <th style="width:7%; padding:5px; border:1px solid #999;">Date</th>
                                <th style="width:7%; padding:5px; border:1px solid #999;">From</th>
                                <th style="width:7%; padding:5px; border:1px solid #999;">To</th>
                                <th style="width:8%; padding:5px; border:1px solid #999;">Purpose</th>
                                <th style="width:7%; padding:5px; border:1px solid #999;">Transport</th>
                                <th style="width:8%; padding:5px; border:1px solid #999;">Customer</th>
                                <th style="width:8%; padding:5px; border:1px solid #999; text-align:right;">Conv. Amount</th>
                                <th style="width:7%; padding:5px; border:1px solid #999; text-align:right;">Food Bill</th>
                                <th style="width:8%; padding:5px; border:1px solid #999;">Others Cost</th>
                                <th style="width:7%; padding:5px; border:1px solid #999; text-align:right;">Amount</th>
                                <th style="width:8%; padding:5px; border:1px solid #999; text-align:right;">Total Amount</th>
                                <th style="width:9%; padding:5px; border:1px solid #999;">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <tr>
                                    <td style="padding:4px; border:1px solid #ccc; text-align:center;"><span t-esc="line_index + 1"/></td>
                                    <td style="padding:4px; border:1px solid #ccc;"><span t-esc="str(line.date) if line.date else ''"/></td>
                                    <td style="padding:4px; border:1px solid #ccc;"><span t-esc="line.from_location or ''"/></td>
                                    <td style="padding:4px; border:1px solid #ccc;"><span t-esc="line.to_location or ''"/></td>
                                    <td style="padding:4px; border:1px solid #ccc;"><span t-esc="line.purpose or ''"/></td>
                                    <td style="padding:4px; border:1px solid #ccc;"><span t-esc="dict(line._fields['transport'].selection).get(line.transport, '')"/></td>
                                    <td style="padding:4px; border:1px solid #ccc;"><span t-esc="line.customer_id.name or ''"/></td>
                                    <td style="padding:4px; border:1px solid #ccc; text-align:right;"><span t-esc="'{:,.2f}'.format(line.conveyance_amount)"/></td>
                                    <td style="padding:4px; border:1px solid #ccc; text-align:right;"><span t-esc="'{:,.2f}'.format(line.food_bill)"/></td>
                                    <td style="padding:4px; border:1px solid #ccc;"><span t-esc="line.others_cost or ''"/></td>
                                    <td style="padding:4px; border:1px solid #ccc; text-align:right;"><span t-esc="'{:,.2f}'.format(line.amount)"/></td>
                                    <td style="padding:4px; border:1px solid #ccc; text-align:right;"><span t-esc="'{:,.2f}'.format(line.total_amount)"/></td>
                                    <td style="padding:4px; border:1px solid #ccc;"><span t-esc="line.remarks or ''"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="background-color:#D9E1F2; font-weight:bold;">
                                <td colspan="12" style="padding:5px; border:1px solid #ccc; text-align:right;">Total Amount (BDT):</td>
                                <td style="padding:5px; border:1px solid #ccc; text-align:right;"><span t-esc="'{:,.2f}'.format(doc.total_amount)"/></td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Signature Section -->
                    <table style="width:100%; margin-top:60px; border-collapse:collapse;">
                        <tr>
                            <td style="width:20%; text-align:center; padding:10px;">
                                <div style="border-top:1px solid black; margin-top:40px; padding-top:8px;">
                                    <strong>Claimed By</strong>
                                </div>
                            </td>
                            <td style="width:20%; text-align:center; padding:10px;">
                                <div style="border-top:1px solid black; margin-top:40px; padding-top:8px;">
                                    <strong>Checked By Dept. Head</strong>
                                </div>
                            </td>
                            <td style="width:20%; text-align:center; padding:10px;">
                                <div style="border-top:1px solid black; margin-top:40px; padding-top:8px;">
                                    <strong>App. By Management</strong>
                                </div>
                            </td>
                            <td style="width:20%; text-align:center; padding:10px;">
                                <div style="border-top:1px solid black; margin-top:40px; padding-top:8px;">
                                    <strong>Processed By Accounts</strong>
                                </div>
                            </td>
                            <td style="width:20%; text-align:center; padding:10px;">
                                <div style="border-top:1px solid black; margin-top:40px; padding-top:8px;">
                                    <strong>Authorized By CFO</strong>
                                </div>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </t>
</template>
</odoo>