<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_iot_gateway" model="ir.sequence">
        <field name="name">Garment IoT Gateway Code</field>
        <field name="code">garment.iot.gateway</field>
        <field name="prefix">IOTGW/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_iot_device" model="ir.sequence">
        <field name="name">Garment IoT Device Code</field>
        <field name="code">garment.iot.device</field>
        <field name="prefix">IOTDEV/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_iot_alert_log" model="ir.sequence">
        <field name="name">Garment IoT Alert Reference</field>
        <field name="code">garment.iot.alert.log</field>
        <field name="prefix">IOTAL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
