<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_iot_alert_log_form" model="ir.ui.view">
        <field name="name">garment.iot.alert.log.form</field>
        <field name="model">garment.iot.alert.log</field>
        <field name="arch" type="xml">
            <form string="IoT Fired Alert">
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_resolve" type="object" string="Resolve"
                            invisible="state == 'resolved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,acknowledged,resolved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Critical" bg_color="text-bg-danger" invisible="severity != 'critical'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Source">
                            <field name="rule_id"/>
                            <field name="reading_id"/>
                            <field name="device_id"/>
                            <field name="gateway_id" readonly="1"/>
                            <field name="machine_id" readonly="1"/>
                        </group>
                        <group string="Trigger">
                            <field name="severity" widget="badge"/>
                            <field name="value"/>
                            <field name="triggered_datetime"/>
                            <field name="action_taken" readonly="1"/>
                        </group>
                    </group>
                    <group string="Follow-up">
                        <field name="acknowledged_by_id" readonly="1"/>
                        <field name="acknowledged_date" readonly="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_iot_alert_log_tree" model="ir.ui.view">
        <field name="name">garment.iot.alert.log.tree</field>
        <field name="model">garment.iot.alert.log</field>
        <field name="arch" type="xml">
            <tree string="IoT Fired Alerts" decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'">
                <field name="name"/>
                <field name="triggered_datetime"/>
                <field name="device_id"/>
                <field name="machine_id"/>
                <field name="rule_id"/>
                <field name="severity" widget="badge"/>
                <field name="value"/>
                <field name="action_taken"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_iot_alert_log_search" model="ir.ui.view">
        <field name="name">garment.iot.alert.log.search</field>
        <field name="model">garment.iot.alert.log</field>
        <field name="arch" type="xml">
            <search string="Search IoT Fired Alerts">
                <field name="name"/>
                <field name="rule_id"/>
                <field name="device_id"/>
                <field name="machine_id"/>
                <filter string="New" name="filter_new" domain="[('state', '=', 'new')]"/>
                <filter string="Acknowledged" name="filter_acknowledged" domain="[('state', '=', 'acknowledged')]"/>
                <filter string="Resolved" name="filter_resolved" domain="[('state', '=', 'resolved')]"/>
                <filter string="Critical" name="filter_critical" domain="[('severity', '=', 'critical')]"/>
                <group expand="0" string="Group By">
                    <filter string="Rule" name="group_rule" context="{'group_by': 'rule_id'}"/>
                    <filter string="Device" name="group_device" context="{'group_by': 'device_id'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_iot_alert_log" model="ir.actions.act_window">
        <field name="name">Fired Alerts</field>
        <field name="res_model">garment.iot.alert.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No IoT alerts fired yet.</p>
        </field>
    </record>

</odoo>
