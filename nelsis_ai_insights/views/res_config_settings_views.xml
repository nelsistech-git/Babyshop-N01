<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_nelsis_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.nelsis.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="nelsis_field_tracking.res_config_settings_view_form_nelsis"/>
        <field name="arch" type="xml">
            <xpath expr="//block[last()]" position="after">
                <block title="AI Assistant (optional)" name="nelsis_ai_assistant_setting_container">
                    <setting string="API key" help="Enables natural-language explanations and the daily digest. The risk detection itself runs without it.">
                        <field name="nelsis_ai_api_key" password="True"/>
                    </setting>
                    <setting string="Model">
                        <field name="nelsis_ai_model"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>