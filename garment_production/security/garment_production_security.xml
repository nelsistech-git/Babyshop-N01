<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_production" model="ir.module.category">
            <field name="name">Smart Garment ERP - Production &amp; MES</field>
            <field name="sequence">15</field>
        </record>

        <record id="group_production_operator" model="res.groups">
            <field name="name">Operator (Production Entry Only)</field>
            <field name="category_id" ref="module_category_garment_production"/>
        </record>

        <record id="group_production_supervisor" model="res.groups">
            <field name="name">Line Supervisor / Floor Supervisor (Line &amp; Shop Floor Control)</field>
            <field name="category_id" ref="module_category_garment_production"/>
            <field name="implied_ids" eval="[(4, ref('group_production_operator'))]"/>
        </record>

        <record id="group_production_planner" model="res.groups">
            <field name="name">Planning / IE Manager (Planning, Capacity, Line Balancing)</field>
            <field name="category_id" ref="module_category_garment_production"/>
        </record>

        <record id="group_production_manager" model="res.groups">
            <field name="name">Production Manager (Full Execution Access)</field>
            <field name="category_id" ref="module_category_garment_production"/>
            <field name="implied_ids" eval="[(4, ref('group_production_supervisor')),
                                              (4, ref('group_production_planner'))]"/>
        </record>

        <record id="group_production_director" model="res.groups">
            <field name="name">Production Director / Factory Head (Full Access + Configuration)</field>
            <field name="category_id" ref="module_category_garment_production"/>
            <field name="implied_ids" eval="[(4, ref('group_production_manager'))]"/>
        </record>

        <!-- Operators may only see/enter their own production entries -->
        <record id="rule_garment_production_entry_operator_own" model="ir.rule">
            <field name="name">Operator: Own Production Entries Only</field>
            <field name="model_id" ref="model_garment_production_entry"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_production_operator'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_production_entry_supervisor_up" model="ir.rule">
            <field name="name">Supervisor and Up: All Production Entries</field>
            <field name="model_id" ref="model_garment_production_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_production_supervisor')),
                                        (4, ref('group_production_manager')),
                                        (4, ref('group_production_director'))]"/>
        </record>

    </data>
</odoo>
