<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_line_balancing_tree" model="ir.ui.view">
        <field name="name">garment.line.balancing.tree</field>
        <field name="model">garment.line.balancing</field>
        <field name="arch" type="xml">
            <tree string="Line Balancing">
                <field name="line_id"/>
                <field name="date"/>
                <field name="production_order_id"/>
                <field name="bottleneck_operation"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_line_balancing_form" model="ir.ui.view">
        <field name="name">garment.line.balancing.form</field>
        <field name="model">garment.line.balancing</field>
        <field name="arch" type="xml">
            <form string="Line Balancing">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,analyzed,actioned"/>
                    <button name="action_analyze" type="object" string="Analyze" class="btn-primary"
                            invisible="status != 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="line_id"/>
                            <field name="production_order_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="bottleneck_operation" readonly="1"/>
                            <field name="bottleneck_reason"/>
                            <field name="expected_gain_pct"/>
                        </group>
                    </group>
                    <field name="suggestion"/>
                    <notebook>
                        <page string="Operation Load">
                            <field name="operation_line_ids">
                                <tree editable="bottom" decoration-danger="is_bottleneck == True">
                                    <field name="sequence" widget="handle"/>
                                    <field name="operation_name"/>
                                    <field name="operator_count"/>
                                    <field name="smv"/>
                                    <field name="target_output"/>
                                    <field name="output_qty"/>
                                    <field name="is_bottleneck"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_line_balancing" model="ir.actions.act_window">
        <field name="name">Line Balancing</field>
        <field name="res_model">garment.line.balancing</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
