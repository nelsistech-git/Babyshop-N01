<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_finishing_order_tree" model="ir.ui.view">
        <field name="name">garment.finishing.order.tree</field>
        <field name="model">garment.finishing.order</field>
        <field name="arch" type="xml">
            <tree string="Finishing Orders">
                <field name="name"/>
                <field name="production_order_id"/>
                <field name="style_id"/>
                <field name="quantity"/>
                <field name="completed_qty"/>
                <field name="completion_pct" widget="progressbar"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_finishing_order_form" model="ir.ui.view">
        <field name="name">garment.finishing.order.form</field>
        <field name="model">garment.finishing.order</field>
        <field name="arch" type="xml">
            <form string="Finishing Order">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,running,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_order_id"/>
                            <field name="style_id"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="completed_qty"/>
                            <field name="completion_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Operations">
                            <field name="operation_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="operation"/>
                                    <field name="operator_id"/>
                                    <field name="quantity"/>
                                    <field name="defect_qty"/>
                                    <field name="machine_id"/>
                                    <field name="temperature"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Measurement Checks">
                            <field name="measurement_check_ids">
                                <tree editable="bottom">
                                    <field name="measurement_point"/>
                                    <field name="required_value"/>
                                    <field name="actual_value"/>
                                    <field name="tolerance"/>
                                    <field name="result"/>
                                    <field name="checked_by_id"/>
                                    <field name="check_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_finishing_order" model="ir.actions.act_window">
        <field name="name">Finishing Orders</field>
        <field name="res_model">garment.finishing.order</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
