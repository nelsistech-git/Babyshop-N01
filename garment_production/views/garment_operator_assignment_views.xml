<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_operator_assignment_tree" model="ir.ui.view">
        <field name="name">garment.operator.assignment.tree</field>
        <field name="model">garment.operator.assignment</field>
        <field name="arch" type="xml">
            <tree string="Operator Assignments">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="line_id"/>
                <field name="operation_name"/>
                <field name="machine_id"/>
                <field name="skill_level"/>
                <field name="target_qty"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_operator_assignment_form" model="ir.ui.view">
        <field name="name">garment.operator.assignment.form</field>
        <field name="model">garment.operator.assignment</field>
        <field name="arch" type="xml">
            <form string="Operator Assignment">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="line_id"/>
                            <field name="production_order_id"/>
                            <field name="routing_line_id"/>
                            <field name="operation_name"/>
                        </group>
                        <group>
                            <field name="machine_id"/>
                            <field name="workstation"/>
                            <field name="date"/>
                            <field name="shift"/>
                            <field name="skill_level"/>
                            <field name="target_qty"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_operator_assignment" model="ir.actions.act_window">
        <field name="name">Operator Assignment</field>
        <field name="res_model">garment.operator.assignment</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
