<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_production_target_tree" model="ir.ui.view">
        <field name="name">garment.production.target.tree</field>
        <field name="model">garment.production.target</field>
        <field name="arch" type="xml">
            <tree string="Production Targets">
                <field name="date"/>
                <field name="target_type"/>
                <field name="target_level"/>
                <field name="line_id"/>
                <field name="employee_id"/>
                <field name="target_qty"/>
                <field name="achieved_qty"/>
                <field name="achievement_pct" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_production_target_form" model="ir.ui.view">
        <field name="name">garment.production.target.form</field>
        <field name="model">garment.production.target</field>
        <field name="arch" type="xml">
            <form string="Production Target">
                <sheet>
                    <group>
                        <group>
                            <field name="target_type"/>
                            <field name="target_level"/>
                            <field name="line_id"/>
                            <field name="employee_id"/>
                            <field name="production_order_id"/>
                            <field name="style_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="hour"/>
                            <field name="target_qty"/>
                            <field name="achieved_qty"/>
                            <field name="achievement_pct"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_production_target" model="ir.actions.act_window">
        <field name="name">Production Targets</field>
        <field name="res_model">garment.production.target</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
