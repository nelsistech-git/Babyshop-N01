<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_cutting_marker_tree" model="ir.ui.view">
        <field name="name">garment.cutting.marker.tree</field>
        <field name="model">garment.cutting.marker</field>
        <field name="arch" type="xml">
            <tree string="Cutting Markers">
                <field name="name"/>
                <field name="style_id"/>
                <field name="size_ratio"/>
                <field name="marker_length"/>
                <field name="fabric_width"/>
                <field name="efficiency_pct"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_cutting_marker_form" model="ir.ui.view">
        <field name="name">garment.cutting.marker.form</field>
        <field name="model">garment.cutting.marker</field>
        <field name="arch" type="xml">
            <form string="Cutting Marker">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="style_id"/>
                            <field name="size_ratio"/>
                            <field name="marker_length"/>
                            <field name="fabric_width"/>
                            <field name="ply_count"/>
                            <field name="cad_file_id"/>
                        </group>
                        <group>
                            <field name="used_area"/>
                            <field name="total_fabric_area"/>
                            <field name="efficiency_pct"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_cutting_marker" model="ir.actions.act_window">
        <field name="name">Markers</field>
        <field name="res_model">garment.cutting.marker</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
