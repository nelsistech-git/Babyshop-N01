<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_line_allocation_tree" model="ir.ui.view">
        <field name="name">garment.line.allocation.tree</field>
        <field name="model">garment.line.allocation</field>
        <field name="arch" type="xml">
            <tree string="Line Allocations">
                <field name="line_id"/>
                <field name="style_id"/>
                <field name="production_order_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="planned_qty"/>
                <field name="delivery_priority"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_line_allocation_form" model="ir.ui.view">
        <field name="name">garment.line.allocation.form</field>
        <field name="model">garment.line.allocation</field>
        <field name="arch" type="xml">
            <form string="Line Allocation">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="production_order_id"/>
                            <field name="style_id"/>
                            <field name="line_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="planned_qty"/>
                            <field name="delivery_priority"/>
                        </group>
                    </group>
                    <group string="Assignment Factors">
                        <field name="style_complexity"/>
                        <field name="smv"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_line_allocation" model="ir.actions.act_window">
        <field name="name">Line Allocation</field>
        <field name="res_model">garment.line.allocation</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
