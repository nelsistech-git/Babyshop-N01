<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_capacity_plan_tree" model="ir.ui.view">
        <field name="name">garment.capacity.plan.tree</field>
        <field name="model">garment.capacity.plan</field>
        <field name="arch" type="xml">
            <tree string="Capacity Plans" editable="bottom">
                <field name="plan_id"/>
                <field name="line_id"/>
                <field name="date"/>
                <field name="operators"/>
                <field name="working_hours"/>
                <field name="efficiency_pct"/>
                <field name="smv"/>
                <field name="daily_capacity"/>
                <field name="allocated_qty"/>
                <field name="available_capacity"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_capacity_plan_form" model="ir.ui.view">
        <field name="name">garment.capacity.plan.form</field>
        <field name="model">garment.capacity.plan</field>
        <field name="arch" type="xml">
            <form string="Capacity Plan">
                <sheet>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="line_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="operators"/>
                            <field name="working_hours"/>
                            <field name="efficiency_pct"/>
                            <field name="smv"/>
                        </group>
                    </group>
                    <group string="Result">
                        <field name="daily_capacity"/>
                        <field name="allocated_qty"/>
                        <field name="available_capacity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_capacity_plan" model="ir.actions.act_window">
        <field name="name">Capacity Planning</field>
        <field name="res_model">garment.capacity.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
