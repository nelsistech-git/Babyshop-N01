<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_work_order_tree" model="ir.ui.view">
        <field name="name">garment.work.order.tree</field>
        <field name="model">garment.work.order</field>
        <field name="arch" type="xml">
            <tree string="Work Orders">
                <field name="name"/>
                <field name="production_order_id"/>
                <field name="operation_name"/>
                <field name="work_center_id"/>
                <field name="line_id"/>
                <field name="quantity"/>
                <field name="actual_qty"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_work_order_form" model="ir.ui.view">
        <field name="name">garment.work.order.form</field>
        <field name="model">garment.work.order</field>
        <field name="arch" type="xml">
            <form string="Work Order">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="planned,released,running,completed"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="status not in ('planned', 'released')"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary"
                            invisible="status != 'running'"/>
                    <button name="action_hold" type="object" string="Hold" invisible="status != 'running'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_order_id"/>
                            <field name="routing_line_id"/>
                            <field name="operation_name"/>
                            <field name="work_center_id"/>
                            <field name="line_id"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="actual_qty"/>
                            <field name="planned_duration"/>
                            <field name="actual_duration"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_work_order" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">garment.work.order</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
