<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_fabric_relaxation_tree" model="ir.ui.view">
        <field name="name">garment.fabric.relaxation.tree</field>
        <field name="model">garment.fabric.relaxation</field>
        <field name="arch" type="xml">
            <tree string="Fabric Relaxation">
                <field name="cutting_order_id"/>
                <field name="fabric_roll_id"/>
                <field name="fabric_material_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration_hours"/>
                <field name="responsible_person_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_fabric_relaxation_form" model="ir.ui.view">
        <field name="name">garment.fabric.relaxation.form</field>
        <field name="model">garment.fabric.relaxation</field>
        <field name="arch" type="xml">
            <form string="Fabric Relaxation">
                <sheet>
                    <group>
                        <group>
                            <field name="cutting_order_id"/>
                            <field name="fabric_roll_id"/>
                            <field name="fabric_material_id"/>
                            <field name="responsible_person_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration_hours"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_fabric_relaxation" model="ir.actions.act_window">
        <field name="name">Fabric Relaxation</field>
        <field name="res_model">garment.fabric.relaxation</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
