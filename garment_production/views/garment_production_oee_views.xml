<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_production_oee_tree" model="ir.ui.view">
        <field name="name">garment.production.oee.tree</field>
        <field name="model">garment.production.oee</field>
        <field name="arch" type="xml">
            <tree string="OEE" editable="bottom" decoration-danger="oee_pct &lt; 60" decoration-success="oee_pct &gt;= 85">
                <field name="date"/>
                <field name="line_id"/>
                <field name="machine_id"/>
                <field name="shift"/>
                <field name="availability_pct"/>
                <field name="performance_pct"/>
                <field name="quality_pct"/>
                <field name="oee_pct"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_production_oee_form" model="ir.ui.view">
        <field name="name">garment.production.oee.form</field>
        <field name="model">garment.production.oee</field>
        <field name="arch" type="xml">
            <form string="OEE Record">
                <sheet>
                    <group>
                        <group>
                            <field name="line_id"/>
                            <field name="machine_id"/>
                            <field name="date"/>
                            <field name="shift"/>
                        </group>
                        <group>
                            <field name="availability_pct"/>
                            <field name="performance_pct"/>
                            <field name="quality_pct"/>
                            <field name="oee_pct"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_production_oee" model="ir.actions.act_window">
        <field name="name">OEE</field>
        <field name="res_model">garment.production.oee</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
