<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_measurement_check_tree" model="ir.ui.view">
        <field name="name">garment.measurement.check.tree</field>
        <field name="model">garment.measurement.check</field>
        <field name="arch" type="xml">
            <tree string="Measurement Checks" decoration-danger="result == 'fail'">
                <field name="finishing_order_id"/>
                <field name="style_id"/>
                <field name="measurement_point"/>
                <field name="required_value"/>
                <field name="actual_value"/>
                <field name="tolerance"/>
                <field name="result"/>
                <field name="checked_by_id"/>
                <field name="check_date"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_measurement_check_form" model="ir.ui.view">
        <field name="name">garment.measurement.check.form</field>
        <field name="model">garment.measurement.check</field>
        <field name="arch" type="xml">
            <form string="Measurement Check">
                <sheet>
                    <group>
                        <field name="finishing_order_id"/>
                        <field name="measurement_point"/>
                        <field name="required_value"/>
                        <field name="actual_value"/>
                        <field name="tolerance"/>
                        <field name="result"/>
                        <field name="checked_by_id"/>
                        <field name="check_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_measurement_check" model="ir.actions.act_window">
        <field name="name">Measurement Checks</field>
        <field name="res_model">garment.measurement.check</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
