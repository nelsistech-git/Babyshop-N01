<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_production_rework_tree" model="ir.ui.view">
        <field name="name">garment.production.rework.tree</field>
        <field name="model">garment.production.rework</field>
        <field name="arch" type="xml">
            <tree string="Production Rework">
                <field name="name"/>
                <field name="production_order_id"/>
                <field name="department"/>
                <field name="quantity"/>
                <field name="reason"/>
                <field name="assigned_to_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_production_rework_form" model="ir.ui.view">
        <field name="name">garment.production.rework.form</field>
        <field name="model">garment.production.rework</field>
        <field name="arch" type="xml">
            <form string="Production Rework">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,in_repair,quality_check,released"/>
                    <button name="action_release" type="object" string="Release" class="btn-primary"
                            invisible="status == 'released'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_order_id"/>
                            <field name="bundle_id"/>
                            <field name="department"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="reason"/>
                            <field name="assigned_to_id"/>
                            <field name="rework_date"/>
                            <field name="completion_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_production_rework" model="ir.actions.act_window">
        <field name="name">Production Rework</field>
        <field name="res_model">garment.production.rework</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
