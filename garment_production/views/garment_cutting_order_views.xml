<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_cutting_order_tree" model="ir.ui.view">
        <field name="name">garment.cutting.order.tree</field>
        <field name="model">garment.cutting.order</field>
        <field name="arch" type="xml">
            <tree string="Cutting Orders">
                <field name="name"/>
                <field name="production_order_id"/>
                <field name="style_id"/>
                <field name="color"/>
                <field name="quantity"/>
                <field name="cut_qty"/>
                <field name="cutting_date"/>
                <field name="cutter_team"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_cutting_order_form" model="ir.ui.view">
        <field name="name">garment.cutting.order.form</field>
        <field name="model">garment.cutting.order</field>
        <field name="arch" type="xml">
            <form string="Cutting Order">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,fabric_reserved,fabric_issued,relaxation,marker_ready,spreading,cutting,numbering,bundling,qc,completed"/>
                    <button name="action_send_to_sewing" type="object" string="Send to Sewing" class="btn-primary"
                            invisible="status == 'completed'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bundles" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="bundle_count" widget="statinfo" string="Bundles"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_order_id"/>
                            <field name="style_id"/>
                            <field name="fabric_material_id"/>
                            <field name="color"/>
                            <field name="quantity"/>
                            <field name="marker_id"/>
                        </group>
                        <group>
                            <field name="cutting_date"/>
                            <field name="cutter_team"/>
                            <field name="line_id"/>
                            <field name="required_fabric_qty"/>
                            <field name="issued_fabric_qty"/>
                            <field name="fabric_ready"/>
                            <field name="cut_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fabric Relaxation">
                            <field name="relaxation_ids">
                                <tree editable="bottom">
                                    <field name="fabric_roll_id"/>
                                    <field name="fabric_material_id"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="duration_hours"/>
                                    <field name="responsible_person_id"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Bundles">
                            <field name="bundle_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="size"/>
                                    <field name="color"/>
                                    <field name="quantity"/>
                                    <field name="barcode"/>
                                    <field name="destination_line_id"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Cutting QC">
                            <field name="qc_ids">
                                <tree editable="bottom">
                                    <field name="bundle_id"/>
                                    <field name="inspector_id"/>
                                    <field name="inspection_date"/>
                                    <field name="panel_measurement_ok"/>
                                    <field name="notch_accuracy_ok"/>
                                    <field name="shade_matching_ok"/>
                                    <field name="quantity_accuracy_ok"/>
                                    <field name="defect_qty"/>
                                    <field name="result"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_cutting_order_search" model="ir.ui.view">
        <field name="name">garment.cutting.order.search</field>
        <field name="model">garment.cutting.order</field>
        <field name="arch" type="xml">
            <search string="Search Cutting Orders">
                <field name="name"/>
                <field name="style_id"/>
                <field name="production_order_id"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Style" name="group_style" context="{'group_by': 'style_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_cutting_order" model="ir.actions.act_window">
        <field name="name">Cutting Orders</field>
        <field name="res_model">garment.cutting.order</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_garment_cutting_order_search"/>
    </record>

</odoo>
