<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_ecomm" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.ecomm</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook[last()]" position="inside">
                    <page string="E-Commerce Info" name="ecommerce_info">
                        <group>
                            <group>
                                <field name="is_ecom_sale" readonly="1"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

    </data>
</odoo>