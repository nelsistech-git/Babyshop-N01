<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_buyer_order_form_invoice_inherit" model="ir.ui.view">
        <field name="name">fw.buyer.order.form.invoice.inherit</field>
        <field name="model">fw.buyer.order</field>
        <field name="inherit_id" ref="fw_merchandising.view_fw_buyer_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_invoices" type="object"
                        class="oe_stat_button" icon="fa-usd"
                        invisible="invoice_count == 0">
                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="before">
                <button name="action_create_invoice" type="object" string="Create Invoice"
                        class="btn-primary" invisible="state not in ('confirmed','in_production','shipped')"/>
            </xpath>
        </field>
    </record>
</odoo>
