<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fw_rfq" model="ir.sequence">
        <field name="name">FW RFQ</field>
        <field name="code">fw.rfq</field>
        <field name="prefix">RFQ/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_purchase_order" model="ir.sequence">
        <field name="name">FW Purchase Order</field>
        <field name="code">fw.purchase.order</field>
        <field name="prefix">PO/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
