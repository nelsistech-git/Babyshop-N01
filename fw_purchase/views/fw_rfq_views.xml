<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_rfq_tree" model="ir.ui.view">
        <field name="name">fw.rfq.tree</field>
        <field name="model">fw.rfq</field>
        <field name="arch" type="xml">
            <tree string="RFQs" decoration-success="state=='closed'">
                <field name="name"/>
                <field name="rfq_date"/>
                <field name="due_date"/>
                <field name="quote_count"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_rfq_form" model="ir.ui.view">
        <field name="name">fw.rfq.form</field>
        <field name="model">fw.rfq</field>
        <field name="arch" type="xml">
            <form string="RFQ">
                <header>
                    <button name="action_send" type="object" string="Send to Vendors"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_quoted" type="object" string="Mark Quotes Received"
                            invisible="state != 'sent'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state == 'closed'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,quoted,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rfq_date"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="selected_quote_id" readonly="1"
                                   invisible="not selected_quote_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials Required">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="material_description"/>
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Vendor Quotes">
                            <field name="vendor_quote_ids">
                                <tree editable="bottom" decoration-success="is_selected==True">
                                    <field name="vendor_id"/>
                                    <field name="quote_date"/>
                                    <field name="total_amount" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="is_selected"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fw_rfq" model="ir.actions.act_window">
        <field name="name">RFQs</field>
        <field name="res_model">fw.rfq</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first RFQ</p>
        </field>
    </record>

    <!-- Standalone Vendor Quote form, opened for detailed line entry and PO creation -->
    <record id="view_fw_rfq_vendor_quote_form" model="ir.ui.view">
        <field name="name">fw.rfq.vendor.quote.form</field>
        <field name="model">fw.rfq.vendor.quote</field>
        <field name="arch" type="xml">
            <form string="Vendor Quote">
                <header>
                    <button name="action_select_as_winner" type="object" string="Select as Winner"
                            class="btn-primary" invisible="is_selected"/>
                    <button name="action_create_purchase_order" type="object"
                            string="Create Purchase Order" class="btn-primary"
                            invisible="not is_selected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="rfq_id"/>
                            <field name="vendor_id"/>
                            <field name="quote_date"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="is_selected" readonly="1"/>
                        </group>
                    </group>
                    <field name="quote_line_ids">
                        <tree editable="bottom">
                            <field name="rfq_line_id" domain="[('rfq_id', '=', parent.rfq_id)]"/>
                            <field name="material_description" readonly="1"/>
                            <field name="qty" readonly="1"/>
                            <field name="unit_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" widget="monetary" readonly="1"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fw_rfq_vendor_quote_tree" model="ir.ui.view">
        <field name="name">fw.rfq.vendor.quote.tree</field>
        <field name="model">fw.rfq.vendor.quote</field>
        <field name="arch" type="xml">
            <tree string="Vendor Quotes" decoration-success="is_selected==True">
                <field name="rfq_id"/>
                <field name="vendor_id"/>
                <field name="quote_date"/>
                <field name="total_amount" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="is_selected"/>
            </tree>
        </field>
    </record>

    <record id="action_fw_rfq_vendor_quote" model="ir.actions.act_window">
        <field name="name">Vendor Quotes</field>
        <field name="res_model">fw.rfq.vendor.quote</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Vendor quotes are added from within an RFQ</p>
        </field>
    </record>
</odoo>
