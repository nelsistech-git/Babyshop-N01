<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_ai_prompt_template_form" model="ir.ui.view">
        <field name="name">garment.ai.prompt.template.form</field>
        <field name="model">garment.ai.prompt.template</field>
        <field name="arch" type="xml">
            <form string="AI Prompt Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="is_active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_usage_log" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <field name="usage_count" widget="statinfo" string="Times Used"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="use_case"/>
                            <field name="provider_config_id"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group string="Prompt">
                        <field name="prompt_text" nolabel="1"/>
                        <field name="variable_hint"/>
                    </group>
                    <group string="Governance Notes">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_ai_prompt_template_tree" model="ir.ui.view">
        <field name="name">garment.ai.prompt.template.tree</field>
        <field name="model">garment.ai.prompt.template</field>
        <field name="arch" type="xml">
            <tree string="AI Prompt Templates" decoration-muted="not is_active">
                <field name="name"/>
                <field name="use_case"/>
                <field name="version"/>
                <field name="provider_config_id"/>
                <field name="usage_count"/>
                <field name="is_active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_ai_prompt_template_search" model="ir.ui.view">
        <field name="name">garment.ai.prompt.template.search</field>
        <field name="model">garment.ai.prompt.template</field>
        <field name="arch" type="xml">
            <search string="Search AI Prompt Templates">
                <field name="name"/>
                <field name="use_case"/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Use Case" name="group_use_case" context="{'group_by': 'use_case'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_ai_prompt_template" model="ir.actions.act_window">
        <field name="name">AI Prompt Templates</field>
        <field name="res_model">garment.ai.prompt.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No prompt templates yet.</p>
            <p>Reusable prompts keep every external AI call in the suite governed centrally instead of
                hard-coded inline.</p>
        </field>
    </record>

</odoo>
