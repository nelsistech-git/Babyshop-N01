<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_ai_provider_config_form" model="ir.ui.view">
        <field name="name">garment.ai.provider.config.form</field>
        <field name="model">garment.ai.provider.config</field>
        <field name="arch" type="xml">
            <form string="AI Provider Configuration">
                <sheet>
                    <widget name="web_ribbon" title="Disabled" bg_color="text-bg-danger" invisible="is_enabled"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_usage_log" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <field name="usage_count" widget="statinfo" string="API Calls"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. OpenAI - Production"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider"/>
                            <field name="model_name"/>
                            <field name="api_endpoint" placeholder="Required for Azure OpenAI / Custom"/>
                            <field name="api_key" password="True" groups="garment_ai_intelligence.group_ai_admin"/>
                        </group>
                        <group>
                            <field name="is_enabled"/>
                            <field name="is_default"/>
                            <field name="sequence"/>
                            <field name="total_estimated_cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Feature Routing" name="routing">
                            <field name="route_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="feature"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_ai_provider_config_tree" model="ir.ui.view">
        <field name="name">garment.ai.provider.config.tree</field>
        <field name="model">garment.ai.provider.config</field>
        <field name="arch" type="xml">
            <tree string="AI Provider Configurations" decoration-muted="not is_enabled">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="is_default"/>
                <field name="is_enabled" widget="boolean_toggle"/>
                <field name="route_count"/>
                <field name="usage_count"/>
                <field name="total_estimated_cost"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_ai_provider_config_search" model="ir.ui.view">
        <field name="name">garment.ai.provider.config.search</field>
        <field name="model">garment.ai.provider.config</field>
        <field name="arch" type="xml">
            <search string="Search AI Provider Configurations">
                <field name="name"/>
                <field name="provider"/>
                <filter string="Enabled" name="filter_enabled" domain="[('is_enabled', '=', True)]"/>
                <filter string="Default" name="filter_default" domain="[('is_default', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Provider" name="group_provider" context="{'group_by': 'provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_ai_provider_config" model="ir.actions.act_window">
        <field name="name">AI Provider Configurations</field>
        <field name="res_model">garment.ai.provider.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_enabled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure an external AI provider (OpenAI / Anthropic /
                Azure OpenAI / Custom), or leave none configured — every AI feature in this suite falls back to a
                deterministic heuristic and keeps working without one.</p>
        </field>
    </record>

    <!-- garment.ai.provider.feature.line has no standalone menu/action: it is
         managed entirely inline via the "Feature Routing" tab on the
         AI Provider Configuration form above (one2many editable tree). -->

</odoo>
