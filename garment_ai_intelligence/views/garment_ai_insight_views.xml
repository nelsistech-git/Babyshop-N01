<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_ai_insight_form" model="ir.ui.view">
        <field name="name">garment.ai.insight.form</field>
        <field name="model">garment.ai.insight</field>
        <field name="arch" type="xml">
            <form string="AI Insight">
                <header>
                    <button name="action_mark_reviewed" string="Mark Reviewed" type="object" class="oe_highlight"
                            invisible="status != 'new'"/>
                    <button name="action_mark_actioned" string="Mark Actioned" type="object" class="oe_highlight"
                            invisible="status not in ('new', 'reviewed')"/>
                    <button name="action_dismiss" string="Dismiss" type="object"
                            invisible="status in ('actioned', 'dismissed')"/>
                    <button name="action_reset_new" string="Reset to New" type="object"
                            invisible="status == 'new'"/>
                    <field name="status" widget="statusbar" statusbar_visible="new,reviewed,actioned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_source" type="object" class="oe_stat_button" icon="fa-external-link"
                                invisible="not res_model">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View Source</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="insight_type"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="res_name"/>
                        </group>
                        <group>
                            <field name="confidence" widget="percentage"/>
                            <field name="source"/>
                            <field name="provider_config_id" invisible="source != 'ai_provider'"/>
                            <field name="usage_log_id" invisible="source != 'ai_provider'"/>
                            <field name="insight_date"/>
                        </group>
                    </group>
                    <group string="Explanation">
                        <field name="explanation" nolabel="1"/>
                    </group>
                    <group string="Recommendation">
                        <field name="recommendation" nolabel="1"/>
                    </group>
                    <group string="Review" invisible="status == 'new'">
                        <field name="reviewed_by_id"/>
                        <field name="reviewed_date"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_ai_insight_tree" model="ir.ui.view">
        <field name="name">garment.ai.insight.tree</field>
        <field name="model">garment.ai.insight</field>
        <field name="arch" type="xml">
            <tree string="AI Insights" decoration-info="status == 'new'" decoration-muted="status == 'dismissed'">
                <field name="name"/>
                <field name="insight_type"/>
                <field name="res_model"/>
                <field name="res_name"/>
                <field name="confidence" widget="percentage"/>
                <field name="source"/>
                <field name="insight_date"/>
                <field name="status" widget="badge" decoration-success="status == 'actioned'"
                       decoration-info="status == 'new'"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_ai_insight_search" model="ir.ui.view">
        <field name="name">garment.ai.insight.search</field>
        <field name="model">garment.ai.insight</field>
        <field name="arch" type="xml">
            <search string="Search AI Insights">
                <field name="name"/>
                <field name="res_model"/>
                <field name="res_name"/>
                <filter string="New" name="filter_new" domain="[('status', '=', 'new')]"/>
                <filter string="High Confidence (&gt;= 70%)" name="filter_high_confidence"
                        domain="[('confidence', '>=', 70)]"/>
                <separator/>
                <filter string="Demand Forecast" name="filter_demand_forecast"
                        domain="[('insight_type', '=', 'demand_forecast')]"/>
                <filter string="Risk Alert" name="filter_risk_alert" domain="[('insight_type', '=', 'risk_alert')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'insight_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Source Model" name="group_res_model" context="{'group_by': 'res_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_ai_insight" model="ir.actions.act_window">
        <field name="name">AI Insights</field>
        <field name="res_model">garment.ai.insight</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI insights logged yet.</p>
            <p>Every module's AI prediction, risk alert, anomaly, recommendation or similarity match can log
                here — one unified place to review AI output across the whole suite.</p>
        </field>
    </record>

</odoo>
