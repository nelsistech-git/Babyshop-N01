<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_demand_forecast_form" model="ir.ui.view">
        <field name="name">garment.demand.forecast.form</field>
        <field name="model">garment.demand.forecast</field>
        <field name="arch" type="xml">
            <form string="AI Demand Forecast">
                <header>
                    <button name="action_generate_demand_forecast" string="Generate Forecast" type="object"
                            class="oe_highlight" invisible="status == 'applied'"/>
                    <button name="action_mark_reviewed" string="Mark Reviewed" type="object"
                            invisible="status != 'generated'"/>
                    <button name="action_apply_to_planning" string="Apply To Planning" type="object"
                            class="oe_highlight" invisible="status not in ('generated', 'reviewed')"/>
                    <button name="action_reset_to_draft" string="Reset To Draft" type="object"
                            invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,generated,reviewed,applied"/>
                </header>
                <sheet>
                    <!-- FIXED: Added ai_insight_id with invisible="1" so the 'invisible' modifier can evaluate it -->
                    <field name="ai_insight_id" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_basis_orders" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not basis_order_count">
                            <field name="basis_order_count" widget="statinfo" string="Historical Orders"/>
                        </button>
                        <button name="action_view_insight" type="object" class="oe_stat_button" icon="fa-lightbulb-o"
                                invisible="not ai_insight_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">AI Insight</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="style_id"/>
                            <field name="buyer_id"/>
                            <field name="forecast_date"/>
                        </group>
                        <group>
                            <field name="period_type"/>
                            <field name="historical_basis"/>
                            <field name="method"/>
                            <field name="forecast_horizon"/>
                        </group>
                    </group>
                    <group string="Result" invisible="status == 'draft'">
                        <group>
                            <field name="forecast_qty"/>
                            <field name="confidence_score" widget="percentage"/>
                        </group>
                        <group>
                            <field name="basis_period_count"/>
                            <field name="basis_order_line_count"/>
                            <field name="basis_qty_total"/>
                            <field name="last_generated"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Period Breakdown" name="periods" invisible="status == 'draft'">
                            <field name="line_ids" readonly="1">
                                <tree decoration-muted="data_type == 'historical'" decoration-info="data_type == 'forecast'">
                                    <field name="period_label"/>
                                    <field name="period_date"/>
                                    <field name="data_type"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Explanation" name="explanation" invisible="status == 'draft'">
                            <field name="explanation" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_demand_forecast_tree" model="ir.ui.view">
        <field name="name">garment.demand.forecast.tree</field>
        <field name="model">garment.demand.forecast</field>
        <field name="arch" type="xml">
            <tree string="AI Demand Forecasts" decoration-muted="status == 'draft'">
                <field name="name"/>
                <field name="style_id"/>
                <field name="buyer_id"/>
                <field name="method"/>
                <field name="forecast_qty"/>
                <field name="confidence_score" widget="percentage"/>
                <field name="forecast_date"/>
                <field name="status" widget="badge" decoration-success="status == 'applied'"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_demand_forecast_search" model="ir.ui.view">
        <field name="name">garment.demand.forecast.search</field>
        <field name="model">garment.demand.forecast</field>
        <field name="arch" type="xml">
            <search string="Search AI Demand Forecasts">
                <field name="style_id"/>
                <field name="buyer_id"/>
                <field name="name"/>
                <filter string="Draft" name="filter_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Generated" name="filter_generated" domain="[('status', '=', 'generated')]"/>
                <filter string="Applied" name="filter_applied" domain="[('status', '=', 'applied')]"/>
                <group expand="0" string="Group By">
                    <filter string="Style" name="group_style" context="{'group_by': 'style_id'}"/>
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Method" name="group_method" context="{'group_by': 'method'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_garment_demand_forecast_graph" model="ir.ui.view">
        <field name="name">garment.demand.forecast.graph</field>
        <field name="model">garment.demand.forecast</field>
        <field name="arch" type="xml">
            <graph string="Demand Forecast" type="bar">
                <field name="style_id"/>
                <field name="forecast_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_garment_demand_forecast" model="ir.actions.act_window">
        <field name="name">AI Demand Forecasts</field>
        <field name="res_model">garment.demand.forecast</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="context">{'search_default_filter_generated': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new demand forecast.</p>
            <p>Pick a Style (optionally a Buyer), then use "Generate Forecast" — a real moving-average /
                weighted-trend calculation over the style's historical Order Lines, not a hardcoded number.</p>
        </field>
    </record>

</odoo>