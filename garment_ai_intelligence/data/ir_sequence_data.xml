<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_ai_insight" model="ir.sequence">
        <field name="name">Garment AI Insight Reference</field>
        <field name="code">garment.ai.insight</field>
        <field name="prefix">AII/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_ai_usage_log" model="ir.sequence">
        <field name="name">Garment AI Usage Log Reference</field>
        <field name="code">garment.ai.usage.log</field>
        <field name="prefix">AIU/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_demand_forecast" model="ir.sequence">
        <field name="name">Garment Demand Forecast Reference</field>
        <field name="code">garment.demand.forecast</field>
        <field name="prefix">DMF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
