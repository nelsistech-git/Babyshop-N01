<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_hr" model="ir.module.category">
            <field name="name">Smart Garment ERP - HR</field>
            <field name="sequence">66</field>
        </record>

        <record id="group_hr_self_service" model="res.groups">
            <field name="name">Employee Self-Service (Own Records Only)</field>
            <field name="category_id" ref="module_category_garment_hr"/>
        </record>

        <record id="group_hr_officer" model="res.groups">
            <field name="name">HR Officer (Recruitment, Employee Data)</field>
            <field name="category_id" ref="module_category_garment_hr"/>
        </record>

        <record id="group_hr_payroll_officer" model="res.groups">
            <field name="name">Payroll Officer (Payroll Processing)</field>
            <field name="category_id" ref="module_category_garment_hr"/>
        </record>

        <record id="group_hr_manager" model="res.groups">
            <field name="name">HR Manager (Full Access, Approvals)</field>
            <field name="category_id" ref="module_category_garment_hr"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_officer')), (4, ref('group_hr_payroll_officer'))]"/>
        </record>

        <record id="group_hr_director" model="res.groups">
            <field name="name">HR Director / MD (Full Access)</field>
            <field name="category_id" ref="module_category_garment_hr"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_manager'))]"/>
        </record>

        <!-- ESS: employees can only see their own linked record -->
        <record id="rule_garment_hr_employee_ess" model="ir.rule">
            <field name="name">ESS: Own Employee Record Only</field>
            <field name="model_id" ref="model_garment_hr_employee"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_self_service'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_hr_attendance_ess" model="ir.rule">
            <field name="name">ESS: Own Attendance Only</field>
            <field name="model_id" ref="model_garment_hr_attendance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_self_service'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_hr_leave_ess" model="ir.rule">
            <field name="name">ESS: Own Leave Only</field>
            <field name="model_id" ref="model_garment_hr_leave"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_self_service'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_hr_payroll_ess" model="ir.rule">
            <field name="name">ESS: Own Payslips Only</field>
            <field name="model_id" ref="model_garment_hr_payroll"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_self_service'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_hr_employee_manager_full" model="ir.rule">
            <field name="name">HR Officer+: All Employees</field>
            <field name="model_id" ref="model_garment_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_officer'))]"/>
        </record>

        <record id="rule_garment_hr_bonus_ess" model="ir.rule">
            <field name="name">ESS: Own Bonuses Only</field>
            <field name="model_id" ref="model_garment_hr_bonus"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_self_service'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_hr_incentive_ess" model="ir.rule">
            <field name="name">ESS: Own Incentives Only</field>
            <field name="model_id" ref="model_garment_hr_incentive"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_self_service'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_hr_loan_ess" model="ir.rule">
            <field name="name">ESS: Own Loans Only</field>
            <field name="model_id" ref="model_garment_hr_loan"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_self_service'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_hr_complaint_ess" model="ir.rule">
            <field name="name">ESS: Own Complaints Only</field>
            <field name="model_id" ref="model_garment_hr_complaint"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_self_service'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
