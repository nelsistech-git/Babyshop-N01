<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_hr_employee" model="ir.sequence">
        <field name="name">Garment Employee ID</field>
        <field name="code">garment.hr.employee</field>
        <field name="prefix">EMP/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_hr_recruitment" model="ir.sequence">
        <field name="name">Garment Recruitment Requisition Number</field>
        <field name="code">garment.hr.recruitment</field>
        <field name="prefix">REQ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_hr_payroll" model="ir.sequence">
        <field name="name">Garment Payslip Number</field>
        <field name="code">garment.hr.payroll</field>
        <field name="prefix">PAY/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_hr_loan" model="ir.sequence">
        <field name="name">Garment Employee Loan Number</field>
        <field name="code">garment.hr.loan</field>
        <field name="prefix">LOAN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_hr_exit" model="ir.sequence">
        <field name="name">Garment Employee Exit Number</field>
        <field name="code">garment.hr.exit</field>
        <field name="prefix">EXIT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
