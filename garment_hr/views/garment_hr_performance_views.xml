<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_hr_performance_tree" model="ir.ui.view">
        <field name="name">garment.hr.performance.tree</field>
        <field name="model">garment.hr.performance</field>
        <field name="arch" type="xml">
            <tree string="Performance Reviews" decoration-danger="rating in ('below_average','poor')" decoration-success="rating in ('outstanding','good')">
                <field name="employee_id"/>
                <field name="review_date"/>
                <field name="overall_score"/>
                <field name="rating"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_hr_performance_form" model="ir.ui.view">
        <field name="name">garment.hr.performance.form</field>
        <field name="model">garment.hr.performance</field>
        <field name="arch" type="xml">
            <form string="Performance Review">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="review_period_start"/>
                            <field name="review_period_end"/>
                            <field name="review_date"/>
                            <field name="reviewer_id"/>
                        </group>
                        <group>
                            <field name="productivity_score"/>
                            <field name="quality_score"/>
                            <field name="attendance_score"/>
                            <field name="discipline_score"/>
                            <field name="skill_score"/>
                            <field name="teamwork_score"/>
                            <field name="overall_score" readonly="1"/>
                            <field name="rating" readonly="1"/>
                        </group>
                    </group>
                    <field name="comments"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_hr_performance" model="ir.actions.act_window">
        <field name="name">Performance Reviews</field>
        <field name="res_model">garment.hr.performance</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first performance review.</p>
        </field>
    </record>
</odoo>
