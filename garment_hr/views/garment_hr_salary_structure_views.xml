<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_hr_salary_structure_tree" model="ir.ui.view">
        <field name="name">garment.hr.salary.structure.tree</field>
        <field name="model">garment.hr.salary.structure</field>
        <field name="arch" type="xml">
            <tree string="Salary Structures (Wage-Board Grades)">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="grade_code"/>
                <field name="employee_category"/>
                <field name="is_wage_board_grade"/>
                <field name="basic_salary"/>
                <field name="house_rent"/>
                <field name="medical_allowance"/>
                <field name="food_allowance"/>
                <field name="transport_allowance"/>
                <field name="gross_salary"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_hr_salary_structure_form" model="ir.ui.view">
        <field name="name">garment.hr.salary.structure.form</field>
        <field name="model">garment.hr.salary.structure</field>
        <field name="arch" type="xml">
            <form string="Salary Structure">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="grade_code"/>
                            <field name="employee_category"/>
                            <field name="is_wage_board_grade"/>
                            <field name="effective_date"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="basic_salary"/>
                            <field name="house_rent"/>
                            <field name="medical_allowance"/>
                            <field name="food_allowance"/>
                            <field name="transport_allowance"/>
                            <field name="gross_salary" readonly="1" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_hr_salary_structure" model="ir.actions.act_window">
        <field name="name">Salary Structures</field>
        <field name="res_model">garment.hr.salary.structure</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first wage-board grade / salary structure.</p>
        </field>
    </record>

</odoo>
