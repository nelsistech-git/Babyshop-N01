<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_hr_leave_tree" model="ir.ui.view">
        <field name="name">garment.hr.leave.tree</field>
        <field name="model">garment.hr.leave</field>
        <field name="arch" type="xml">
            <tree string="Leaves" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'">
                <field name="employee_id"/>
                <field name="leave_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_hr_leave_form" model="ir.ui.view">
        <field name="name">garment.hr.leave.form</field>
        <field name="model">garment.hr.leave</field>
        <field name="arch" type="xml">
            <form string="Leave">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="status not in ('submitted', 'line_manager_review', 'hr_approval')"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="leave_type"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="days" readonly="1"/>
                        </group>
                        <group>
                            <field name="approver_id"/>
                        </group>
                    </group>
                    <field name="reason"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_hr_leave" model="ir.actions.act_window">
        <field name="name">Leaves</field>
        <field name="res_model">garment.hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Apply for your first leave.</p>
        </field>
    </record>
</odoo>
