<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_hr_candidate_tree" model="ir.ui.view">
        <field name="name">garment.hr.candidate.tree</field>
        <field name="model">garment.hr.candidate</field>
        <field name="arch" type="xml">
            <tree string="Candidates" decoration-success="status == 'joined'" decoration-muted="status == 'rejected'">
                <field name="name"/>
                <field name="recruitment_id"/>
                <field name="mobile"/>
                <field name="interview_score"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_hr_candidate_form" model="ir.ui.view">
        <field name="name">garment.hr.candidate.form</field>
        <field name="model">garment.hr.candidate</field>
        <field name="arch" type="xml">
            <form string="Candidate">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_convert_to_employee" type="object" string="Convert to Employee" class="btn-primary"
                            invisible="status != 'offered'"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="recruitment_id"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="application_date"/>
                            <field name="experience_years"/>
                            <field name="referred_by"/>
                            <field name="resume" filename="resume_filename"/>
                            <field name="resume_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="interview_date"/>
                            <field name="interviewer_id"/>
                            <field name="interview_score"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="offered_salary"/>
                            <field name="joining_date"/>
                            <field name="employee_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="interview_notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_hr_candidate" model="ir.actions.act_window">
        <field name="name">Candidates</field>
        <field name="res_model">garment.hr.candidate</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first candidate.</p>
        </field>
    </record>
</odoo>
