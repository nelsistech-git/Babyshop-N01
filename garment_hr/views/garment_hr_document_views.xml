<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_hr_document_tree" model="ir.ui.view">
        <field name="name">garment.hr.document.tree</field>
        <field name="model">garment.hr.document</field>
        <field name="arch" type="xml">
            <tree string="Employee Documents" decoration-danger="is_expiring_soon == True">
                <field name="employee_id"/>
                <field name="document_type"/>
                <field name="expiry_date"/>
                <field name="is_expiring_soon"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_hr_document" model="ir.actions.act_window">
        <field name="name">Employee Documents</field>
        <field name="res_model">garment.hr.document</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
