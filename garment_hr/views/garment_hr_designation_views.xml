<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_hr_designation_tree" model="ir.ui.view">
        <field name="name">garment.hr.designation.tree</field>
        <field name="model">garment.hr.designation</field>
        <field name="arch" type="xml">
            <tree string="Designations" editable="bottom">
                <field name="name"/>
                <field name="grade"/>
                <field name="employee_category"/>
                <field name="salary_structure_id"/>
                <field name="is_piece_rate_eligible"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_hr_designation_form" model="ir.ui.view">
        <field name="name">garment.hr.designation.form</field>
        <field name="model">garment.hr.designation</field>
        <field name="arch" type="xml">
            <form string="Designation">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="grade"/>
                            <field name="employee_category"/>
                            <field name="is_piece_rate_eligible"/>
                        </group>
                        <group>
                            <field name="salary_structure_id"/>
                        </group>
                    </group>
                    <group string="Responsibilities">
                        <field name="responsibilities" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_hr_designation" model="ir.actions.act_window">
        <field name="name">Designations</field>
        <field name="res_model">garment.hr.designation</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
