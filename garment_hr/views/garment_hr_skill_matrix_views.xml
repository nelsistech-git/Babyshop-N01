<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_hr_skill_matrix_tree" model="ir.ui.view">
        <field name="name">garment.hr.skill.matrix.tree</field>
        <field name="model">garment.hr.skill.matrix</field>
        <field name="arch" type="xml">
            <tree string="Skill Matrix" editable="bottom">
                <field name="employee_id"/>
                <field name="operation"/>
                <field name="proficiency_level"/>
                <field name="certified_date"/>
                <field name="last_assessed_date"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_hr_skill_matrix" model="ir.actions.act_window">
        <field name="name">Skill Matrix</field>
        <field name="res_model">garment.hr.skill.matrix</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first skill matrix entry.</p>
        </field>
    </record>
</odoo>
