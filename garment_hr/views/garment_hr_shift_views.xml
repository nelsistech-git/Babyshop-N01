<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_hr_shift_tree" model="ir.ui.view">
        <field name="name">garment.hr.shift.tree</field>
        <field name="model">garment.hr.shift</field>
        <field name="arch" type="xml">
            <tree string="Shifts" editable="bottom">
                <field name="name"/>
                <field name="shift_type"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="break_hours"/>
                <field name="grace_period_minutes"/>
                <field name="working_hours"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_hr_shift_form" model="ir.ui.view">
        <field name="name">garment.hr.shift.form</field>
        <field name="model">garment.hr.shift</field>
        <field name="arch" type="xml">
            <form string="Shift">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="shift_type"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                        <group>
                            <field name="break_hours"/>
                            <field name="grace_period_minutes"/>
                            <field name="working_hours" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_hr_shift" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">garment.hr.shift</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first factory shift.</p>
        </field>
    </record>

    <record id="view_garment_hr_shift_assignment_tree" model="ir.ui.view">
        <field name="name">garment.hr.shift.assignment.tree</field>
        <field name="model">garment.hr.shift.assignment</field>
        <field name="arch" type="xml">
            <tree string="Shift Assignments" editable="bottom">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="shift_id"/>
                <field name="effective_date"/>
                <field name="end_date"/>
                <field name="reason"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_hr_shift_assignment" model="ir.actions.act_window">
        <field name="name">Shift Assignments / Roster</field>
        <field name="res_model">garment.hr.shift.assignment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Assign a worker to a shift.</p>
        </field>
    </record>

</odoo>
