<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_hr_employee_form" model="ir.ui.view">
        <field name="name">garment.hr.employee.form</field>
        <field name="model">garment.hr.employee</field>
        <field name="arch" type="xml">
            <form string="Employee">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_run_ai_analysis" type="object" string="Run AI Retention Analysis" class="btn-secondary" icon="fa-magic"/>
                </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="user_id"/>
                            <field name="department_id"/>
                            <field name="designation_id"/>
                            <field name="employee_category" readonly="1"/>
                            <field name="reporting_manager_id"/>
                            <field name="work_location"/>
                        </group>
                        <group>
                            <field name="joining_date"/>
                            <field name="employment_type"/>
                            <field name="line_assignment"/>
                            <field name="shift_id"/>
                            <field name="skill_level"/>
                            <field name="is_piece_rate_eligible" readonly="1"/>
                            <field name="machine_operated"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personal Information">
                            <group>
                                <group>
                                    <field name="gender"/>
                                    <field name="date_of_birth"/>
                                    <field name="blood_group"/>
                                    <field name="father_name"/>
                                    <field name="mother_name"/>
                                    <field name="national_id"/>
                                    <field name="mobile"/>
                                </group>
                                <group>
                                    <field name="present_address"/>
                                    <field name="permanent_address"/>
                                    <field name="emergency_contact_name"/>
                                    <field name="emergency_contact_number"/>
                                </group>
                            </group>
                        </page>
                        <page string="Documents">
                            <field name="document_ids">
                                <tree editable="bottom" decoration-danger="is_expiring_soon == True">
                                    <field name="is_expiring_soon" column_invisible="True"/>
                                    <field name="document_type"/>
                                    <field name="file" filename="filename"/>
                                    <field name="filename" column_invisible="True"/>
                                    <field name="expiry_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Attendance">
                            <field name="attendance_ids">
                                <tree>
                                    <field name="attendance_date"/>
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="working_hours"/>
                                    <field name="overtime_hours"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Leave">
                            <field name="leave_ids">
                                <tree>
                                    <field name="leave_type"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="days"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payroll">
                            <field name="payroll_ids">
                                <tree>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="gross_earnings"/>
                                    <field name="net_salary"/>
                                    <field name="payment_status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Skill Matrix">
                            <field name="skill_matrix_ids">
                                <tree editable="bottom">
                                    <field name="operation"/>
                                    <field name="proficiency_level"/>
                                    <field name="certified_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Training">
                            <field name="training_ids">
                                <tree>
                                    <field name="training_name"/>
                                    <field name="training_type"/>
                                    <field name="scheduled_date"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Performance">
                            <field name="performance_ids">
                                <tree>
                                    <field name="review_date"/>
                                    <field name="overall_score"/>
                                    <field name="rating"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Discipline">
                            <field name="discipline_ids">
                                <tree>
                                    <field name="incident_date"/>
                                    <field name="issue_type"/>
                                    <field name="action_taken"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Bonuses &amp; Incentives">
                            <group string="Bonuses">
                                <field name="bonus_ids" nolabel="1">
                                    <tree>
                                        <field name="bonus_type"/>
                                        <field name="period"/>
                                        <field name="amount"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="Production Incentives">
                                <field name="incentive_ids" nolabel="1">
                                    <tree>
                                        <field name="period_end"/>
                                        <field name="target_output"/>
                                        <field name="actual_output"/>
                                        <field name="incentive_amount"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </group>
                        </page>
                        <page string="Loans">
                            <field name="loan_ids">
                                <tree>
                                    <field name="loan_number"/>
                                    <field name="loan_type"/>
                                    <field name="amount"/>
                                    <field name="outstanding_balance"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Complaints">
                            <field name="complaint_ids">
                                <tree>
                                    <field name="submitted_date"/>
                                    <field name="category"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Shift Assignments">
                            <field name="shift_assignment_ids">
                                <tree>
                                    <field name="shift_id"/>
                                    <field name="effective_date"/>
                                    <field name="end_date"/>
                                    <field name="reason"/>
                                </tree>
                            </field>
                        </page>
                        <page string="AI Retention Risk">
                            <field name="ai_last_run" readonly="1"/>
                            <field name="ai_retention_risk_note" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_hr_employee_tree" model="ir.ui.view">
        <field name="name">garment.hr.employee.tree</field>
        <field name="model">garment.hr.employee</field>
        <field name="arch" type="xml">
            <tree string="Employees" decoration-muted="status in ('resigned','terminated')">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="designation_id"/>
                <field name="joining_date"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_hr_employee_kanban" model="ir.ui.view">
        <field name="name">garment.hr.employee.kanban</field>
        <field name="model">garment.hr.employee</field>
        <field name="arch" type="xml">
            <kanban default_group_by="department_id" class="o_kanban_small_column">
                <field name="name"/>
                <field name="designation_id"/>
                <field name="photo"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card">
                            <img t-if="record.photo.raw_value"
                                 t-att-src="kanban_image('garment.hr.employee', 'photo', record.id.raw_value)"
                                 t-att-alt="record.name.value"
                                 class="o_kanban_image" style="max-height:40px;"/>
                            <div class="o_kanban_record_top"><strong><field name="name"/></strong></div>
                            <div><field name="designation_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_garment_hr_employee_search" model="ir.ui.view">
        <field name="name">garment.hr.employee.search</field>
        <field name="model">garment.hr.employee</field>
        <field name="arch" type="xml">
            <search string="Search Employees">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="status"/>
                <filter string="Active" name="filter_active" domain="[('status', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Designation" name="group_designation" context="{'group_by': 'designation_id'}"/>
                    <filter string="Employee Category" name="group_category" context="{'group_by': 'employee_category'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_hr_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">garment.hr.employee</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first employee.</p>
        </field>
    </record>

</odoo>