<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_shipment_form_readiness_inherit" model="ir.ui.view">
        <field name="name">fw.shipment.form.readiness.inherit</field>
        <field name="model">fw.shipment</field>
        <field name="inherit_id" ref="fw_merchandising.view_fw_shipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="before">
                <!-- Add the field invisibly so Odoo can evaluate it -->
                <field name="overall_ready" invisible="1"/>

                <div class="alert alert-success" role="alert" invisible="not overall_ready">
                    <strong>Ready to Ship</strong>
                    — all readiness checks have passed.
                </div>
                <div class="alert alert-warning" role="alert" invisible="overall_ready">
                    <strong>Not Ready to Ship</strong>
                    <field name="readiness_summary" readonly="1" nolabel="1"
                           style="white-space: pre-line;"/>
                </div>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="after">
                <group string="Readiness Checklist">
                    <group>
                        <field name="qc_ready" widget="boolean_toggle" readonly="1"/>
                        <field name="cartons_ready" widget="boolean_toggle" readonly="1"/>
                    </group>
                    <group>
                        <field name="export_docs_ready" widget="boolean_toggle" readonly="1"/>
                        <field name="lc_ready" widget="boolean_toggle" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_fw_shipment_tree_readiness_inherit" model="ir.ui.view">
        <field name="name">fw.shipment.tree.readiness.inherit</field>
        <field name="model">fw.shipment</field>
        <field name="inherit_id" ref="fw_merchandising.view_fw_shipment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="overall_ready" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>