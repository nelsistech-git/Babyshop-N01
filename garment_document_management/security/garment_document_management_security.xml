<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_document_management" model="ir.module.category">
            <field name="name">Smart Garment ERP - Document Management</field>
            <field name="sequence">83</field>
        </record>

        <record id="group_document_user" model="res.groups">
            <field name="name">Department User (Upload/View)</field>
            <field name="category_id" ref="module_category_garment_document_management"/>
        </record>

        <record id="group_document_controller" model="res.groups">
            <field name="name">Document Controller (Create/Edit)</field>
            <field name="category_id" ref="module_category_garment_document_management"/>
            <field name="implied_ids" eval="[(4, ref('group_document_user'))]"/>
        </record>

        <record id="group_document_approval_manager" model="res.groups">
            <field name="name">Approval Manager (Approve)</field>
            <field name="category_id" ref="module_category_garment_document_management"/>
            <field name="implied_ids" eval="[(4, ref('group_document_user'))]"/>
        </record>

        <record id="group_document_auditor" model="res.groups">
            <field name="name">Auditor (Read Only - All Documents)</field>
            <field name="category_id" ref="module_category_garment_document_management"/>
        </record>

        <record id="group_document_manager" model="res.groups">
            <field name="name">Document Administrator (Full Access)</field>
            <field name="category_id" ref="module_category_garment_document_management"/>
            <field name="implied_ids" eval="[(4, ref('group_document_controller')),
                                              (4, ref('group_document_approval_manager')),
                                              (4, ref('group_document_auditor'))]"/>
        </record>

        <!-- Security-level / department visibility on garment.document.
             Restrictive rule applies to every internal user (base.group_user);
             the full-access rule below is OR-combined for members of the
             elevated groups, so controllers/approval managers/auditors/admins
             always see every document regardless of the restrictive rule. -->
        <record id="rule_garment_document_visibility" model="ir.rule">
            <field name="name">Document: Security Level / Ownership Visibility</field>
            <field name="model_id" ref="model_garment_document"/>
            <field name="domain_force">['|', '|', '|', '|',
                ('security_level', 'in', ('public', 'internal')),
                ('owner_id', '=', user.id),
                ('responsible_id', '=', user.id),
                ('allowed_user_ids', 'in', [user.id]),
                ('allowed_group_ids', 'in', user.groups_id.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <record id="rule_garment_document_full_access" model="ir.rule">
            <field name="name">Document: Full Access (Controller/Approval Manager/Auditor/Admin)</field>
            <field name="model_id" ref="model_garment_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_document_controller')),
                                        (4, ref('group_document_approval_manager')),
                                        (4, ref('group_document_auditor')),
                                        (4, ref('group_document_manager'))]"/>
        </record>

        <!-- Buyer/Supplier Document Portal (SRS sections 33-34) is a
             follow-up integration (see IMPLEMENTATION_NOTES.md) — this rule
             gives portal.mixin-backed access to a document only once a
             Document Controller has explicitly listed a portal user's
             res.users record on that document's Additional Users Allowed
             field, keeping today's behaviour safe-by-default. -->
        <record id="rule_garment_document_portal_shared" model="ir.rule">
            <field name="name">Document: Portal User Sees Only Explicitly Shared Documents</field>
            <field name="model_id" ref="model_garment_document"/>
            <field name="domain_force">[('allowed_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_document_company" model="ir.rule">
            <field name="name">Document: Multi-Company</field>
            <field name="model_id" ref="model_garment_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
