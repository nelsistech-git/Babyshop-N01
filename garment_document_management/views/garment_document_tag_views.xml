<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_document_tag_tree" model="ir.ui.view">
        <field name="name">garment.document.tag.tree</field>
        <field name="model">garment.document.tag</field>
        <field name="arch" type="xml">
            <tree string="Document Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_document_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">garment.document.tag</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first document tag.</p>
        </field>
    </record>

</odoo>
