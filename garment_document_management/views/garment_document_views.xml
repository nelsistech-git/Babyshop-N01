<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_document_form" model="ir.ui.view">
        <field name="name">garment.document.form</field>
        <field name="model">garment.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_check_out" type="object" string="Check Out" class="btn-secondary"
                            invisible="is_locked == True"/>
                    <button name="action_check_in" type="object" string="Check In" class="btn-primary"
                            invisible="is_locked == False"/>
                    <button name="action_submit_for_approval" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_approve_step" type="object" string="Approve Step"
                            class="btn-primary" invisible="status != 'pending_approval'"/>
                    <button name="action_reject_step" type="object" string="Reject Step"
                            class="btn-secondary" invisible="status != 'pending_approval'"/>
                    <button name="action_archive_document" type="object" string="Archive"
                            class="btn-secondary" invisible="status in ('archived',)"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,pending_approval,approved,active,archived"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Checked Out" bg_color="bg-warning"
                            invisible="is_locked == False"/>
                    <widget name="web_ribbon" title="Expired" bg_color="bg-danger"
                            invisible="expiry_status != 'expired'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_versions" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                        <button name="action_view_access_log" type="object" class="oe_stat_button" icon="fa-eye">
                            <field name="view_count" widget="statinfo" string="Views"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_no" readonly="1"/>
                            <field name="category_id"/>
                            <field name="department"/>
                            <field name="document_type"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="keywords"/>
                        </group>
                        <group>
                            <field name="owner_id"/>
                            <field name="responsible_id"/>
                            <field name="res_model_id"/>
                            <field name="res_id" invisible="not res_model_id"/>
                            <field name="res_name" readonly="1" invisible="not res_model_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="File">
                            <group>
                                <group>
                                    <field name="file" filename="file_name"/>
                                    <field name="file_name"/>
                                    <field name="file_size" readonly="1"/>
                                </group>
                                <group>
                                    <field name="version" readonly="1"/>
                                    <field name="is_locked" readonly="1"/>
                                    <field name="locked_by_id" readonly="1" invisible="is_locked == False"/>
                                    <field name="locked_date" readonly="1" invisible="is_locked == False"/>
                                </group>
                            </group>
                        </page>
                        <page string="Security &amp; Access">
                            <group>
                                <group>
                                    <field name="security_level"/>
                                    <field name="is_password_protected"/>
                                    <field name="access_password" password="True" invisible="is_password_protected == False"/>
                                </group>
                                <group>
                                    <field name="allowed_group_ids" widget="many2many_tags"/>
                                    <field name="allowed_user_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        <page string="Expiry &amp; Retention">
                            <group>
                                <group>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="renewal_reminder_days"/>
                                </group>
                                <group>
                                    <field name="expiry_status" readonly="1"/>
                                    <field name="retention_policy_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Approval Workflow">
                            <group>
                                <group>
                                    <field name="workflow_id"/>
                                    <field name="current_step_id" readonly="1"
                                           invisible="not workflow_id"/>
                                </group>
                                <group>
                                    <field name="pending_step_ids" widget="many2many_tags" readonly="1"
                                           invisible="not workflow_id"/>
                                    <field name="completed_step_ids" widget="many2many_tags" readonly="1"
                                           invisible="not workflow_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Versions">
                            <field name="version_ids">
                                <tree editable="bottom" create="0">
                                    <field name="sequence"/>
                                    <field name="version_label"/>
                                    <field name="file" filename="file_name"/>
                                    <field name="file_name"/>
                                    <field name="created_by_id" readonly="1"/>
                                    <field name="create_date" readonly="1"/>
                                    <field name="note"/>
                                    <field name="is_current" widget="boolean_toggle" readonly="1"/>
                                    <button name="action_restore" type="object" string="Restore" icon="fa-undo"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Access Log">
                            <field name="access_log_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="action_date"/>
                                    <field name="user_id"/>
                                    <field name="action"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_document_tree" model="ir.ui.view">
        <field name="name">garment.document.tree</field>
        <field name="model">garment.document</field>
        <field name="arch" type="xml">
            <tree string="Documents" decoration-danger="expiry_status == 'expired'"
                  decoration-warning="expiry_status == 'expiring_soon'">
                <field name="document_no"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="department"/>
                <field name="owner_id"/>
                <field name="version"/>
                <field name="security_level"/>
                <field name="expiry_date"/>
                <field name="expiry_status"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('approved', 'active')"
                       decoration-danger="status in ('rejected', 'expired')"
                       decoration-info="status == 'pending_approval'"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_document_kanban" model="ir.ui.view">
        <field name="name">garment.document.kanban</field>
        <field name="model">garment.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div>
                                <field name="document_no"/> · <field name="category_id"/>
                            </div>
                            <div>
                                <field name="owner_id" widget="many2one_avatar_user"/>
                                <span class="float-end">
                                    <field name="expiry_status" widget="badge"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_garment_document_search" model="ir.ui.view">
        <field name="name">garment.document.search</field>
        <field name="model">garment.document</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name"/>
                <field name="document_no"/>
                <field name="keywords"/>
                <field name="tag_ids"/>
                <field name="owner_id"/>
                <field name="category_id"/>
                <field name="res_model"/>
                <filter string="My Documents" name="my_documents" domain="[('owner_id', '=', uid)]"/>
                <filter string="Checked Out" name="checked_out" domain="[('is_locked', '=', True)]"/>
                <filter string="Pending Approval" name="pending_approval" domain="[('status', '=', 'pending_approval')]"/>
                <filter string="Expiring Soon" name="expiring_soon" domain="[('expiry_status', '=', 'expiring_soon')]"/>
                <filter string="Expired" name="expired" domain="[('expiry_status', '=', 'expired')]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Security Level" name="group_security" context="{'group_by': 'security_level'}"/>
                    <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">garment.document</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_my_documents': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload your first document.</p>
        </field>
    </record>

</odoo>
