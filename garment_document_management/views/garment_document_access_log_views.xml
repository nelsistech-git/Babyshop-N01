<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_document_access_log_tree" model="ir.ui.view">
        <field name="name">garment.document.access.log.tree</field>
        <field name="model">garment.document.access.log</field>
        <field name="arch" type="xml">
            <tree string="Document Access Log" create="0" edit="0">
                <field name="action_date"/>
                <field name="document_id"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_document_access_log_search" model="ir.ui.view">
        <field name="name">garment.document.access.log.search</field>
        <field name="model">garment.document.access.log</field>
        <field name="arch" type="xml">
            <search string="Search Access Log">
                <field name="document_id"/>
                <field name="user_id"/>
                <field name="action"/>
                <group expand="0" string="Group By">
                    <filter string="Document" name="group_document" context="{'group_by': 'document_id'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Action" name="group_action" context="{'group_by': 'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_document_access_log" model="ir.actions.act_window">
        <field name="name">Access Log</field>
        <field name="res_model">garment.document.access.log</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
