<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_document_version_tree" model="ir.ui.view">
        <field name="name">garment.document.version.tree</field>
        <field name="model">garment.document.version</field>
        <field name="arch" type="xml">
            <tree string="Document Versions" create="0">
                <field name="document_id"/>
                <field name="version_label"/>
                <field name="sequence"/>
                <field name="created_by_id"/>
                <field name="create_date"/>
                <field name="is_current"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_document_version_form" model="ir.ui.view">
        <field name="name">garment.document.version.form</field>
        <field name="model">garment.document.version</field>
        <field name="arch" type="xml">
            <form string="Document Version">
                <sheet>
                    <group>
                        <group>
                            <field name="document_id"/>
                            <field name="version_label"/>
                            <field name="sequence"/>
                            <field name="is_current" readonly="1"/>
                        </group>
                        <group>
                            <field name="file" filename="file_name"/>
                            <field name="file_name"/>
                            <field name="file_size" readonly="1"/>
                            <field name="created_by_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="note"/>
                    <button name="action_restore" type="object" string="Restore This Version" class="btn-secondary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_document_version_search" model="ir.ui.view">
        <field name="name">garment.document.version.search</field>
        <field name="model">garment.document.version</field>
        <field name="arch" type="xml">
            <search string="Search Versions">
                <field name="document_id"/>
                <field name="version_label"/>
                <field name="created_by_id"/>
                <group expand="0" string="Group By">
                    <filter string="Document" name="group_document" context="{'group_by': 'document_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_document_version" model="ir.actions.act_window">
        <field name="name">Versions</field>
        <field name="res_model">garment.document.version</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
