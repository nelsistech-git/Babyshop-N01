<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_document_category_tree" model="ir.ui.view">
        <field name="name">garment.document.category.tree</field>
        <field name="model">garment.document.category</field>
        <field name="arch" type="xml">
            <tree string="Document Categories">
                <field name="sequence" widget="handle"/>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="department"/>
                <field name="document_type"/>
                <field name="document_count"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_document_category_form" model="ir.ui.view">
        <field name="name">garment.document.category.form</field>
        <field name="model">garment.document.category</field>
        <field name="arch" type="xml">
            <form string="Document Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="department"/>
                            <field name="document_type"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_document_category_search" model="ir.ui.view">
        <field name="name">garment.document.category.search</field>
        <field name="model">garment.document.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <filter string="Top-Level Folders" name="top_level" domain="[('parent_id', '=', False)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by': 'department'}"/>
                    <filter string="Parent Folder" name="group_parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_document_category" model="ir.actions.act_window">
        <field name="name">Categories / Folders</field>
        <field name="res_model">garment.document.category</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_top_level': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first document category / folder.</p>
        </field>
    </record>

</odoo>
