<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_supplier" model="ir.module.category">
            <field name="name">Smart Garment ERP - Supplier</field>
            <field name="sequence">59</field>
        </record>

        <record id="group_supplier_procurement_officer" model="res.groups">
            <field name="name">Procurement Officer (Assigned Suppliers)</field>
            <field name="category_id" ref="module_category_garment_supplier"/>
        </record>

        <record id="group_supplier_qa_manager" model="res.groups">
            <field name="name">QA Manager (Quality Data, Approve Quality)</field>
            <field name="category_id" ref="module_category_garment_supplier"/>
        </record>

        <record id="group_supplier_compliance_manager" model="res.groups">
            <field name="name">Compliance Manager (Audit Data, Approve Compliance)</field>
            <field name="category_id" ref="module_category_garment_supplier"/>
        </record>

        <record id="group_supplier_purchase_manager" model="res.groups">
            <field name="name">Purchase Manager (Full Supplier &amp; Purchase Access)</field>
            <field name="category_id" ref="module_category_garment_supplier"/>
            <field name="implied_ids" eval="[(4, ref('group_supplier_procurement_officer')),
                                              (4, ref('group_supplier_qa_manager')),
                                              (4, ref('group_supplier_compliance_manager'))]"/>
        </record>

        <record id="group_supplier_top_management" model="res.groups">
            <field name="name">Top Management (MD - Full Access)</field>
            <field name="category_id" ref="module_category_garment_supplier"/>
            <field name="implied_ids" eval="[(4, ref('group_supplier_purchase_manager'))]"/>
        </record>

        <record id="rule_garment_supplier_officer_full_read" model="ir.rule">
            <field name="name">Procurement Officer: All Suppliers (Read)</field>
            <field name="model_id" ref="model_garment_supplier"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_supplier_procurement_officer'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_supplier_manager_full" model="ir.rule">
            <field name="name">Purchase Manager+: All Suppliers</field>
            <field name="model_id" ref="model_garment_supplier"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_supplier_purchase_manager'))]"/>
        </record>

        <record id="rule_garment_supplier_portal_own" model="ir.rule">
            <field name="name">Supplier Portal User: Own Record Only</field>
            <field name="model_id" ref="model_garment_supplier"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
