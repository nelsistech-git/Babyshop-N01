<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Document Expiry notification (SRS section 47): "Certificate expires
         in 15 days" — checks daily and notifies the Purchase Manager group. -->
    <record id="ir_cron_garment_supplier_document_expiry" model="ir.cron">
        <field name="name">Garment Supplier: Notify Expiring Documents</field>
        <field name="model_id" ref="model_garment_supplier_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_expiring_documents()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
