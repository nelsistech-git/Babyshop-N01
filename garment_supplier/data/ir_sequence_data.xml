<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_supplier" model="ir.sequence">
        <field name="name">Garment Supplier Code</field>
        <field name="code">garment.supplier</field>
        <field name="prefix">SUP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_supplier_audit" model="ir.sequence">
        <field name="name">Garment Supplier Audit Number</field>
        <field name="code">garment.supplier.audit</field>
        <field name="prefix">AUD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
