<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_supplier_graph" model="ir.ui.view">
        <field name="name">garment.supplier.graph</field>
        <field name="model">garment.supplier</field>
        <field name="arch" type="xml">
            <graph string="Suppliers by Ranking" type="bar">
                <field name="ranking"/>
            </graph>
        </field>
    </record>

    <record id="view_garment_supplier_pivot" model="ir.ui.view">
        <field name="name">garment.supplier.pivot</field>
        <field name="model">garment.supplier</field>
        <field name="arch" type="xml">
            <pivot string="Supplier Analysis">
                <field name="category_id" type="row"/>
                <field name="classification" type="col"/>
                <field name="rating" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_garment_supplier_dashboard" model="ir.actions.act_window">
        <field name="name">Supplier Dashboard</field>
        <field name="res_model">garment.supplier</field>
        <field name="view_mode">graph,pivot,kanban,tree</field>
    </record>

</odoo>
