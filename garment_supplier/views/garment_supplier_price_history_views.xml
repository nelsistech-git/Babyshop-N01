<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_supplier_price_history_tree" model="ir.ui.view">
        <field name="name">garment.supplier.price.history.tree</field>
        <field name="model">garment.supplier.price.history</field>
        <field name="arch" type="xml">
            <tree string="Supplier Price History">
                <field name="supplier_id"/>
                <field name="material_name"/>
                <field name="effective_date"/>
                <field name="validity_date"/>
                <field name="price"/>
                <field name="moq"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_supplier_price_history" model="ir.actions.act_window">
        <field name="name">Supplier Price History</field>
        <field name="res_model">garment.supplier.price.history</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
