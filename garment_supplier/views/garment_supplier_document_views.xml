<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_supplier_document_tree" model="ir.ui.view">
        <field name="name">garment.supplier.document.tree</field>
        <field name="model">garment.supplier.document</field>
        <field name="arch" type="xml">
            <tree string="Supplier Documents" decoration-danger="expiry_status in ('expiring_soon','expired')">
                <field name="supplier_id"/>
                <field name="document_type"/>
                <field name="expiry_date"/>
                <field name="expiry_status"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_supplier_document" model="ir.actions.act_window">
        <field name="name">Supplier Documents</field>
        <field name="res_model">garment.supplier.document</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
