<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_supplier_risk_tree" model="ir.ui.view">
        <field name="name">garment.supplier.risk.tree</field>
        <field name="model">garment.supplier.risk</field>
        <field name="arch" type="xml">
            <tree string="Supplier Risks" editable="bottom" decoration-danger="risk_level in ('high','critical')" decoration-muted="status == 'closed'">
                <field name="supplier_id"/>
                <field name="risk_factor"/>
                <field name="risk_level"/>
                <field name="identified_date"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_supplier_risk" model="ir.actions.act_window">
        <field name="name">Supplier Risks</field>
        <field name="res_model">garment.supplier.risk</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
