<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_supplier_capa_tree" model="ir.ui.view">
        <field name="name">garment.supplier.capa.tree</field>
        <field name="model">garment.supplier.capa</field>
        <field name="arch" type="xml">
            <tree string="Corrective Actions" editable="bottom" decoration-success="completion_status == 'completed'" decoration-danger="completion_status == 'overdue'">
                <field name="supplier_id"/>
                <field name="audit_id"/>
                <field name="issue"/>
                <field name="responsible_person_id"/>
                <field name="due_date"/>
                <field name="completion_status"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_supplier_capa" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">garment.supplier.capa</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
