<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Team Member -->
    <record id="view_garment_plm_team_member_tree" model="ir.ui.view">
        <field name="name">garment.plm.team.member.tree</field>
        <field name="model">garment.plm.team.member</field>
        <field name="arch" type="xml">
            <tree string="PLM Team Assignments" editable="bottom">
                <field name="project_id"/>
                <field name="role"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="is_lead"/>
                <field name="date_assigned"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_plm_team_member_search" model="ir.ui.view">
        <field name="name">garment.plm.team.member.search</field>
        <field name="model">garment.plm.team.member</field>
        <field name="arch" type="xml">
            <search string="Search Team Assignments">
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="role"/>
                <group expand="0" string="Group By">
                    <filter string="Role" name="groupby_role" context="{'group_by': 'role'}"/>
                    <filter string="Project" name="groupby_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_plm_team_member" model="ir.actions.act_window">
        <field name="name">Team Assignments</field>
        <field name="res_model">garment.plm.team.member</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_garment_plm_team_member_search"/>
    </record>

    <!-- Task -->
    <record id="view_garment_plm_task_tree" model="ir.ui.view">
        <field name="name">garment.plm.task.tree</field>
        <field name="model">garment.plm.task</field>
        <field name="arch" type="xml">
            <tree string="PLM Tasks" decoration-danger="status == 'delayed'" decoration-muted="status in ('completed', 'cancelled')">
                <field name="project_id"/>
                <field name="style_id"/>
                <field name="name"/>
                <field name="task_type"/>
                <field name="assigned_to_id"/>
                <field name="due_date"/>
                <field name="priority"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_plm_task_form" model="ir.ui.view">
        <field name="name">garment.plm.task.form</field>
        <field name="model">garment.plm.task</field>
        <field name="arch" type="xml">
            <form string="PLM Task">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary"
                            invisible="status not in ('running', 'delayed')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,running,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="style_id" readonly="1"/>
                            <field name="stage_gate_id"/>
                            <field name="task_type"/>
                        </group>
                        <group>
                            <field name="assigned_to_id"/>
                            <field name="due_date"/>
                            <field name="completed_date" readonly="1"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_plm_task_search" model="ir.ui.view">
        <field name="name">garment.plm.task.search</field>
        <field name="model">garment.plm.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name"/>
                <field name="project_id"/>
                <field name="assigned_to_id"/>
                <filter string="My Tasks" name="filter_my" domain="[('assigned_to_id', '=', uid)]"/>
                <filter string="Open" name="filter_open" domain="[('status', 'not in', ('completed', 'cancelled'))]"/>
                <filter string="Overdue" name="filter_overdue"
                        domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('status', 'not in', ('completed', 'cancelled'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="groupby_status" context="{'group_by': 'status'}"/>
                    <filter string="Assigned To" name="groupby_assignee" context="{'group_by': 'assigned_to_id'}"/>
                    <filter string="Project" name="groupby_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_plm_task" model="ir.actions.act_window">
        <field name="name">PLM Tasks</field>
        <field name="res_model">garment.plm.task</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_garment_plm_task_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>

</odoo>
