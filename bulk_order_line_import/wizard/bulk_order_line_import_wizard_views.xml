<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bulk_order_line_import_wizard_form" model="ir.ui.view">
        <field name="name">wizard.bulk.order.line.import.form</field>
        <field name="model">wizard.bulk.order.line.import</field>
        <field name="arch" type="xml">
            <form string="Import Order Lines">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <group>
                    <field name="order_reference" readonly="1"/>
                </group>
                <group>
                    <field name="file" filename="filename" required="1"/>
                    <field name="filename" invisible="1"/>
                    <field name="duplicate_strategy" widget="radio"/>
                </group>
                <div class="text-muted" style="margin: 4px 0 12px;">
                    Required columns: <b>Product Code / SKU</b>, <b>Quantity</b>.
                    Optional: Unit Price, UoM<span invisible="res_model != 'sale.order'">, Discount (%)</span>.
                    Products are matched against Internal Reference or Barcode.
                </div>
                <footer>
                    <button name="action_download_sample_template" type="object"
                            string="Download Sample Template" class="btn-link"/>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
