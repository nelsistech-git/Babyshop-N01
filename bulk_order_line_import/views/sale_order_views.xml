<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_bulk_import" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.bulk.import</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_confirm" id="action_confirm" position="before">
                <button name="action_open_bulk_import_wizard" type="object"
                        string="Import Lines" class="btn-secondary"
                        invisible="state not in ('draft', 'sent')"/>
            </button>
        </field>
    </record>
</odoo>
