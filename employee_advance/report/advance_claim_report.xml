<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same page geometry as the Expenses Report: letterhead header at 1 inch from the top,
         title 0.4 in under the pad, left/right margins 1 inch. -->
    <record id="paperformat_advance_claim" model="report.paperformat">
        <field name="name">Advance Claim Sheet / Adjustment (A4, letterhead)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">46.4</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">25.4</field>
        <field name="margin_right">25.4</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">21</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_advance_claim" model="ir.actions.report">
        <field name="name">Advance Claim Sheet</field>
        <field name="model">employee.advance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_advance.report_advance_claim_template</field>
        <field name="report_file">employee_advance.report_advance_claim_template</field>
        <field name="print_report_name">'Advance Claim Sheet - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_advance_claim"/>
        <field name="binding_model_id" ref="model_employee_advance"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_advance_claim_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">

                    <!-- Letterhead header + footer (hard-coded, same as the attached pad) -->
                    <t t-call="employee_advance.letterhead_header_footer"/>

                    <div class="page">
                        <div style="text-align:center; margin:0 0 16px 0; padding:0;">
                            <h2 style="text-transform:uppercase; font-weight:bold; font-size:14pt; margin:0; padding:0; line-height:1.1;">Advance Claim Sheet</h2>
                            <p style="font-size:10pt; margin:2px 0 0 0;"><strong><span t-esc="o.name"/></strong></p>
                        </div>

                        <table style="width:100%; border-collapse:collapse; margin-bottom:12px;">
                            <tr>
                                <td style="width:50%; padding:4px;"><strong>Employee: </strong><span t-esc="o.employee_id.name"/></td>
                                <td style="width:50%; padding:4px;"><strong>Designation: </strong><span t-esc="o.job_title or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding:4px;"><strong>Department: </strong><span t-esc="o.department_id.complete_name or o.department_id.name or ''"/></td>
                                <td style="padding:4px;"><strong>Date: </strong><span t-esc="o.date.strftime('%d-%b-%Y') if o.date else ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding:4px;"><strong>Status: </strong><span t-esc="dict(o._fields['state']._description_selection(o.env)).get(o.state, '')"/></td>
                                <td style="padding:4px;"><strong>Advance Head: </strong><span t-esc="o.advance_account_id.display_name or ''"/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered"
                               style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:9px; table-layout:fixed; word-wrap:break-word;">
                            <thead>
                                <tr style="background-color:#6C7E7F; color:white;">
                                    <th style="width:8%;  padding:5px 3px; border:1px solid #000; text-align:center;">SL</th>
                                    <th style="width:16%; padding:5px 3px; border:1px solid #000;">Date</th>
                                    <th style="width:22%; padding:5px 3px; border:1px solid #000;">Reference No.</th>
                                    <th style="width:38%; padding:5px 3px; border:1px solid #000;">Purpose</th>
                                    <th style="width:16%; padding:5px 3px; border:1px solid #000; text-align:right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border:1px solid #000;">
                                    <td style="padding:4px 3px; border:1px solid #000; text-align:center;">1</td>
                                    <td style="padding:4px 3px; border:1px solid #000;"><span t-esc="o.date.strftime('%d-%b-%Y') if o.date else ''"/></td>
                                    <td style="padding:4px 3px; border:1px solid #000;"><span t-esc="o.name"/></td>
                                    <td style="padding:4px 3px; border:1px solid #000;"><span t-esc="o.purpose or ''"/></td>
                                    <td style="padding:4px 3px; border:1px solid #000; text-align:right;"><span t-esc="'{:,.2f}'.format(o.amount)"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="background-color:#D9E1F2; font-weight:bold;">
                                    <td colspan="4" style="padding:5px 3px; border:1px solid #000; text-align:right;">Total Advance Amount (BDT):</td>
                                    <td style="padding:5px 3px; border:1px solid #000; text-align:right;"><span t-esc="'{:,.2f}'.format(o.amount)"/></td>
                                </tr>
                                <tr style="font-weight:bold;">
                                    <td colspan="5" style="padding:5px 3px; border:1px solid #000; text-align:left;">Amount in Word: <span t-esc="o.amount_in_words"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Signatures: four floated columns (no table, so no box around them) -->
                        <div style="margin-top:90px; border:0 !important; overflow:hidden; page-break-inside:avoid;">
                            <div style="float:left; width:25%; box-sizing:border-box; padding:0 12px; border:0 !important; text-align:center;">
                                <div style="border:0 !important; border-top:1px solid #000 !important; padding-top:6px;"><strong>Prepared by</strong></div>
                            </div>
                            <div style="float:left; width:25%; box-sizing:border-box; padding:0 12px; border:0 !important; text-align:center;">
                                <div style="border:0 !important; border-top:1px solid #000 !important; padding-top:6px;"><strong>Checked By</strong></div>
                            </div>
                            <div style="float:left; width:25%; box-sizing:border-box; padding:0 12px; border:0 !important; text-align:center;">
                                <div style="border:0 !important; border-top:1px solid #000 !important; padding-top:6px;"><strong>Authorized by</strong></div>
                            </div>
                            <div style="float:left; width:25%; box-sizing:border-box; padding:0 12px; border:0 !important; text-align:center;">
                                <div style="border:0 !important; border-top:1px solid #000 !important; padding-top:6px;"><strong>Approved By</strong></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>