<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bit Body Bangladesh Limited letterhead pad (copy of Letter_Head_Pad1.pdf).
         Everything is hard-coded on purpose: nothing here comes from the Company record.
         Use it in any report of this module (and of the adjustment module) with
             <t t-call="web.basic_layout">
                 <t t-call="employee_advance.letterhead_header_footer"/>
                 <div class="page"> ... </div>
             </t>
         together with the paper format `employee_advance.paperformat_advance_claim`
         (top margin 46.4 mm / header spacing 21 mm / bottom margin 32 mm / left-right 25.4 mm).
         The header box is exactly 72 pt (= 46.4 - 21 mm) and the footer box exactly 90.7 pt
         (= the 32 mm bottom margin), so the pad lands in the same place on every page. -->
    <template id="letterhead_header_footer">
        <div class="header" style="margin:0; padding:0;">
            <div style="position:relative; box-sizing:border-box; height:72pt;">
                <div style="position:absolute; left:0; right:-25.4mm; bottom:0; height:0; border-top:0.75pt solid #000;"></div>
                <img src="data:image/png;base64," alt="" style="position:absolute; left:0; top:30.5pt; width:106pt; height:auto; border:0; padding:0; background:none; box-shadow:none;"/>
                <div style="position:absolute; right:-10pt; top:31pt; white-space:nowrap; font-family:'Times New Roman', 'Liberation Serif', Times, serif; font-size:26pt; font-weight:bold; line-height:38pt; color:#323E4F;">Bit Body Bangladesh Limited</div>
            </div>
        </div>

        <div class="footer" style="margin:0; padding:0; text-align:center; color:#002060;">
            <div style="box-sizing:border-box; height:90.7pt; padding-top:10pt;"><div style="border-top:0.75pt solid #000; padding-top:0.5pt;">
                <div style="font-family:'Times New Roman', 'Liberation Serif', Times, serif; font-size:7pt; line-height:9.3pt;"><strong>Registered Office:</strong> House # B-1 (First Floor), Plot # 11/A-1, Gulshan -2, Dhaka-1212</div>
                <div style="font-family:'Times New Roman', 'Liberation Serif', Times, serif; font-size:7pt; line-height:9.3pt;"><strong>Factory &amp; Corporate Office:</strong> Sattar Bhaban, Plot- 224 &amp; 226, Bogabari Bazaar, Alia Madrasha, Ashulia, Dhaka-1349, Bangladesh</div>
                <div style="font-family:Arial, 'Liberation Sans', Helvetica, sans-serif; font-size:10pt; line-height:14pt; white-space:nowrap;">
                    <img src="data:image/png;base64," alt="" style="width:8.8pt; height:7.4pt; vertical-align:middle; border:0; padding:0; background:none; box-shadow:none;"/>&#160;+8801911908653<span style="font-size:7pt;">,</span>&#160;<img src="data:image/png;base64," alt="" style="width:11.2pt; height:7.7pt; vertical-align:middle; border:0; padding:0; background:none; box-shadow:none;"/>&#160;<span style="text-decoration:underline;">bbbl@mtailor.com</span>&#160;&#160;<img src="data:image/png;base64," alt="" style="width:9.9pt; height:9.4pt; vertical-align:middle; border:0; padding:0; background:none; box-shadow:none;"/>&#160;<span style="text-decoration:underline;">www.mtailor.com</span>
                </div>
            </div>
        </div></div>
    </template>
</odoo>
