<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_advance" model="ir.module.category">
        <field name="name">Employee Advance</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_advance_user" model="res.groups">
        <field name="name">Employee</field>
        <field name="category_id" ref="module_category_employee_advance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_advance_manager" model="res.groups">
        <field name="name">Supervisor (Check)</field>
        <field name="category_id" ref="module_category_employee_advance"/>
        <field name="implied_ids" eval="[(4, ref('group_advance_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_advance_accountant" model="res.groups">
        <field name="name">Accounts (Final Check and Post)</field>
        <field name="category_id" ref="module_category_employee_advance"/>
        <field name="implied_ids" eval="[(4, ref('group_advance_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_advance_own" model="ir.rule">
        <field name="name">Advance: own records</field>
        <field name="model_id" ref="model_employee_advance"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_advance_user'))]"/>
    </record>
    <record id="rule_advance_all" model="ir.rule">
        <field name="name">Advance: supervisor and accounts see all</field>
        <field name="model_id" ref="model_employee_advance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_advance_manager')), (4, ref('group_advance_accountant'))]"/>
    </record>
    <record id="rule_advance_company" model="ir.rule">
        <field name="name">Advance: multi-company</field>
        <field name="model_id" ref="model_employee_advance"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
