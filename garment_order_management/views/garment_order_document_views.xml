<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_order_document_tree" model="ir.ui.view">
        <field name="name">garment.order.document.tree</field>
        <field name="model">garment.order.document</field>
        <field name="arch" type="xml">
            <tree string="Document Checklist" editable="bottom" decoration-danger="status == 'missing'"
                  decoration-warning="status == 'pending'" decoration-success="status == 'completed'">
                <field name="order_id"/>
                <field name="document_type"/>
                <field name="status"/>
                <field name="received_date"/>
                <field name="attachment" filename="attachment_filename"/>
                <field name="attachment_filename" invisible="1"/>
                <field name="remarks"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_order_document_form" model="ir.ui.view">
        <field name="name">garment.order.document.form</field>
        <field name="model">garment.order.document</field>
        <field name="arch" type="xml">
            <form string="Order Document">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="document_type"/>
                            <field name="status"/>
                            <field name="received_date"/>
                        </group>
                        <group>
                            <field name="attachment" filename="attachment_filename"/>
                            <field name="attachment_filename" invisible="1"/>
                            <field name="remarks"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_order_document" model="ir.actions.act_window">
        <field name="name">Document Checklist</field>
        <field name="res_model">garment.order.document</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
