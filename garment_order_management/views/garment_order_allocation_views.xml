<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_order_allocation_tree" model="ir.ui.view">
        <field name="name">garment.order.allocation.tree</field>
        <field name="model">garment.order.allocation</field>
        <field name="arch" type="xml">
            <tree string="Factory Allocations" editable="bottom">
                <field name="order_id"/>
                <field name="order_line_id"/>
                <field name="split_type"/>
                <field name="factory"/>
                <field name="production_line"/>
                <field name="allocated_qty" sum="Total"/>
                <field name="delivery_date"/>
                <field name="production_status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_order_allocation_form" model="ir.ui.view">
        <field name="name">garment.order.allocation.form</field>
        <field name="model">garment.order.allocation</field>
        <field name="arch" type="xml">
            <form string="Factory Allocation">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="order_line_id"/>
                            <field name="split_type"/>
                        </group>
                        <group>
                            <field name="factory"/>
                            <field name="production_line"/>
                            <field name="allocated_qty"/>
                            <field name="delivery_date"/>
                            <field name="production_status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_order_allocation" model="ir.actions.act_window">
        <field name="name">Factory Allocations</field>
        <field name="res_model">garment.order.allocation</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
