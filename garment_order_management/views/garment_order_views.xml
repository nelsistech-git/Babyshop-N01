<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_order_tree" model="ir.ui.view">
        <field name="name">garment.order.tree</field>
        <field name="model">garment.order</field>
        <field name="arch" type="xml">
            <tree string="Orders" decoration-danger="risk_level in ('high','critical')"
                  decoration-warning="risk_level == 'medium'" decoration-muted="state in ('closed','cancelled')">
                <field name="name"/>
                <field name="buyer_po_number"/>
                <field name="buyer_id"/>
                <field name="style_id"/>
                <field name="quantity" sum="Total Qty"/>
                <field name="order_value" sum="Total Value" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="delivery_date"/>
                <field name="shipment_date"/>
                <field name="progress" widget="progressbar"/>
                <field name="risk_level"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'"
                       decoration-info="state in ('confirmed','tna_created')"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_order_form" model="ir.ui.view">
        <field name="name">garment.order.form</field>
        <field name="model">garment.order</field>
        <field name="arch" type="xml">
            <form string="Order">
                <header>
                    <button name="action_receive_po" type="object" string="Receive PO" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm Order" class="btn-primary"
                            invisible="state != 'po_received'"/>
                    <button name="action_mark_tna_created" type="object" string="Mark TNA Created"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_start_material_planning" type="object" string="Start Material Planning"
                            class="btn-primary" invisible="state != 'tna_created'"/>
                    <button name="action_release_to_production" type="object" string="Release To Production"
                            class="btn-primary" invisible="state != 'material_planning'"/>
                    <button name="action_start_quality_checking" type="object" string="Start Quality Checking"
                            class="btn-primary" invisible="state != 'production_running'"/>
                    <button name="action_ready_for_shipment" type="object" string="Ready For Shipment"
                            class="btn-primary" invisible="state != 'quality_checking'"/>
                    <button name="action_ship" type="object" string="Ship" class="btn-primary"
                            invisible="state != 'ready_for_shipment'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary"
                            invisible="state != 'shipped'"/>
                    <button name="action_close" type="object" string="Close Order" class="btn-secondary"
                            invisible="state != 'completed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('shipped','completed','closed','cancelled')"
                            confirm="Cancel this order?"/>
                    <button name="action_reset_to_draft" type="object" string="Reset To Draft"
                            groups="garment_order_management.group_order_manager"
                            invisible="state not in ('cancelled',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,po_received,confirmed,tna_created,material_planning,production_running,quality_checking,ready_for_shipment,shipped,completed,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Locked" bg_color="bg-danger" invisible="is_locked == False"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Order Lines"/>
                        </button>
                        <button name="action_view_shipments" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="shipment_count" widget="statinfo" string="Shipments"/>
                        </button>
                        <button name="action_view_allocations" type="object" class="oe_stat_button"
                                icon="fa-industry">
                            <field name="allocation_count" widget="statinfo" string="Allocations"/>
                        </button>
                        <button name="action_view_risks" type="object" class="oe_stat_button"
                                icon="fa-exclamation-triangle">
                            <field name="risk_count" widget="statinfo" string="Risks"/>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file-text">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button name="action_view_revisions" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="revision_count" widget="statinfo" string="Revisions"/>
                        </button>
                        <button name="action_view_delays" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="delay_count" widget="statinfo" string="Delays"/>
                        </button>
                        <button name="action_view_techpacks" type="object" class="oe_stat_button" icon="fa-scissors"
                                invisible="not style_id">
                            <field name="techpack_count" widget="statinfo" string="Tech Packs"/>
                        </button>
                        <button name="action_view_samples" type="object" class="oe_stat_button" icon="fa-cube"
                                invisible="not style_id">
                            <field name="sample_count" widget="statinfo" string="Samples"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="buyer_po_number" placeholder="Buyer PO Number"/></h3>
                    </div>
                    <group>
                        <group string="Buyer &amp; Origin">
                            <field name="buyer_id"/>
                            <field name="merch_order_confirmation_id"/>
                            <field name="quotation_id" readonly="1" invisible="not quotation_id"/>
                            <field name="po_date"/>
                            <field name="buyer_reference"/>
                            <field name="contract_number"/>
                            <field name="brand"/>
                            <field name="buying_house"/>
                            <field name="season"/>
                            <field name="collection"/>
                        </group>
                        <group string="Style / Planning References">
                            <field name="style_id"/>
                            <field name="product_category_id" readonly="1"/>
                            <field name="bom_id"/>
                            <field name="costing_id"/>
                            <field name="tna_id"/>
                            <field name="sample_approval_done"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates &amp; Factory">
                            <field name="order_date"/>
                            <field name="delivery_date"/>
                            <field name="shipment_date"/>
                            <field name="factory"/>
                            <field name="production_unit"/>
                            <field name="merchandiser_id"/>
                        </group>
                        <group string="Commercial">
                            <field name="currency_id"/>
                            <field name="payment_term_id"/>
                            <field name="shipment_term"/>
                            <field name="delivery_location"/>
                            <field name="port_of_loading"/>
                            <field name="port_of_destination"/>
                            <field name="quantity" readonly="1"/>
                            <field name="order_value" readonly="1" widget="monetary"/>
                            <field name="shipped_qty" readonly="1"/>
                            <field name="balance_qty" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids" context="{'default_order_id': id}">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="style_id"/>
                                    <field name="product_name"/>
                                    <field name="color"/>
                                    <field name="size_range"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="unit_price"/>
                                    <field name="total_value" sum="Total Value" widget="monetary"/>
                                    <field name="delivery_date"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Export / Shipment Info">
                            <group>
                                <group string="Export Standards (Bangladesh)">
                                    <field name="buyer_country_id"/>
                                    <field name="hs_code"/>
                                    <field name="export_category"/>
                                    <field name="shipment_mode"/>
                                    <field name="forwarder_details"/>
                                </group>
                            </group>
                        </page>
                        <page string="Material Planning">
                            <group>
                                <group string="Material Requirement (Order Qty x BOM Consumption)">
                                    <field name="fabric_consumption_per_pc"/>
                                    <field name="required_fabric_qty" readonly="1"/>
                                    <field name="material_status"/>
                                    <field name="materials_planned"/>
                                </group>
                                <group string="Material Availability Check">
                                    <field name="available_stock_qty"/>
                                    <field name="reserved_stock_qty"/>
                                    <field name="incoming_purchase_qty"/>
                                    <field name="shortage_qty" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Production Capacity">
                            <group>
                                <field name="capacity_required_qty"/>
                                <field name="capacity_available_qty"/>
                                <field name="capacity_shortage_qty" readonly="1"/>
                                <field name="production_capacity_available"/>
                            </group>
                        </page>
                        <page string="Order Tracking / Progress">
                            <group>
                                <group>
                                    <field name="material_progress" widget="progressbar"/>
                                    <field name="cutting_progress" widget="progressbar"/>
                                    <field name="sewing_progress" widget="progressbar"/>
                                </group>
                                <group>
                                    <field name="finishing_progress" widget="progressbar"/>
                                    <field name="inspection_progress" widget="progressbar"/>
                                    <field name="progress" widget="progressbar" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="AI Order Intelligence">
                            <div class="oe_button_box" style="margin-bottom: 10px;">
                                <button name="action_run_ai_risk_prediction" type="object"
                                        string="Run AI Risk Prediction" class="btn-secondary" icon="fa-magic"/>
                                <button name="action_run_ai_delivery_prediction" type="object"
                                        string="Predict Delivery (AI)" class="btn-secondary" icon="fa-calendar"/>
                                <button name="action_run_ai_optimization" type="object"
                                        string="Optimize Allocation (AI)" class="btn-secondary" icon="fa-cogs"/>
                            </div>
                            <group>
                                <group>
                                    <field name="risk_level"/>
                                    <field name="risk_score"/>
                                    <field name="ai_predicted_shipment_date" readonly="1"/>
                                    <field name="ai_delay_probability" readonly="1"/>
                                    <field name="ai_last_run" readonly="1"/>
                                </group>
                            </group>
                            <group string="AI Risk Reason">
                                <field name="ai_risk_reason" nolabel="1" readonly="1"/>
                            </group>
                            <group string="AI Recommendation">
                                <field name="ai_recommendation" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                        <page string="Locking / Approval">
                            <group>
                                <field name="is_locked" readonly="1"/>
                                <field name="locked_date" readonly="1"/>
                            </group>
                            <button name="action_create_revision" type="object" string="New Revision"
                                    class="btn-secondary" invisible="not is_locked"/>
                            <button name="action_lock_order" type="object" string="Lock"
                                    class="btn-secondary" invisible="is_locked"
                                    groups="garment_order_management.group_order_manager"/>
                            <button name="action_unlock_order" type="object" string="Unlock"
                                    class="btn-secondary" invisible="not is_locked"
                                    groups="garment_order_management.group_order_manager"/>
                            <field name="approval_ids">
                                <tree>
                                    <field name="stage"/>
                                    <field name="approver_id"/>
                                    <field name="status"/>
                                    <field name="date"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_order_search" model="ir.ui.view">
        <field name="name">garment.order.search</field>
        <field name="model">garment.order</field>
        <field name="arch" type="xml">
            <search string="Search Orders">
                <field name="name"/>
                <field name="buyer_po_number"/>
                <field name="buyer_id"/>
                <field name="style_id"/>
                <field name="merchandiser_id"/>
                <field name="factory"/>
                <filter string="My Orders" name="my_orders" domain="[('merchandiser_id', '=', uid)]"/>
                <filter string="Active" name="active_orders"
                        domain="[('state', 'not in', ('closed', 'cancelled'))]"/>
                <filter string="Delayed" name="delayed_orders" domain="[('delay_ids.status', '!=', 'resolved')]"/>
                <filter string="High / Critical Risk" name="high_risk" domain="[('risk_level', 'in', ('high','critical'))]"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="state_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Production Running" name="state_production"
                        domain="[('state', '=', 'production_running')]"/>
                <filter string="Shipped" name="state_shipped" domain="[('state', '=', 'shipped')]"/>
                <group expand="0" string="Group By">
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Merchandiser" name="group_merchandiser" context="{'group_by': 'merchandiser_id'}"/>
                    <filter string="Risk Level" name="group_risk" context="{'group_by': 'risk_level'}"/>
                    <filter string="Buyer Country" name="group_country" context="{'group_by': 'buyer_country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">garment.order</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_garment_order_search"/>
        <field name="context">{'search_default_active_orders': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create a new Buyer Order</p>
            <p>Register a buyer PO here and drive it through confirmation, TNA, material planning,
                production, quality and shipment to closure.</p>
        </field>
    </record>

</odoo>
