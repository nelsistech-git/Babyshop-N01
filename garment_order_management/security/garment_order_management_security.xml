<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_order" model="ir.module.category">
            <field name="name">Smart Garment ERP - Order Management</field>
            <field name="sequence">60</field>
        </record>

        <record id="group_order_merchandiser" model="res.groups">
            <field name="name">Merchandiser (Manage Assigned Orders)</field>
            <field name="category_id" ref="module_category_garment_order"/>
        </record>

        <record id="group_order_department_manager" model="res.groups">
            <field name="name">Department Manager (Costing / Planning / Purchase / Production / QA / Commercial / Finance)</field>
            <field name="category_id" ref="module_category_garment_order"/>
            <field name="comment">Covers Costing Manager, Planning Manager, Purchase Manager, Production Manager,
                QA Manager, Commercial Manager and Finance Manager (SRS section 5/42): each updates their own
                domain data on the order and approves their workflow stage.</field>
        </record>

        <record id="group_order_sales_manager" model="res.groups">
            <field name="name">Sales / Merchandising Manager (Order Processing)</field>
            <field name="category_id" ref="module_category_garment_order"/>
            <field name="implied_ids" eval="[(4, ref('group_order_merchandiser'))]"/>
        </record>

        <record id="group_order_manager" model="res.groups">
            <field name="name">Order Manager (Full Access)</field>
            <field name="category_id" ref="module_category_garment_order"/>
            <field name="implied_ids" eval="[(4, ref('group_order_sales_manager')),
                                              (4, ref('group_order_department_manager'))]"/>
        </record>

        <record id="group_order_top_management" model="res.groups">
            <field name="name">Managing Director (Full Dashboard)</field>
            <field name="category_id" ref="module_category_garment_order"/>
            <field name="implied_ids" eval="[(4, ref('group_order_manager'))]"/>
        </record>

        <!-- Record Rules (SRS section 43) -->

        <record id="rule_garment_order_merchandiser_assigned" model="ir.rule">
            <field name="name">Merchandiser: Assigned Orders / Buyers Only</field>
            <field name="model_id" ref="model_garment_order"/>
            <field name="domain_force">['|', ('merchandiser_id', '=', user.id),
                                        ('buyer_id.assigned_merchandiser_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_order_merchandiser'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_order_manager_all" model="ir.rule">
            <field name="name">Order Manager: All Orders</field>
            <field name="model_id" ref="model_garment_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_order_manager')), (4, ref('group_order_department_manager'))]"/>
        </record>

        <record id="rule_garment_order_portal_own" model="ir.rule">
            <field name="name">Buyer Portal: Own Orders Only</field>
            <field name="model_id" ref="model_garment_order"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
