<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_real_estate_work_package_tree" model="ir.ui.view">
        <field name="name">real.estate.work.package.tree</field>
        <field name="model">real.estate.work.package</field>
        <field name="arch" type="xml">
            <tree string="Work Packages" decoration-success="status=='completed'" decoration-muted="status=='cancelled'">
                <field name="name"/>
                <field name="work_name"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="planned_quantity"/>
                <field name="completed_quantity"/>
                <field name="progress" widget="progressbar"/>
                <field name="status" widget="badge"
                       decoration-success="status=='completed'"
                       decoration-info="status=='in_progress'"
                       decoration-warning="status in ('draft','on_hold')"
                       decoration-muted="status=='cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_real_estate_work_package_form" model="ir.ui.view">
        <field name="name">real.estate.work.package.form</field>
        <field name="model">real.estate.work.package</field>
        <field name="arch" type="xml">
            <form string="Work Package">
                <header>
                    <button name="action_start" type="object" string="Start" class="oe_highlight"
                            invisible="status != 'draft'"/>
                    <button name="action_complete" type="object" string="Complete" class="oe_highlight"
                            invisible="status != 'in_progress'"/>
                    <button name="action_hold" type="object" string="Hold"
                            invisible="status != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="status in ('completed','cancelled')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="work_name"/>
                        <h1><field name="work_name" placeholder="e.g. Foundation - Tower A"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="project_id" required="1"/>
                            <field name="building_id"/>
                            <field name="parent_id"/>
                            <field name="contractor_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="planned_quantity"/>
                            <field name="completed_quantity"/>
                            <field name="uom_id"/>
                            <field name="progress" widget="progressbar" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="rate"/>
                            <field name="budget"/>
                        </group>
                        <group>
                            <field name="actual_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sub Work Packages">
                            <field name="child_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="work_name"/>
                                    <field name="status"/>
                                    <field name="progress" widget="progressbar"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_real_estate_work_package_search" model="ir.ui.view">
        <field name="name">real.estate.work.package.search</field>
        <field name="model">real.estate.work.package</field>
        <field name="arch" type="xml">
            <search string="Search Work Packages">
                <field name="name"/>
                <field name="work_name"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Contractor" name="group_contractor" context="{'group_by': 'contractor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_real_estate_work_package" model="ir.actions.act_window">
        <field name="name">Work Packages</field>
        <field name="res_model">real.estate.work.package</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_real_estate_work_package_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Work Package</p>
        </field>
    </record>

</odoo>
