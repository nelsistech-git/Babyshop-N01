<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_real_estate_rent_schedule_tree" model="ir.ui.view">
        <field name="name">real.estate.rent.schedule.tree</field>
        <field name="model">real.estate.rent.schedule</field>
        <field name="arch" type="xml">
            <tree string="Rent Schedule" decoration-danger="status=='overdue'" decoration-success="status=='paid'">
                <field name="display_name"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="paid_amount"/>
                <field name="due_amount"/>
                <field name="status" widget="badge"
                       decoration-success="status=='paid'"
                       decoration-danger="status=='overdue'"
                       decoration-warning="status=='partial'"/>
            </tree>
        </field>
    </record>

    <record id="view_real_estate_rent_schedule_search" model="ir.ui.view">
        <field name="name">real.estate.rent.schedule.search</field>
        <field name="model">real.estate.rent.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Rent Schedule">
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="rental_agreement_id"/>
                <filter string="Overdue" name="filter_overdue" domain="[('status','=','overdue')]"/>
                <filter string="Due" name="filter_due" domain="[('status','=','due')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Tenant" name="group_tenant" context="{'group_by': 'tenant_id'}"/>
                    <filter string="Rental Agreement" name="group_rental" context="{'group_by': 'rental_agreement_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_real_estate_rent_schedule" model="ir.actions.act_window">
        <field name="name">Rent Schedule</field>
        <field name="res_model">real.estate.rent.schedule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_real_estate_rent_schedule_search"/>
        <field name="context">{'search_default_filter_overdue': 1}</field>
    </record>

</odoo>
