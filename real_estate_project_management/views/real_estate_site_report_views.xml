<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_real_estate_site_report_tree" model="ir.ui.view">
        <field name="name">real.estate.site.report.tree</field>
        <field name="model">real.estate.site.report</field>
        <field name="arch" type="xml">
            <tree string="Site Daily Reports">
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="engineer_id"/>
                <field name="workers_present"/>
                <field name="progress" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <record id="view_real_estate_site_report_form" model="ir.ui.view">
        <field name="name">real.estate.site.report.form</field>
        <field name="model">real.estate.site.report</field>
        <field name="arch" type="xml">
            <form string="Site Daily Report">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="project_id" required="1"/>
                            <field name="building_id"/>
                            <field name="engineer_id"/>
                        </group>
                        <group>
                            <field name="weather"/>
                            <field name="workers_present"/>
                            <field name="contractor_id"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Details">
                            <group>
                                <field name="work_completed"/>
                                <field name="materials_used"/>
                                <field name="equipment_used"/>
                            </group>
                        </page>
                        <page string="Issues">
                            <group>
                                <field name="problems"/>
                                <field name="safety_issues"/>
                            </group>
                        </page>
                        <page string="Photos">
                            <field name="photo_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Remarks">
                            <field name="remarks"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_real_estate_site_report_search" model="ir.ui.view">
        <field name="name">real.estate.site.report.search</field>
        <field name="model">real.estate.site.report</field>
        <field name="arch" type="xml">
            <search string="Search Site Reports">
                <field name="name"/>
                <field name="project_id"/>
                <field name="engineer_id"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_real_estate_site_report" model="ir.actions.act_window">
        <field name="name">Site Daily Reports</field>
        <field name="res_model">real.estate.site.report</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_real_estate_site_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Site Daily Report</p>
        </field>
    </record>

</odoo>
