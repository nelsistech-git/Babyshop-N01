<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Role dashboards: first menu entry of the app for these users ===== -->
    <menuitem id="menu_real_estate_customer_dashboard"
              name="My Dashboard"
              parent="menu_real_estate_root"
              action="action_server_customer_dashboard"
              sequence="1"
              groups="real_estate_project_management.group_real_estate_customer_portal"/>

    <menuitem id="menu_real_estate_agent_dashboard"
              name="Agent Dashboard"
              parent="menu_real_estate_root"
              action="action_server_agent_dashboard"
              sequence="1"
              groups="real_estate_project_management.group_real_estate_agent"/>

    <!-- ===== Agent CRM (agents see only their own leads; staff see all) ===== -->
    <menuitem id="menu_real_estate_crm_root"
              name="Agent CRM"
              parent="menu_real_estate_root"
              sequence="6"/>

    <menuitem id="menu_real_estate_crm_leads"
              name="Leads &amp; Customer Follow-up"
              parent="menu_real_estate_crm_root"
              action="action_real_estate_agent_lead"
              sequence="10"/>

    <!-- ===== Staff: agents, commission, rules ===== -->
    <menuitem id="menu_real_estate_agent_root"
              name="Agents &amp; Commission"
              parent="menu_real_estate_root"
              sequence="55"
              groups="real_estate_project_management.group_real_estate_user"/>

    <menuitem id="menu_real_estate_agents"
              name="Agents"
              parent="menu_real_estate_agent_root"
              action="action_real_estate_agent_partner"
              sequence="10"/>

    <menuitem id="menu_real_estate_commissions"
              name="Commissions"
              parent="menu_real_estate_agent_root"
              action="action_real_estate_commission"
              sequence="20"/>

    <menuitem id="menu_real_estate_commission_rules"
              name="Commission Rules (2 Layers)"
              parent="menu_real_estate_agent_root"
              action="action_real_estate_commission_rule"
              sequence="30"
              groups="real_estate_project_management.group_real_estate_sales_manager"/>

</odoo>
