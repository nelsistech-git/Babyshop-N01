        <record id="rule_real_estate_agent_lead_company" model="ir.rule">
            <field name="name">Agent CRM Lead: Multi-Company</field>
            <field name="model_id" ref="model_real_estate_agent_lead"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- An agent sees / edits ONLY his own CRM leads ... -->
        <record id="rule_real_estate_agent_lead_agent" model="ir.rule">
            <field name="name">Agent CRM Lead: agent sees own leads only</field>
            <field name="model_id" ref="model_real_estate_agent_lead"/>
            <field name="groups" eval="[(4, ref('group_real_estate_agent'))]"/>
            <field name="domain_force">[('agent_id', '=', user.partner_id.id)]</field>
        </record>
        <!-- ... while the sales team (and anyone who is also agent + sales manager) sees all -->
        <record id="rule_real_estate_agent_lead_manager" model="ir.rule">
            <field name="name">Agent CRM Lead: sales manager sees all</field>
            <field name="model_id" ref="model_real_estate_agent_lead"/>
            <field name="groups" eval="[(4, ref('group_real_estate_sales_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_real_estate_agent_lead_log_agent" model="ir.rule">
            <field name="name">Agent CRM Log: agent sees own logs only</field>
            <field name="model_id" ref="model_real_estate_agent_lead_log"/>
            <field name="groups" eval="[(4, ref('group_real_estate_agent'))]"/>
            <field name="domain_force">[('lead_id.agent_id', '=', user.partner_id.id)]</field>
        </record>
        <record id="rule_real_estate_agent_lead_log_manager" model="ir.rule">
            <field name="name">Agent CRM Log: sales manager sees all</field>
            <field name="model_id" ref="model_real_estate_agent_lead_log"/>
            <field name="groups" eval="[(4, ref('group_real_estate_sales_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Contacts: customers and agents may only see themselves, the company
             and staff partners (so names of salespeople still display) -
             plus, for an agent, the customers he referred. -->
        <record id="rule_res_partner_customer_own" model="ir.rule">
            <field name="name">Contacts: customer sees only himself</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('group_real_estate_customer_portal'))]"/>
            <field name="domain_force">['|', '|', ('id', '=', user.partner_id.id), ('id', '=', user.company_id.partner_id.id), ('partner_share', '=', False)]</field>
        </record>
        <record id="rule_res_partner_agent_own" model="ir.rule">
            <field name="name">Contacts: agent sees himself and his referred customers</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('group_real_estate_agent'))]"/>
            <field name="domain_force">['|', '|', '|', ('id', '=', user.partner_id.id), ('id', '=', user.company_id.partner_id.id), ('partner_share', '=', False), ('referred_by_id', '=', user.partner_id.id)]</field>
        </record>

    </data>
</odoo>
