<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_update_installment_status" model="ir.cron">
            <field name="name">Real Estate: Update Installment Due/Overdue Status</field>
            <field name="model_id" ref="model_real_estate_installment"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_all_statuses()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_update_rent_schedule_status" model="ir.cron">
            <field name="name">Real Estate: Update Rent Schedule Due/Overdue Status</field>
            <field name="model_id" ref="model_real_estate_rent_schedule"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_all_statuses()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
