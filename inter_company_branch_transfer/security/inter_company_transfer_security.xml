<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inter_company_transfer" model="ir.module.category">
        <field name="name">Inter-Company Transfer</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_inter_company_transfer_manager" model="res.groups">
        <field name="name">Inter-Company Transfer Manager</field>
        <field name="category_id" ref="module_category_inter_company_transfer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Multi-company record rule: a user only sees transfers where they
         belong to either the source or the destination company -->
    <record id="rule_inter_company_transfer_multi_company" model="ir.rule">
        <field name="name">Inter-Company Transfer: multi-company</field>
        <field name="model_id" ref="model_inter_company_transfer"/>
        <field name="domain_force">
            ['|', ('source_company_id', 'in', company_ids), ('dest_company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_inter_company_transfer_manager_all" model="ir.rule">
        <field name="name">Inter-Company Transfer: manager full access</field>
        <field name="model_id" ref="model_inter_company_transfer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_inter_company_transfer_manager'))]"/>
    </record>
</odoo>
