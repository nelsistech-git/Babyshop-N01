<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_crm_call_log" model="ir.actions.report">
        <field name="name">Call Detail Report</field>
        <field name="model">crm.call.log</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">crm_omnichannel_hub.report_crm_call_log_document</field>
        <field name="report_file">crm_omnichannel_hub.report_crm_call_log_document</field>
        <field name="binding_model_id" ref="model_crm_call_log"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Call Report - %s' % (object.display_name)</field>
    </record>

    <template id="report_crm_call_log_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Call Report</h2>
                        <table class="table table-sm" style="margin-top: 16px;">
                            <tr>
                                <td><strong>Customer</strong></td>
                                <td><span t-field="o.partner_id.name"/><span t-if="not o.partner_id" t-esc="o.partner_name"/></td>
                                <td><strong>Phone</strong></td>
                                <td><span t-field="o.phone_number"/></td>
                            </tr>
                            <tr>
                                <td><strong>Direction</strong></td>
                                <td><span t-field="o.direction"/></td>
                                <td><strong>Status</strong></td>
                                <td><span t-field="o.state"/></td>
                            </tr>
                            <tr>
                                <td><strong>Agent</strong></td>
                                <td><span t-field="o.agent_id.name"/></td>
                                <td><strong>Team</strong></td>
                                <td><span t-field="o.team_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Call Started</strong></td>
                                <td><span t-field="o.call_date"/></td>
                                <td><strong>Duration (s)</strong></td>
                                <td><span t-field="o.duration_seconds"/></td>
                            </tr>
                            <tr>
                                <td><strong>Disposition</strong></td>
                                <td><span t-field="o.disposition"/></td>
                                <td><strong>CRM Lead</strong></td>
                                <td><span t-field="o.lead_id.name"/></td>
                            </tr>
                        </table>

                        <h4 style="margin-top: 20px;">Agent Notes</h4>
                        <p t-field="o.agent_notes"/>

                        <h4 style="margin-top: 20px;">Recordings</h4>
                        <table class="table table-sm" t-if="o.recording_ids">
                            <thead>
                                <tr><th>Date</th><th>Duration (s)</th><th>File / URL</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.recording_ids" t-as="rec">
                                    <td><span t-field="rec.call_date"/></td>
                                    <td><span t-field="rec.duration_seconds"/></td>
                                    <td>
                                        <span t-if="rec.audio_filename" t-esc="rec.audio_filename"/>
                                        <span t-if="rec.recording_url" t-esc="rec.recording_url"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="not o.recording_ids" class="text-muted">No recordings attached to this call.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
