<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_omni" model="ir.module.category">
            <field name="name">Omni-Channel CRM Hub</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_omni_agent" model="res.groups">
            <field name="name">Agent</field>
            <field name="category_id" ref="module_category_omni"/>
            <field name="comment">Can only see and work on chats, calls and leads assigned to them.</field>
        </record>

        <record id="group_omni_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="module_category_omni"/>
            <field name="implied_ids" eval="[(4, ref('group_omni_agent'))]"/>
            <field name="comment">Can view and monitor all conversations for their sales team.</field>
        </record>

        <record id="group_omni_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_omni"/>
            <field name="implied_ids" eval="[(4, ref('group_omni_supervisor'))]"/>
            <field name="comment">Full access to all conversations, configuration and reports.</field>
        </record>

    </data>
</odoo>
