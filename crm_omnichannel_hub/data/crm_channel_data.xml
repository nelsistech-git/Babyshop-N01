<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="channel_facebook" model="crm.channel">
            <field name="name">Facebook Messenger</field>
            <field name="code">facebook</field>
            <field name="icon">fa-facebook</field>
            <field name="color">4</field>
            <field name="sequence">10</field>
        </record>

        <record id="channel_instagram" model="crm.channel">
            <field name="name">Instagram</field>
            <field name="code">instagram</field>
            <field name="icon">fa-instagram</field>
            <field name="color">6</field>
            <field name="sequence">20</field>
        </record>

        <record id="channel_whatsapp" model="crm.channel">
            <field name="name">WhatsApp</field>
            <field name="code">whatsapp</field>
            <field name="icon">fa-whatsapp</field>
            <field name="color">3</field>
            <field name="sequence">30</field>
        </record>

        <record id="channel_call" model="crm.channel">
            <field name="name">IP Calling</field>
            <field name="code">call</field>
            <field name="icon">fa-phone</field>
            <field name="color">2</field>
            <field name="sequence">40</field>
        </record>

        <record id="default_sla_policy" model="crm.sla">
            <field name="name">Default SLA (All Channels)</field>
            <field name="green_minutes">1</field>
            <field name="yellow_minutes">2</field>
            <field name="red_minutes">5</field>
        </record>

    </data>
</odoo>
