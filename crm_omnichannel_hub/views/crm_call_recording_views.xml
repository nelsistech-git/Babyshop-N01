<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_call_recording_tree" model="ir.ui.view">
        <field name="name">crm.call.recording.tree</field>
        <field name="model">crm.call.recording</field>
        <field name="arch" type="xml">
            <tree string="Call Recordings">
                <field name="call_date"/>
                <field name="display_name"/>
                <field name="partner_id"/>
                <field name="agent_id"/>
                <field name="duration_seconds"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_call_recording_form" model="ir.ui.view">
        <field name="name">crm.call.recording.form</field>
        <field name="model">crm.call.recording</field>
        <field name="arch" type="xml">
            <form string="Call Recording">
                <header>
                    <button name="action_download" type="object" string="Download / Play" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="call_id"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="agent_id" readonly="1"/>
                        <field name="call_date" readonly="1"/>
                        <field name="duration_seconds"/>
                    </group>
                    <group string="Storage">
                        <field name="audio_file" filename="audio_filename"/>
                        <field name="audio_filename" invisible="1"/>
                        <field name="recording_url" placeholder="https://..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_call_recording" model="ir.actions.act_window">
        <field name="name">Call Recordings</field>
        <field name="res_model">crm.call.recording</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
