<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_channel_tree" model="ir.ui.view">
        <field name="name">crm.channel.tree</field>
        <field name="model">crm.channel</field>
        <field name="arch" type="xml">
            <tree string="Channels">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="account_identifier"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_channel_form" model="ir.ui.view">
        <field name="name">crm.channel.form</field>
        <field name="model">crm.channel</field>
        <field name="arch" type="xml">
            <form string="Channel">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="icon"/>
                        <field name="color"/>
                        <field name="account_identifier"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_channel" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">crm.channel</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
