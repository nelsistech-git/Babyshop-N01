<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_communication_tag_list" model="ir.ui.view">
        <field name="name">crm.communication.tag.tree</field>
        <field name="model">crm.communication.tag</field>
        <field name="arch" type="xml">
            <tree string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="action_crm_communication_tag" model="ir.actions.act_window">
        <field name="name">Communication Tags</field>
        <field name="res_model">crm.communication.tag</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
