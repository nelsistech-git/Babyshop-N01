<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_crm_call_log_tree" model="ir.ui.view">
        <field name="name">crm.call.log.tree</field>
        <field name="model">crm.call.log</field>
        <field name="arch" type="xml">
            <tree string="Calls" decoration-danger="state in ('missed', 'rejected')"
                  decoration-success="state == 'completed'"
                  decoration-warning="state in ('ringing', 'on_hold')">
                <field name="call_date"/>
                <field name="display_name" string="Customer"/>
                <field name="direction"/>
                <field name="agent_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state in ('ringing', 'on_hold')"
                       decoration-success="state in ('answered', 'completed')"
                       decoration-danger="state in ('missed', 'rejected')"/>
                <field name="duration_seconds"/>
                <field name="disposition" optional="show"/>
                <field name="recording_count" optional="hide"/>
                <field name="lead_id" optional="hide"/>
                <field name="customer_rating" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- KANBAN VIEW (Call Center Board) -->
    <record id="view_crm_call_log_kanban" model="ir.ui.view">
        <field name="name">crm.call.log.kanban</field>
        <field name="model">crm.call.log</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state">
                <field name="display_name"/>
                <field name="direction"/>
                <field name="state"/>
                <field name="duration_seconds"/>
                <field name="agent_id"/>
                <field name="call_date"/>
                <field name="disposition"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span t-esc="record.display_name.value"/>
                                    </strong>
                                    <span class="badge rounded-pill ms-1" t-esc="record.direction.value"/>
                                </div>
                            </div>
                            <div class="text-muted">
                                <span t-esc="record.call_date.value"/>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <span t-if="record.disposition.value" class="badge bg-secondary">
                                        <t t-esc="record.disposition.value"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="agent_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_crm_call_log_form" model="ir.ui.view">
        <field name="name">crm.call.log.form</field>
        <field name="model">crm.call.log</field>
        <field name="arch" type="xml">
            <form string="Call">
                <header>
                    <button name="action_answer" type="object" string="Answer"
                            invisible="state != 'ringing'" class="btn-primary"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'ringing'" class="btn-secondary"/>
                    <button name="action_hold" type="object" string="Hold"
                            invisible="state != 'answered'" class="btn-secondary"/>
                    <button name="action_resume" type="object" string="Resume"
                            invisible="state != 'on_hold'" class="btn-secondary"/>
                    <button name="action_complete" type="object" string="Complete"
                            invisible="state not in ('answered', 'on_hold')" class="btn-primary"/>
                    <button name="action_mark_missed" type="object" string="Mark Missed"
                            invisible="state not in ('new', 'ringing')" class="btn-secondary"/>
                    <button name="action_request_csat" type="object" string="Request Feedback"
                            invisible="not partner_id or customer_rating" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,ringing,answered,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="lead_id" invisible="1"/>
                        <button name="action_view_lead" type="object" class="oe_stat_button" icon="fa-address-card"
                                invisible="not lead_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">CRM Lead</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="partner_name"/>
                            <field name="phone_number"/>
                            <field name="external_call_id"/>
                        </group>
                        <group string="Routing">
                            <field name="channel_id"/>
                            <field name="direction"/>
                            <field name="agent_id"/>
                            <field name="team_id"/>
                            <field name="transferred_to_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <group string="Timing">
                            <field name="call_date"/>
                            <field name="answered_date"/>
                            <field name="end_date"/>
                            <field name="duration_seconds"/>
                            <field name="hold_count"/>
                            <field name="is_conference"/>
                        </group>
                        <group string="After Call Work">
                            <field name="disposition"/>
                            <field name="agent_notes"/>
                        </group>
                    </group>
                    <group>
                        <group string="Customer Satisfaction">
                            <field name="customer_rating"/>
                            <field name="customer_feedback"/>
                            <field name="csat_requested_date" readonly="1"/>
                            <field name="csat_submitted_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recordings">
                            <field name="recording_ids">
                                <tree editable="bottom">
                                    <field name="call_date" readonly="1"/>
                                    <field name="duration_seconds"/>
                                    <field name="audio_file" filename="audio_filename"/>
                                    <field name="audio_filename" invisible="1"/>
                                    <field name="recording_url"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_crm_call_log_search" model="ir.ui.view">
        <field name="name">crm.call.log.search</field>
        <field name="model">crm.call.log</field>
        <field name="arch" type="xml">
            <search string="Search Calls">
                <field name="display_name" string="Customer"/>
                <field name="phone_number"/>
                <field name="lead_id" string="Lead"/>
                <field name="agent_id"/>
                <separator/>
                <filter string="Incoming" name="filter_inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter string="Outgoing" name="filter_outbound" domain="[('direction', '=', 'outbound')]"/>
                <separator/>
                <filter string="Missed" name="filter_missed" domain="[('state', '=', 'missed')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Active Now" name="filter_active" domain="[('state', 'in', ('ringing', 'answered', 'on_hold'))]"/>
                <separator/>
                <filter string="My Calls" name="filter_my_calls" domain="[('agent_id', '=', uid)]"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('call_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="This Week" name="filter_this_week"
                        domain="[('call_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Agent" name="groupby_agent" context="{'group_by': 'agent_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Disposition" name="groupby_disposition" context="{'group_by': 'disposition'}"/>
                    <filter string="Direction" name="groupby_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Call Date" name="groupby_call_date" date="call_date"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_crm_call_log" model="ir.actions.act_window">
        <field name="name">Call Center</field>
        <field name="res_model">crm.call.log</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_crm_call_log_search"/>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No calls logged yet.
            </p>
            <p>
                Calls will appear here automatically once the IP Calling connector
                is installed and configured, or you can log calls manually / use
                Click-to-Call from a Contact or Lead.
            </p>
        </field>
    </record>

</odoo>
