<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_omni_dashboard_executive" model="ir.actions.client">
        <field name="name">Executive Dashboard</field>
        <field name="tag">crm_omni_dashboard</field>
        <field name="context" eval="{'dashboard_type': 'executive'}"/>
    </record>

    <record id="action_omni_dashboard_manager" model="ir.actions.client">
        <field name="name">Manager Dashboard</field>
        <field name="tag">crm_omni_dashboard</field>
        <field name="context" eval="{'dashboard_type': 'manager'}"/>
    </record>

    <record id="action_omni_dashboard_agent" model="ir.actions.client">
        <field name="name">My Dashboard</field>
        <field name="tag">crm_omni_dashboard</field>
        <field name="context" eval="{'dashboard_type': 'agent'}"/>
    </record>

    <menuitem id="menu_omni_dashboard_agent" name="My Dashboard" parent="menu_omni_root"
              action="action_omni_dashboard_agent" sequence="1"
              groups="crm_omnichannel_hub.group_omni_agent"/>

    <menuitem id="menu_omni_dashboard_manager" name="Manager Dashboard" parent="menu_omni_root"
              action="action_omni_dashboard_manager" sequence="2"
              groups="crm_omnichannel_hub.group_omni_supervisor"/>

    <menuitem id="menu_omni_dashboard_executive" name="Executive Dashboard" parent="menu_omni_root"
              action="action_omni_dashboard_executive" sequence="3"
              groups="crm_omnichannel_hub.group_omni_manager"/>

</odoo>
