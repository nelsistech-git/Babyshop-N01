<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_bond_receipt" model="ir.sequence">
        <field name="name">Bond Receipt</field>
        <field name="code">bond.inventory.receipt</field>
        <field name="prefix">BRC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_consignment" model="ir.sequence">
        <field name="name">Bond Consignment</field>
        <field name="code">bond.inventory.consignment</field>
        <field name="prefix">BCN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bond_classification_request" model="ir.sequence">
        <field name="name">Bond Classification Request</field>
        <field name="code">bond.inventory.classification.request</field>
        <field name="prefix">BCR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
