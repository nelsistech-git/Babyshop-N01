<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Generic document types only. "Required for bonded receipts" is intentionally left off:
         requirements must be configured after regulatory review by a qualified customs professional. -->
    <record id="doc_type_lc_copy" model="bond.inventory.document.type">
        <field name="name">LC Copy</field><field name="code">LC</field><field name="sequence">10</field>
    </record>
    <record id="doc_type_bill_of_entry" model="bond.inventory.document.type">
        <field name="name">Bill of Entry</field><field name="code">BOE</field><field name="sequence">20</field>
    </record>
    <record id="doc_type_invoice" model="bond.inventory.document.type">
        <field name="name">Commercial Invoice</field><field name="code">INV</field><field name="sequence">30</field>
    </record>
    <record id="doc_type_packing_list" model="bond.inventory.document.type">
        <field name="name">Packing List</field><field name="code">PL</field><field name="sequence">40</field>
    </record>
    <record id="doc_type_transport" model="bond.inventory.document.type">
        <field name="name">Bill of Lading / Airway Bill</field><field name="code">BL</field><field name="sequence">50</field>
    </record>
    <record id="doc_type_origin" model="bond.inventory.document.type">
        <field name="name">Certificate of Origin</field><field name="code">COO</field><field name="sequence">60</field>
    </record>
    <record id="doc_type_other" model="bond.inventory.document.type">
        <field name="name">Other Supporting Document</field><field name="code">OTH</field><field name="sequence">99</field>
    </record>
</odoo>
