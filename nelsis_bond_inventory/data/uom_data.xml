<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Leather area units in their own category: no implicit conversion from pieces or kilograms. -->
    <record id="uom_categ_leather_area" model="uom.category">
        <field name="name">Leather Area</field>
    </record>
    <record id="uom_sqm_leather" model="uom.uom">
        <field name="name">Square Meter (sqm)</field>
        <field name="category_id" ref="uom_categ_leather_area"/>
        <field name="uom_type">reference</field>
        <field name="factor" eval="1.0"/>
        <field name="rounding" eval="0.001"/>
    </record>
    <record id="uom_sqft_leather" model="uom.uom">
        <field name="name">Square Foot (sqft)</field>
        <field name="category_id" ref="uom_categ_leather_area"/>
        <field name="uom_type">smaller</field>
        <field name="factor" eval="10.7639104167"/>
        <field name="rounding" eval="0.001"/>
    </record>
</odoo>
