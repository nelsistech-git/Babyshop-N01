<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bond_receipt_tree" model="ir.ui.view">
        <field name="name">bond.inventory.receipt.tree</field>
        <field name="model">bond.inventory.receipt</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'done'" decoration-danger="state in ('rejected', 'cancelled')"
                  decoration-info="state == 'approval'">
                <field name="name"/>
                <field name="receipt_date"/>
                <field name="partner_id"/>
                <field name="bond_status"/>
                <field name="lc_label"/>
                <field name="boe_number"/>
                <field name="location_dest_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_bond_receipt_form" model="ir.ui.view">
        <field name="name">bond.inventory.receipt.form</field>
        <field name="model">bond.inventory.receipt</field>
        <field name="arch" type="xml">
            <form class="nl-ui">
                <header>
                    <button name="action_submit_verification" type="object" string="Submit for Document Verification"
                            class="btn-primary nl-btn nl-success" invisible="state != 'draft'" icon="fa-check-circle"/>
                    <button name="action_verify_documents" type="object" string="Documents Verified"
                            class="btn-primary nl-btn nl-success" invisible="state != 'doc_verification'" icon="fa-check-circle"/>
                    <button name="action_mark_all_inspected" type="object" string="Mark All Lines Inspected"
                            invisible="state != 'inspection'" class="nl-btn nl-success" icon="fa-check-circle"/>
                    <button name="action_complete_inspection" type="object" string="Complete Inspection"
                            class="btn-primary nl-btn nl-success" invisible="state != 'inspection'" icon="fa-check-circle"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary nl-btn nl-success"
                            invisible="state != 'approval'" groups="nelsis_bond_inventory.group_bond_inventory_approver" icon="fa-thumbs-up"/>
                    <button name="action_validate" type="object" string="Validate Receipt" class="btn-primary nl-btn nl-success"
                            invisible="state != 'ready'"
                            confirm="Stock will be posted to the receiving location. Continue?" icon="fa-check-circle"/>
                    <button name="action_return" type="object" string="Return" invisible="state != 'done'" class="nl-btn nl-warning" icon="fa-reply"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('doc_verification', 'inspection', 'approval')" class="nl-btn nl-danger" icon="fa-times-circle"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'doc_verification', 'inspection', 'approval', 'ready')" class="nl-btn nl-danger" icon="fa-ban"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')" class="nl-btn nl-neutral" icon="fa-undo"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,doc_verification,inspection,approval,ready,done" class="nl-statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object" class="oe_stat_button nl-stat" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfer"/>
                        </button>
                        <button name="action_view_returns" type="object" class="oe_stat_button nl-stat" icon="fa-undo"
                                invisible="return_count == 0">
                            <field name="return_count" widget="statinfo" string="Returns"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group name="main">
                            <field name="bond_status" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="consignment_id" readonly="state != 'draft'"/>
                            <field name="picking_type_id" readonly="state != 'draft'"/>
                            <field name="location_dest_id" readonly="state != 'draft'"/>
                            <field name="receipt_date" readonly="state != 'draft'"/>
                        </group>
                        <group name="customs" string="LC &amp; Customs">
                            <field name="lc_ref" readonly="state not in ('draft', 'doc_verification')"/>
                            <field name="lc_number" readonly="state not in ('draft', 'doc_verification')"/>
                            <field name="boe_number" readonly="state not in ('draft', 'doc_verification')"/>
                            <field name="boe_date" readonly="state not in ('draft', 'doc_verification')"/>
                            <field name="customs_ref" readonly="state not in ('draft', 'doc_verification')"/>
                            <field name="approval_required"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="state not in ('doc_verification', 'inspection', 'approval', 'rejected')">
                        <field name="reject_reason" placeholder="Required when rejecting the receipt"
                               readonly="state == 'rejected'"/>
                    </group>
                    <notebook>
                        <page string="Receipt Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="consignment_line_id" optional="hide"
                                           domain="[('consignment_id', '=', parent.consignment_id)]"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="product_id" readonly="parent.state != 'draft'"/>
                                    <field name="product_tracking" column_invisible="1"/>
                                    <field name="requires_expiry" column_invisible="1"/>
                                    <field name="hs_code" readonly="parent.state not in ('draft', 'doc_verification')"/>
                                    <field name="product_uom_id" readonly="parent.state != 'draft'"/>
                                    <field name="declared_qty" readonly="parent.state != 'draft'"/>
                                    <field name="received_qty" readonly="parent.state != 'inspection'"/>
                                    <field name="damaged_qty" readonly="parent.state != 'inspection'"/>
                                    <field name="rejected_qty" readonly="parent.state != 'inspection'"/>
                                    <field name="accepted_qty"/>
                                    <field name="shortage_qty"/>
                                    <field name="excess_qty"/>
                                    <field name="lot_name" readonly="parent.state != 'inspection'"
                                           required="product_tracking != 'none' and accepted_qty > 0 and parent.state == 'inspection'"/>
                                    <field name="expiry_date" readonly="parent.state != 'inspection'"
                                           required="requires_expiry and accepted_qty > 0 and parent.state == 'inspection'"/>
                                    <field name="measure_qty" optional="show" readonly="parent.state != 'inspection'"/>
                                    <field name="measure_uom_id" optional="show" readonly="parent.state != 'inspection'"/>
                                    <field name="disposition_note" optional="hide" readonly="parent.state != 'inspection'"/>
                                    <field name="inspected" readonly="parent.state != 'inspection'"/>
                                    <field name="inspection_result" widget="badge"/>
                                    <field name="lot_id" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Customs Documents" name="documents">
                            <field name="document_ids">
                                <tree editable="bottom">
                                    <field name="type_id"/>
                                    <field name="reference"/>
                                    <field name="document_date"/>
                                    <field name="customs_ref" optional="hide"/>
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                    <field name="verified"/>
                                    <field name="verified_by" optional="hide"/>
                                    <field name="verified_on" optional="hide"/>
                                    <button name="action_verify" type="object" string="Verify" icon="fa-check"
                                            invisible="verified" class="nl-btn nl-success"/>
                                    <button name="action_reset_verification" type="object" string="Reset"
                                            icon="fa-undo" invisible="not verified" class="nl-btn nl-neutral"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Audit Trail" name="audit">
                            <group>
                                <group>
                                    <field name="doc_verified_by"/>
                                    <field name="doc_verified_on"/>
                                    <field name="inspected_by"/>
                                    <field name="inspected_on"/>
                                </group>
                                <group>
                                    <field name="approved_by"/>
                                    <field name="approved_on"/>
                                    <field name="validated_by"/>
                                    <field name="validated_on"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_bond_receipt_search" model="ir.ui.view">
        <field name="name">bond.inventory.receipt.search</field>
        <field name="model">bond.inventory.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lc_number"/>
                <field name="boe_number"/>
                <field name="location_dest_id"/>
                <filter name="bonded" string="Bonded" domain="[('bond_status', '=', 'bonded')]"/>
                <filter name="non_bonded" string="Non-Bonded" domain="[('bond_status', '=', 'non_bonded')]"/>
                <separator/>
                <filter name="open" string="In Progress"
                        domain="[('state', 'in', ('draft', 'doc_verification', 'inspection', 'approval', 'ready'))]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Supplier" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_boe" string="Bill of Entry" context="{'group_by': 'boe_number'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bond_receipt" model="ir.actions.act_window">
        <field name="name">Bond Receipts</field>
        <field name="res_model">bond.inventory.receipt</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bond_receipt_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
