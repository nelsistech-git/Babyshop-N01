<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bond_class_request_tree" model="ir.ui.view">
        <field name="name">bond.inventory.classification.request.tree</field>
        <field name="model">bond.inventory.classification.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="target_type"/>
                <field name="location_id" optional="show"/>
                <field name="product_tmpl_id" optional="show"/>
                <field name="lot_id" optional="show"/>
                <field name="current_status"/>
                <field name="new_status"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_bond_class_request_form" model="ir.ui.view">
        <field name="name">bond.inventory.classification.request.form</field>
        <field name="model">bond.inventory.classification.request</field>
        <field name="arch" type="xml">
            <form class="nl-ui">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary nl-btn nl-primary"
                            invisible="state != 'draft'" icon="fa-paper-plane"/>
                    <button name="action_approve" type="object" string="Approve &amp; Apply" class="btn-primary nl-btn nl-success"
                            invisible="state != 'submitted'"
                            groups="nelsis_bond_inventory.group_bond_inventory_approver"
                            confirm="The classification will be changed immediately. Continue?" icon="fa-thumbs-up"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'"
                            groups="nelsis_bond_inventory.group_bond_inventory_approver" class="nl-btn nl-danger" icon="fa-times-circle"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'rejected'" class="nl-btn nl-neutral" icon="fa-undo"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,applied" class="nl-statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="target_type" readonly="state != 'draft'"/>
                            <field name="location_id" invisible="target_type != 'location'"
                                   required="target_type == 'location'" readonly="state != 'draft'"/>
                            <field name="product_tmpl_id" invisible="target_type != 'product'"
                                   required="target_type == 'product'" readonly="state != 'draft'"/>
                            <field name="lot_id" invisible="target_type != 'lot'"
                                   required="target_type == 'lot'" readonly="state != 'draft'"/>
                            <field name="current_status"/>
                            <field name="new_status" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="license_ref" invisible="target_type != 'location' or new_status != 'bonded'"
                                   readonly="state != 'draft'"/>
                            <field name="authorized_from" invisible="target_type != 'location' or new_status != 'bonded'"
                                   readonly="state != 'draft'"/>
                            <field name="authorized_to" invisible="target_type != 'location' or new_status != 'bonded'"
                                   readonly="state != 'draft'"/>
                            <field name="requested_by"/>
                            <field name="decided_by"/>
                            <field name="decided_on"/>
                            <field name="company_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="state != 'draft'"/>
                        <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                        <field name="rejection_reason" invisible="state not in ('submitted', 'rejected')"
                               readonly="state != 'submitted'"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_bond_class_request" model="ir.actions.act_window">
        <field name="name">Classification Requests</field>
        <field name="res_model">bond.inventory.classification.request</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
