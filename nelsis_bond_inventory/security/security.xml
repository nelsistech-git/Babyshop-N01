<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bond_inventory" model="ir.module.category">
        <field name="name">Bonded Inventory</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_bond_inventory_user" model="res.groups">
        <field name="name">Bond Receipt Officer</field>
        <field name="category_id" ref="module_category_bond_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_bond_inventory_inspector" model="res.groups">
        <field name="name">Bond Inspector / Document Verifier</field>
        <field name="category_id" ref="module_category_bond_inventory"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_inventory_user'))]"/>
    </record>
    <record id="group_bond_inventory_approver" model="res.groups">
        <field name="name">Bond Approver</field>
        <field name="category_id" ref="module_category_bond_inventory"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_inventory_inspector'))]"/>
    </record>
    <record id="group_bond_inventory_manager" model="res.groups">
        <field name="name">Bond Inventory Manager</field>
        <field name="category_id" ref="module_category_bond_inventory"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_inventory_approver')), (4, ref('stock.group_stock_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_bond_receipt_company" model="ir.rule">
        <field name="name">Bond Receipt: multi-company</field>
        <field name="model_id" ref="model_bond_inventory_receipt"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_receipt_line_company" model="ir.rule">
        <field name="name">Bond Receipt Line: multi-company</field>
        <field name="model_id" ref="model_bond_inventory_receipt_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_receipt_document_company" model="ir.rule">
        <field name="name">Bond Receipt Document: multi-company</field>
        <field name="model_id" ref="model_bond_inventory_receipt_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_consignment_company" model="ir.rule">
        <field name="name">Bond Consignment: multi-company</field>
        <field name="model_id" ref="model_bond_inventory_consignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_consignment_line_company" model="ir.rule">
        <field name="name">Bond Consignment Line: multi-company</field>
        <field name="model_id" ref="model_bond_inventory_consignment_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_class_request_company" model="ir.rule">
        <field name="name">Bond Classification Request: multi-company</field>
        <field name="model_id" ref="model_bond_inventory_classification_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bond_stock_report_company" model="ir.rule">
        <field name="name">Bond Stock Report: multi-company</field>
        <field name="model_id" ref="model_bond_inventory_stock_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
