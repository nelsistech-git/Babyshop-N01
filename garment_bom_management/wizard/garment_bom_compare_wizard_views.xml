<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_bom_compare_wizard_form" model="ir.ui.view">
        <field name="name">garment.bom.compare.wizard.form</field>
        <field name="model">garment.bom.compare.wizard</field>
        <field name="arch" type="xml">
            <form string="Compare BOM Versions">
                <group>
                    <field name="bom_id_1"/>
                    <field name="bom_id_2"/>
                </group>
                <field name="comparison_result" invisible="not comparison_result"/>
                <footer>
                    <button name="action_compare" type="object" string="Compare" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
