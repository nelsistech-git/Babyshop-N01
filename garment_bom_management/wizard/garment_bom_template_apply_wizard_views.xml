<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_bom_template_apply_wizard_form" model="ir.ui.view">
        <field name="name">garment.bom.template.apply.wizard.form</field>
        <field name="model">garment.bom.template.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply BOM Template">
                <group>
                    <field name="bom_id"/>
                    <field name="template_id"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_garment_bom_template_apply_wizard" model="ir.actions.act_window">
        <field name="name">Apply BOM Template</field>
        <field name="res_model">garment.bom.template.apply.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_garment_bom"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
