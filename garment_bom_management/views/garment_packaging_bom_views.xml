<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_packaging_bom_tree" model="ir.ui.view">
        <field name="name">garment.packaging.bom.tree</field>
        <field name="model">garment.packaging.bom</field>
        <field name="arch" type="xml">
            <tree string="Packaging BOM">
                <field name="bom_id"/>
                <field name="packaging_type"/>
                <field name="description"/>
                <field name="required_qty"/>
                <field name="line_cost"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_packaging_bom_form" model="ir.ui.view">
        <field name="name">garment.packaging.bom.form</field>
        <field name="model">garment.packaging.bom</field>
        <field name="arch" type="xml">
            <form string="Packaging BOM Line">
                <sheet>
                    <group>
                        <group>
                            <field name="bom_id"/>
                            <field name="packaging_type"/>
                            <field name="description"/>
                            <field name="packaging_size"/>
                            <field name="dimension"/>
                            <field name="weight"/>
                            <field name="material"/>
                        </group>
                        <group>
                            <field name="supplier_id"/>
                            <field name="uom"/>
                            <field name="consumption_per_piece"/>
                            <field name="unit_price"/>
                            <field name="required_qty" readonly="1"/>
                            <field name="line_cost" readonly="1"/>
                        </group>
                    </group>
                    <group string="Buyer Requirements">
                        <field name="buyer_material_code"/>
                        <field name="is_restricted"/>
                        <field name="restriction_reason" invisible="not is_restricted"/>
                    </group>
                    <group string="Purchase Requirement">
                        <group>
                            <field name="available_stock"/>
                            <field name="incoming_stock"/>
                        </group>
                        <group>
                            <field name="safety_stock"/>
                            <field name="purchase_qty" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_packaging_bom" model="ir.actions.act_window">
        <field name="name">Packaging BOM</field>
        <field name="res_model">garment.packaging.bom</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
