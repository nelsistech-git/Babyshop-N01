<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_material_alternative_tree" model="ir.ui.view">
        <field name="name">garment.material.alternative.tree</field>
        <field name="model">garment.material.alternative</field>
        <field name="arch" type="xml">
            <tree string="Alternative Materials" editable="bottom">
                <field name="bom_id"/>
                <field name="main_material"/>
                <field name="alternative_material"/>
                <field name="buyer_approved"/>
                <field name="approval_status"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_material_alternative" model="ir.actions.act_window">
        <field name="name">Alternative Materials</field>
        <field name="res_model">garment.material.alternative</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
