<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add 'Office Vendor' field to the vendor form view -->
    <record id="view_partner_form_office_vendor" model="ir.ui.view">
        <field name="name">res.partner.form.office.vendor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_employee']" position="after">
                <field name="is_office_vendor" string="Office Vendor"/>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="type_of_work" string="Type Of Work"/>
            </xpath>
        </field>
    </record>

    <!-- Kanban View for Office Vendors -->
    <record id="view_office_vendor_kanban" model="ir.ui.view">
        <field name="name">office.vendor.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="parent_id" string="Company Name"/>
                <field name="type_of_work"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="country_id"/>
                <field name="city"/>
                <field name="image_128"/>
                <field name="supplier_rank"/>
                <field name="is_office_vendor"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image:url('#{kanban_image('res.partner', 'image_128', record.id.raw_value)}')"/>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section"/>
                                <ul>
                                    <li t-if="record.email.raw_value">
                                        <field name="email"/>
                                    </li>
                                    <li t-if="record.phone.raw_value">
                                        <field name="phone"/>
                                    </li>
                                    <li t-if="record.city.raw_value or record.country_id.raw_value">
                                        <t t-if="record.city.raw_value">
                                            <field name="city"/>,
                                        </t>
                                        <field name="country_id"/>
                                    </li>
                                </ul>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left"/>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View for Office Vendors -->
    <record id="view_office_vendor_list" model="ir.ui.view">
        <field name="name">office.vendor.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Office Vendors">
                <field name="name"/>
                <field name="parent_id" string="Company Name"/>
                <field name="type_of_work"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="is_office_vendor"/>
            </tree>
        </field>
    </record>

    <!-- Search View for Office Vendors -->
    <record id="view_office_vendor_search" model="ir.ui.view">
        <field name="name">office.vendor.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Office Vendors">
                <field name="name" string="Vendor" filter_domain="[('name', 'ilike', self)]"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="country_id"/>
                <separator/>
                <filter string="Office Vendors" name="office_vendors" domain="[('is_office_vendor', '=', True)]"/>
            </search>
        </field>
    </record>


</odoo>