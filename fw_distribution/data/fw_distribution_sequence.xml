<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fw_distribution_order" model="ir.sequence">
        <field name="name">FW Distribution Order</field>
        <field name="code">fw.distribution.order</field>
        <field name="prefix">DSO/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fw_warranty_claim" model="ir.sequence">
        <field name="name">FW Warranty Claim</field>
        <field name="code">fw.warranty.claim</field>
        <field name="prefix">WAR/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
