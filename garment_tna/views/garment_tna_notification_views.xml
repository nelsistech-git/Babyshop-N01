<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_tna_notification_tree" model="ir.ui.view">
        <field name="name">garment.tna.notification.tree</field>
        <field name="model">garment.tna.notification</field>
        <field name="arch" type="xml">
            <tree string="Notifications" decoration-muted="status == 'sent'">
                <field name="tna_id"/>
                <field name="escalation_level"/>
                <field name="channel"/>
                <field name="recipient_id"/>
                <field name="subject"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_garment_tna_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">garment.tna.notification</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
