<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_tna_template_tree" model="ir.ui.view">
        <field name="name">garment.tna.template.tree</field>
        <field name="model">garment.tna.template</field>
        <field name="arch" type="xml">
            <tree string="TNA Templates">
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="style_category_id"/>
                <field name="lead_time_days"/>
                <field name="shipment_type"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_tna_template_form" model="ir.ui.view">
        <field name="name">garment.tna.template.form</field>
        <field name="model">garment.tna.template</field>
        <field name="arch" type="xml">
            <form string="TNA Template">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="style_category_id"/>
                        </group>
                        <group>
                            <field name="lead_time_days"/>
                            <field name="shipment_type"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="activity_name"/>
                            <field name="category"/>
                            <field name="department"/>
                            <field name="days_before_shipment"/>
                            <field name="is_milestone"/>
                            <field name="dependency_type"/>
                            <field name="predecessor_line_id" domain="[('template_id', '=', parent.id)]"/>
                        </tree>
                    </field>
                    <notebook>
                        <page string="Buyer-Specific Settings">
                            <group>
                                <field name="approval_steps" placeholder="e.g. Merchandiser -> Merchandising Manager -> Buyer"/>
                                <field name="required_documents" placeholder="e.g. Lab Dip Approval Letter, Inspection Report"/>
                                <field name="escalation_rules" placeholder="Buyer-specific escalation notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_tna_template" model="ir.actions.act_window">
        <field name="name">TNA Templates</field>
        <field name="res_model">garment.tna.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
