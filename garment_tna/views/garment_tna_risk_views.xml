<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_tna_risk_tree" model="ir.ui.view">
        <field name="name">garment.tna.risk.tree</field>
        <field name="model">garment.tna.risk</field>
        <field name="arch" type="xml">
            <tree string="TNA Risks" decoration-danger="risk_level in ('high','critical')" decoration-muted="status == 'closed'">
                <field name="tna_id"/>
                <field name="risk_type"/>
                <field name="probability_pct"/>
                <field name="impact"/>
                <field name="risk_level"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_tna_risk_form" model="ir.ui.view">
        <field name="name">garment.tna.risk.form</field>
        <field name="model">garment.tna.risk</field>
        <field name="arch" type="xml">
            <form string="TNA Risk">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_close" type="object" string="Close Risk" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tna_id"/>
                            <field name="risk_type"/>
                            <field name="probability_pct"/>
                            <field name="impact"/>
                            <field name="risk_level"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="mitigation_plan"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_tna_risk" model="ir.actions.act_window">
        <field name="name">TNA Risks</field>
        <field name="res_model">garment.tna.risk</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
