<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_tna_milestone_tree" model="ir.ui.view">
        <field name="name">garment.tna.milestone.tree</field>
        <field name="model">garment.tna.milestone</field>
        <field name="arch" type="xml">
            <tree string="Milestones" editable="bottom" decoration-danger="risk_level in ('high','critical')" decoration-success="status == 'achieved'">
                <field name="tna_id"/>
                <field name="milestone_name"/>
                <field name="due_date"/>
                <field name="responsible_person_id"/>
                <field name="status"/>
                <field name="risk_level"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_tna_milestone_form" model="ir.ui.view">
        <field name="name">garment.tna.milestone.form</field>
        <field name="model">garment.tna.milestone</field>
        <field name="arch" type="xml">
            <form string="TNA Milestone">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,achieved"/>
                    <button name="action_mark_achieved" type="object" string="Mark Achieved" class="btn-primary"
                            invisible="status == 'achieved'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="milestone_name"/>
                        <h1><field name="milestone_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tna_id"/>
                            <field name="activity_id"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="responsible_person_id"/>
                            <field name="dependency"/>
                            <field name="risk_level"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_garment_tna_milestone" model="ir.actions.act_window">
        <field name="name">Milestones</field>
        <field name="res_model">garment.tna.milestone</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
