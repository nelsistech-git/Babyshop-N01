<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_tna" model="ir.sequence">
        <field name="name">Garment TNA Number</field>
        <field name="code">garment.tna</field>
        <field name="prefix">TNA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_tna_revision" model="ir.sequence">
        <field name="name">Garment TNA Revision Number</field>
        <field name="code">garment.tna.revision</field>
        <field name="prefix">TNA-REV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
