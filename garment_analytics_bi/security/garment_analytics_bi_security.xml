<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_analytics_bi" model="ir.module.category">
            <field name="name">Smart Garment ERP - Analytics &amp; BI</field>
            <field name="sequence">76</field>
        </record>

        <record id="group_bi_viewer" model="res.groups">
            <field name="name">BI Viewer (Department Manager - Read-Only)</field>
            <field name="category_id" ref="module_category_garment_analytics_bi"/>
        </record>

        <record id="group_bi_executive" model="res.groups">
            <field name="name">Executive (MD/CEO/Director - Dashboard Read-Only)</field>
            <field name="category_id" ref="module_category_garment_analytics_bi"/>
        </record>

        <record id="group_bi_analyst" model="res.groups">
            <field name="name">BI Analyst (Create/Edit KPIs &amp; Dashboards)</field>
            <field name="category_id" ref="module_category_garment_analytics_bi"/>
            <field name="implied_ids" eval="[(4, ref('group_bi_viewer'))]"/>
        </record>

        <record id="group_bi_manager" model="res.groups">
            <field name="name">BI Manager (Full Access + Report Scheduling)</field>
            <field name="category_id" ref="module_category_garment_analytics_bi"/>
            <field name="implied_ids" eval="[(4, ref('group_bi_analyst')), (4, ref('group_bi_executive'))]"/>
        </record>

    </data>
</odoo>
