<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_report_schedule_form" model="ir.ui.view">
        <field name="name">garment.report.schedule.form</field>
        <field name="model">garment.report.schedule</field>
        <field name="arch" type="xml">
            <form string="BI Report Schedule">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,paused"/>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state == 'active'"/>
                    <button name="action_pause" type="object" string="Pause" class="btn-secondary"
                            invisible="state == 'paused'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="report_category"/>
                            <field name="board_id"/>
                            <field name="kpi_ids" widget="many2many_tags"/>
                            <field name="format"/>
                        </group>
                        <group>
                            <field name="frequency"/>
                            <field name="send_time"/>
                            <field name="weekday" invisible="frequency != 'weekly'"/>
                            <field name="day_of_month" invisible="frequency not in ('monthly', 'yearly')"/>
                            <field name="next_run_date" readonly="1"/>
                            <field name="last_sent_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Delivery Channels (SRS section 20, 54)">
                        <group>
                            <field name="delivery_email"/>
                            <field name="delivery_whatsapp"/>
                            <field name="delivery_mobile_push"/>
                        </group>
                        <group>
                            <field name="recipient_user_ids" widget="many2many_tags"/>
                            <field name="recipient_emails"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_report_schedule_tree" model="ir.ui.view">
        <field name="name">garment.report.schedule.tree</field>
        <field name="model">garment.report.schedule</field>
        <field name="arch" type="xml">
            <tree string="BI Report Schedules" decoration-muted="state == 'paused'">
                <field name="name"/>
                <field name="report_category"/>
                <field name="frequency"/>
                <field name="format"/>
                <field name="next_run_date"/>
                <field name="last_sent_date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_report_schedule_search" model="ir.ui.view">
        <field name="name">garment.report.schedule.search</field>
        <field name="model">garment.report.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Report Schedules">
                <field name="name"/>
                <field name="report_category"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'report_category'}"/>
                    <filter string="Frequency" name="group_frequency" context="{'group_by': 'frequency'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_report_schedule" model="ir.actions.act_window">
        <field name="name">Report Schedules</field>
        <field name="res_model">garment.report.schedule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first scheduled BI report.</p>
            <p>Configuration only — actual rendering/delivery is deferred, see IMPLEMENTATION_NOTES.md.</p>
        </field>
    </record>

</odoo>
