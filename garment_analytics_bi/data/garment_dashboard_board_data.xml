<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ================= Executive Dashboard (SRS 8-9, 45) ================= -->

    <record id="dashboard_board_executive" model="garment.dashboard.board">
        <field name="name">Executive Dashboard</field>
        <field name="category">executive</field>
        <field name="sequence">10</field>
        <field name="is_default">True</field>
        <field name="description">Business overview for Managing Director / CEO / Directors — orders, order value and receivable exposure.</field>
    </record>

    <record id="dashboard_tile_exec_active_orders" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_executive"/>
        <field name="name">Active Orders</field>
        <field name="sequence">10</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_active_orders"/>
        <field name="icon">fa-shopping-cart</field>
        <field name="color">4</field>
    </record>

    <record id="dashboard_tile_exec_order_value" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_executive"/>
        <field name="name">Confirmed Order Value (Month)</field>
        <field name="sequence">20</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_confirmed_order_value"/>
        <field name="icon">fa-money</field>
        <field name="color">3</field>
    </record>

    <record id="dashboard_tile_exec_line_efficiency" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_executive"/>
        <field name="name">Factory Efficiency</field>
        <field name="sequence">30</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_line_efficiency"/>
        <field name="icon">fa-tachometer</field>
        <field name="color">10</field>
    </record>

    <record id="dashboard_tile_exec_receivable" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_executive"/>
        <field name="name">Outstanding Receivable</field>
        <field name="sequence">40</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_outstanding_receivable"/>
        <field name="icon">fa-university</field>
        <field name="color">2</field>
    </record>

    <!-- ================= Factory / Production Dashboard (SRS 10-13) ================= -->

    <record id="dashboard_board_production" model="garment.dashboard.board">
        <field name="name">Factory Production Dashboard</field>
        <field name="category">production</field>
        <field name="sequence">20</field>
        <field name="description">For Factory Manager / Production Manager — output, efficiency and OEE.</field>
    </record>

    <record id="dashboard_tile_prod_output" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_production"/>
        <field name="name">Today's Production</field>
        <field name="sequence">10</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_daily_output"/>
        <field name="icon">fa-industry</field>
        <field name="color">4</field>
    </record>

    <record id="dashboard_tile_prod_efficiency" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_production"/>
        <field name="name">Line Efficiency</field>
        <field name="sequence">20</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_line_efficiency"/>
        <field name="icon">fa-tachometer</field>
        <field name="color">10</field>
    </record>

    <record id="dashboard_tile_prod_oee" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_production"/>
        <field name="name">OEE</field>
        <field name="sequence">30</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_oee"/>
        <field name="icon">fa-cogs</field>
        <field name="color">6</field>
    </record>

    <!-- ================= Quality Dashboard (SRS 14) ================= -->

    <record id="dashboard_board_quality" model="garment.dashboard.board">
        <field name="name">Quality Dashboard</field>
        <field name="category">quality</field>
        <field name="sequence">30</field>
        <field name="description">Defect / pass-rate visibility for the Quality department.</field>
    </record>

    <record id="dashboard_tile_quality_score" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_quality"/>
        <field name="name">Quality Pass Score</field>
        <field name="sequence">10</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_quality_score"/>
        <field name="icon">fa-check-circle</field>
        <field name="color">10</field>
    </record>

    <record id="dashboard_tile_quality_inspected" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_quality"/>
        <field name="name">Inspected Quantity</field>
        <field name="sequence">20</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_inspected_qty"/>
        <field name="icon">fa-search</field>
        <field name="color">5</field>
    </record>

    <!-- ================= Finance Dashboard (SRS 15) ================= -->

    <record id="dashboard_board_finance" model="garment.dashboard.board">
        <field name="name">Finance Dashboard</field>
        <field name="category">finance</field>
        <field name="sequence">40</field>
        <field name="description">For CFO / Finance team — receivable, expense and average FOB price.</field>
    </record>

    <record id="dashboard_tile_finance_receivable" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_finance"/>
        <field name="name">Outstanding Receivable</field>
        <field name="sequence">10</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_outstanding_receivable"/>
        <field name="icon">fa-university</field>
        <field name="color">2</field>
    </record>

    <record id="dashboard_tile_finance_expense" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_finance"/>
        <field name="name">Approved Expense (Month)</field>
        <field name="sequence">20</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_approved_expense"/>
        <field name="icon">fa-credit-card</field>
        <field name="color">1</field>
    </record>

    <record id="dashboard_tile_finance_fob" model="garment.dashboard.tile">
        <field name="board_id" ref="dashboard_board_finance"/>
        <field name="name">Average FOB Price</field>
        <field name="sequence">30</field>
        <field name="tile_type">kpi</field>
        <field name="kpi_id" ref="kpi_def_avg_fob_price"/>
        <field name="icon">fa-tags</field>
        <field name="color">3</field>
    </record>

</odoo>
