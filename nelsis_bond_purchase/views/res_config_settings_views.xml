<odoo>
    <record id="res_config_settings_view_form_bond_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bond.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="after">
                <block title="Bonded Purchase" name="bond_purchase_setting_container">
                    <setting id="bond_po_require_lc" string="Bonded purchases require an LC"
                             help="A bonded import order cannot be confirmed without a Letter of Credit.">
                        <field name="bond_po_require_lc"/>
                    </setting>
                    <setting id="bond_po_lc_limit" string="LC limit check"
                             help="Orders on an LC must fit the LC amount plus tolerance.">
                        <field name="bond_po_lc_limit_policy"/>
                    </setting>
                    <setting id="bond_po_entitlement" string="Entitlement check"
                             help="Bonded orders are compared with the available entitlement (validated utilization only).">
                        <field name="bond_po_entitlement_policy"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
