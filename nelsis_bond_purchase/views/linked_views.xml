<odoo>
    <record id="nelsis_lc_form_purchase" model="ir.ui.view">
        <field name="name">nelsis.lc.form.purchase</field>
        <field name="model">nelsis.lc</field>
        <field name="inherit_id" ref="nelsis_lc_management.view_nelsis_lc_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_orders" type="object" class="oe_stat_button nl-stat" icon="fa-shopping-cart"
                        invisible="purchase_count == 0" groups="purchase.group_purchase_user">
                    <field name="purchase_count" widget="statinfo" string="Purchase Orders"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='pi_number']" position="after">
                <field name="purchase_count" invisible="1"/>
                <field name="po_committed_amount" widget="monetary" invisible="purchase_count == 0"/>
                <field name="po_balance_amount" widget="monetary" invisible="purchase_count == 0"/>
            </xpath>
        </field>
    </record>

    <record id="nelsis_commercial_file_form_purchase" model="ir.ui.view">
        <field name="name">nelsis.commercial.file.form.purchase</field>
        <field name="model">nelsis.commercial.file</field>
        <field name="inherit_id" ref="nelsis_commercial.view_commercial_file_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_orders" type="object" class="oe_stat_button nl-stat" icon="fa-shopping-cart"
                        invisible="purchase_count == 0" groups="purchase.group_purchase_user">
                    <field name="purchase_count" widget="statinfo" string="Purchase Orders"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_bond_consignment_form_purchase" model="ir.ui.view">
        <field name="name">bond.inventory.consignment.form.purchase</field>
        <field name="model">bond.inventory.consignment</field>
        <field name="inherit_id" ref="nelsis_bond_inventory.view_bond_consignment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_order" type="object" class="oe_stat_button nl-stat" icon="fa-shopping-cart"
                        invisible="not purchase_order_id" groups="purchase.group_purchase_user">
                    <div class="o_stat_info"><span class="o_stat_text">Purchase Order</span></div>
                </button>
            </xpath>
            <xpath expr="//field[@name='lc_number']" position="after">
                <field name="lc_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="purchase_order_id" readonly="state != 'draft'" options="{'no_create': True}"
                       groups="purchase.group_purchase_user"/>
                <field name="lc_shipment_id" readonly="state in ('closed', 'cancelled')" invisible="not lc_id"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='declared_qty']" position="after">
                <field name="purchase_order_id" column_invisible="1"/>
                <field name="purchase_line_id" column_invisible="not parent.purchase_order_id"
                       options="{'no_create': True}" groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_bond_receipt_form_purchase" model="ir.ui.view">
        <field name="name">bond.inventory.receipt.form.purchase</field>
        <field name="model">bond.inventory.receipt</field>
        <field name="inherit_id" ref="nelsis_bond_inventory.view_bond_receipt_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="purchase_order_id" invisible="1"/>
                <button name="action_view_purchase_order" type="object" class="oe_stat_button nl-stat" icon="fa-shopping-cart"
                        invisible="not purchase_order_id" groups="purchase.group_purchase_user">
                    <div class="o_stat_info"><span class="o_stat_text">Purchase Order</span></div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
