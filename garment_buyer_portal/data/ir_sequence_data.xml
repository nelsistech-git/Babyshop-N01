<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_portal_access_request" model="ir.sequence">
        <field name="name">Buyer Portal Access Request</field>
        <field name="code">garment.portal.access.request</field>
        <field name="prefix">PAR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_portal_approval_action" model="ir.sequence">
        <field name="name">Buyer Portal Approval Action</field>
        <field name="code">garment.portal.approval.action</field>
        <field name="prefix">PAP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_portal_message" model="ir.sequence">
        <field name="name">Buyer Portal Message</field>
        <field name="code">garment.portal.message</field>
        <field name="prefix">MSG/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
