<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_buyer_portal" model="ir.module.category">
            <field name="name">Smart Garment ERP - Buyer Portal</field>
            <field name="sequence">220</field>
        </record>

        <!-- ============================================================
             Internal staff roles (SRS section 5 - Internal Users)
             ============================================================ -->
        <record id="group_buyer_portal_staff" model="res.groups">
            <field name="name">Portal Support Staff (Respond to Buyer Messages)</field>
            <field name="category_id" ref="module_category_garment_buyer_portal"/>
            <field name="comment">Merchandiser / QA Manager / Commercial Manager (SRS section 5): responds to buyer
                messages, actions comments and applies buyer approval decisions raised via the portal.</field>
        </record>

        <record id="group_buyer_portal_coordinator" model="res.groups">
            <field name="name">Portal Coordinator (Buyer Registration Review)</field>
            <field name="category_id" ref="module_category_garment_buyer_portal"/>
            <field name="implied_ids" eval="[(4, ref('group_buyer_portal_staff'))]"/>
            <field name="comment">Buyer Manager (SRS section 5): runs Sales Review on Buyer Portal Access
                Requests (SRS section 22).</field>
        </record>

        <record id="group_buyer_portal_manager" model="res.groups">
            <field name="name">Portal Manager (Full Access)</field>
            <field name="category_id" ref="module_category_garment_buyer_portal"/>
            <field name="implied_ids" eval="[(4, ref('group_buyer_portal_coordinator'))]"/>
            <field name="comment">Management Approval stage on Buyer Portal Access Requests, full access to
                every buyer's portal activity log.</field>
        </record>

        <record id="group_buyer_portal_top_management" model="res.groups">
            <field name="name">Managing Director (Full Buyer Portal Dashboard)</field>
            <field name="category_id" ref="module_category_garment_buyer_portal"/>
            <field name="implied_ids" eval="[(4, ref('group_buyer_portal_manager'))]"/>
        </record>

        <!-- ============================================================
             Record Rules — internal
             ============================================================ -->
        <record id="rule_garment_portal_access_request_manager_all" model="ir.rule">
            <field name="name">Portal Manager+: All Access Requests</field>
            <field name="model_id" ref="model_garment_portal_access_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_buyer_portal_manager'))]"/>
        </record>

        <!-- ============================================================
             Record Rules — Buyer Portal (external users, SRS section 25:
             "Data Visibility Rules"). `buyer_id.partner_id` is compared to
             `user.partner_id.commercial_partner_id` (not the bare login
             partner) so a buyer's *secondary* portal users - additional
             contacts created for "a buyer can have multiple users" (SRS
             section 7) - see the same buyer data as the primary contact.
             ============================================================ -->
        <record id="rule_garment_portal_approval_action_portal_own" model="ir.rule">
            <field name="name">Buyer Portal: Own Approvals Only</field>
            <field name="model_id" ref="model_garment_portal_approval_action"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_portal_message_portal_own" model="ir.rule">
            <field name="name">Buyer Portal: Own Messages Only</field>
            <field name="model_id" ref="model_garment_portal_message"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_portal_activity_log_portal_own" model="ir.rule">
            <field name="name">Buyer Portal: Own Activity Log Only</field>
            <field name="model_id" ref="model_garment_portal_activity_log"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- ============================================================
             Buyer Portal visibility grants for sibling-module models this
             module exposes at /my but does not own (SRS section 25). Each
             sibling module already grants base.group_portal read access to
             its own top document; the matching ir.model.access.csv row in
             THIS module below extends that grant to garment.techpack,
             garment.quality.inspection and garment.style.approval, which
             previously had none.
             ============================================================ -->
        <record id="rule_garment_techpack_portal_own_buyer" model="ir.rule">
            <field name="name">Buyer Portal: Own Tech Packs Only</field>
            <field name="model_id" ref="garment_techpack.model_garment_techpack"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_quality_inspection_portal_own_buyer" model="ir.rule">
            <field name="name">Buyer Portal: Own Released Inspections Only</field>
            <field name="model_id" ref="garment_quality.model_garment_quality_inspection"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.commercial_partner_id.id),
                                        ('state', 'in', ('approved', 'released'))]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_style_approval_portal_own_buyer" model="ir.rule">
            <field name="name">Buyer Portal: Own Style Approval Steps Only</field>
            <field name="model_id" ref="garment_style_library.model_garment_style_approval"/>
            <field name="domain_force">[('style_id.buyer_id.partner_id', '=',
                                          user.partner_id.commercial_partner_id.id),
                                        ('approval_step', '=', 'buyer_approval')]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- ============================================================
             Supplementary Buyer Portal rules that OR onto garment.order /
             garment.sample / garment.shipment (each already ships one
             narrower base.group_portal rule keyed on `user.partner_id`
             directly). These broaden coverage to secondary buyer contacts
             via `commercial_partner_id` without altering the sibling
             modules' own files (Odoo ORs multiple rules for the same
             model + group).
             ============================================================ -->
        <record id="rule_garment_order_portal_own_buyer_multiuser" model="ir.rule">
            <field name="name">Buyer Portal: Own Orders Only (Multi-User Buyer Contacts)</field>
            <field name="model_id" ref="garment_order_management.model_garment_order"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_sample_portal_own_buyer_multiuser" model="ir.rule">
            <field name="name">Buyer Portal: Own Samples Only (Multi-User Buyer Contacts)</field>
            <field name="model_id" ref="garment_sample_management.model_garment_sample"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_shipment_portal_own_buyer_multiuser" model="ir.rule">
            <field name="name">Buyer Portal: Own Shipments Only (Multi-User Buyer Contacts)</field>
            <field name="model_id" ref="garment_logistics.model_garment_shipment"/>
            <field name="domain_force">[('buyer_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
