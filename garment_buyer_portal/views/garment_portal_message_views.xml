<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_portal_message_tree" model="ir.ui.view">
        <field name="name">garment.portal.message.tree</field>
        <field name="model">garment.portal.message</field>
        <field name="arch" type="xml">
            <tree string="Buyer Portal Messages" decoration-muted="completion_status == 'confirmed'"
                  decoration-warning="completion_status == 'open'">
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="subject"/>
                <field name="direction"/>
                <field name="responsible_department"/>
                <field name="assigned_user_id"/>
                <field name="message_date"/>
                <field name="completion_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_portal_message_form" model="ir.ui.view">
        <field name="name">garment.portal.message.form</field>
        <field name="model">garment.portal.message</field>
        <field name="arch" type="xml">
            <form string="Buyer Portal Message">
                <header>
                    <field name="completion_status" widget="statusbar"
                           statusbar_visible="open,assigned,action_taken,response_submitted,confirmed"/>
                    <button name="action_assign" type="object" string="Assign to Team"
                            class="btn-primary" invisible="completion_status != 'open'"/>
                    <button name="action_mark_action_taken" type="object" string="Mark Action Taken"
                            invisible="completion_status != 'assigned'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="partner_id"/>
                            <field name="author_user_id"/>
                            <field name="direction"/>
                            <field name="message_date"/>
                        </group>
                        <group>
                            <field name="order_id"/>
                            <field name="sample_id"/>
                            <field name="techpack_id"/>
                            <field name="shipment_id"/>
                        </group>
                    </group>
                    <group string="Assignment">
                        <field name="responsible_department"/>
                        <field name="assigned_user_id"/>
                        <field name="mentioned_partner_ids" widget="many2many_tags"/>
                        <field name="is_read"/>
                    </group>
                    <group string="Message">
                        <field name="subject"/>
                        <field name="body" nolabel="1"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <notebook>
                        <page string="Replies">
                            <field name="reply_ids">
                                <tree editable="bottom">
                                    <field name="direction"/>
                                    <field name="author_user_id"/>
                                    <field name="partner_id"/>
                                    <field name="subject"/>
                                    <field name="message_date"/>
                                    <field name="completion_status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_garment_portal_message_search" model="ir.ui.view">
        <field name="name">garment.portal.message.search</field>
        <field name="model">garment.portal.message</field>
        <field name="arch" type="xml">
            <search string="Search Buyer Portal Messages">
                <field name="name"/>
                <field name="subject"/>
                <field name="buyer_id"/>
                <field name="assigned_user_id"/>
                <filter string="Open" name="filter_open" domain="[('completion_status', '=', 'open')]"/>
                <filter string="Assigned to Me" name="filter_mine" domain="[('assigned_user_id', '=', uid)]"/>
                <filter string="Unconfirmed" name="filter_unconfirmed"
                        domain="[('completion_status', '!=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'responsible_department'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'completion_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_portal_message" model="ir.actions.act_window">
        <field name="name">Buyer Portal Messages</field>
        <field name="res_model">garment.portal.message</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_garment_portal_message_search"/>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'search_default_filter_unconfirmed': 1}</field>
    </record>

</odoo>
