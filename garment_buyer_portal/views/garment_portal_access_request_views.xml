<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_portal_access_request_tree" model="ir.ui.view">
        <field name="name">garment.portal.access.request.tree</field>
        <field name="model">garment.portal.access.request</field>
        <field name="arch" type="xml">
            <tree string="Buyer Portal Access Requests" decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="company_name"/>
                <field name="contact_person"/>
                <field name="email"/>
                <field name="requested_role"/>
                <field name="buyer_id"/>
                <field name="request_date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_portal_access_request_form" model="ir.ui.view">
        <field name="name">garment.portal.access.request.form</field>
        <field name="model">garment.portal.access.request</field>
        <field name="arch" type="xml">
            <form string="Buyer Portal Access Request">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,sales_review,management_approval,approved"/>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start_sales_review" type="object" string="Start Sales Review"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="garment_buyer_portal.group_buyer_portal_coordinator"/>
                    <button name="action_send_for_management_approval" type="object"
                            string="Send for Management Approval" class="btn-primary"
                            invisible="state != 'sales_review'"
                            groups="garment_buyer_portal.group_buyer_portal_coordinator"/>
                    <button name="action_approve" type="object" string="Approve &amp; Create Portal Account"
                            class="btn-primary" invisible="state != 'management_approval'"
                            groups="garment_buyer_portal.group_buyer_portal_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state in ('approved', 'rejected')"
                            groups="garment_buyer_portal.group_buyer_portal_coordinator"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Portal Account Created" bg_color="text-bg-success"
                            invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Registration">
                            <field name="source"/>
                            <field name="buyer_id" options="{'no_create': True}"/>
                            <field name="company_name"/>
                            <field name="brand_name"/>
                            <field name="country_id"/>
                            <field name="website"/>
                            <field name="business_category"/>
                            <field name="buyer_type"/>
                        </group>
                        <group string="Contact &amp; Requested Access">
                            <field name="contact_person"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="requested_role"/>
                            <field name="department"/>
                            <field name="request_date"/>
                        </group>
                    </group>
                    <group string="Review" invisible="state == 'draft'">
                        <group>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="review_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="welcome_email_sent" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rejection Reason" invisible="state == 'approved'">
                        <field name="rejection_reason" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_garment_portal_access_request_search" model="ir.ui.view">
        <field name="name">garment.portal.access.request.search</field>
        <field name="model">garment.portal.access.request</field>
        <field name="arch" type="xml">
            <search string="Search Buyer Portal Access Requests">
                <field name="name"/>
                <field name="company_name"/>
                <field name="contact_person"/>
                <field name="email"/>
                <field name="buyer_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Review" name="filter_pending"
                        domain="[('state', 'in', ('submitted', 'sales_review', 'management_approval'))]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requested Role" name="group_role" context="{'group_by': 'requested_role'}"/>
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_portal_access_request" model="ir.actions.act_window">
        <field name="name">Buyer Portal Access Requests</field>
        <field name="res_model">garment.portal.access.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_garment_portal_access_request_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create a Buyer Portal Access Request</p>
            <p>Registration Request -&gt; Sales Review -&gt; Management Approval -&gt; Portal Account Created
                -&gt; Welcome Email Sent (SRS section 22).</p>
        </field>
    </record>

</odoo>
