<odoo>
    <record id="module_category_bond_compliance" model="ir.module.category">
        <field name="name">Bond Compliance</field>
        <field name="description">Regulatory rule register for the bonded warehouse.</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_bond_compliance_user" model="res.groups">
        <field name="name">Compliance User (Read Only)</field>
        <field name="category_id" ref="module_category_bond_compliance"/>
        <field name="comment">Can read rules, exceptions and the evaluation log.</field>
    </record>

    <record id="group_bond_compliance_officer" model="res.groups">
        <field name="name">Compliance Officer</field>
        <field name="category_id" ref="module_category_bond_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_compliance_user'))]"/>
        <field name="comment">Drafts rules and exceptions, submits them and creates new versions.</field>
    </record>

    <record id="group_bond_compliance_reviewer" model="res.groups">
        <field name="name">Compliance Reviewer</field>
        <field name="category_id" ref="module_category_bond_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_compliance_user'))]"/>
        <field name="comment">Verifies rules against the official source and records professional verification.</field>
    </record>

    <record id="group_bond_compliance_approver" model="res.groups">
        <field name="name">Compliance Approver</field>
        <field name="category_id" ref="module_category_bond_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_bond_compliance_user'))]"/>
        <field name="comment">Approves and activates rules and exceptions.</field>
    </record>

    <record id="group_bond_compliance_manager" model="res.groups">
        <field name="name">Compliance Manager</field>
        <field name="category_id" ref="module_category_bond_compliance"/>
        <field name="implied_ids" eval="[
            (4, ref('group_bond_compliance_officer')),
            (4, ref('group_bond_compliance_reviewer')),
            (4, ref('group_bond_compliance_approver'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access including master data. Segregation of duties still applies to workflow steps.</field>
    </record>
</odoo>
