<odoo noupdate="1">
    <record id="ir_cron_bond_compliance_rule_reminders" model="ir.cron">
        <field name="name">Bond Compliance: Rule Reminders</field>
        <field name="model_id" ref="model_bond_compliance_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_compliance_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
    <record id="ir_cron_bond_compliance_exception_expiry" model="ir.cron">
        <field name="name">Bond Compliance: Expire Exceptions</field>
        <field name="model_id" ref="model_bond_compliance_exception"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_exceptions()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
</odoo>
