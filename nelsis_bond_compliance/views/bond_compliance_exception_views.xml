<odoo>
    <record id="view_bond_compliance_exception_tree" model="ir.ui.view">
        <field name="name">bond.compliance.exception.tree</field>
        <field name="model">bond.compliance.exception</field>
        <field name="arch" type="xml">
            <tree string="Compliance Exceptions"
                  decoration-success="state == 'approved'"
                  decoration-danger="state in ('rejected', 'revoked')"
                  decoration-muted="state == 'expired'">
                <field name="name"/>
                <field name="rule_id"/>
                <field name="reference"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="requested_by"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_bond_compliance_exception_form" model="ir.ui.view">
        <field name="name">bond.compliance.exception.form</field>
        <field name="model">bond.compliance.exception</field>
        <field name="arch" type="xml">
            <form string="Compliance Exception" duplicate="0" class="nl-ui">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary nl-btn nl-primary" invisible="state != 'draft'"
                            groups="nelsis_bond_compliance.group_bond_compliance_officer" icon="fa-paper-plane"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary nl-btn nl-success" invisible="state != 'submitted'"
                            groups="nelsis_bond_compliance.group_bond_compliance_approver" icon="fa-thumbs-up"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="state != 'submitted'"
                            groups="nelsis_bond_compliance.group_bond_compliance_approver" class="nl-btn nl-danger" icon="fa-times-circle"/>
                    <button name="action_return_to_draft" type="object" string="Return to Draft"
                            invisible="state != 'rejected'"
                            groups="nelsis_bond_compliance.group_bond_compliance_officer" class="nl-btn nl-neutral" icon="fa-undo"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            invisible="state != 'approved'"
                            groups="nelsis_bond_compliance.group_bond_compliance_approver" class="nl-btn nl-danger" icon="fa-ban"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved" class="nl-statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        An approved exception never turns a failed evaluation into a pass; it is returned
                        to the calling module for its own decision. It does not constitute customs approval.
                    </div>
                    <group>
                        <group>
                            <field name="rule_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="rule_code"/>
                            <field name="rule_version"/>
                            <field name="reference" readonly="state != 'draft'"/>
                            <field name="res_model" readonly="state != 'draft'" groups="base.group_no_one"/>
                            <field name="res_id" readonly="state != 'draft'" groups="base.group_no_one"/>
                        </group>
                        <group>
                            <field name="valid_from" readonly="state != 'draft'"/>
                            <field name="valid_to" readonly="state != 'draft'"/>
                            <field name="requested_by"/>
                            <field name="submitted_by"/>
                            <field name="approved_by"/>
                            <field name="approved_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="state != 'draft'"/>
                        <field name="conditions" readonly="state != 'draft'"/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                    </group>
                    <group string="Professional Verification">
                        <field name="requires_professional_verification" readonly="state != 'draft'"/>
                        <field name="professional_verified_by" invisible="not requires_professional_verification"
                               readonly="state not in ('draft', 'submitted')"/>
                        <field name="professional_verified_date" invisible="not requires_professional_verification"
                               readonly="state not in ('draft', 'submitted')"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_bond_compliance_exception_search" model="ir.ui.view">
        <field name="name">bond.compliance.exception.search</field>
        <field name="model">bond.compliance.exception</field>
        <field name="arch" type="xml">
            <search string="Compliance Exceptions">
                <field name="name"/>
                <field name="reference"/>
                <field name="rule_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Awaiting Approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bond_compliance_exception" model="ir.actions.act_window">
        <field name="name">Compliance Exceptions</field>
        <field name="res_model">bond.compliance.exception</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
