<odoo>
    <record id="view_bond_compliance_reject_wizard_form" model="ir.ui.view">
        <field name="name">bond.compliance.reject.wizard.form</field>
        <field name="model">bond.compliance.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject" class="nl-ui">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="reason" placeholder="Explain what must be corrected..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary nl-btn nl-danger" icon="fa-times-circle"/>
                    <button string="Cancel" class="btn-secondary nl-btn nl-ghost" special="cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
