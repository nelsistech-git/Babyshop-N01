<odoo>
    <!-- Rule categories -->
    <record id="view_bond_compliance_rule_category_tree" model="ir.ui.view">
        <field name="name">bond.compliance.rule.category.tree</field>
        <field name="model">bond.compliance.rule.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="rule_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_bond_compliance_rule_category" model="ir.actions.act_window">
        <field name="name">Rule Categories</field>
        <field name="res_model">bond.compliance.rule.category</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- License categories -->
    <record id="view_bond_compliance_license_category_tree" model="ir.ui.view">
        <field name="name">bond.compliance.license.category.tree</field>
        <field name="model">bond.compliance.license.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_bond_compliance_license_category" model="ir.actions.act_window">
        <field name="name">License / Factory Categories</field>
        <field name="res_model">bond.compliance.license.category</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Document types -->
    <record id="view_bond_compliance_document_type_tree" model="ir.ui.view">
        <field name="name">bond.compliance.document.type.tree</field>
        <field name="model">bond.compliance.document.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_bond_compliance_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">bond.compliance.document.type</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
