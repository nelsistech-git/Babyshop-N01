<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_tech_attachment_tree" model="ir.ui.view">
        <field name="name">garment.tech.attachment.tree</field>
        <field name="model">garment.tech.attachment</field>
        <field name="arch" type="xml">
            <tree string="Attachments">
                <field name="techpack_id"/>
                <field name="name"/>
                <field name="source"/>
                <field name="ai_extraction_done"/>
                <field name="human_verified"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_tech_attachment_form" model="ir.ui.view">
        <field name="name">garment.tech.attachment.form</field>
        <field name="model">garment.tech.attachment</field>
        <field name="arch" type="xml">
            <form string="Tech Pack Attachment">
                <header>
                    <button name="action_run_ai_extraction" type="object" string="Run AI Extraction" class="btn-secondary" icon="fa-magic"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="techpack_id"/>
                            <field name="name"/>
                            <field name="source"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="uploaded_by_id"/>
                            <field name="upload_date"/>
                            <field name="ai_extraction_done" readonly="1"/>
                            <field name="human_verified"/>
                        </group>
                    </group>
                    <field name="ai_extracted_data" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_tech_attachment" model="ir.actions.act_window">
        <field name="name">Tech Pack Attachments</field>
        <field name="res_model">garment.tech.attachment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
