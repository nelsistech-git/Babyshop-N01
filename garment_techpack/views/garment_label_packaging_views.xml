<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_label_spec_tree" model="ir.ui.view">
        <field name="name">garment.label.spec.tree</field>
        <field name="model">garment.label.spec</field>
        <field name="arch" type="xml">
            <tree string="Labels">
                <field name="techpack_id"/>
                <field name="label_type"/>
                <field name="label_code"/>
                <field name="material"/>
                <field name="approval_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_label_spec_form" model="ir.ui.view">
        <field name="name">garment.label.spec.form</field>
        <field name="model">garment.label.spec</field>
        <field name="arch" type="xml">
            <form string="Label Specification">
                <header>
                    <field name="approval_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="techpack_id"/>
                            <field name="label_type"/>
                            <field name="label_code"/>
                            <field name="material"/>
                        </group>
                        <group>
                            <field name="size"/>
                            <field name="color"/>
                            <field name="position"/>
                            <field name="sewing_method"/>
                            <field name="supplier_id"/>
                        </group>
                    </group>
                    <field name="label_image" widget="image"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_label_spec" model="ir.actions.act_window">
        <field name="name">Labels</field>
        <field name="res_model">garment.label.spec</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_garment_packaging_spec_tree" model="ir.ui.view">
        <field name="name">garment.packaging.spec.tree</field>
        <field name="model">garment.packaging.spec</field>
        <field name="arch" type="xml">
            <tree string="Packaging Specifications">
                <field name="techpack_id"/>
                <field name="poly_bag_type"/>
                <field name="carton_type"/>
                <field name="approval_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_garment_packaging_spec_form" model="ir.ui.view">
        <field name="name">garment.packaging.spec.form</field>
        <field name="model">garment.packaging.spec</field>
        <field name="arch" type="xml">
            <form string="Packaging Specification">
                <header>
                    <field name="approval_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="techpack_id"/>
                            <field name="poly_bag_type"/>
                            <field name="poly_bag_size"/>
                            <field name="thickness"/>
                        </group>
                        <group>
                            <field name="carton_type"/>
                            <field name="carton_dimension"/>
                            <field name="folding_method"/>
                        </group>
                    </group>
                    <group>
                        <field name="hanger_requirement"/>
                        <field name="tissue_requirement"/>
                        <field name="barcode_requirement"/>
                    </group>
                    <field name="carton_marking"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_packaging_spec" model="ir.actions.act_window">
        <field name="name">Packaging Specifications</field>
        <field name="res_model">garment.packaging.spec</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
