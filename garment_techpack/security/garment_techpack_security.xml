<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_garment_techpack" model="ir.module.category">
            <field name="name">Smart Garment ERP - Tech Pack</field>
            <field name="sequence">52</field>
        </record>

        <record id="group_techpack_merchandiser" model="res.groups">
            <field name="name">Merchandiser (Create/Edit Assigned Tech Packs)</field>
            <field name="category_id" ref="module_category_garment_techpack"/>
        </record>

        <record id="group_techpack_designer" model="res.groups">
            <field name="name">Designer (Design Section Access)</field>
            <field name="category_id" ref="module_category_garment_techpack"/>
        </record>

        <record id="group_techpack_pattern_master" model="res.groups">
            <field name="name">Pattern Master (Pattern Section Access)</field>
            <field name="category_id" ref="module_category_garment_techpack"/>
        </record>

        <record id="group_techpack_cad_operator" model="res.groups">
            <field name="name">CAD Operator (CAD Section Access)</field>
            <field name="category_id" ref="module_category_garment_techpack"/>
        </record>

        <record id="group_techpack_readonly" model="res.groups">
            <field name="name">Sampling / Production / Quality (View / Inspection Access)</field>
            <field name="category_id" ref="module_category_garment_techpack"/>
        </record>

        <record id="group_techpack_technical_manager" model="res.groups">
            <field name="name">Technical Manager (Full Access)</field>
            <field name="category_id" ref="module_category_garment_techpack"/>
            <field name="implied_ids" eval="[(4, ref('group_techpack_merchandiser')),
                                              (4, ref('group_techpack_designer')),
                                              (4, ref('group_techpack_pattern_master')),
                                              (4, ref('group_techpack_cad_operator'))]"/>
        </record>

        <record id="group_techpack_top_management" model="res.groups">
            <field name="name">Top Management (MD / Product Dev Manager / Merchandising Manager)</field>
            <field name="category_id" ref="module_category_garment_techpack"/>
            <field name="implied_ids" eval="[(4, ref('group_techpack_technical_manager'))]"/>
        </record>

        <record id="rule_garment_techpack_merchandiser_assigned" model="ir.rule">
            <field name="name">Merchandiser: Assigned Tech Packs Only</field>
            <field name="model_id" ref="model_garment_techpack"/>
            <field name="domain_force">[('assigned_merchandiser_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_techpack_merchandiser'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_techpack_full_access" model="ir.rule">
            <field name="name">Full Access Roles: All Tech Packs</field>
            <field name="model_id" ref="model_garment_techpack"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_techpack_technical_manager'))]"/>
        </record>

        <record id="rule_garment_techpack_readonly_approved" model="ir.rule">
            <field name="name">Sampling/Production/Quality: Approved-Only View</field>
            <field name="model_id" ref="model_garment_techpack"/>
            <field name="domain_force">[('state', 'in', ['approved', 'production_release'])]</field>
            <field name="groups" eval="[(4, ref('group_techpack_readonly'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_garment_techpack_portal_approved_only" model="ir.rule">
            <field name="name">Portal Buyer: Approved Tech Pack View</field>
            <field name="model_id" ref="model_garment_techpack"/>
            <field name="domain_force">[('state', 'in', ['approved', 'production_release']),
                                        ('buyer_id.partner_id', '=', user.partner_id.id),
                                        ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
