<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garment_techpack_version_compare_form" model="ir.ui.view">
        <field name="name">garment.techpack.version.compare.form</field>
        <field name="model">garment.techpack.version.compare</field>
        <field name="arch" type="xml">
            <form string="Compare Tech Pack Versions">
                <group>
                    <field name="techpack_id" readonly="1"/>
                    <field name="version_from_id"/>
                    <field name="version_to_id"/>
                </group>
                <field name="comparison_result" readonly="1"/>
                <footer>
                    <button name="action_compare" type="object" string="Compare" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_garment_techpack_version_compare" model="ir.actions.act_window">
        <field name="name">Compare Tech Pack Versions</field>
        <field name="res_model">garment.techpack.version.compare</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
