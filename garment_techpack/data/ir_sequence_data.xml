<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_garment_techpack" model="ir.sequence">
        <field name="name">Garment Tech Pack Number</field>
        <field name="code">garment.techpack</field>
        <field name="prefix">TP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_artwork" model="ir.sequence">
        <field name="name">Garment Artwork Number</field>
        <field name="code">garment.artwork</field>
        <field name="prefix">ART/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garment_tech_change" model="ir.sequence">
        <field name="name">Garment Tech Change Number</field>
        <field name="code">garment.tech.change</field>
        <field name="prefix">TCR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
