<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    <data>-->
        <!-- change password wizard -->
        <record id="technician_change_password_wizard_view" model="ir.ui.view">
            <field name="name">Change Password</field>
            <field name="model">technician.change.password.wizard</field>
            <field name="arch" type="xml">
                <form string="Change Password">
                    <group>
                        <group>
                            <field name="user_id" options="{'no_open': True,'no_create': True}" readonly="1"/>
                            <field name="password" password="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Change Password" name="technician_change_password" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="technician_change_password_wizard_action" model="ir.actions.act_window">
            <field name="name">Change Password</field>
            <field name="res_model">technician.change.password.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

