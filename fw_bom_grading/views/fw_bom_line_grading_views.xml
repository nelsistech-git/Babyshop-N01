<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_bom_line_grading_form" model="ir.ui.view">
        <field name="name">fw.bom.line.grading.form</field>
        <field name="model">fw.bom.line</field>
        <field name="arch" type="xml">
            <form string="BOM Component - Size Grading">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="part_name" readonly="1"/></h1>
                        <h3><field name="component_id" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="bom_id" readonly="1"/>
                            <field name="qty_per_pair" readonly="1"/>
                        </group>
                        <group>
                            <field name="has_size_grading" readonly="1"/>
                            <field name="avg_graded_qty_per_pair" readonly="1"/>
                        </group>
                    </group>
                    <button name="action_generate_size_grading" type="object"
                            string="Generate from Style's Size Curve" class="btn-primary mb-2"/>
                    <field name="grading_line_ids">
                        <tree editable="bottom">
                            <field name="size_id"/>
                            <field name="qty_per_pair"/>
                            <field name="remarks"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fw_bom_line_grading_tree" model="ir.ui.view">
        <field name="name">fw.bom.line.grading.tree</field>
        <field name="model">fw.bom.line</field>
        <field name="arch" type="xml">
            <tree string="BOM Components (Size Grading)" decoration-success="has_size_grading==True">
                <field name="bom_id"/>
                <field name="part_name"/>
                <field name="component_id"/>
                <field name="qty_per_pair"/>
                <field name="has_size_grading"/>
                <field name="avg_graded_qty_per_pair"/>
            </tree>
        </field>
    </record>

    <record id="view_fw_bom_line_grading_search" model="ir.ui.view">
        <field name="name">fw.bom.line.grading.search</field>
        <field name="model">fw.bom.line</field>
        <field name="arch" type="xml">
            <search string="Search BOM Components">
                <field name="bom_id"/>
                <field name="part_name"/>
                <field name="component_id"/>
                <filter string="Size Grading Defined" name="graded" domain="[('has_size_grading','=',True)]"/>
                <filter string="Not Yet Graded" name="not_graded" domain="[('has_size_grading','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="BOM Version" name="group_bom" context="{'group_by': 'bom_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fw_bom_line_grading" model="ir.actions.act_window">
        <field name="name">BOM Size Grading</field>
        <field name="res_model">fw.bom.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fw_bom_line_grading_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Select a BOM component to define its size-wise material consumption
            </p>
        </field>
    </record>

    <menuitem id="menu_fw_bom_line_grading" name="BOM Size Grading"
              parent="fw_plm.menu_fw_plm_root" action="action_fw_bom_line_grading"
              sequence="15"/>
</odoo>
