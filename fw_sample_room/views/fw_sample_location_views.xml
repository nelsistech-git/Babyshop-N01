<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fw_sample_location_tree" model="ir.ui.view">
        <field name="name">fw.sample.location.tree</field>
        <field name="model">fw.sample.location</field>
        <field name="arch" type="xml">
            <tree string="Storage Locations" editable="bottom">
                <field name="location_code"/>
                <field name="name"/>
                <field name="location_type"/>
                <field name="capacity_note"/>
            </tree>
        </field>
    </record>

    <record id="action_fw_sample_location" model="ir.actions.act_window">
        <field name="name">Storage Locations</field>
        <field name="res_model">fw.sample.location</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
